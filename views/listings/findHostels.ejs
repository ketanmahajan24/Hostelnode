<!-- ===== HERO ===== -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-badge">
      <div class="dot"></div>
      Now live across India
    </div>

    <% if (student) { %>
      <h1>Welcome back,<br><span class="accent"><%= student.firstName %></span> 👋</h1>
      <p class="hero-sub">
        <% if (student.city) { %>
          Showing hostels near <strong><%= student.city %></strong> ·
        <% } %>
        Search 2,400+ verified hostels and PGs. Compare prices and book a visit in seconds.
      </p>
    <% } else { %>
      <h1>Find your perfect<br><span class="accent">hostel or PG</span> near<br>your college</h1>
      <p class="hero-sub">Search 2,400+ verified hostels and PGs near your college. Compare prices, amenities, and book a visit in seconds.</p>
    <% } %>

    <!-- Search Card -->
    <div class="search-card">
      <div class="search-tabs">
        <button class="search-tab active" onclick="switchTab(this)">All</button>
        <button class="search-tab" onclick="switchTab(this)">Hostel</button>
        <button class="search-tab" onclick="switchTab(this)">PG</button>
        <button class="search-tab" onclick="switchTab(this)">Flat share</button>
      </div>

<form action="/findHostels/results" method="GET" id="heroSearchForm">
  <div class="search-row">

    <!-- College / Area / City input with autocomplete -->
    <div class="search-field" style="flex:2; min-width:200px; position:relative;">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" name="college" id="collegeInput"
        placeholder="College name or area (e.g. IIT Bombay, Pune)…"
        autocomplete="off"
        value="<%= student ? (student.collegeName || student.city || '') : '' %>">
      <!-- Autocomplete suggestions dropdown -->
      <div id="acSuggestions" style="
        display:none; position:absolute; top:100%; left:0; right:0;
        background:#fff; border:1px solid #e0e8e2; border-radius:12px;
        box-shadow:0 8px 24px rgba(0,0,0,.10); z-index:999; overflow:hidden;
        margin-top:6px; max-height:280px; overflow-y:auto;
      "></div>
    </div>

    <!-- Budget -->
    <div class="search-field">
      <i class="fa-solid fa-indian-rupee-sign"></i>
      <select name="budget">
        <option value="">Any budget</option>
        <option value="3000">Under ₹3,000</option>
        <option value="5000">Under ₹5,000</option>
        <option value="8000">Under ₹8,000</option>
        <option value="12000">Under ₹12,000</option>
      </select>
    </div>

    <!-- Gender -->
    <div class="search-field">
      <i class="fa-solid fa-venus-mars"></i>
      <select name="gender">
        <option value="">Any type</option>
        <option value="boys">Boys</option>
        <option value="girls">Girls</option>
        <option value="coed">Co-ed</option>
      </select>
    </div>

    <!-- Property type (hidden, set by tabs) -->
    <input type="hidden" name="type" id="propTypeInput" value="">

    <button type="submit" class="btn-search">
      <i class="fa-solid fa-magnifying-glass"></i> Search
    </button>
  </div>
</form>

      <div class="search-quick">
        <span class="search-quick-label">Popular:</span>
        <button type="button" class="quick-chip" onclick="fillSearch('IIT Bombay')">IIT Bombay</button>
        <button type="button" class="quick-chip" onclick="fillSearch('Delhi University')">Delhi University</button>
        <button type="button" class="quick-chip" onclick="fillSearch('Christ University Bangalore')">Christ Univ.</button>
        <button type="button" class="quick-chip" onclick="fillSearch('Pune University')">Pune Univ.</button>
        <button type="button" class="quick-chip" onclick="fillSearch('VIT Vellore')">VIT Vellore</button>
      </div>
    </div>
  </div><!-- /hero-inner -->

  <!-- Stats strip -->
  <div class="stats-strip">
