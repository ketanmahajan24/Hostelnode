<script>
/* ===== LOADER ===== */
document.addEventListener('DOMContentLoaded', function () {
  setTimeout(function () {
    const loader = document.getElementById('hn-loader');
    loader.style.opacity = '0';
    setTimeout(() => loader.style.display = 'none', 400);
  }, 1400);
});

/* ===== NAVBAR SCROLL ===== */
window.addEventListener('scroll', function () {
  document.getElementById('hnNav').classList.toggle('scrolled', window.scrollY > 10);
}, { passive: true });

/* ===== MOBILE NAV ===== */
function openMobileNav() {
  document.getElementById('mobileNav').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeMobileNav(e) {
  if (e.target === document.getElementById('mobileNav')) {
    document.getElementById('mobileNav').classList.remove('open');
    document.body.style.overflow = '';
  }
}

/* ═══════════════════════════════════════════════════════
   PROFILE DROPDOWN
   - click pill  → toggle open class
   - click outside → close
   - stopPropagation prevents the document listener from
     immediately closing it on the same click that opens it
═══════════════════════════════════════════════════════ */
function snToggle(e) {
  e.stopPropagation();
  const pill = document.getElementById('snPill');
  if (pill) pill.classList.toggle('open');
}

document.addEventListener('click', function () {
  const pill = document.getElementById('snPill');
  if (pill) pill.classList.remove('open');
});

/* ===== SEARCH TABS ===== */
function switchTab(el) {
  document.querySelectorAll('.search-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

/* ===== QUICK CHIPS ===== */
function fillSearch(college) {
  document.getElementById('collegeInput').value = college;
  document.getElementById('collegeInput').focus();
}

/* ===== PRICE RANGE ===== */
function updatePrice(val) {
  document.getElementById('priceVal').textContent = '₹' + Number(val).toLocaleString('en-IN');
}

/* ===== WISHLIST TOGGLE ===== */
async function toggleWish(e, btn) {
  e.stopPropagation();

  const card = btn.closest('.hostel-card');
  const listingId = card?.dataset.id;

  if (!listingId) {
    window.location.href = '/student/login';
    return;
  }

  // Optimistic UI update first
  const isSaved = btn.classList.contains('saved');
  btn.classList.toggle('saved', !isSaved);
  btn.querySelector('i').className = !isSaved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';

  try {
    const res = await fetch(`/student/wishlist/toggle/${listingId}`, { method: 'POST' });

    if (res.redirected || res.status === 401) {
      // Not logged in — revert and redirect
      btn.classList.toggle('saved', isSaved);
      btn.querySelector('i').className = isSaved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
      window.location.href = '/student/login';
      return;
    }

    const data = await res.json();

    if (data.success) {
      // Confirm the real state from server
      btn.classList.toggle('saved', data.saved);
      btn.querySelector('i').className = data.saved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
      showToast(data.saved ? '❤️ Saved to wishlist' : '🤍 Removed from wishlist');
    } else {
      // Revert on failure
      btn.classList.toggle('saved', isSaved);
      btn.querySelector('i').className = isSaved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
      showToast('Could not update wishlist');
    }

  } catch (err) {
    // Revert on network error
    btn.classList.toggle('saved', isSaved);
    btn.querySelector('i').className = isSaved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
    console.error('Wishlist error:', err);
  }
}

function showToast(msg) {
  let t = document.getElementById('hn-toast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'hn-toast';
    t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:#1a1a2e;color:white;padding:12px 22px;border-radius:12px;font-size:14px;font-weight:500;z-index:9999;transition:transform .3s,opacity .3s;opacity:0;pointer-events:none;white-space:nowrap;';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = '1';
  t.style.transform = 'translateX(-50%) translateY(0)';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => {
    t.style.opacity = '0';
    t.style.transform = 'translateX(-50%) translateY(80px)';
  }, 2500);
}

/* ===== SORT ===== */
function setSort(el, type) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
}

/* ===== FILTERS ===== */
function applyFilters() {
  const btn = document.querySelector('.btn-apply-filter');
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Applying…';
  setTimeout(() => {
    btn.innerHTML = '<i class="fa-solid fa-sliders"></i> Apply filters';
  }, 900);
}
function clearFilters() {
  document.querySelectorAll('.sidebar input[type="checkbox"]').forEach(cb => cb.checked = false);
  document.getElementById('priceRange').value = 8000;
  updatePrice(8000);
}

/* ===== VIEW HOSTEL ===== */
function viewHostel(slug) { window.location.href = '/hostel/' + slug; }

/* ===== CALL / WHATSAPP ===== */
function callHostel(phone) { window.location.href = 'tel:' + phone; }
function waHostel(phone) {
  const num = (phone || '').replace(/[^0-9]/g, '');
  if (!num) return;
  window.open('https://wa.me/' + num + '?text=' +
    encodeURIComponent('Hi! I found your hostel on HostelNode. I am interested in a room. Can you share details?'),
    '_blank');
}

/* ===== COLLEGE CHIP ===== */
function searchCollege(name) {
  window.location.href = '/findHostels/results?college=' + encodeURIComponent(name);
}

/* ===== MAP ===== */
function openMap() {
  alert('Map view coming soon! Add your Google Maps API key to enable this.');
}

/* ===== LOAD MORE ===== */
function loadMore(btn) {
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Loading…';
  setTimeout(() => {
    btn.innerHTML = '<i class="fa-solid fa-rotate"></i> Load more hostels';
  }, 1200);
}

/* ===== IMAGE SLIDER ===== */
function slideImage(e, btn, direction) {
  e.stopPropagation();
  const wrap   = btn.closest('.card-img-wrap');
  const slides = wrap.querySelectorAll('.slide');
  const dots   = wrap.querySelectorAll('.dot');
  let idx = [...slides].findIndex(s => s.classList.contains('active'));
  slides[idx].classList.remove('active');
  dots[idx]?.classList.remove('active');
  idx = (idx + direction + slides.length) % slides.length;
  slides[idx].classList.add('active');
  dots[idx]?.classList.add('active');
}

function goToSlide(e, dot, idx) {
  e.stopPropagation();
  const wrap   = dot.closest('.card-img-wrap');
  const slides = wrap.querySelectorAll('.slide');
  const dots   = wrap.querySelectorAll('.dot');
  slides.forEach(s => s.classList.remove('active'));
  dots.forEach(d => d.classList.remove('active'));
  slides[idx].classList.add('active');
  dots[idx].classList.add('active');
}
</script>

<script>
/* ── Tab → sets hidden 'type' input ───────────────────── */
function switchTab(el) {
  document.querySelectorAll('.search-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  const map = { 'All':'', 'Hostel':'hostel', 'PG':'pg', 'Flat share':'flat' };
  document.getElementById('propTypeInput').value = map[el.textContent.trim()] || '';
}

/* ── Quick chip ── */
function fillSearch(college) {
  document.getElementById('collegeInput').value = college;
  document.getElementById('collegeInput').focus();
}

/* ── Autocomplete ─────────────────────────────────────── */
const POPULAR = [
  'IIT Bombay','IIT Delhi','IIT Madras','IIT Kharagpur',
  'Delhi University','Jawaharlal Nehru University','Jamia Millia',
  'Christ University Bangalore','Pune University','Savitribai Phule Pune University',
  'VIT Vellore','VIT Chennai','SRM Chennai','Amity Noida',
  'BITS Pilani','BITS Goa','BITS Hyderabad',
  'NIT Trichy','NIT Warangal','NIT Surathkal',
  'Manipal University','Manipal Jaipur',
  'Osmania University Hyderabad','JNTU Hyderabad',
  'Anna University Chennai','PSG Coimbatore',
  'Mumbai University','Navi Mumbai','Thane',
  'Andheri','Powai','Vashi','Kharghar',
  'Koregaon Park Pune','Kothrud Pune','Hadapsar',
  'Koramangala Bangalore','Electronic City','HSR Layout',
  'Lajpat Nagar Delhi','Dwarka','Noida','Gurgaon',
];

const input = document.getElementById('collegeInput');
const box   = document.getElementById('acSuggestions');

input?.addEventListener('input', function () {
  const q = this.value.trim().toLowerCase();
  if (!q || q.length < 2) { box.style.display='none'; return; }

  const hits = POPULAR.filter(s => s.toLowerCase().includes(q)).slice(0,7);
  if (!hits.length) { box.style.display='none'; return; }

  box.innerHTML = hits.map(h => `
    <div onclick="pickSuggestion('${h}')" style="
      padding:10px 16px; cursor:pointer; font-size:13.5px;
      display:flex; align-items:center; gap:10px; color:#0a1628;
      transition:background .12s;
    " onmouseover="this.style.background='#f0fdf4'"
       onmouseout="this.style.background=''"
    >
      <i class="fa-solid fa-location-dot" style="color:#09b850; width:14px"></i>
      ${h.replace(new RegExp(q,'gi'), m => `<mark>${m}</mark>`)}
    </div>
  `).join('');
  box.style.display = 'block';
});

function pickSuggestion(val) {
  input.value = val;
  box.style.display = 'none';
  document.getElementById('heroSearchForm').submit();
}

document.addEventListener('click', e => {
  if (!box.contains(e.target) && e.target !== input) box.style.display = 'none';
});
</script>
 

