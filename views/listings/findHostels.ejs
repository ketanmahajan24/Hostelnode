  </div>
</section>


<!-- ===== LISTINGS ===== -->
<section class="section listings-section">
  <div class="listings-layout">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-title">
        Filters
        <span class="sidebar-clear" onclick="clearFilters()">Clear all</span>
      </div>

      <div class="filter-group">
        <div class="filter-group-label">Room type</div>
        <div class="filter-options">
          <div class="filter-option"><input type="checkbox" id="f-single" checked><label for="f-single">Single room</label></div>
          <div class="filter-option"><input type="checkbox" id="f-double"><label for="f-double">Double sharing</label></div>
          <div class="filter-option"><input type="checkbox" id="f-triple"><label for="f-triple">Triple sharing</label></div>
          <div class="filter-option"><input type="checkbox" id="f-dorm"><label for="f-dorm">Dormitory</label></div>
        </div>
      </div>

      <div class="filter-divider"></div>

      <div class="filter-group">
        <div class="filter-group-label">Gender</div>
        <div class="filter-options">
          <div class="filter-option"><input type="checkbox" id="f-boys"><label for="f-boys">Boys</label></div>
          <div class="filter-option"><input type="checkbox" id="f-girls"><label for="f-girls">Girls</label></div>
          <div class="filter-option"><input type="checkbox" id="f-co"><label for="f-co">Co-ed</label></div>
        </div>
      </div>

      <div class="filter-divider"></div>

      <div class="filter-group">
        <div class="filter-group-label">Amenities</div>
        <div class="filter-options">
          <div class="filter-option"><input type="checkbox" id="f-wifi"><label for="f-wifi">WiFi included</label></div>
          <div class="filter-option"><input type="checkbox" id="f-meals"><label for="f-meals">Meals included</label></div>
          <div class="filter-option"><input type="checkbox" id="f-ac"><label for="f-ac">AC rooms</label></div>
          <div class="filter-option"><input type="checkbox" id="f-laundry"><label for="f-laundry">Laundry</label></div>
          <div class="filter-option"><input type="checkbox" id="f-security"><label for="f-security">24/7 Security</label></div>
        </div>
      </div>

      <div class="filter-divider"></div>

      <div class="filter-group">
        <div class="filter-group-label">Max budget / month</div>
        <div class="price-range-wrap">
          <input type="range" min="1000" max="15000" step="500" value="8000"
            id="priceRange" oninput="updatePrice(this.value)">
          <div class="price-range-vals">
            <span>₹1,000</span>
            <strong id="priceVal">₹8,000</strong>
          </div>
        </div>
      </div>

      <button class="btn-apply-filter" onclick="applyFilters()">
        <i class="fa-solid fa-sliders"></i> Apply filters
      </button>
    </aside>

    <!-- Main listings -->
    <div class="main-listings">
      <div class="listings-header">
        <div>
          <h2 class="section-title" style="font-size:1.55rem">
            Featured hostels <span style="color:var(--green)">near top colleges</span>
          </h2>
          <p class="results-count">
            <strong id="resultsCount"><%= listings ? listings.length : 0 %></strong> hostels found
          </p>
        </div>
        <div class="filter-bar">
          <button class="filter-btn active" onclick="setSort(this,'distance')">
            <i class="fa-solid fa-location-dot"></i> Nearest
          </button>
          <button class="filter-btn" onclick="setSort(this,'price')">
            <i class="fa-solid fa-arrow-up-wide-short"></i> Price
          </button>
          <button class="filter-btn" onclick="setSort(this,'rating')">
            <i class="fa-solid fa-star"></i> Top rated
          </button>
        </div>
      </div>

      <!-- CARDS GRID (DYNAMIC) -->
      <div class="cards-grid" id="hostelGrid">

        <% if (listings && listings.length > 0) { %>

          <% listings.forEach(function(l) { %>

           <div class="hostel-card" data-id="<%= l._id %>" onclick="viewHostel('<%= l.slug %>')">

              <!-- IMAGE -->
              <div class="card-img-wrap">
                <div class="card-slider">
                  <% if (l.images && l.images.length > 0) { %>
                    <% l.images.forEach(function(img, i) { %>
                      <img src="/listing-images/<%= img %>"
                           class="slide <%= i === 0 ? 'active' : '' %>">
                    <% }) %>
                  <% } else { %>
                    <img src="/images/placeholder.jpg" class="slide active">
                  <% } %>
                </div>

                <button class="slide-btn prev" onclick="slideImage(event,this,-1)">
                  <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button class="slide-btn next" onclick="slideImage(event,this,1)">
                  <i class="fa-solid fa-chevron-right"></i>
                </button>

                <div class="slide-dots">
                  <% if (l.images) { %>
                    <% l.images.forEach(function(_, i) { %>
                      <span class="dot <%= i === 0 ? 'active' : '' %>"
                            onclick="goToSlide(event,this,<%= i %>)"></span>
                    <% }) %>
                  <% } %>
                </div>

                <span class="card-badge badge-<%= (l.gender || '').toLowerCase() %>">
                  <%= l.gender %>
                </span>

                <% if (l.isVerified) { %>
                  <span class="card-badge"
                    style="left:72px; top:12px; background:#fff;margin-left: 4px; color:#09b850;">
                    <i class="fa-solid fa-shield-halved"></i>  Verified
                  </span>
                <% } %>

                <div class="card-wishlist" onclick="toggleWish(event,this)">
                  <i class="fa-regular fa-heart"></i>
                </div>

                <div class="card-dist">
                  <i class="fa-solid fa-location-dot"></i> Near by
                  <%= l.location?.nearCollege || l.location?.city %>
                </div>
              </div>

              <!-- BODY -->
              <div class="card-body">
                <div class="card-top">
                  <div>
                    <div class="card-name"><%= l.title %></div>
                    <div class="card-best-value">
                      <i class="fa-solid fa-bolt"></i> <%= l.propertyType %>
                    </div>
                  </div>
                  <div class="card-rating">
                    <i class="fa-solid fa-star"></i>
                    <%= l.rating || 4.2 %>
                    <span style="font-size:0.7rem;color:var(--muted-light)">
                      (<%= l.reviewCount || 0 %>)
                    </span>
                  </div>
                </div>

                <div class="card-loc">
                  <i class="fa-solid fa-location-dot"></i>
                  <%= l.location?.address %>, <%= l.location?.city %>
                </div>

                <div class="card-view-count">
                  <i class="fa-solid fa-eye"></i>
                  <%= l.views || 0 %> students viewed today
                </div>

                <div class="card-amenities">
                  <% if (l.amenities) { %>
                    <% l.amenities.slice(0,5).forEach(function(a) { %>
                      <span class="amenity-tag"><%= a %></span>
                    <% }) %>
                  <% } %>
                </div>

                <div class="card-footer-row">
                  <div class="card-price">
                    <div class="price-val">₹<%= l.startingPrice %> <span>/mo</span></div>
                    <div class="price-label"><%= l.rooms?.[0]?.type || 'Room' %></div>
                  </div>
                  <button class="btn-view"
                    onclick="event.stopPropagation();viewHostel('<%= l.slug %>')">
                    View <i class="fa-solid fa-arrow-right"></i>
                  </button>
                </div>

                <div class="card-contact-row">
                  <button class="btn-wa"
                    onclick="event.stopPropagation();waHostel('<%= l.contact?.whatsapp %>')">
                    <i class="fa-brands fa-whatsapp"></i> WhatsApp
                  </button>
                  <button class="btn-call"
                    onclick="event.stopPropagation();callHostel('<%= l.contact?.phone %>')">
                    <i class="fa-solid fa-phone"></i> Call
                  </button>
                </div>
              </div>
            </div>

          <% }) %>

        <% } else { %>
          <div style="text-align:center; padding:40px;">
            <h3>No hostels found 😔</h3>
            <p>Try different search or filters</p>
          </div>
        <% } %>

      </div><!-- /cards-grid -->

      <div class="load-more-wrap">
        <button class="btn-load-more" onclick="loadMore(this)">
          <i class="fa-solid fa-rotate"></i> Load more hostels
        </button>
      </div>
    </div><!-- /main-listings -->
  </div>
</section>


<!-- ===== MAP STRIP ===== -->
<div class="map-strip" id="mapSection">
  <div class="map-strip-inner">
    <div class="map-placeholder-icon">📍</div>
    <h3>View all hostels on map</h3>
    <p>See exact hostel locations, distances from your college, and nearby landmarks — all in one view.</p>
    <button class="btn-green" onclick="openMap()" style="margin-top:4px; padding:10px 24px;">
      <i class="fa-solid fa-map-location-dot"></i> Open map view
    </button>
  </div>
</div>


<!-- ===== NEAR YOUR COLLEGE ===== -->
<section class="section college-section">
  <div class="section-tag">Near your college</div>
  <h2 class="section-title">Top colleges with<br>most listings nearby</h2>

  <div class="college-list">
    <%
      var colleges = [
