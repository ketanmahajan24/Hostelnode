  <style>
    /* ═══════════════════════════════════════════════════════
       STUDENT PROFILE PILL + DROPDOWN
       Scoped with .sn- prefix to avoid collisions
    ═══════════════════════════════════════════════════════ */

    /* The clickable pill in the navbar */
    .sn-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 5px 12px 5px 5px;
      border-radius: 50px;
      border: 1.5px solid rgba(9, 184, 80, 0.30);
      background: rgba(9, 184, 80, 0.07);
      cursor: pointer;
      user-select: none;
      position: relative;           /* anchor for dropdown */
      transition: border-color .2s, background .2s;
    }
    .sn-pill:hover {
      border-color: rgba(9, 184, 80, 0.55);
      background: rgba(9, 184, 80, 0.12);
    }

    /* Avatar circle */
    .sn-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 2px solid #09b850;
      background: #e8faf0;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }
    .sn-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Name text */
    .sn-name {
      font-size: 13.5px;
      font-weight: 600;
      color: #0a1628;
      max-width: 110px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Chevron */
    .sn-chevron {
      font-size: 10px;
      color: #09b850;
      transition: transform .2s;
    }
    .sn-pill.open .sn-chevron {
      transform: rotate(180deg);
    }

    /* ── Dropdown panel ── */
    .sn-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: 240px;
      background: #fff;
      border-radius: 16px;
      border: 1px solid #e8f0ea;
      box-shadow: 0 8px 40px rgba(0,0,0,.13), 0 1px 3px rgba(0,0,0,.06);
      overflow: hidden;
      z-index: 9999;

      /* hidden by default */
      opacity: 0;
      transform: translateY(-6px);
      pointer-events: none;
      transition: opacity .18s ease, transform .18s ease;
    }
    .sn-pill.open .sn-dropdown {
      opacity: 1;
      transform: translateY(0);
      pointer-events: all;
    }

    /* Green header inside dropdown */
    .sn-dd-header {
      padding: 16px;
      background: linear-gradient(135deg, #09B850 0%, #00c264 100%);
    }
    .sn-dd-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,.4);
      background: rgba(255,255,255,.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      overflow: hidden;
      margin-bottom: 10px;
    }
    .sn-dd-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .sn-dd-name {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
    }
    .sn-dd-phone {
      font-size: 12px;
      color: rgba(255,255,255,.72);
      margin-top: 2px;
    }

    /* Incomplete-profile nudge strip */
    .sn-nudge {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 8px 12px;
      padding: 8px 12px;
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 10px;
      font-size: 12px;
      color: #92400e;
      text-decoration: none;
      transition: background .15s;
    }
    .sn-nudge:hover { background: #fef3c7; color: #92400e; }
    .sn-nudge i { color: #f59e0b; }

    /* Menu links */
    .sn-dd-items { padding: 6px 0; }

    .sn-dd-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      font-size: 13.5px;
      font-weight: 500;
      color: #0a1628;
      text-decoration: none;
      transition: background .14s;
    }
    .sn-dd-link:hover { background: #f5fbf7; color: #09b850; }
    .sn-dd-link i {
      width: 16px;
      text-align: center;
      color: #09b850;
      font-size: 13px;
    }

    .sn-dd-divider { height: 1px; background: #eef3ee; margin: 4px 0; }

    /* Logout — red */
    .sn-dd-logout {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      width: 100%;
      font-size: 13.5px;
      font-weight: 500;
      color: #e53e3e;
      background: none;
      border: none;
      text-align: left;
      cursor: pointer;
      text-decoration: none;
      transition: background .14s;
    }
    .sn-dd-logout:hover { background: #fff5f5; }
    .sn-dd-logout i { width: 16px; text-align: center; }

    /* ═══════════════════════════════════════════════════════
       MOBILE NAV — profile strip (when logged in)
    ═══════════════════════════════════════════════════════ */
    .sn-mob-strip {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 20px;
      background: linear-gradient(135deg, #09B850, #00c264);
    }
    .sn-mob-avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,.4);
      background: rgba(255,255,255,.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      overflow: hidden;
      flex-shrink: 0;
    }
    .sn-mob-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .sn-mob-name  { font-size: 15px; font-weight: 700; color: #fff; }
    .sn-mob-phone { font-size: 12px; color: rgba(255,255,255,.72); margin-top: 2px; }

    /* logout link colour in mobile drawer */
    .mobile-nav-drawer .sn-logout-link { color: #e53e3e !important; }
    .mobile-nav-drawer .sn-logout-link:hover { background: #fff5f5 !important; }
  </style>
</head>
