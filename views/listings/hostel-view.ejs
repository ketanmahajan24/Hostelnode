@media(max-width:480px) {
  .enq-body { padding:18px 18px 22px; }
  .enq-row-2 { grid-template-columns:1fr; }
}
</style>
<style>
/* Overlay */
.enq-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(3px);
  z-index: 10000;
  display: flex; align-items: center; justify-content: center;
  padding: 16px;
  opacity: 0; pointer-events: none;
  transition: opacity .22s;
}
.enq-overlay.open {
  opacity: 1; pointer-events: all;
}

/* Box */
.enq-box {
  background: #fff;
  border-radius: 22px;
  width: 100%; max-width: 460px;
  max-height: 92vh; overflow-y: auto;
  position: relative;
  box-shadow: 0 20px 60px rgba(0,0,0,.22);
  transform: translateY(20px);
  transition: transform .25s;
  scrollbar-width: thin;
}
.enq-overlay.open .enq-box {
  transform: translateY(0);
}

/* Close */
.enq-close {
  position: absolute; top: 14px; right: 14px;
  width: 32px; height: 32px;
  border-radius: 50%; border: none;
  background: rgba(0,0,0,.08);
  color: #555; font-size: 15px;
  cursor: pointer; z-index: 10;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.enq-close:hover { background: rgba(0,0,0,.15); }

/* Header */
.enq-header {
  padding: 28px 24px 22px;
  text-align: center;
  position: relative;
}
.enq-header-auth {
  background: linear-gradient(135deg, #0a1628 0%, #1a3a5c 100%);
}
.enq-header-form {
  background: linear-gradient(135deg, #09B850 0%, #00c264 100%);
}
.enq-header h3 {
  font-family: 'Instrument Sans', sans-serif;
  font-size: 20px; font-weight: 700; color: #fff; margin: 0 0 4px;
}
.enq-header p { color: rgba(255,255,255,.75); font-size: 13px; margin: 0; }
.enq-header-icon { font-size: 32px; margin-bottom: 10px; }

/* Room pill */
.enq-room-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.18);
  border: 1px solid rgba(255,255,255,.3);
  border-radius: 50px; padding: 5px 14px;
  font-size: 13px; font-weight: 600; color: white;
  margin-bottom: 10px;
}
.enq-room-price { font-weight: 400; opacity: .82; }

/* Body */
.enq-body { padding: 22px 24px 24px; }

/* Alert */
.enq-alert {
  display: none; padding: 10px 14px; border-radius: 10px;
  font-size: 13px; margin-bottom: 14px;
}
.enq-alert.show { display: block; }
.enq-alert.error   { background: #fff5f5; color: #c53030; border: 1px solid #feb2b2; }
.enq-alert.success { background: #e8faf0; color: #078a3c; border: 1px solid #9ae6b4; }

/* Step indicator */
.enq-steps-ind {
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 20px;
}
.enq-step-dot {
  width: 26px; height: 26px; border-radius: 50%;
  background: #e2e8f0; color: #94a3b8;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; font-weight: 700;
  transition: background .2s, color .2s;
  flex-shrink: 0;
}
.enq-step-dot.active { background: #09B850; color: white; }
.enq-step-dot.done   { background: #0a1628; color: white; }
.enq-step-line { flex: 1; height: 2px; background: #e2e8f0; border-radius: 2px; }

/* Fields */
.enq-field { margin-bottom: 14px; }
.enq-field label {
  display: block; font-size: 12px; font-weight: 600;
  color: #3d4f63; margin-bottom: 6px;
  text-transform: uppercase; letter-spacing: 0.4px;
}
.req { color: #09B850; }

.enq-input, .enq-field input[type="text"],
.enq-field input[type="tel"], .enq-field input[type="date"],
.enq-field select, .enq-field textarea {
  width: 100%; padding: 11px 13px;
  border: 1.5px solid #d6e4d9; border-radius: 12px;
  font-size: 14.5px; font-family: inherit; color: #0a1628;
  background: #fff; outline: none;
  transition: border-color .18s, box-shadow .18s;
  box-sizing: border-box;
}
.enq-input:focus,
.enq-field input:focus,
.enq-field select:focus,
.enq-field textarea:focus {
  border-color: #09B850;
  box-shadow: 0 0 0 3px rgba(9,184,80,.12);
}
.enq-field input::placeholder,
.enq-field textarea::placeholder { color: #b0bec5; }

/* OTP row */
.enq-otp-row { display: flex; gap: 10px; }

.enq-btn-otp {
  padding: 10px 14px;
  background: #e8faf0; color: #078a3c;
  border: 1.5px solid #09B850; border-radius: 12px;
  font-size: 13px; font-weight: 600; cursor: pointer;
  white-space: nowrap; font-family: inherit;
  transition: all .18s; flex-shrink: 0;
}
.enq-btn-otp:hover { background: #09B850; color: white; }
.enq-btn-otp:disabled { opacity: .5; cursor: not-allowed; }

.enq-countdown {
  font-size: 12px; color: #64748b; margin-top: 5px;
}
.enq-countdown span { color: #09B850; font-weight: 600; }

.enq-verified-badge {
  display: inline-flex; align-items: center; gap: 5px;
  background: #e8faf0; color: #078a3c;
  font-size: 12px; font-weight: 600;
  padding: 4px 12px; border-radius: 20px;
}

/* 2-col row */
.enq-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

/* Contact option cards */
.enq-contact-opts { display: flex; gap: 10px; }
.enq-opt { flex: 1; cursor: pointer; }
.enq-opt input { display: none; }
.enq-opt-card {
  display: flex; flex-direction: column; align-items: center;
  gap: 6px; padding: 12px 8px;
  border: 1.5px solid #d6e4d9; border-radius: 12px;
  font-size: 12.5px; font-weight: 600; color: #3d4f63;
  transition: all .18s; text-align: center;
}
.enq-opt-card i { font-size: 18px; color: #94a3b8; }
.enq-opt input:checked + .enq-opt-card {
  border-color: #09B850; background: #e8faf0; color: #09B850;
}
.enq-opt input:checked + .enq-opt-card i { color: #09B850; }

/* Primary button */
.enq-btn-primary {
  width: 100%; padding: 13px;
  background: #09B850; color: white;
  border: none; border-radius: 13px;
  font-size: 15px; font-weight: 700;
  font-family: 'Instrument Sans', sans-serif;
  cursor: pointer; margin-top: 6px;
  transition: background .18s, transform .15s;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.enq-btn-primary:hover { background: #078a3c; }
.enq-btn-primary:active { transform: scale(.98); }
.enq-btn-primary:disabled { opacity: .6; cursor: not-allowed; }

/* Login note */
.enq-login-note {
  text-align: center; font-size: 13px; color: #64748b; margin-top: 14px;
}
.enq-login-note a { color: #09B850; font-weight: 600; text-decoration: none; }

/* Trust row */
.enq-trust-row {
  display: flex; justify-content: center; gap: 16px;
  margin-top: 14px; font-size: 12px; color: #94a3b8; flex-wrap: wrap;
}
.enq-trust-row i { color: #09B850; margin-right: 3px; }

/* Success state */
.enq-success {
  text-align: center; padding: 48px 24px;
}
.enq-success-icon { font-size: 56px; margin-bottom: 16px; }
.enq-success h3 {
  font-family: 'Instrument Sans', sans-serif;
  font-size: 22px; font-weight: 700; color: #0a1628; margin-bottom: 8px;
}
.enq-success p { color: #64748b; font-size: 15px; max-width: 300px; margin: 0 auto 24px; }

@media (max-width: 480px) {
  .enq-body { padding: 18px 18px 22px; }
  .enq-row-2 { grid-template-columns: 1fr; }
  .enq-contact-opts { gap: 7px; }
  .enq-opt-card { padding: 10px 6px; font-size: 11.5px; }
}
</style>
<style>
    /* ═══════════════════════════════════════════════════════
       STUDENT PROFILE PILL + DROPDOWN
       Scoped with .sn- prefix to avoid collisions
    ═══════════════════════════════════════════════════════ */

    /* The clickable pill in the navbar */
    .sn-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 5px 12px 5px 5px;
      border-radius: 50px;
      border: 1.5px solid rgba(9, 184, 80, 0.30);
      background: rgba(9, 184, 80, 0.07);
      cursor: pointer;
      user-select: none;
      position: relative;           /* anchor for dropdown */
      transition: border-color .2s, background .2s;
    }
    .sn-pill:hover {
      border-color: rgba(9, 184, 80, 0.55);
      background: rgba(9, 184, 80, 0.12);
    }

    /* Avatar circle */
    .sn-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 2px solid #09b850;
      background: #e8faf0;
      overflow: hidden;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }
    .sn-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Name text */
    .sn-name {
      font-size: 13.5px;
      font-weight: 600;
      color: #0a1628;
      max-width: 110px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Chevron */
    .sn-chevron {
      font-size: 10px;
      color: #09b850;
      transition: transform .2s;
    }
    .sn-pill.open .sn-chevron {
      transform: rotate(180deg);
    }

    /* ── Dropdown panel ── */
    .sn-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      width: 240px;
      background: #fff;
      border-radius: 16px;
      border: 1px solid #e8f0ea;
      box-shadow: 0 8px 40px rgba(0,0,0,.13), 0 1px 3px rgba(0,0,0,.06);
      overflow: hidden;
      z-index: 9999;

      /* hidden by default */
      opacity: 0;
      transform: translateY(-6px);
      pointer-events: none;
      transition: opacity .18s ease, transform .18s ease;
    }
    .sn-pill.open .sn-dropdown {
      opacity: 1;
      transform: translateY(0);
      pointer-events: all;
    }

    /* Green header inside dropdown */
    .sn-dd-header {
      padding: 16px;
      background: linear-gradient(135deg, #09B850 0%, #00c264 100%);
    }
    .sn-dd-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,.4);
      background: rgba(255,255,255,.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      overflow: hidden;
      margin-bottom: 10px;
    }
    .sn-dd-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .sn-dd-name {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
    }
    .sn-dd-phone {
      font-size: 12px;
      color: rgba(255,255,255,.72);
      margin-top: 2px;
    }

    /* Incomplete-profile nudge strip */
    .sn-nudge {
      display: flex;
      align-items: center;
      gap: 8px;
      margin: 8px 12px;
      padding: 8px 12px;
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 10px;
      font-size: 12px;
      color: #92400e;
      text-decoration: none;
      transition: background .15s;
    }
    .sn-nudge:hover { background: #fef3c7; color: #92400e; }
    .sn-nudge i { color: #f59e0b; }

    /* Menu links */
    .sn-dd-items { padding: 6px 0; }

    .sn-dd-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      font-size: 13.5px;
      font-weight: 500;
      color: #0a1628;
      text-decoration: none;
      transition: background .14s;
    }
    .sn-dd-link:hover { background: #f5fbf7; color: #09b850; }
    .sn-dd-link i {
      width: 16px;
      text-align: center;
      color: #09b850;
      font-size: 13px;
    }

    .sn-dd-divider { height: 1px; background: #eef3ee; margin: 4px 0; }

    /* Logout — red */
    .sn-dd-logout {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      width: 100%;
      font-size: 13.5px;
      font-weight: 500;
      color: #e53e3e;
      background: none;
      border: none;
      text-align: left;
      cursor: pointer;
      text-decoration: none;
      transition: background .14s;
    }
    .sn-dd-logout:hover { background: #fff5f5; }
    .sn-dd-logout i { width: 16px; text-align: center; }

    /* ═══════════════════════════════════════════════════════
       MOBILE NAV — profile strip (when logged in)
    ═══════════════════════════════════════════════════════ */
    .sn-mob-strip {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 20px;
      background: linear-gradient(135deg, #09B850, #00c264);
    }
    .sn-mob-avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,.4);
