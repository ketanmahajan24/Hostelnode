  <a href="#rooms"      class="pnav-link">Rooms</a>
  <a href="#amenities"  class="pnav-link">Amenities</a>
  <a href="#policies"   class="pnav-link">Policies</a>
  <a href="#location"   class="pnav-link">Location</a>
  <a href="#reviews"    class="pnav-link">Reviews</a>
</div>

<!-- ============================================================
     MAIN CONTENT
============================================================ -->
<div class="hv-container">

  <!-- ======= LEFT COLUMN ======= -->
  <div class="hv-left">

    <!-- OVERVIEW -->
    <section class="hv-section" id="overview">

      <!-- Title row -->
      <div class="title-row">
        <div class="title-left">
          <div class="title-tags">
            

            <% const type = (hostel.propertyType || 'Hostel').toLowerCase(); %>

              <span class="htag htag-type htag-<%= type %>">

                <i class="fa-solid 
                  <%= type === 'pg' ? 'fa-bed' :
                      type === 'flat' ? 'fa-house' :
                      'fa-building' %>">
                </i>
                <%= hostel.propertyType %>
              </span>

            <span class="htag htag-gender">
              <i class="fa-solid fa-<%= hostel.gender === 'Girls' ? 'venus' : (hostel.gender === 'Boys' ? 'mars' : 'venus-mars') %>"></i>
              <%= hostel.gender %>
            </span>
            <!-- <span class="htag htag-verified"><i class="fa-solid fa-shield-halved"></i> Verified</span> -->
             <% if (hostel.isVerified) { %>
                   <span class="htag htag-verified"><i class="fa-solid fa-shield-halved"></i> Verified</span> 
                <% } %>
            <!-- Share button -->
             <button class="hn-share-nav" onclick="shareHostel()" title="Share"> 
              <i class="fa-solid fa-share-nodes"></i>
            <span>Share</span>
            </button> 
            
          </div>
          <h1 class="hv-title"><%= hostel.title %> </h1>
  
          <div class="hv-loc">
            
            <span> <i class="fa-solid fa-location-dot"></i> <%= hostel.location.address %>, <%= hostel.location.city %> , <%= hostel.location.state %>,  <%= hostel.location.pincode %> </span>
            
            <span class="loc-divider">·</span>
            <span class="near-college"><i class="fa-solid fa-location"></i> Near by <%= hostel.location.nearCollege || '0.8 km from college' %></span>
          </div>
        </div>

        <div class="title-right">
          <div class="rating-badge">
            <div class="rating-num"><%= hostel.rating || '4.7' %></div>
            <div class="rating-stars">
              <% const r = hostel.rating || 4.7; %>
              <% for(let s=1;s<=5;s++) { %>
                <i class="fa-<%= s <= Math.round(r) ? 'solid' : 'regular' %> fa-star"></i>
              <% } %>
            </div>
            <div class="rating-count"><%= hostel.reviewCount || 48 %> reviews</div>
          </div>
        </div>
      </div>

      <!-- Quick stats strip -->
      <div class="quick-stats">
        <div class="qstat">
          <i class="fa-solid fa-bed"></i>
          <div>
            <div class="qstat-val"><%= hostel.rooms ? hostel.rooms.length : 3 %> types</div>
            <div class="qstat-label">Room options</div>
          </div>
        </div>
        <div class="qstat">
          <i class="fa-solid fa-users"></i>
          <div>
            <div class="qstat-val"><%= hostel.capacity || '50+' %></div>
            <div class="qstat-label">Residents</div>
          </div>
        </div>
        <div class="qstat">
          <i class="fa-solid fa-calendar-check"></i>
          <div>
            <div class="qstat-val"><%= hostel.availability || 'Available' %></div>
            <div class="qstat-label">Move-in</div>
          </div>
        </div>
        <div class="qstat">
          <i class="fa-solid fa-indian-rupee-sign"></i>
          <div>
            <div class="qstat-val">₹<%= hostel.deposit || 'No Deposit' %></div>
            <div class="qstat-label">Min. deposit</div>
          </div>
        </div>
      </div>

      <!-- About -->
      <div class="about-block">
        <h2 class="hv-h2">About this property</h2>
        <p class="about-text" id="aboutText"><%= hostel.description %></p>
        <button class="read-more-btn" id="readMoreBtn" onclick="toggleReadMore()">
          Read more <i class="fa-solid fa-chevron-down"></i>
        </button>
      </div>

    </section><!-- /overview -->

    <!-- ROOM TYPES -->
    <section class="hv-section" id="rooms">
      <h2 class="hv-h2">Room Types & Pricing</h2>
      <div class="rooms-grid">
        <% hostel.rooms.forEach((room, i) => { %>
        <div class="room-card animate-in" style="animation-delay: <%= i * 0.08 %>s">
          <div class="room-card-top">
            <div class="room-icon">
              <i class="fa-solid fa-<%= room.type.toLowerCase().includes('single') ? 'user' : room.type.toLowerCase().includes('double') ? 'user-group' : 'users' %>"></i>
            </div>
            <div class="room-info">
              <h4 class="room-name"><%= room.type %></h4>
              <div class="room-price">
                <span class="price-main">₹<%= room.price.toLocaleString('en-IN') %></span>
                <span class="price-period"> / month</span>
              </div>
              <div class="room-deposit">Security deposit: ₹<%= room.deposit.toLocaleString('en-IN') %></div>
            </div>
          </div>
          <div class="room-card-features">
            <% if(room.features) { room.features.forEach(f => { %>
            <span class="room-feat"><i class="fa-solid fa-check"></i> <%= f %></span>
            <% }) } %>
          </div>
          <div class="room-card-footer">
            <span class="room-avail <%= room.available ? 'avail-yes' : 'avail-no' %>">
              <i class="fa-solid fa-circle"></i>
              <%= room.available ? 'Available now' : 'Waitlist' %>
            </span>
            <button class="btn-book-room" onclick="openBooking('<%= room.type %>', <%= room.price %>)">
              Enquire Now
            </button>
          </div>
        </div>
        <% }) %>
      </div>
    </section>

    <!-- AMENITIES -->
    <section class="hv-section" id="amenities">
      <h2 class="hv-h2">Amenities</h2>
      <div class="amenities-grid">
       <% const amenityIcons = {
  'WiFi': 'wifi', 'wifi': 'wifi',
  'AC': 'snowflake', 'Air Conditioning': 'snowflake',
  'Meals': 'utensils', 'Food': 'utensils',
  'Laundry': 'shirt', 'Washing Machine': 'shirt',
  'Security': 'shield-halved', '24/7 Security': 'shield-halved',
  'Parking': 'car', 'Gym': 'dumbbell',
  'TV': 'tv', 'CCTV': 'camera',
  'Hot Water': 'droplet', 'Water Purifier': 'droplet',
  'Power Backup': 'bolt', 'Study Room': 'book',
  'Attached Bathroom': 'bath', 'Common Bathroom': 'bath',
  'Geyser': 'fire-flame-simple', 'Housekeeping': 'broom',
  'Cafeteria': 'mug-saucer', 'Library': 'book-open',

  // ── NEW AMENITIES ──
  'Lift / Elevator': 'elevator',
  'Night Guard': 'user-shield',
  'Biometric Entry': 'fingerprint',
  'Cooking Allowed': 'fire-burner',
  'Bed with Mattress': 'bed',
  'Common Room': 'couch',
  'Bike Parking': 'bicycle',
  'Bus Stop Nearby': 'bus',
  'Iron / Ironing': 'shirt',
  'Drinking Water 24hr': 'glass-water',
  'Rooftop Access': 'building',
  'Indoor Games': 'chess-board',
  'ATM Nearby': 'money-bill',
  'Grocery Nearby': 'basket-shopping',
  'Fire Extinguisher': 'fire-extinguisher',
  'Locker / Safe': 'lock',
  'Refrigerator': 'box'
}; %>
        <% hostel.amenities.forEach(a => { %>
        <div class="amenity-item animate-in">
          <div class="amenity-icon">
            <i class="fa-solid fa-<%= amenityIcons[a] || 'check' %>"></i>
          </div>
          <span class="amenity-label"><%= a %></span>
        </div>
        <% }) %>
      </div>
    </section>

    <!-- POLICIES -->
    <section class="hv-section" id="policies">
      <h2 class="hv-h2">Policies & Rules</h2>
      <div class="policies-grid">
        <% hostel.rules.forEach((r, i) => { %>
        <div class="policy-item animate-in" style="animation-delay: <%= i * 0.05 %>s">
          <div class="policy-icon">
            <i class="fa-solid fa-circle-info"></i>
          </div>
          <span><%= r %></span>
        </div>
        <% }) %>
      </div>
    </section>

    <!-- LOCATION / MAP -->
<section class="hv-section" id="location">
  <h2 class="hv-h2">Location</h2>

  <div class="map-address-row">
    
    <!-- ADDRESS -->
    <div class="map-address">
      <i class="fa-solid fa-location-dot"></i>
      <div>
        <div class="map-addr-text">
          <%= hostel.location.address %>, <%= hostel.location.city %>
        </div>

        <% if (hostel.location.nearCollege) { %>
          <div class="map-near">
            Near <%= hostel.location.nearCollege %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- DIRECTIONS BUTTON -->
    <a 
      href="<%= hostel.location.coordinates?.lat && hostel.location.coordinates?.lng 
        ? `https://www.google.com/maps?q=${hostel.location.coordinates.lat},${hostel.location.coordinates.lng}`
        : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
            hostel.location.address + ', ' + hostel.location.city
          )}` %>"
      target="_blank"
      class="btn-directions"
    >
      <i class="fa-solid fa-diamond-turn-right"></i> Get directions
    </a>

  </div>

  <!-- MAP -->
  <div class="map-frame-wrap">
    <% if (hostel.location.coordinates?.lat && hostel.location.coordinates?.lng) { %>

      <iframe
        src="https://maps.google.com/maps?q=<%= hostel.location.coordinates.lat %>,<%= hostel.location.coordinates.lng %>&output=embed"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Hostel location map">
      </iframe>

    <% } else { %>

      <!-- fallback -->
      <iframe
        src="https://maps.google.com/maps?q=<%= encodeURIComponent(hostel.location.address + ', ' + hostel.location.city) %>&output=embed"
        allowfullscreen
        loading="lazy"
        title="Hostel location map">
      </iframe>

    <% } %>
  </div>

</section>

    <!-- REVIEWS -->
     
<section class="hv-section" id="reviews">
  <div class="reviews-header">
    <h2 class="hv-h2">Student Reviews</h2>
    <div class="overall-rating">
      <div class="overall-num" id="overallNum"><%= hostel.rating || '0' %></div>
      <div>
        <div class="overall-stars">
          <% const rr = hostel.rating || 0; %>
          <% for(let s=1; s<=5; s++) { %>
            <i class="fa-solid fa-star<%= s <= Math.round(rr) ? '' : '-half-stroke' %>"></i>
          <% } %>
        </div>
        <div class="overall-count" id="overallCount">
          Based on <%= hostel.reviewCount || 0 %> reviews
        </div>
      </div>
    </div>
  </div>
<section class="faq-section">
<h2>Frequently Asked Questions</h2>

<h3>What is the rent of this hostel?</h3>
<p>Rent starts from ₹<%= hostel.startingPrice %>.</p>

<h3>Is food included?</h3>
<p><%= hostel.amenities.includes("Meals")
? "Yes, meals are available."
: "Please contact owner for meal details." %></p>

<h3>Is this hostel near <%= hostel.location.nearCollege %>?</h3>
<p>Yes, it is located nearby.</p>
</section>
  <!-- ══ WRITE A REVIEW (logged-in students only) ══ -->
  <% if (student) { %>
    <% if (studentReview) { %>

      <!-- Already reviewed — show their review with delete option -->
      <div class="your-review-banner">
        <div class="yrb-left">
          <i class="fa-solid fa-circle-check"></i>
          <div>
            <div class="yrb-title">Your review</div>
            <div class="yrb-stars">
              <% for(let s=1; s<=5; s++) { %>
                <i class="fa-solid fa-star<%= s <= studentReview.rating ? '' : ' star-empty' %>"></i>
              <% } %>
            </div>
            <div class="yrb-comment"><%= studentReview.comment || 'No comment added.' %></div>
          </div>
        </div>
        <button class="yrb-delete-btn"
          onclick="deleteReview('<%= hostel._id %>')"
          title="Delete your review">
          <i class="fa-solid fa-trash-can"></i> Delete
        </button>
      </div>

    <% } else { %>

      <!-- Review form -->
      <div class="review-form-wrap" id="reviewFormWrap">
        <h3 class="rf-title">
          <i class="fa-solid fa-star"></i> Rate this hostel
        </h3>

        <!-- Star picker -->
        <div class="star-picker" id="starPicker">
          <% for(let s=1; s<=5; s++) { %>
            <button class="sp-star" data-val="<%= s %>" onclick="pickStar(<%= s %>)"
              title="<%= s %> star<%= s > 1 ? 's' : '' %>">
              <i class="fa-regular fa-star"></i>
            </button>
          <% } %>
          <span class="sp-label" id="spLabel">Tap to rate</span>
        </div>

        <!-- Comment -->
        <textarea
          id="reviewComment"
          class="rf-textarea"
          placeholder="Share your experience — cleanliness, food, security, location…"
          rows="4"
          maxlength="500">
        </textarea>
        <div class="rf-char-count">
          <span id="charCount">0</span>/500
        </div>

        <!-- Submit -->
        <button class="rf-submit-btn" id="rfSubmitBtn"
          onclick="submitReview('<%= hostel._id %>')">
          <i class="fa-solid fa-paper-plane"></i> Submit Review
        </button>
      </div>

    <% } %>
  <% } else { %>

    <!-- Guest nudge -->
    <a href="/student/login" class="review-login-nudge">
      <i class="fa-solid fa-user-circle"></i>
      <span>Login to rate and review this hostel</span>
      <i class="fa-solid fa-arrow-right"></i>
    </a>

  <% } %>

  <!-- ══ REVIEWS LIST ══ -->
  <div class="reviews-list" id="reviewsList">
    <% const reviews = hostel.reviews && hostel.reviews.length > 0
        ? hostel.reviews
        : []; %>

    <% if (reviews.length === 0) { %>
      <div class="no-reviews-msg" id="noReviewsMsg">
        <i class="fa-regular fa-comment-dots"></i>
        <p>No reviews yet. Be the first to review!</p>
      </div>
    <% } %>

    <% reviews.slice().reverse().forEach(rev => { %>
      <div class="review-card animate-in">
        <div class="review-top">
          <div class="rev-avatar-wrap">
            <% if (rev.avatar) { %>
              <img loading="lazy" src="/student-images/<%= rev.avatar %>" alt="<%= rev.userName %>"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <div class="rev-avatar-fallback" style="display:none">
                <%= rev.userName?.charAt(0) || '?' %>
              </div>
            <% } else { %>
              <div class="rev-avatar-fallback" style="display:flex">
                <%= rev.userName?.charAt(0) || '?' %>
              </div>
            <% } %>
          </div>
          <div class="rev-meta">
            <div class="rev-name"><%= rev.userName %></div>
            <div class="rev-date">
              <%= new Date(rev.date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
            </div>
          </div>
          <div class="rev-stars">
            <% for(let s=1; s<=5; s++) { %>
              <i class="fa-solid fa-star<%= s <= rev.rating ? '' : ' star-empty' %>"></i>
            <% } %>
          </div>
        </div>
        <% if (rev.comment) { %>
          <p class="rev-text"><%= rev.comment %></p>
        <% } %>
      </div>
    <% }) %>
  </div>

</section>


  </div><!-- /hv-left -->

  <!-- ======= RIGHT SIDEBAR ======= -->
  <div class="hv-right">
    <div class="booking-card" id="bookingCard">

      <!-- Price -->
      <div class="bc-price-row">
        <div>
          <div class="bc-from">Starting from</div>
          <div class="bc-price">
            ₹<%= hostel.startingPrice ? hostel.startingPrice.toLocaleString('en-IN') : '4,000' %>
            <span>/month</span>
          </div>
        </div>
        <button class="bc-wish" id="wishBtn" onclick="toggleWishlist()" title="Save">
          <i class="fa-regular fa-heart"></i>
        </button>
      </div>

      <!-- Rating mini -->
      <div class="bc-rating">
        <% for(let s=1;s<=5;s++) { %>
          <i class="fa-solid fa-star<%= s <= Math.round(hostel.rating || 4.7) ? '' : ' dimstar' %>"></i>
        <% } %>
        <span><%= hostel.rating || '4.9' %> · <%= hostel.reviewCount || 48 %> reviews</span>
      </div>

      <!-- CTA buttons -->
      <div class="bc-actions">
        <button class="bc-btn-primary" onclick="scrollToRooms()">
          <i class="fa-solid fa-bed"></i> View Rooms & Enquire
        </button>
        <button class="bc-btn-call"   onclick="callHostel('<%= hostel.contact?.phone %>')">
          <i class="fa-solid fa-phone"></i> Call Owner
        </button>
        <button class="bc-btn-whatsapp" onclick="whatsappHostel( '<%= hostel.contact?.phone %>' )">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp
        </button>
      </div>

      <!-- Trust signals -->
      <!-- <div class="bc-shortlist">
        <i class="fa-solid fa-fire"></i>
        <span><strong>16 students</strong> shortlisted this week</span>
      </div> -->

      <div class="bc-trust">
        <div class="trust-item">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Verified listing</span>
        </div>
        <div class="trust-item">
          <i class="fa-solid fa-lock"></i>
          <span>Secure contact</span>
        </div>
        <div class="trust-item">
          <i class="fa-solid fa-headset"></i>
          <span>24/7 support</span>
        </div>
        <div class="trust-item">
          <i class="fa-solid fa-ban"></i>
          <span>Zero broker fee</span>
        </div>
      </div>

      <!-- EMI note -->
      <div class="bc-emi">
        <i class="fa-solid fa-calendar-days"></i>
        Monthly rent — no advance booking fee
      </div>

    </div><!-- /booking-card -->

    <!-- Host card -->
    <div class="host-card">
      <h4 class="host-title">Hosted by</h4>
      <div class="host-info">
        <div class="host-avatar">
          <%= (hostel.owner?.name || 'Owner').charAt(0) %>
        </div>
        <div>
          <div class="host-name"> Property Owner</div>
        <div class="host-since">
  Member since 
  <%= hostel.owner?.createdAt 
      ? new Date(hostel.owner.createdAt).toLocaleString('en-IN', { month: 'long', year: 'numeric' }) 
      : '2022' %>
</div>
        </div>
      </div>
      <div class="host-stats">
        <div class="hstat">
          <div class="hstat-val"><%= hostel.responseRate || '98%' %></div>
          <div class="hstat-label">Response rate</div>
        </div>
        
        <div class="hstat">
          <div class="hstat-val"><%= hostel.responseTime || '< 1 hr' %></div>
          <div class="hstat-label">Response time</div>   
        </div>
        <div class="hstat">
          <div class="hstat-val"><%= hostel.hostedCount || '20+' %></div>
          <div class="hstat-label">Hostings</div>         
        </div>  
        <div class="hstat">
          <span class="hostel-website">
             <% if (hostel.website) { %>
                <a href="/ketan" target="_blank"  class="near-college">
                   <i class="fa-solid fa-globe"></i>  Visit Website
                </a>
            <% } else { %>
            <span style="color: gray;">www.hostelnode.com</span>
            <% } %>
         </span>
        </div>
      </div>
    </div>

  </div><!-- /hv-right -->

</div><!-- /hv-container -->

