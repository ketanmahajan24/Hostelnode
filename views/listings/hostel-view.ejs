  <div class="similar-inner">
    <div class="similar-header">
      <div>
        <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(9,184,80,0.10);border:1px solid rgba(9,184,80,0.25);border-radius:20px;padding:4px 14px;font-size:12px;font-weight:700;color:#09b850;margin-bottom:10px;letter-spacing:0.04em;">
          <i class="fa-solid fa-location-dot"></i> NEARBY PICKS
        </div>
        <h2 style="font-family:'Instrument Sans',sans-serif;font-size:1.5rem;font-weight:700;color:#0a1628;margin:0;">Similar hostels nearby</h2>
      </div>
      <a href="/findHostels" class="see-all-link">See all <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <div class="similar-grid" id="similarGrid">
      <% similar.forEach((h, i) => { %>
      <div class="sc2-card animate-in" style="animation-delay:<%= i*0.1 %>s"
           onclick="location.href='/hostel/<%= h.slug %>'">

        <!-- IMAGE -->
        <div class="sc2-img-wrap">
          <img loading="lazy"
            src="/listing-images/<%= h.images?.[0] %>"
            alt="<%= h.title || h.name %>"
            onerror="this.src='/images/placeholder.jpg'">

          <!-- Gender badge -->
          <span class="sc2-gender-badge sc2-badge-<%= (h.gender || 'coed').toLowerCase() %>">
            <i class="fa-solid fa-<%= h.gender === 'Girls' ? 'venus' : h.gender === 'Boys' ? 'mars' : 'venus-mars' %>"></i>
            <%= h.gender || 'Co-ed' %>
          </span>

          <!-- Verified badge -->
          <% if (h.isVerified) { %>
          <span class="sc2-verified-badge">
            <i class="fa-solid fa-shield-halved"></i> Verified
          </span>
          <% } %>

          <!-- Wishlist -->
          <button class="sc2-wish" onclick="event.stopPropagation();this.classList.toggle('active')">
            <i class="fa-regular fa-heart"></i>
          </button>

          <!-- Price overlay -->
          <div class="sc2-price-overlay">
            ₹<%= (h.startingPrice || 0).toLocaleString('en-IN') %><span>/mo</span>
          </div>
        </div>

        <!-- BODY -->
        <div class="sc2-body">
          <!-- Rating -->
          <div class="sc2-rating">
            <i class="fa-solid fa-star"></i>
            <%= h.rating || '4.5' %>
            <span class="sc2-review-count">(<%= h.reviewCount || 0 %> reviews)</span>
          </div>

          <!-- Name -->
          <h5 class="sc2-name"><%= h.title || h.name %></h5>

          <!-- Location — properly formatted -->
          <div class="sc2-loc">
            <i class="fa-solid fa-location-dot"></i>
            <span>
              <%= h.location?.address ? h.location.address + ', ' : '' %><%= h.location?.city || h.city || '' %>
            </span>
          </div>

          <!-- Near college pill -->
          <% if (h.location?.nearCollege) { %>
          <div class="sc2-near">
            <i class="fa-solid fa-graduation-cap"></i>
            Near <%= h.location.nearCollege %>
          </div>
          <% } %>

          <!-- Amenities -->
          <% if (h.amenities && h.amenities.length > 0) { %>
          <div class="sc2-amenities">
            <% h.amenities.slice(0, 3).forEach(a => { %>
              <span class="sc2-amenity-tag"><%= a %></span>
            <% }) %>
            <% if (h.amenities.length > 3) { %>
              <span class="sc2-amenity-tag sc2-more">+<%= h.amenities.length - 3 %></span>
            <% } %>
          </div>
          <% } %>

          <!-- Footer -->
          <div class="sc2-footer">
            <div class="sc2-type-pill">
              <i class="fa-solid fa-building"></i>
              <%= h.propertyType || 'Hostel' %>
            </div>
            <button class="sc2-cta" onclick="event.stopPropagation();location.href='/hostel/<%= h.slug %>'">
              View <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

