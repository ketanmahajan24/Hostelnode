    <div class="gallery-side">
      <% hostel.images.slice(1, 5).forEach((img, i) => { %>
        <div class="gallery-thumb <%= i === 3 ? 'last-thumb' : '' %>"
             onclick="<%= i === 3 ? 'openLightbox(' + (i+1) + ')' : 'swapMain(this,' + (i+1) + ')' %>">
          <img loading="lazy" src="/listing-images/<%= img %>" alt="Hostel photo <%= i+2 %>">
          <% if (i === 3) { %>
            <div class="gallery-more-overlay">
              <i class="fa-solid fa-images"></i>
              <span>+<%= Math.max(0, hostel.images.length - 5) %> more</span>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
