/* ══════════════════════════════════════
   STAR PICKER
══════════════════════════════════════ */
let selectedRating = 0;
const starLabels = ['', 'Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];

function pickStar(val) {
  selectedRating = val;
  document.querySelectorAll('.sp-star').forEach((btn, i) => {
    const icon = btn.querySelector('i');
    if (i < val) {
      icon.className = 'fa-solid fa-star';
      btn.classList.add('active');
    } else {
      icon.className = 'fa-regular fa-star';
      btn.classList.remove('active');
    }
  });
  document.getElementById('spLabel').textContent = starLabels[val];
}

/* ── char counter ── */
const reviewComment = document.getElementById('reviewComment');
if (reviewComment) {
  reviewComment.addEventListener('input', function () {
    document.getElementById('charCount').textContent = this.value.length;
  });
}

/* ══════════════════════════════════════
   SUBMIT REVIEW
══════════════════════════════════════ */
async function submitReview(listingId) {
  if (!selectedRating) {
    showToastMsg('Please select a star rating first', 'fa-star');
    return;
  }

  const comment = document.getElementById('reviewComment').value.trim();
  const btn = document.getElementById('rfSubmitBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting…';

  try {
    const res = await fetch(`/student/review/${listingId}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ rating: selectedRating, comment })
    });

    const data = await res.json();

    if (data.success) {
      // Hide form
      document.getElementById('reviewFormWrap').style.display = 'none';

      // Add new review card to top of list
      const list = document.getElementById('reviewsList');
      const noMsg = document.getElementById('noReviewsMsg');
      if (noMsg) noMsg.remove();

      const card = buildReviewCard(data.review);
      list.insertAdjacentHTML('afterbegin', card);

      // Update rating display
      document.getElementById('overallNum').textContent = data.newRating;
      document.getElementById('overallCount').textContent =
        `Based on ${data.newReviewCount} review${data.newReviewCount !== 1 ? 's' : ''}`;

      showToastMsg('✅ Review submitted!');
    } else {
      showToastMsg(data.error || 'Could not submit review');
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit Review';
    }

  } catch (err) {
    console.error(err);
    showToastMsg('Network error. Try again.');
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> Submit Review';
  }
}

function buildReviewCard(rev) {
  const date = new Date(rev.date).toLocaleDateString('en-IN', {
    day: 'numeric', month: 'short', year: 'numeric'
  });
  const stars = [1,2,3,4,5].map(s =>
    `<i class="fa-solid fa-star${s <= rev.rating ? '' : ' star-empty'}"></i>`
  ).join('');
  const avatarHtml = rev.avatar
    ? `<img loading="lazy" src="/student-images/${rev.avatar}" alt="${rev.userName}"
           onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
       <div class="rev-avatar-fallback" style="display:none">${rev.userName?.charAt(0)}</div>`
    : `<div class="rev-avatar-fallback" style="display:flex">${rev.userName?.charAt(0)}</div>`;

  return `
    <div class="review-card animate-in">
      <div class="review-top">
        <div class="rev-avatar-wrap">${avatarHtml}</div>
        <div class="rev-meta">
          <div class="rev-name">${rev.userName}</div>
          <div class="rev-date">${date}</div>
        </div>
        <div class="rev-stars">${stars}</div>
      </div>
      ${rev.comment ? `<p class="rev-text">${rev.comment}</p>` : ''}
    </div>`;
}

/* ══════════════════════════════════════
   DELETE REVIEW
══════════════════════════════════════ */
async function deleteReview(listingId) {
  if (!confirm('Delete your review?')) return;

  try {
    const res = await fetch(`/student/review/${listingId}`, { method: 'DELETE' });
    const data = await res.json();

    if (data.success) {
      // Reload so the form reappears — simplest UX
      showToastMsg('Review deleted');
      setTimeout(() => location.reload(), 1000);
    } else {
      showToastMsg(data.error || 'Could not delete');
    }
  } catch (err) {
    showToastMsg('Network error');
  }
}

/* ══════════════════════════════════════
   TOAST HELPER (reuses existing toast)
══════════════════════════════════════ */
function showToastMsg(msg) {
  const el = document.getElementById('toastMsg');
  const txt = document.getElementById('toastText');
  if (!el || !txt) return;
  txt.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 3000);
}
</script>
<script>

  /* ============================================================
   ENQUIRY MODAL JS
   Paste this REPLACING your old openBooking(), closeBooking(),
   submitBooking() functions inside your <script> block
============================================================ */

let enqRoomType = '';
let enqRoomPrice = 0;
let authOtpVerified = false;
let loginOtpVerified = false;

/* ── OPEN ── */
function openBooking(roomType, roomPrice) {
  enqRoomType  = roomType;
  enqRoomPrice = roomPrice;

  document.getElementById('enqRoomName').textContent  = roomType;
  document.getElementById('enqRoomPrice').textContent = roomPrice
    ? ' · ₹' + roomPrice.toLocaleString('en-IN') + '/mo' : '';
  document.getElementById('enqHostelName').textContent = HOSTEL_DATA.name || '';

  // If logged in → show form directly, else → show auth
  const isLoggedIn = <%= student ? 'true' : 'false' %>;
  showEnqStep(isLoggedIn ? 'form' : 'auth');

  document.getElementById('enqOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

/* ── CLOSE ── */
function closeEnquiry() {
  document.getElementById('enqOverlay').classList.remove('open');
  document.body.style.overflow = '';

  // 🔄 Refresh page
  location.reload();
}
function enqOverlayClick(e) {
  if (e.target.id === 'enqOverlay') closeEnquiry();
}

/* ── SWITCH STEPS ── */
function showEnqStep(step) {
  ['auth','form','success'].forEach(s => {
    document.getElementById('enqStep' + s.charAt(0).toUpperCase() + s.slice(1)).style.display =
      s === step ? 'block' : 'none';
  });
}

/* ── SWITCH SIGNUP ↔ LOGIN ── */
function switchToLogin() {
  document.getElementById('authPanel1').style.display = 'none';
  document.getElementById('authPanel2').style.display = 'block';
}
function switchToSignup() {
  document.getElementById('authPanel1').style.display = 'block';
  document.getElementById('authPanel2').style.display = 'none';
}

/* ── ALERT HELPERS ── */
function showAuthAlert(msg, type = 'error') {
  const el = document.getElementById('authAlert');
  el.textContent = msg;
  el.className = 'enq-alert show ' + type;
  setTimeout(() => el.classList.remove('show'), 4000);
}
function showFormAlert(msg, type = 'error') {
  const el = document.getElementById('formAlert');
  el.textContent = msg;
  el.className = 'enq-alert show ' + type;
  setTimeout(() => el.classList.remove('show'), 4000);
}

/* ── COUNTDOWN TIMER ── */
function startCountdown(timerId, countdownId, btnId) {
  let s = 60;
  const cd = document.getElementById(countdownId);
  const t  = document.getElementById(timerId);
  const b  = document.getElementById(btnId);
  cd.style.display = 'block';
  b.disabled = true;
  const iv = setInterval(() => {
    t.textContent = --s;
    if (s <= 0) {
      clearInterval(iv);
      cd.style.display = 'none';
      b.disabled = false;
      b.textContent = 'Resend';
    }
  }, 1000);
}

/* ════════════════════
   SIGNUP FLOW
════════════════════ */
async function authSendOtp() {
  const phone = document.getElementById('authPhone').value.trim();
  if (!/^[6-9]\d{9}$/.test(phone)) return showAuthAlert('Enter a valid 10-digit number');

  const btn = document.getElementById('authSendBtn');
  btn.disabled = true; btn.textContent = 'Sending…';

  const res  = await fetch('/student/send-otp', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone })
  }).catch(() => null);

  if (!res) { btn.disabled=false; btn.textContent='Send OTP'; return showAuthAlert('Network error'); }

  const data = await res.json();

  if (!data.success) {
    btn.disabled=false; btn.textContent='Send OTP';
    // already registered → auto-switch to login
    if (data.error?.toLowerCase().includes('registered')) {
      showAuthAlert('Already registered — switching to login', 'success');
      return setTimeout(switchToLogin, 1200);
    }
    return showAuthAlert(data.error || 'Failed to send OTP');
  }

  document.getElementById('authOtpField').style.display = 'block';
  showAuthAlert('OTP sent to WhatsApp ✅', 'success');
  startCountdown('authTimer', 'authCountdown', 'authSendBtn');
}

async function authVerifyOtp() {
  const phone = document.getElementById('authPhone').value.trim();
  const otp   = document.getElementById('authOtp').value.trim();
  if (otp.length !== 4) return;

  const res  = await fetch('/student/verify-otp', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone, otp })
  }).catch(() => null);

  if (!res) return showAuthAlert('Network error');
  const data = await res.json();
  if (!data.success) return showAuthAlert(data.error || 'Wrong OTP');

  authOtpVerified = true;
  document.getElementById('authVerifiedBadge').style.display = 'block';
  document.getElementById('authOtp').disabled = true;
  document.getElementById('authVerifyBtn').disabled = true;
  document.getElementById('authNextBtn').disabled = false;
  showAuthAlert('Verified! Click Continue ✅', 'success');
}

async function authNext() {
  if (!authOtpVerified) return showAuthAlert('Verify your mobile first');

  const firstName = document.getElementById('authFirst').value.trim();
  const lastName  = document.getElementById('authLast').value.trim();
  const phone     = document.getElementById('authPhone').value.trim();

  if (firstName.length < 2) return showAuthAlert('Enter your first name');
  if (lastName.length  < 2) return showAuthAlert('Enter your last name');

  const btn = document.getElementById('authNextBtn');
  btn.disabled = true; btn.textContent = 'Setting up…';

  const res  = await fetch('/student/signup', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ firstName, lastName, phone })
  }).catch(() => null);

  if (!res) { btn.disabled=false; btn.textContent='Continue to Enquiry →'; return showAuthAlert('Network error'); }

  const data = await res.json();
  if (!data.success) {
    btn.disabled=false; btn.textContent='Continue to Enquiry →';
    return showAuthAlert(data.error || 'Signup failed');
  }

  showEnqStep('form');   // ← JWT cookie set, move to enquiry
}

/* ════════════════════
   LOGIN FLOW
════════════════════ */
async function loginSendOtp() {
  const phone = document.getElementById('loginPhone').value.trim();
  if (!/^[6-9]\d{9}$/.test(phone)) return showAuthAlert('Enter a valid 10-digit number');

  const btn = document.getElementById('loginSendBtn');
  btn.disabled = true; btn.textContent = 'Sending…';

  const res  = await fetch('/student/send-otp', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone })
  }).catch(() => null);

  if (!res) { btn.disabled=false; btn.textContent='Send OTP'; return showAuthAlert('Network error'); }

  const data = await res.json();
  if (!data.success) {
    btn.disabled=false; btn.textContent='Send OTP';
    if (data.error?.toLowerCase().includes('no account')) {
      showAuthAlert('No account found — switching to signup', 'success');
      return setTimeout(switchToSignup, 1200);
    }
    return showAuthAlert(data.error || 'Failed to send OTP');
  }

  document.getElementById('loginOtpField').style.display = 'block';
  showAuthAlert('OTP sent ✅', 'success');
  startCountdown('loginTimer', 'loginCountdown', 'loginSendBtn');

  // auto-verify when 6 digits typed
  document.getElementById('loginOtp').addEventListener('input', async function () {
    if (this.value.length !== 4 || loginOtpVerified) return;
    const r = await fetch('/student/verify-otp', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ phone, otp: this.value })
    }).catch(() => null);
    if (!r) return;
    const d = await r.json();
    if (d.success) {
      loginOtpVerified = true;
      this.disabled = true;
      document.getElementById('loginVerifiedBadge').style.display = 'block';
      document.getElementById('loginNextBtn').disabled = false;
      showAuthAlert('Verified! Click Login ✅', 'success');
    } else {
      showAuthAlert(d.error || 'Wrong OTP');
    }
  });
}

async function loginNext() {
  if (!loginOtpVerified) return showAuthAlert('Verify OTP first');

  const phone = document.getElementById('loginPhone').value.trim();
  const btn   = document.getElementById('loginNextBtn');
  btn.disabled = true; btn.textContent = 'Logging in…';

  const res  = await fetch('/student/login', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone })
  }).catch(() => null);

  if (!res) { btn.disabled=false; btn.textContent='Login & Continue →'; return showAuthAlert('Network error'); }

  const data = await res.json();
  if (!data.success) {
    btn.disabled=false; btn.textContent='Login & Continue →';
    return showAuthAlert(data.error || 'Login failed');
  }

  showEnqStep('form');   // ← JWT cookie set, move to enquiry
}

/* ════════════════════
   ENQUIRY SUBMIT
════════════════════ */
// char counter
document.addEventListener('DOMContentLoaded', () => {
  const msg = document.getElementById('enqMessage');
  if (msg) msg.addEventListener('input', () => {
    document.getElementById('enqCharCount').textContent = msg.value.length;
  });
});

async function submitEnquiry() {
  const contactMethod = document.querySelector('input[name="contactMethod"]:checked')?.value;
  const date          = document.getElementById('enqDate').value;
  const moveIn        = document.getElementById('enqMoveIn').value;
  const message       = document.getElementById('enqMessage').value.trim();

  if (!contactMethod) return showFormAlert('Select a contact method');
  if (!date)          return showFormAlert('Select a preferred date');

  const btn = document.getElementById('enqSubmitBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sending…';

  const res = await fetch('/student/enquiry', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      roomType:      enqRoomType,
      roomPrice:     enqRoomPrice,
      contactMethod,
      preferredDate: date,
      moveIn,
      message,
      hostelId:      '<%= hostel._id %>',
      hostelName:    '<%= hostel.title %>'
    })
  }).catch(() => null);

  if (!res) {
    btn.disabled=false;
    btn.innerHTML='<i class="fa-solid fa-paper-plane"></i> Send Enquiry';
    return showFormAlert('Network error. Try again.');
  }

  const data = await res.json();
  if (data.success) {
    showEnqStep('success');
  } else {
    btn.disabled=false;
    btn.innerHTML='<i class="fa-solid fa-paper-plane"></i> Send Enquiry';
    showFormAlert(data.error || 'Could not send. Try again.');
  }
}

</script>
