<div class="toast-msg" id="toastMsg"><i class="fa-solid fa-check-circle"></i><span id="toastText">Done!</span></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
/* ============================================================
   MAP PICKER STATE
============================================================ */
let mpLat = null, mpLng = null, mpConfirmed = false;
let currentMode = 'click'; // 'click' | 'drag'
let mpSearchTimeout = null;
let iframeReady = false;

const POPULAR_PLACES = [
  { name:'IIT Bombay', detail:'Powai, Mumbai, Maharashtra', lat:19.1334, lng:72.9133 },
  { name:'Delhi University North Campus', detail:'Maurice Nagar, Delhi', lat:28.6862, lng:77.2126 },
  { name:'Christ University Bangalore', detail:'Hosur Road, Bangalore, Karnataka', lat:12.9261, lng:77.6011 },
  { name:'Pune University', detail:'Ganeshkhind, Pune, Maharashtra', lat:18.5586, lng:73.8075 },
  { name:'VIT Vellore', detail:'Vellore, Tamil Nadu', lat:12.9692, lng:79.1559 },
  { name:'BITS Pilani', detail:'Vidya Vihar, Pilani, Rajasthan', lat:28.3623, lng:75.5897 },
  { name:'NIT Trichy', detail:'Tiruchirappalli, Tamil Nadu', lat:10.7603, lng:78.8125 },
  { name:'Manipal University', detail:'Manipal, Udupi, Karnataka', lat:13.3494, lng:74.7896 },
  { name:'SRM University Chennai', detail:'Kattankulathur, Chennai, Tamil Nadu', lat:12.7395, lng:80.0275 },
  { name:'JNTU Hyderabad', detail:'Kukatpally, Hyderabad, Telangana', lat:17.4933, lng:78.3782 },
  { name:'Mumbai University', detail:'Fort, Mumbai, Maharashtra', lat:18.9322, lng:72.8353 },
  { name:'Osmania University', detail:'Amberpet, Hyderabad, Telangana', lat:17.4126, lng:78.5283 },
  { name:'Calcutta University', detail:'Ballygunge, Kolkata, West Bengal', lat:22.5197, lng:88.3663 },
  { name:'Anna University Chennai', detail:'Guindy, Chennai, Tamil Nadu', lat:13.0101, lng:80.2337 },
  { name:'Amity University Noida', detail:'Sector 125, Noida, UP', lat:28.5445, lng:77.3325 },
];

/* ============================================================
   SEARCH SUGGESTIONS
============================================================ */
function onMpInput() {
  clearTimeout(mpSearchTimeout);
  const q = document.getElementById('mpSearchInput').value.trim();
  if (q.length < 2) { closeSugg(); return; }
  mpSearchTimeout = setTimeout(() => renderSugg(q), 180);
}

function renderSugg(q) {
  const ql = q.toLowerCase();
  const matches = POPULAR_PLACES.filter(p =>
    p.name.toLowerCase().includes(ql) || p.detail.toLowerCase().includes(ql)
  ).slice(0, 6);
  const drop = document.getElementById('mpSuggDrop');
  if (!matches.length) { closeSugg(); return; }
  drop.innerHTML = matches.map(m => `
    <div class="mp-sugg-item" onclick="pickSugg(${m.lat},${m.lng},'${escJs(m.name)}','${escJs(m.detail)}')">
      <i class="fa-solid fa-location-dot mp-sugg-icon"></i>
      <div><div class="mp-sugg-name">${m.name}</div><div class="mp-sugg-detail">${m.detail}</div></div>
    </div>`).join('');
  drop.classList.add('open');
}

function escJs(s) { return s.replace(/'/g, "\\'"); }

function closeSugg() { document.getElementById('mpSuggDrop').classList.remove('open'); }

function pickSugg(lat, lng, name, detail) {
  document.getElementById('mpSearchInput').value = name;
  closeSugg();
  loadMapAt(lat, lng, name);
}

function doMpSearch() {
  closeSugg();
  const q = document.getElementById('mpSearchInput').value.trim();
  if (!q) return;
  const ql = q.toLowerCase();
  const match = POPULAR_PLACES.find(p =>
    p.name.toLowerCase().includes(ql) || p.detail.toLowerCase().includes(ql)
  );
  if (match) { loadMapAt(match.lat, match.lng, match.name); return; }
  // Fallback: use address text fields if filled
  const addr = document.getElementById('address').value || q;
  setMpStatus('Searching…', 'loading');
  // Simulate geocode delay then load map with query
  setTimeout(() => {
    const iframe = document.getElementById('mpIframe');
    iframe.src = `https://maps.google.com/maps?q=${encodeURIComponent(addr)}&z=16&output=embed`;
    setMpStatus('Map updated — click to drop pin', '');
  }, 700);
}

/* ============================================================
   LOAD MAP AT COORDS
============================================================ */
function loadMapAt(lat, lng, label) {
  setMpStatus('Loading…', 'loading');
  document.getElementById('mpLoader').classList.remove('hidden');
  const iframe = document.getElementById('mpIframe');
  iframe.src = `https://maps.google.com/maps?q=${lat},${lng}&z=17&output=embed`;
  // Store as pending center (user still needs to click exact spot)
  mpLat = parseFloat(lat.toFixed(6));
  mpLng = parseFloat(lng.toFixed(6));
  showPinAt(50, 50); // center of map visually
  updateCoordsBar(lat, lng, label || '');
}

function onIframeLoad() {
  iframeReady = true;
  document.getElementById('mpLoader').classList.add('hidden');
  if (mpLat !== null) {
    setMpStatus('Map loaded — click exact hostel location to pin', '');
  } else {
    setMpStatus('Click on map to drop pin', '');
  }
}

/* ============================================================
   CLICK-TO-PIN
============================================================ */
function setMode(mode) {
  currentMode = mode;
  const overlay = document.getElementById('mpOverlay');
  document.getElementById('modeClick').classList.toggle('active', mode === 'click');
  document.getElementById('modeDrag').classList.toggle('active', mode === 'drag');
  overlay.classList.toggle('disabled', mode === 'drag');
  if (mode === 'drag') {
    // Enable iframe interaction
    document.getElementById('mpIframe').style.pointerEvents = 'auto';
    setMpStatus('Pan mode — scroll & explore. Switch back to click to pin', '');
  } else {
    document.getElementById('mpIframe').style.pointerEvents = 'none';
    setMpStatus('Click on the map to drop your pin', '');
  }
}

function handleMapClick(e) {
  if (currentMode !== 'click') return;
  const container = document.getElementById('mpMapContainer');
  const rect = container.getBoundingClientRect();
  const x = e.clientX - rect.left;
  const y = e.clientY - rect.top;
  const pctX = x / rect.width;
  const pctY = y / rect.height;

  // Show ripple
  showRipple(x, y);
  // Show pin
  showPinAt(pctX * 100, pctY * 100);

  // Estimate coordinates from iframe src (approximate from current map center)
  // We parse lat/lng from current iframe src + estimate offset
  const iframe = document.getElementById('mpIframe');
  const srcMatch = iframe.src.match(/q=([\-\d.]+),([\-\d.]+)/);
  let centerLat = 20.5937, centerLng = 78.9629; // India default
  if (srcMatch) { centerLat = parseFloat(srcMatch[1]); centerLng = parseFloat(srcMatch[2]); }

  // Approximate lat/lng from pixel offset (zoom 17 ≈ 0.001 deg per pixel at this scale)
  const zoomMatch = iframe.src.match(/z=(\d+)/);
  const zoom = zoomMatch ? parseInt(zoomMatch[1]) : 16;
  const degPerPixel = 360 / (256 * Math.pow(2, zoom));
  const offsetLat = -(pctY - 0.5) * rect.height * degPerPixel;
  const offsetLng =  (pctX - 0.5) * rect.width  * degPerPixel;

  mpLat = parseFloat((centerLat + offsetLat).toFixed(6));
  mpLng = parseFloat((centerLng + offsetLng).toFixed(6));

  updateCoordsBar(mpLat, mpLng, '');
  setMpStatus(`Pin dropped at ${mpLat.toFixed(4)}, ${mpLng.toFixed(4)} — confirm below ↓`, 'green');
  document.getElementById('mpConfirmBtn').disabled = false;
  mpConfirmed = false;
  document.getElementById('confirmedBadge').classList.remove('show');
  document.getElementById('mapPickerWrap').classList.remove('pinned');
}

function showPinAt(pctX, pctY) {
  const pin = document.getElementById('mpPin');
  pin.style.left = pctX + '%';
  pin.style.top = pctY + '%';
  pin.style.display = 'block';
  // Re-trigger animation
  pin.style.animation = 'none';
  pin.offsetHeight; // reflow
  pin.style.animation = '';
}

function showRipple(x, y) {
  const r = document.getElementById('mpRipple');
  r.style.left = x + 'px';
  r.style.top  = y + 'px';
  r.style.display = 'block';
  r.style.animation = 'none';
  r.offsetHeight;
  r.style.animation = 'rippleOut 0.5s ease forwards';
  setTimeout(() => r.style.display = 'none', 500);
}

function updateCoordsBar(lat, lng, addr) {
  const latEl = document.getElementById('dispLat');
  const lngEl = document.getElementById('dispLng');
  const addrEl = document.getElementById('dispAddr');
  latEl.textContent = parseFloat(lat).toFixed(6);
  latEl.className = 'mp-coord-value filled';
  lngEl.textContent = parseFloat(lng).toFixed(6);
  lngEl.className = 'mp-coord-value filled';
  if (addr) { addrEl.textContent = addr; addrEl.className = 'mp-coord-value filled'; }
  else { addrEl.textContent = 'Click to detect'; addrEl.className = 'mp-coord-value empty'; }
}

function setMpStatus(text, state) {
  document.getElementById('mpStatusText').textContent = text;
  const dot = document.getElementById('mpDot');
  dot.className = 'mp-status-dot' + (state === 'green' ? ' green' : state === 'loading' ? ' loading' : '');
}

/* ============================================================
   CONFIRM PIN
============================================================ */
function confirmPin() {
  if (mpLat === null) return;
  document.getElementById('coordLat').value = mpLat;
  document.getElementById('coordLng').value = mpLng;
  mpConfirmed = true;
  document.getElementById('mapPickerWrap').classList.add('pinned');
  document.getElementById('confirmedBadge').classList.add('show');
  document.getElementById('mpConfirmBtn').innerHTML = '<i class="fa-solid fa-circle-check"></i> Pinned ✓';
  document.getElementById('mpConfirmBtn').style.background = 'var(--green-dark)';
  setMpStatus('Location confirmed and saved!', 'green');
  showToast('📍 Location pinned successfully!');
  updateProgress();
}

/* ============================================================
   GPS
============================================================ */
function useGps() {
  if (!navigator.geolocation) { showToast('Geolocation not supported', true); return; }
  setMpStatus('Getting GPS location…', 'loading');
  navigator.geolocation.getCurrentPosition(
    pos => {
      const { latitude: lat, longitude: lng } = pos.coords;
      document.getElementById('mpSearchInput').value = `${lat.toFixed(4)}, ${lng.toFixed(4)}`;
      loadMapAt(lat, lng, 'Your GPS location');
      showToast('GPS location detected!');
    },
    err => {
      const m = { 1:'Location permission denied', 2:'Location unavailable', 3:'Request timed out' };
      setMpStatus(m[err.code] || 'GPS error', '');
      showToast(m[err.code] || 'GPS error', true);
    },
    { enableHighAccuracy: true, timeout: 10000 }
  );
}

/* ============================================================
   RESET MAP
============================================================ */
function resetMap() {
  mpLat = null; mpLng = null; mpConfirmed = false;
  document.getElementById('mpIframe').src = 'https://maps.google.com/maps?q=India&z=5&output=embed';
  document.getElementById('mpPin').style.display = 'none';
  document.getElementById('coordLat').value = '';
  document.getElementById('coordLng').value = '';
  document.getElementById('dispLat').textContent = 'Not set yet';
  document.getElementById('dispLat').className = 'mp-coord-value empty';
  document.getElementById('dispLng').textContent = 'Not set yet';
  document.getElementById('dispLng').className = 'mp-coord-value empty';
  document.getElementById('dispAddr').textContent = 'Drop pin to detect';
  document.getElementById('dispAddr').className = 'mp-coord-value empty';
  document.getElementById('mpConfirmBtn').disabled = true;
  document.getElementById('mpConfirmBtn').innerHTML = '<i class="fa-solid fa-circle-check"></i> Confirm Pin';
  document.getElementById('mpConfirmBtn').style.background = '';
  document.getElementById('confirmedBadge').classList.remove('show');
  document.getElementById('mapPickerWrap').classList.remove('pinned');
  document.getElementById('mpSearchInput').value = '';
  setMpStatus('Click on map to drop pin', '');
}

/* close suggestions when clicking outside */
document.addEventListener('click', e => {
  if (!document.getElementById('mpSearchInput').contains(e.target) &&
      !document.getElementById('mpSuggDrop').contains(e.target)) closeSugg();
});

/* ============================================================
   ROOMS
============================================================ */
let roomCount = 1, ruleCount = 2;
function addRoom() {
  const i = roomCount;
  const html = `<div class="room-entry" id="room-${i}">
    <div class="room-entry-header">
      <div class="room-entry-title"><span class="room-num">${i+1}</span> Room Type ${i+1}</div>
      <button type="button" class="btn-remove-room" onclick="removeRoom('room-${i}')"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="room-grid">
      <div class="form-group"><label class="form-label">Room Type <span class="label-required">*</span></label><select name="rooms[${i}][type]" class="form-select" required><option value="">Select type</option><option>Single</option><option>Double</option><option>Triple</option><option>Dormitory</option><option>AC Single</option><option>AC Double</option></select></div>
      <div class="form-group"><label class="form-label">Price / month <span class="label-required">*</span></label><div class="input-icon-wrap has-prefix"><span class="input-prefix">₹</span><input type="number" name="rooms[${i}][price]" class="form-input" placeholder="5500" min="0" required></div></div>
      <div class="form-group"><label class="form-label">Deposit</label><div class="input-icon-wrap has-prefix"><span class="input-prefix">₹</span><input type="number" name="rooms[${i}][deposit]" class="form-input" placeholder="10000" min="0"></div></div>
    </div>
    <div class="room-features-row">
      <div class="room-features-label">Room features</div>
      <div class="room-features-wrap">
        <input type="checkbox" id="rf${i}-ac" name="rooms[${i}][features][]" value="AC" class="rf-cb"><label for="rf${i}-ac" class="rf-lbl">AC</label>
        <input type="checkbox" id="rf${i}-ab" name="rooms[${i}][features][]" value="Attached Bathroom" class="rf-cb"><label for="rf${i}-ab" class="rf-lbl">Attached Bath</label>
        <input type="checkbox" id="rf${i}-tv" name="rooms[${i}][features][]" value="TV" class="rf-cb"><label for="rf${i}-tv" class="rf-lbl">TV</label>
        <input type="checkbox" id="rf${i}-balcony" name="rooms[${i}][features][]" value="Balcony" class="rf-cb"><label for="rf${i}-balcony" class="rf-lbl">Balcony</label>
        <input type="checkbox" id="rf${i}-wardrobe" name="rooms[${i}][features][]" value="Wardrobe" class="rf-cb"><label for="rf${i}-wardrobe" class="rf-lbl">Wardrobe</label>
        <input type="checkbox" id="rf${i}-desk" name="rooms[${i}][features][]" value="Study Desk" class="rf-cb"><label for="rf${i}-desk" class="rf-lbl">Study Desk</label>
      </div>
    </div>
    <div style="margin-top:10px;display:flex;align-items:center;gap:8px">
      <span style="font-size:0.76rem;font-weight:600;color:var(--muted)">Availability:</span>
      <input type="checkbox" id="avail-${i}" name="rooms[${i}][available]" value="true" class="avail-cb" checked>
      <label for="avail-${i}" class="avail-lbl">Available now</label>
