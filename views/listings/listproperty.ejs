function removeRoom(id) {
  const el = document.getElementById(id);
  if (!el) return;
  el.style.transition = 'all 0.22s'; el.style.opacity = '0'; el.style.transform = 'translateY(-6px)';
  setTimeout(() => el.remove(), 230);
}

/* ============================================================
   RULES
============================================================ */
function addRule() {
  const id = `rule-${ruleCount}`;
  document.getElementById('rulesList').insertAdjacentHTML('beforeend', `<div class="rule-entry" id="${id}"><input type="text" name="rules[]" class="form-input" placeholder="Add a house rule…"><button type="button" class="btn-del-rule" onclick="removeRule('${id}')"><i class="fa-solid fa-xmark"></i></button></div>`);
  ruleCount++;
}
function removeRule(id) {
  const el = document.getElementById(id);
  if (!el) return;
  el.style.transition = 'all 0.2s'; el.style.opacity = '0';
  setTimeout(() => el.remove(), 210);
}

/* ============================================================
   IMAGE UPLOAD
============================================================ */
let uploadedFiles = [];
function handleFileSelect(e) { addFiles(Array.from(e.target.files)); }
function handleDrop(e) { e.preventDefault(); document.getElementById('uploadZone').classList.remove('drag-over'); addFiles(Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/'))); }
function handleDragOver(e) { e.preventDefault(); document.getElementById('uploadZone').classList.add('drag-over'); }
function handleDragLeave() { document.getElementById('uploadZone').classList.remove('drag-over'); }
function addFiles(files) {
  const preview = document.getElementById('uploadPreview');
  files.slice(0, Math.max(0, 15 - uploadedFiles.length)).forEach(file => {
    if (file.size > 5 * 1024 * 1024) { showToast(`${file.name} exceeds 5MB`, true); return; }
    const reader = new FileReader(), gi = uploadedFiles.length;
    uploadedFiles.push(file);
    reader.onload = ev => {
      const wrap = document.createElement('div');
      wrap.className = 'preview-img-wrap'; wrap.id = `prev-${gi}`;
      wrap.innerHTML = `<img src="${ev.target.result}" alt="">${gi===0?'<div class="preview-main-tag">Cover</div>':''}<button type="button" class="preview-remove" onclick="removePreview(${gi})"><i class="fa-solid fa-xmark"></i></button>`;
      preview.appendChild(wrap);
      if (gi === 0) { document.getElementById('previewImg').src = ev.target.result; document.getElementById('previewImg').style.display = 'block'; document.getElementById('previewImgWrap').querySelector('i').style.display = 'none'; }
    };
    reader.readAsDataURL(file);
  });
  updateProgress();
}
function removePreview(idx) {
  const el = document.getElementById(`prev-${idx}`);
  if (el) { el.style.transition = 'all 0.2s'; el.style.opacity = '0'; el.style.transform = 'scale(0.85)'; setTimeout(() => el.remove(), 210); }
  uploadedFiles[idx] = null; updateProgress();
}

/* ============================================================
   CHAR COUNTER
============================================================ */
function updateCharCount(id, cid, max) {
  const v = document.getElementById(id).value.length;
  const el = document.getElementById(cid);
  el.textContent = `${v} / ${max}`;
  el.className = 'char-counter' + (v > max * 0.9 ? ' warn' : '') + (v >= max ? ' over' : '');
}

/* ============================================================
   LIVE PREVIEW
============================================================ */
function updatePreview() {
  const name = document.getElementById('title').value || 'Your property name';
  const price = document.getElementById('startingPrice').value;
  const addr = document.getElementById('address').value;
  const coll = document.getElementById('nearCollege').value;
  document.getElementById('previewName').textContent = name;
  document.getElementById('previewPrice').textContent = price ? `₹${Number(price).toLocaleString('en-IN')}/mo` : '₹—/mo';
  let loc = addr || '';
  if (coll) loc += (loc ? ' · ' : '') + 'Near ' + coll;
  document.getElementById('previewLoc').innerHTML = `<i class="fa-solid fa-location-dot"></i> ${loc || 'Location · Near College'}`;
}

/* ============================================================
   PROGRESS
============================================================ */
function updateProgress() {
  const checks = [
    !!document.getElementById('title').value.trim(),
    !!document.getElementById('startingPrice').value,
    !!document.querySelector('input[name="gender"]:checked'),
    !!document.getElementById('address').value.trim(),
    !!document.getElementById('nearCollege').value.trim(),
    mpConfirmed,
    !!(document.querySelector('#roomsList .form-select') && document.querySelector('#roomsList .form-select').value),
    document.querySelectorAll('.amenity-cb:checked').length > 0,
    uploadedFiles.filter(Boolean).length > 0,
    !!document.getElementById('phone').value.trim(),
  ];
  const done = checks.filter(Boolean).length;
  const pct = Math.round(done / checks.length * 100);
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('pctText').textContent = pct + '%';
  const stepDone = [
    checks[0] && checks[1] && checks[2],
    checks[3] && checks[4] && checks[5],
    checks[6],
    checks[7],
    checks[8],
    checks[9],
  ];
  document.querySelectorAll('.ps-item').forEach((el, i) => {
    el.classList.toggle('done', !!stepDone[i]);
  });
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.form-input,.form-select,.form-textarea,input[type="radio"],input[type="checkbox"]').forEach(el => {
    el.addEventListener('input', updateProgress);
    el.addEventListener('change', updateProgress);
  });
});

/* ============================================================
   NAV STEPS HIGHLIGHT ON SCROLL
============================================================ */
const SECS = ['sec-basic','sec-location','sec-rooms','sec-amenities','sec-media','sec-contact'];
window.addEventListener('scroll', () => {
  let cur = 0;
  SECS.forEach((id, i) => {
    const el = document.getElementById(id);
    if (el && window.scrollY + 100 >= el.offsetTop) cur = i;
  });
  document.querySelectorAll('.lp-step').forEach((el, i) => el.classList.toggle('active', i === cur));
}, { passive: true });

/* ============================================================
   JUMP
============================================================ */
function jumpTo(id) {
  const el = document.getElementById(id);
  if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

/* ============================================================
   SAME NUMBER
============================================================ */
function toggleSameNum() {
  const cb = document.getElementById('sameNumber');
  const wa = document.getElementById('whatsapp');
  if (cb.checked) { wa.value = document.getElementById('phone').value; wa.readOnly = true; wa.style.background = 'var(--bg2)'; }
  else { wa.readOnly = false; wa.style.background = ''; }
}

/* ============================================================
   TOAST
============================================================ */
function showToast(msg, isError = false) {
  const t = document.getElementById('toastMsg');
  document.getElementById('toastText').textContent = msg;
  t.querySelector('i').style.color = isError ? '#ef4444' : 'var(--green)';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2800);
}

/* ============================================================
   DRAFT
============================================================ */
function saveDraft() {
  const btn = document.querySelector('.btn-draft');
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving…';
  setTimeout(() => { btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Save Draft'; showToast('Draft saved!'); }, 900);
}

/* ============================================================
   SUBMIT VALIDATION
============================================================ */
function handleSubmit(e) {
  e.preventDefault(); // always stop default first

  console.log("🔥 Submit clicked");

  const required = [
    { id:'title', msg:'Please enter a property title.' },
    { id:'startingPrice', msg:'Please enter the starting price.' },
    { id:'address', msg:'Please enter the full address.' },
    { id:'nearCollege', msg:'Please specify the nearest college.' },
    { id:'city', msg:'Please enter the city.' },
    { id:'phone', msg:'Please enter a contact phone number.' },
  ];

  for (const f of required) {
    if (!document.getElementById(f.id).value.trim()) {
      showToast(f.msg, true);
      document.getElementById(f.id).focus();
      return;
    }
  }

  if (!document.querySelector('input[name="gender"]:checked')) {
    showToast('Please select who the property is for.', true);
    return;
  }

  if (!mpConfirmed) {
    showToast('Please pin your location on the map.', true);
    return;
  }

  const btn = document.querySelector('.btn-submit-main');
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';
  btn.disabled = true;

  console.log("✅ All validation passed");

  // 🚀 THIS WAS MISSING
  document.getElementById("listingForm").submit();
}
</script>