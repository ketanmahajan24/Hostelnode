<% layout("/layouts/boilerplate") -%>

<link rel="stylesheet" href="/css/listingProperty.css">



 
 

<br><br>
<!-- HERO -->
<div class="lp-hero">
  <div class="lp-hero-inner">
    <div class="lp-hero-text">
      <div class="lp-hero-badge"><div class="dot"></div> New Listing</div>
      <h1>List your <span>property</span> on HostelNode</h1>
      <p>Fill in the details below and reach thousands of students searching near your college — free, zero brokerage.</p>
    </div>
    <div class="lp-steps-strip">
      <div class="lp-step active" id="navStep1" onclick="jumpTo('sec-basic')"><div class="step-circle">1</div><span class="step-label">Basic</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep2" onclick="jumpTo('sec-location')"><div class="step-circle">2</div><span class="step-label">Location</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep3" onclick="jumpTo('sec-rooms')"><div class="step-circle">3</div><span class="step-label">Rooms</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep4" onclick="jumpTo('sec-amenities')"><div class="step-circle">4</div><span class="step-label">Amenities</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep5" onclick="jumpTo('sec-media')"><div class="step-circle">5</div><span class="step-label">Photos</span></div>
      <div class="step-sep"></div>
      <div class="lp-step" id="navStep6" onclick="jumpTo('sec-contact')"><div class="step-circle">6</div><span class="step-label">Contact</span></div>
    </div>
  </div>
</div>

<!-- MAIN BODY -->
<div class="lp-body">
  <div class="lp-form-col">
  <form id="listingForm" action="/user/new-list-property" method="POST" enctype="multipart/form-data" novalidate>

    <!-- ── SECTION 1: BASIC ── -->
    <div class="form-section" id="sec-basic">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-house"></i></div>
        <div class="section-title-text"><h3>Basic Information</h3><p> Tell students what makes your property special</p></div>
        <span class="section-num">01 / 06</span>
      </div>
      <div class="form-group" style="margin-bottom:18px">
        <label class="form-label">Property Type <span class="label-required">*</span></label>
        <div class="type-selector">
          <div><input type="radio" name="propertyType" id="typeHostel" class="type-option" value="Hostel" checked><label for="typeHostel" class="type-label"><div class="type-icon"><i class="fa-solid fa-building"></i></div><div class="type-name">Hostel</div><div class="type-desc">Shared with warden</div></label></div>
          <div><input type="radio" name="propertyType" id="typePG" class="type-option" value="PG"><label for="typePG" class="type-label"><div class="type-icon"><i class="fa-solid fa-house-user"></i></div><div class="type-name">PG</div><div class="type-desc">With meals & services</div></label></div>
          <div><input type="radio" name="propertyType" id="typeFlat" class="type-option" value="Flat"><label for="typeFlat" class="type-label"><div class="type-icon"><i class="fa-solid fa-door-open"></i></div><div class="type-name">Flat</div><div class="type-desc">Shared apartment</div></label></div>
        </div>
      </div>
      <div class="form-group" style="margin-bottom:18px">
        <label class="form-label">For whom? <span class="label-required">*</span></label>
        <div class="gender-selector">
          <div><input type="radio" name="gender" id="gBoys" class="gender-option boys" value="Boys" required><label for="gBoys" class="gender-label"><i class="fa-solid fa-mars"></i> Boys only</label></div>
          <div><input type="radio" name="gender" id="gGirls" class="gender-option girls" value="Girls"><label for="gGirls" class="gender-label"><i class="fa-solid fa-venus"></i> Girls only</label></div>
          <div><input type="radio" name="gender" id="gCoed" class="gender-option" value="Co-ed"><label for="gCoed" class="gender-label"><i class="fa-solid fa-venus-mars"></i> Co-ed</label></div>
        </div>
      </div>
      <div class="form-grid">
        <div class="form-group full">
          <label class="form-label" for="title">Property Name / Title <span class="label-required">*</span><span class="label-hint">e.g. "Sai Niwas Boys Hostel"</span></label>
          <input type="text" id="title" name="title" class="form-input" placeholder="Give your property a catchy, memorable name" maxlength="80" oninput="updateCharCount('title','titleCount',80);updatePreview()" required>
          <div class="char-counter" id="titleCount">0 / 80</div>
        </div>
        <div class="form-group">
          <label class="form-label" for="startingPrice">Starting Price / month <span class="label-required">*</span></label>
          <div class="input-icon-wrap has-prefix"><span class="input-prefix">₹</span><input type="number" id="startingPrice" name="startingPrice" class="form-input" placeholder="e.g. 4500" min="500" required oninput="updatePreview()"></div>
        </div>
        <div class="form-group">
          <label class="form-label" for="deposit">Security Deposit<span class="label-hint">Optional</span></label>
          <div class="input-icon-wrap has-prefix"><span class="input-prefix">₹</span><input type="number" id="deposit" name="deposit" class="form-input" placeholder="e.g. 10000" min="0"></div>
        </div>
        <div class="form-group">
          <label class="form-label" for="capacity">Total Capacity</label>
          <div class="input-icon-wrap"><i class="input-icon fa-solid fa-users"></i><input type="number" id="capacity" name="capacity" class="form-input" placeholder="Max residents" min="1"></div>
        </div>
        <div class="form-group full">
          <label class="form-label" for="description">Description <span class="label-required">*</span><span class="label-hint">What makes your place great?</span></label>
          <textarea id="description" name="description" class="form-textarea" placeholder="Location highlights, safety, meals, ambience, nearby landmarks..." maxlength="1000" rows="4" oninput="updateCharCount('description','descCount',1000)" required></textarea>
          <div class="char-counter" id="descCount">0 / 1000</div>
        </div>
      </div>
    </div>

    <!-- ── SECTION 2: LOCATION + MAP PICKER ── -->
    <div class="form-section" id="sec-location">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-location-dot"></i></div>
        <div class="section-title-text"><h3>Location & Map Pin</h3><p>Search or click on the map to drop your pin</p></div>
        <span class="section-num">02 / 06</span>
      </div>

      <!-- Text fields -->
      <div class="form-grid" style="margin-bottom:20px">
        <div class="form-group full">
          <label class="form-label" for="address">Full Address <span class="label-required">*</span></label>
          <div class="input-icon-wrap"><i class="input-icon fa-solid fa-location-dot"></i><input type="text" id="address" name="location[address]" class="form-input" placeholder="Street / building / landmark..." required oninput="updatePreview()"></div>
        </div>
        <div class="form-group full">
          <label class="form-label" for="nearCollege">Nearest College / Place <span class="label-required">*</span><span class="label-hint">Students search by College / University / Institute / Place name</span></label>
          <div class="input-icon-wrap"><i class="input-icon fa-solid fa-graduation-cap"></i><input type="text" id="nearCollege" name="location[nearCollege]" class="form-input" placeholder="e.g. IIT Bombay, Delhi University, Railway Station ,temple ...." required oninput="updatePreview()"></div>
        </div>
        <div class="form-group">
          <label class="form-label" for="city">City <span class="label-required">*</span></label>
          <input type="text" id="city" name="location[city]" class="form-input" placeholder="e.g. Mumbai" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="state">State</label>
          <select id="state" name="location[state]" class="form-select">
            <option value="">Select state</option>
            <option>Maharashtra</option><option>Delhi</option><option>Karnataka</option>
            <option>Tamil Nadu</option><option>Telangana</option><option>Gujarat</option>
            <option>Rajasthan</option><option>Uttar Pradesh</option><option>West Bengal</option>
            <option>Madhya Pradesh</option><option>Punjab</option><option>Haryana</option>
            <option>Kerala</option><option>Andhra Pradesh</option><option>Bihar</option>
            <option>Jharkhand</option><option>Odisha</option><option>Assam</option><option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="pincode">Pincode</label>
          <input type="text" id="pincode" name="location[pincode]" class="form-input" placeholder="e.g. 400076" maxlength="6" pattern="[0-9]{6}">
        </div>
        <div class="form-group">
          <label class="form-label">Country</label>
          <input type="text" name="location[country]" class="form-input" value="India" readonly style="background:var(--bg2);color:var(--muted)">
        </div>
      </div>

      <!-- HIDDEN coord inputs (auto-filled by map) -->
      <input type="hidden" id="coordLat" name="location[coordinates][lat]">
      <input type="hidden" id="coordLng" name="location[coordinates][lng]">

      <!-- ══ MAP PICKER ══ -->
      <label class="form-label" style="margin-bottom:10px; display:flex; align-items:center; gap:6px;">
        <i class="fa-solid fa-map-pin" style="color:var(--green)"></i>
        Pin your exact location on the map <span class="label-required">*</span>
        <span id="confirmedBadge" class="mp-confirmed-badge" style="margin-left:auto">
          <i class="fa-solid fa-circle-check" style="font-size:0.8rem"></i> Location pinned
        </span>
      </label>

      <div class="map-picker-wrap" id="mapPickerWrap">

        <!-- Search bar -->
        <div class="mp-searchbar">
          <div class="mp-searchbar-inner">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="mpSearchInput" placeholder="Search college, area, landmark..." oninput="onMpInput()" onkeydown="if(event.key==='Enter'){event.preventDefault();doMpSearch()}">
          </div>
          <button type="button" class="mp-searchbar-btn green" onclick="doMpSearch()">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
          <button type="button" class="mp-searchbar-btn ghost" onclick="useGps()" title="Use my GPS location">
            <i class="fa-solid fa-location-crosshairs" style="color:var(--green)"></i> GPS
          </button>
        </div>

        <!-- Suggestions -->
        <div class="mp-sugg-outer" id="mpSuggOuter">
          <div class="mp-sugg-drop" id="mpSuggDrop"></div>
        </div>

        <!-- Toolbar -->
        <div class="mp-toolbar">
          <button type="button" class="mp-mode-btn active" id="modeClick" onclick="setMode('click')">
            <i class="fa-solid fa-hand-pointer"></i> Click to pin
          </button>
          <button type="button" class="mp-mode-btn" id="modeDrag" onclick="setMode('drag')">
            <i class="fa-solid fa-up-down-left-right"></i> Pan & explore
          </button>
          <div class="mp-toolbar-sep"></div>
          <button type="button" class="mp-mode-btn" onclick="resetMap()" style="color:#ef4444;border-color:#fecaca">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </button>
          <div class="mp-status-chip">
            <div class="mp-status-dot" id="mpDot"></div>
            <span id="mpStatusText">Click on map to drop pin</span>
          </div>
        </div>

        <!-- Map + overlay -->
        <div class="mp-map-container" id="mpMapContainer">
          <!-- Loading overlay -->
          <div class="mp-map-loader" id="mpLoader">
            <div class="mp-spinner"></div>
            <p>Loading map…</p>
          </div>
          <!-- Google Map iframe -->
          <iframe id="mpIframe"
            src="https://maps.google.com/maps?q=India&z=5&output=embed"
            onload="onIframeLoad()"
            title="Location map">
          </iframe>
          <!-- Click intercept overlay (active in click mode) -->
          <div class="mp-click-overlay" id="mpOverlay" onclick="handleMapClick(event)"></div>
          <!-- Pin marker -->
          <div class="mp-pin" id="mpPin">
            <svg width="36" height="44" viewBox="0 0 36 44" fill="none">
              <path d="M18 0C8.06 0 0 8.06 0 18c0 13.5 18 26 18 26s18-12.5 18-26C36 8.06 27.94 0 18 0z" fill="#09b850"/>
              <circle cx="18" cy="18" r="7" fill="white"/>
              <circle cx="18" cy="18" r="4" fill="#09b850"/>
            </svg>
            <div class="mp-pin-pulse"></div>
          </div>
          <!-- Ripple -->
          <div class="mp-ripple" id="mpRipple"></div>
        </div>

        <!-- Coords bar -->
        <div class="mp-coords-bar" id="mpCoordsBar">
          <div class="mp-coord-box">
            <div class="mp-coord-label">Latitude</div>
            <div class="mp-coord-value empty" id="dispLat">Not set yet</div>
          </div>
          <div class="mp-coord-box">
            <div class="mp-coord-label">Longitude</div>
            <div class="mp-coord-value empty" id="dispLng">Not set yet</div>
          </div>
          <div class="mp-coord-box">
            <div class="mp-coord-label">Address</div>
            <div class="mp-coord-value empty" id="dispAddr" style="font-size:0.72rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px">Drop pin to detect</div>
          </div>
          <button type="button" class="mp-confirm-btn" id="mpConfirmBtn" onclick="confirmPin()" disabled>
            <i class="fa-solid fa-circle-check"></i> Confirm Pin
          </button>
        </div>

        <!-- Tip -->
        <div class="mp-tip">
          <i class="fa-solid fa-lightbulb"></i>
          <span><strong>How to pin:</strong> Search your college / area above, then <strong>click exactly on your hostel's location</strong> on the map. The green pin will drop there. Hit "Confirm Pin" to save coordinates.</span>
        </div>

      </div><!-- /map-picker-wrap -->
    </div><!-- /sec-location -->

    <!-- ── SECTION 3: ROOMS ── -->
    <div class="form-section" id="sec-rooms">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-bed"></i></div>
        <div class="section-title-text"><h3>Rooms & Pricing</h3><p>Add each room type you offer</p></div>
        <span class="section-num">03 / 06</span>
      </div>
      <div class="rooms-list" id="roomsList">
        <div class="room-entry" id="room-0">
          <div class="room-entry-header">
            <div class="room-entry-title"><span class="room-num">1</span> Room Type 1</div>
            <button type="button" class="btn-remove-room" onclick="removeRoom('room-0')"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="room-grid">
            <div class="form-group"><label class="form-label">Room Type <span class="label-required">*</span></label><select name="rooms[0][type]" class="form-select" required><option value="">Select type</option><option>Single</option><option>Double</option><option>Triple</option><option>Dormitory</option><option>AC Single</option><option>AC Double</option></select></div>
            <div class="form-group"><label class="form-label">Price / month <span class="label-required">*</span></label><div class="input-icon-wrap has-prefix"><span class="input-prefix">₹</span><input type="number" name="rooms[0][price]" class="form-input" placeholder="5500" min="0" required></div></div>
            <div class="form-group"><label class="form-label">Deposit</label><div class="input-icon-wrap has-prefix"><span class="input-prefix">₹</span><input type="number" name="rooms[0][deposit]" class="form-input" placeholder="10000" min="0"></div></div>
          </div>
          <div class="room-features-row">
            <div class="room-features-label">Room features</div>
            <div class="room-features-wrap">
              <input type="checkbox" id="rf0-ac" name="rooms[0][features][]" value="AC" class="rf-cb"><label for="rf0-ac" class="rf-lbl">AC</label>
              <input type="checkbox" id="rf0-ab" name="rooms[0][features][]" value="Attached Bathroom" class="rf-cb"><label for="rf0-ab" class="rf-lbl">Attached Bath</label>
              <input type="checkbox" id="rf0-tv" name="rooms[0][features][]" value="TV" class="rf-cb"><label for="rf0-tv" class="rf-lbl">TV</label>
              <input type="checkbox" id="rf0-balcony" name="rooms[0][features][]" value="Balcony" class="rf-cb"><label for="rf0-balcony" class="rf-lbl">Balcony</label>
              <input type="checkbox" id="rf0-wardrobe" name="rooms[0][features][]" value="Wardrobe" class="rf-cb"><label for="rf0-wardrobe" class="rf-lbl">Wardrobe</label>
              <input type="checkbox" id="rf0-desk" name="rooms[0][features][]" value="Study Desk" class="rf-cb"><label for="rf0-desk" class="rf-lbl">Study Desk</label>
            </div>
          </div>
          <div style="margin-top:10px;display:flex;align-items:center;gap:8px">
            <span style="font-size:0.76rem;font-weight:600;color:var(--muted)">Availability:</span>
            <input type="checkbox" id="avail-0" name="rooms[0][available]" value="true" class="avail-cb" checked>
            <label for="avail-0" class="avail-lbl">Available now</label>
          </div>
        </div>
      </div>
      <button type="button" class="btn-add-room" onclick="addRoom()"><i class="fa-solid fa-plus"></i> Add another room type</button>
    </div>

    <!-- ── SECTION 4: AMENITIES & RULES ── -->
    <div class="form-section" id="sec-amenities">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-star"></i></div>
        <div class="section-title-text"><h3>Amenities & Rules</h3><p>What you offer and your house policies</p></div>
        <span class="section-num">04 / 06</span>
      </div>
      <div class="form-group" style="margin-bottom:22px">
        <label class="form-label" style="margin-bottom:10px"><i class="fa-solid fa-check-circle" style="color:var(--green)"></i> What amenities do you provide?</label>
        <div class="amenities-grid">
          <% [['WiFi','wifi'],['AC','snowflake'],['Meals','utensils'],['Laundry','shirt'],['Security','shield-halved'],['Parking','car'],['Gym','dumbbell'],['CCTV','camera'],['Hot Water','droplet'],['Power Backup','bolt'],['Study Room','book'],['Attached Bathroom','bath'],['Common Bathroom','bath'],['Water Purifier','droplet'],['Geyser','fire-flame-simple'],['Housekeeping','broom'],['Cafeteria','mug-saucer'],['Library','book-open'],['TV','tv'],['Refrigerator','box']].forEach((a,i) => { %>
          <div><input type="checkbox" id="am-<%=i%>" name="amenities[]" value="<%=a[0]%>" class="amenity-cb"><label for="am-<%=i%>" class="amenity-lbl"><i class="fa-solid fa-<%=a[1]%>"></i> <%=a[0]%></label></div>
          <% }) %>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" style="margin-bottom:9px"><i class="fa-solid fa-circle-info" style="color:var(--green)"></i> House Rules & Policies<span class="label-hint">Recommended</span></label>
        <div class="rules-list" id="rulesList">
          <div class="rule-entry" id="rule-0"><input type="text" name="rules[]" class="form-input" placeholder="e.g. No smoking on premises"><button type="button" class="btn-del-rule" onclick="removeRule('rule-0')"><i class="fa-solid fa-xmark"></i></button></div>
          <div class="rule-entry" id="rule-1"><input type="text" name="rules[]" class="form-input" placeholder="e.g. Visitors allowed till 8 PM"><button type="button" class="btn-del-rule" onclick="removeRule('rule-1')"><i class="fa-solid fa-xmark"></i></button></div>
        </div>
        <button type="button" class="btn-add-rule" onclick="addRule()"><i class="fa-solid fa-plus"></i> Add rule</button>
      </div>
    </div>

    <!-- ── SECTION 5: PHOTOS ── -->
    <div class="form-section" id="sec-media">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-images"></i></div>
        <div class="section-title-text"><h3>Photos & Media</h3><p>Listings with 5+ photos get 3× more inquiries</p></div>
        <span class="section-num">05 / 06</span>
      </div>
      <div class="upload-zone" id="uploadZone" ondrop="handleDrop(event)" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)">
        <input type="file" id="imagesInput" name="images" multiple accept="image/*" onchange="handleFileSelect(event)">
        <div class="upload-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
        <div class="upload-title">Drag & drop photos here</div>
        <div class="upload-sub">or click to browse from your device</div>
        <div class="upload-hint">JPEG, PNG, WebP · Max 5 MB per photo · Up to 15 photos</div>
      </div>
      <div class="upload-preview" id="uploadPreview"></div>
      <div style="margin-top:12px;padding:10px 13px;background:var(--green-light);border:1.5px solid var(--green-border);border-radius:var(--radius-sm);display:flex;gap:7px;align-items:flex-start;font-size:0.75rem;color:#1e5c30;line-height:1.6">
        <i class="fa-solid fa-lightbulb" style="color:var(--green);margin-top:2px;flex-shrink:0"></i>
        <span><strong>Pro tip:</strong> First photo = cover image. Upload bright shots of the room, common area, washroom and building entrance.</span>
      </div>
    </div>

    <!-- ── SECTION 6: CONTACT ── -->
    <div class="form-section" id="sec-contact">
      <div class="section-header">
        <div class="section-icon"><i class="fa-solid fa-phone"></i></div>
        <div class="section-title-text"><h3>Contact Details</h3><p>Students reach out directly on these numbers</p></div>
        <span class="section-num">06 / 06</span>
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="phone">Phone Number <span class="label-required">*</span></label>
          <div class="input-icon-wrap has-prefix"><span class="input-prefix">+91</span><input type="tel" id="phone" name="contact[phone]" class="form-input" placeholder="XXXXX XXXXX" maxlength="10" pattern="[0-9]{10}" required></div>
        </div>
        <div class="form-group">
          <label class="form-label" for="whatsapp">WhatsApp Number<span class="label-hint">Leave blank if same</span></label>
          <div class="input-icon-wrap has-prefix"><span class="input-prefix">+91</span><input type="tel" id="whatsapp" name="contact[whatsapp]" class="form-input" placeholder="XXXXX XXXXX" maxlength="10"></div>
        </div>
        <div class="form-group full">
          <label style="display:flex;align-items:center;gap:9px;cursor:pointer;padding:11px 13px;border:1.5px solid var(--border);border-radius:var(--radius-md);background:var(--bg);transition:all 0.18s">
            <input type="checkbox" id="sameNumber" onchange="toggleSameNum()" style="accent-color:var(--green);width:15px;height:15px">
            <span style="font-size:0.82rem;font-weight:500;color:var(--muted)">WhatsApp same as phone number</span>
          </label>
        </div>
      </div>
    </div>

    <!-- TRUST STRIP -->
    <div class="trust-strip">
      <div class="trust-item"><i class="fa-solid fa-shield-halved"></i> Reviewed before going live</div>
      <!-- <div class="trust-item"><i class="fa-solid fa-eye-slash"></i> Phone hidden until inquiry</div> -->
      <div class="trust-item"><i class="fa-solid fa-ban"></i> Zero broker fee</div>
      <div class="trust-item"><i class="fa-solid fa-users"></i> 5,000+ students/month</div>
    </div>

    <!-- SUBMIT -->
    <div class="submit-section">
      <div class="submit-inner">
        <div>
          <div class="submit-note-title">Ready to publish your listing?</div>
          <div class="submit-note-sub">Our team reviews and approves within 24 hours. You'll get notified by email.</div>
        </div>
        <div class="submit-actions">
          <button type="button" class="btn-draft" onclick="saveDraft()"><i class="fa-solid fa-floppy-disk"></i> Save Draft</button>
          <button type="submit" class="btn-submit-main" onclick="handleSubmit(event)"><i class="fa-solid fa-paper-plane"></i> Submit Listing</button>
        </div>
      </div>
    </div>

  </form>
  </div><!-- /lp-form-col -->

  <!-- SIDEBAR -->
