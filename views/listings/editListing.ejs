/* ============================================================
   SUBMIT
============================================================ */
function handleEditSubmit(e) {
  e.preventDefault();
  const required = [
    { id:'title',        msg:'Please enter a property title.' },
    { id:'startingPrice',msg:'Please enter the starting price.' },
    { id:'address',      msg:'Please enter the full address.' },
    { id:'nearCollege',  msg:'Please specify the nearest college.' },
    { id:'city',         msg:'Please enter the city.' },
    { id:'phone',        msg:'Please enter a contact phone number.' },
  ];
  for (const f of required) {
    if (!document.getElementById(f.id).value.trim()) {
      showToast(f.msg, true);
      document.getElementById(f.id).focus();
      return;
    }
  }
  if (!document.querySelector('input[name="gender"]:checked')) {
    showToast('Please select who the property is for.', true); return;
  }
  const btn = document.querySelector('.btn-submit-main');
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving…';
  btn.disabled = true;
  hideUnsavedBar();
  document.getElementById('editForm').submit();
}

