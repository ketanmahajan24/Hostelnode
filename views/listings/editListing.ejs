<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
/* ============================================================
   EDIT PAGE STATE
============================================================ */
// Pre-fill from existing listing data
let mpLat    = <%= listing.location?.coordinates?.lat || 'null' %>;
let mpLng    = <%= listing.location?.coordinates?.lng || 'null' %>;
let mpConfirmed = <%= listing.location?.coordinates?.lat ? 'true' : 'false' %>;
let currentMode  = 'click';
let mpSearchTimeout = null;
let hasUnsavedChanges = false;
let roomCount = <%= (listing.rooms || []).length %>;
let ruleCount = <%= Math.max((listing.rules || []).filter(r => r && r.trim()).length, 1) %>;
let uploadedFiles = [];
let deletedImages = [];

/* ============================================================
   UNSAVED CHANGES TRACKING
============================================================ */
function markChanged(el) {
  el.classList.add('changed');
  showUnsavedBar();
}

function showUnsavedBar() {
  if (!hasUnsavedChanges) {
    hasUnsavedChanges = true;
    document.getElementById('unsavedBar').classList.add('show');
  }
}

function hideUnsavedBar() {
  hasUnsavedChanges = false;
  document.getElementById('unsavedBar').classList.remove('show');
  document.querySelectorAll('.changed').forEach(el => el.classList.remove('changed'));
}

function discardChanges() {
  if (confirm('Discard all unsaved changes and reload?')) window.location.reload();
}

/* ============================================================
   EXISTING IMAGE MANAGEMENT
============================================================ */
function markImageDelete(idx, filename) {
  const wrap = document.getElementById(`existImg-${idx}`);
  if (!wrap) return;

  if (wrap.classList.contains('marked-delete')) {
    // Undo delete
    wrap.classList.remove('marked-delete');
    deletedImages = deletedImages.filter(f => f !== filename);
    document.getElementById(`del-input-${idx}`)?.remove();
    wrap.querySelector('.img-delete-btn').innerHTML = '<i class="fa-solid fa-xmark"></i>';
    wrap.querySelector('.img-delete-btn').title = 'Remove this photo';
  } else {
    // Mark for delete
    wrap.classList.add('marked-delete');
    deletedImages.push(filename);
    wrap.querySelector('.img-delete-btn').innerHTML = '<i class="fa-solid fa-rotate-left"></i>';
    wrap.querySelector('.img-delete-btn').title = 'Undo remove';
    // Add hidden input
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'deleteImages[]';
    input.value = filename;
    input.id = `del-input-${idx}`;
    document.getElementById('deleteImagesInputs').appendChild(input);
  }
  showUnsavedBar();
}

let currentCoverIdx = 0;
function setCoverImage(idx) {
  // Remove old cover tag
  const oldCover = document.querySelector('.img-cover-tag');
  if (oldCover) {
    const oldWrap = oldCover.closest('.existing-img-wrap');
    oldCover.remove();
    // Add "set cover" button back
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'img-set-cover';
    btn.onclick = () => setCoverImage(currentCoverIdx);
    btn.textContent = 'Set cover';
    oldWrap.appendChild(btn);
  }

  // Set new cover
  const newWrap = document.getElementById(`existImg-${idx}`);
  newWrap.querySelector('.img-set-cover')?.remove();
  const tag = document.createElement('div');
  tag.className = 'img-cover-tag';
  tag.textContent = 'Cover';
  newWrap.appendChild(tag);

  // Update hidden input
  const filename = newWrap.dataset.filename;
  document.getElementById('coverImageInput').value = filename;
  currentCoverIdx = idx;

  // Update preview
  document.getElementById('previewImg').src = `/listing-images/${filename}`;
  document.getElementById('previewImg').style.display = 'block';
  document.getElementById('previewImgWrap').querySelector('i').style.display = 'none';

  showUnsavedBar();
}

/* ============================================================
   MAP PICKER (same as create page)
============================================================ */
const POPULAR_PLACES = [
  { name:'IIT Bombay', detail:'Powai, Mumbai, Maharashtra', lat:19.1334, lng:72.9133 },
  { name:'Delhi University North Campus', detail:'Maurice Nagar, Delhi', lat:28.6862, lng:77.2126 },
  { name:'Christ University Bangalore', detail:'Hosur Road, Bangalore, Karnataka', lat:12.9261, lng:77.6011 },
  { name:'Pune University', detail:'Ganeshkhind, Pune, Maharashtra', lat:18.5586, lng:73.8075 },
  { name:'VIT Vellore', detail:'Vellore, Tamil Nadu', lat:12.9692, lng:79.1559 },
  { name:'BITS Pilani', detail:'Vidya Vihar, Pilani, Rajasthan', lat:28.3623, lng:75.5897 },
  { name:'NIT Trichy', detail:'Tiruchirappalli, Tamil Nadu', lat:10.7603, lng:78.8125 },
  { name:'Manipal University', detail:'Manipal, Udupi, Karnataka', lat:13.3494, lng:74.7896 },
  { name:'SRM University Chennai', detail:'Kattankulathur, Chennai, Tamil Nadu', lat:12.7395, lng:80.0275 },
  { name:'JNTU Hyderabad', detail:'Kukatpally, Hyderabad, Telangana', lat:17.4933, lng:78.3782 },
  { name:'Mumbai University', detail:'Fort, Mumbai, Maharashtra', lat:18.9322, lng:72.8353 },
  { name:'Anna University Chennai', detail:'Guindy, Chennai, Tamil Nadu', lat:13.0101, lng:80.2337 },
  { name:'Amity University Noida', detail:'Sector 125, Noida, UP', lat:28.5445, lng:77.3325 },
];

function onMpInput() {
  clearTimeout(mpSearchTimeout);
  const q = document.getElementById('mpSearchInput').value.trim();
  if (q.length < 2) { closeSugg(); return; }
  mpSearchTimeout = setTimeout(() => renderSugg(q), 180);
}
function renderSugg(q) {
  const ql = q.toLowerCase();
  const matches = POPULAR_PLACES.filter(p => p.name.toLowerCase().includes(ql) || p.detail.toLowerCase().includes(ql)).slice(0,6);
  const drop = document.getElementById('mpSuggDrop');
  if (!matches.length) { closeSugg(); return; }
  drop.innerHTML = matches.map(m => `<div class="mp-sugg-item" onclick="pickSugg(${m.lat},${m.lng},'${escJs(m.name)}','${escJs(m.detail)}')"><i class="fa-solid fa-location-dot mp-sugg-icon"></i><div><div class="mp-sugg-name">${m.name}</div><div class="mp-sugg-detail">${m.detail}</div></div></div>`).join('');
  drop.classList.add('open');
}
function escJs(s) { return s.replace(/'/g, "\\'"); }
function closeSugg() { document.getElementById('mpSuggDrop').classList.remove('open'); }
function pickSugg(lat, lng, name, detail) { document.getElementById('mpSearchInput').value = name; closeSugg(); loadMapAt(lat, lng, name); }

function doMpSearch() {
  closeSugg();
  const q = document.getElementById('mpSearchInput').value.trim();
  if (!q) return;
  const match = POPULAR_PLACES.find(p => p.name.toLowerCase().includes(q.toLowerCase()) || p.detail.toLowerCase().includes(q.toLowerCase()));
  if (match) { loadMapAt(match.lat, match.lng, match.name); return; }
  setMpStatus('Searching…', 'loading');
  setTimeout(() => {
    document.getElementById('mpIframe').src = `https://maps.google.com/maps?q=${encodeURIComponent(q + ' India')}&z=16&output=embed`;
    setMpStatus('Map updated — click to drop pin', '');
  }, 700);
}

function loadMapAt(lat, lng, label) {
  setMpStatus('Loading…', 'loading');
  document.getElementById('mpLoader').classList.remove('hidden');
  document.getElementById('mpIframe').src = `https://maps.google.com/maps?q=${lat},${lng}&z=17&output=embed`;
  mpLat = parseFloat(lat.toFixed(6));
  mpLng = parseFloat(lng.toFixed(6));
  showPinAt(50, 50);
  updateCoordsBar(lat, lng, label || '');
}
function onIframeLoad() {
  document.getElementById('mpLoader').classList.add('hidden');
  setMpStatus(mpLat !== null ? 'Click exact hostel location to update pin' : 'Click on map to drop pin', mpLat !== null ? 'green' : '');
}

function setMode(mode) {
  currentMode = mode;
  document.getElementById('modeClick').classList.toggle('active', mode === 'click');
  document.getElementById('modeDrag').classList.toggle('active', mode === 'drag');
  document.getElementById('mpOverlay').classList.toggle('disabled', mode === 'drag');
  document.getElementById('mpIframe').style.pointerEvents = mode === 'drag' ? 'auto' : 'none';
  setMpStatus(mode === 'drag' ? 'Pan mode — switch back to click to pin' : 'Click on the map to drop pin', '');
}

function handleMapClick(e) {
  if (currentMode !== 'click') return;
  const container = document.getElementById('mpMapContainer');
  const rect = container.getBoundingClientRect();
  const x = e.clientX - rect.left, y = e.clientY - rect.top;
  const pctX = x / rect.width, pctY = y / rect.height;
  showRipple(x, y);
  showPinAt(pctX * 100, pctY * 100);
  const iframe = document.getElementById('mpIframe');
  const srcMatch = iframe.src.match(/q=([\-\d.]+),([\-\d.]+)/);
  let centerLat = 20.5937, centerLng = 78.9629;
  if (srcMatch) { centerLat = parseFloat(srcMatch[1]); centerLng = parseFloat(srcMatch[2]); }
  const zoomMatch = iframe.src.match(/z=(\d+)/);
  const zoom = zoomMatch ? parseInt(zoomMatch[1]) : 16;
  const degPerPixel = 360 / (256 * Math.pow(2, zoom));
  mpLat = parseFloat((centerLat - (pctY - 0.5) * rect.height * degPerPixel).toFixed(6));
  mpLng = parseFloat((centerLng + (pctX - 0.5) * rect.width  * degPerPixel).toFixed(6));
  updateCoordsBar(mpLat, mpLng, '');
  setMpStatus(`Pin dropped at ${mpLat.toFixed(4)}, ${mpLng.toFixed(4)} — confirm below ↓`, 'green');
  document.getElementById('mpConfirmBtn').disabled = false;
  mpConfirmed = false;
  document.getElementById('confirmedBadge').classList.remove('show');
  document.getElementById('mapPickerWrap').classList.remove('pinned');
}

function showPinAt(pctX, pctY) {
  const pin = document.getElementById('mpPin');
  pin.style.left = pctX + '%'; pin.style.top = pctY + '%'; pin.style.display = 'block';
  pin.style.animation = 'none'; pin.offsetHeight; pin.style.animation = '';
}
function showRipple(x, y) {
  const r = document.getElementById('mpRipple');
  r.style.left = x + 'px'; r.style.top = y + 'px'; r.style.display = 'block';
  r.style.animation = 'none'; r.offsetHeight; r.style.animation = 'rippleOut 0.5s ease forwards';
  setTimeout(() => r.style.display = 'none', 500);
}
function updateCoordsBar(lat, lng, addr) {
  const lE = document.getElementById('dispLat'), lnE = document.getElementById('dispLng'), aE = document.getElementById('dispAddr');
  lE.textContent = parseFloat(lat).toFixed(6); lE.className = 'mp-coord-value filled';
  lnE.textContent = parseFloat(lng).toFixed(6); lnE.className = 'mp-coord-value filled';
  if (addr) { aE.textContent = addr; aE.className = 'mp-coord-value filled'; }
}
function setMpStatus(text, state) {
  document.getElementById('mpStatusText').textContent = text;
  const dot = document.getElementById('mpDot');
  dot.className = 'mp-status-dot' + (state === 'green' ? ' green' : state === 'loading' ? ' loading' : '');
}

function confirmPin() {
  if (mpLat === null) return;
  document.getElementById('coordLat').value = mpLat;
  document.getElementById('coordLng').value = mpLng;
  mpConfirmed = true;
  document.getElementById('mapPickerWrap').classList.add('pinned');
  document.getElementById('confirmedBadge').classList.add('show');
  document.getElementById('confirmedBadge').innerHTML = '<i class="fa-solid fa-circle-check" style="font-size:0.8rem"></i> Location pinned';
  document.getElementById('mpConfirmBtn').innerHTML = '<i class="fa-solid fa-circle-check"></i> Pinned ✓';
  document.getElementById('mpConfirmBtn').style.background = 'var(--green-dark)';
  setMpStatus('Location confirmed and saved!', 'green');
  showToast('📍 Location pinned successfully!');
  showUnsavedBar();
}

function useGps() {
  if (!navigator.geolocation) { showToast('Geolocation not supported', true); return; }
  setMpStatus('Getting GPS location…', 'loading');
  navigator.geolocation.getCurrentPosition(
    pos => { loadMapAt(pos.coords.latitude, pos.coords.longitude, 'Your GPS location'); showToast('GPS location detected!'); },
    err => { const m = {1:'Permission denied',2:'Location unavailable',3:'Timed out'}; setMpStatus(m[err.code]||'GPS error',''); showToast(m[err.code]||'GPS error', true); },
    { enableHighAccuracy: true, timeout: 10000 }
  );
}

function resetMap() {
  mpLat = null; mpLng = null; mpConfirmed = false;
  document.getElementById('mpIframe').src = 'https://maps.google.com/maps?q=India&z=5&output=embed';
  document.getElementById('mpPin').style.display = 'none';
  document.getElementById('coordLat').value = '';
  document.getElementById('coordLng').value = '';
  ['dispLat','dispLng'].forEach(id => { document.getElementById(id).textContent = 'Not set yet'; document.getElementById(id).className = 'mp-coord-value empty'; });
  document.getElementById('dispAddr').textContent = 'Drop pin to detect';
  document.getElementById('mpConfirmBtn').disabled = true;
  document.getElementById('mpConfirmBtn').innerHTML = '<i class="fa-solid fa-circle-check"></i> Confirm Pin';
  document.getElementById('mpConfirmBtn').style.background = '';
  document.getElementById('confirmedBadge').classList.remove('show');
  document.getElementById('mapPickerWrap').classList.remove('pinned');
  document.getElementById('mpSearchInput').value = '';
  setMpStatus('Click on map to drop pin', '');
}

document.addEventListener('click', e => {
  if (!document.getElementById('mpSearchInput').contains(e.target) && !document.getElementById('mpSuggDrop').contains(e.target)) closeSugg();
});

