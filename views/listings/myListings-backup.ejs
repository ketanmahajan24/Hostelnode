<% layout("/layouts/boilerplate") -%>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  /* ── TOKENS ─────────────────────────────── */
  :root {
    --g:       #09B850;
    --g-dark:  #078040;
    --g-dim:   rgba(9,184,80,.12);
    --g-glow:  rgba(9,184,80,.22);
    --ink:     #0f1117;
    --ink2:    #3a3d47;
    --muted:   #7c8090;
    --surface: #ffffff;
    --bg:      #f4f5f7;
    --border:  #e2e4ea;
    --radius:  14px;
    --panel-l: 300px;
    --hdr:     64px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .ml-shell {
    width: 80%;
    margin-top: 50px;
    margin-left: 20%;
    display: flex;
    height: calc(100vh - var(--hdr));
    background: var(--bg);
    font-family: 'DM Sans', sans-serif;
    overflow: hidden;
  }

  /* ═══ LEFT PANEL ═══ */
  .ml-left {
    width: var(--panel-l);
    min-width: var(--panel-l);
    background: var(--surface);
    border-right: 1.5px solid var(--border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ml-left-head {
    padding: 20px 18px 14px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .ml-left-head h2 {
    font-family: sans-serif;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.3px;
  }
  .ml-left-head p { font-size: 0.72rem; color: var(--muted); margin-top: 2px; }

  .ml-add-btn {
    display: flex; align-items: center; gap: 6px;
    margin-top: 12px; padding: 9px 14px;
    background: var(--g); color: #fff;
    border: none; border-radius: 10px;
    font-size: 0.78rem; font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer; text-decoration: none;
    width: 100%; justify-content: center;
    transition: background .18s, transform .12s;
  }
  .ml-add-btn:hover { background: var(--g-dark); transform: translateY(-1px); color: #fff; }

  .ml-search { padding: 12px 18px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .ml-search-wrap {
    display: flex; align-items: center; gap: 7px;
    background: var(--bg); border: 1.5px solid var(--border);
    border-radius: 10px; padding: 7px 11px;
  }
  .ml-search-wrap i { color: var(--muted); font-size: 0.78rem; }
  .ml-search-wrap input {
    border: none; background: transparent; outline: none;
    font-size: 0.78rem; color: var(--ink);
    font-family: 'DM Sans', sans-serif; width: 100%;
  }
  .ml-search-wrap input::placeholder { color: var(--muted); }

  .ml-cards-scroll { flex: 1; overflow-y: auto; padding: 10px 10px 20px; }
  .ml-cards-scroll::-webkit-scrollbar { width: 4px; }
  .ml-cards-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  .ml-card {
    display: flex; gap: 10px; padding: 11px 10px;
    border-radius: 12px; cursor: pointer;
    transition: background .15s, box-shadow .15s;
    border: 1.5px solid transparent;
    margin-bottom: 4px; position: relative;
  }
  .ml-card:hover { background: var(--bg); }
  .ml-card.active { background: var(--g-dim); border-color: var(--g); }
  .ml-card.active::before {
    content: ''; position: absolute;
    left: 0; top: 50%; transform: translateY(-50%);
    width: 3px; height: 60%;
    background: var(--g); border-radius: 0 3px 3px 0;
  }

  .ml-card-thumb {
    width: 56px; height: 56px; border-radius: 10px;
    object-fit: cover; flex-shrink: 0; background: var(--bg);
  }
  .ml-card-thumb-placeholder {
    width: 56px; height: 56px; border-radius: 10px;
    background: var(--border); display: flex;
    align-items: center; justify-content: center; flex-shrink: 0;
  }
  .ml-card-thumb-placeholder i { color: var(--muted); font-size: 1rem; }

  .ml-card-info { flex: 1; min-width: 0; }
  .ml-card-title {
    font-size: 0.8rem; font-weight: 600; color: var(--ink);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    font-family: sans-serif;
  }
  .ml-card-loc { font-size: 0.7rem; color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ml-card-meta { display: flex; align-items: center; gap: 5px; margin-top: 5px; }
  .ml-card-price { font-size: 0.72rem; font-weight: 600; color: var(--g); }

  .status-pill {
    font-size: 0.62rem; font-weight: 600; padding: 2px 7px;
    border-radius: 20px; text-transform: uppercase; letter-spacing: 0.4px;
  }
  .status-pill.Pending  { background: #FFF3CD; color: #856404; }
  .status-pill.Approved { background: #D1FAE5; color: #065f46; }
  .status-pill.Rejected { background: #FEE2E2; color: #991b1b; }

  .ml-empty { text-align: center; padding: 40px 20px; color: var(--muted); font-size: 0.8rem; }
  .ml-empty i { font-size: 2rem; display: block; margin-bottom: 8px; color: var(--border); }

  /* ═══ RIGHT PANEL ═══ */
  .ml-right {
    flex: 1; display: flex; flex-direction: column;
    overflow: hidden; background: var(--bg);
  }

  .ml-placeholder {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 12px; color: var(--muted);
  }
  .ml-placeholder .ph-icon {
    width: 72px; height: 72px; border-radius: 50%;
    background: var(--border); display: flex;
    align-items: center; justify-content: center;
    font-size: 1.8rem; color: var(--muted);
  }
  .ml-placeholder p { font-size: 0.85rem; }

  /* ── DETAIL PANEL ── */
  .ml-detail {
    flex: 1; overflow-y: auto;
    display: none; flex-direction: column;
  }
  .ml-detail.visible { display: flex; }
  .ml-detail::-webkit-scrollbar { width: 5px; }
  .ml-detail::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  /* ══════════════════════════════════════
     HERO SLIDER  — THE FIXED PART
  ══════════════════════════════════════ */
  .ml-hero {
    position: relative;
    height: 230px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--ink);
  }

  /* Each hero contains ONE .ml-slider */
  .ml-slider {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* All slides stacked, hidden by default */
  .ml-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.7s ease;
    /* NO transform — transform caused the scale glitch + layout issues */
  }
  .ml-slide.active {
    opacity: 1;
    position: relative; /* keeps container height */
    z-index: 1;
  }

  /* Arrows */
  .ml-slide-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.92);
    border: none;
    width: 34px; height: 34px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 20;
    font-size: 0.75rem;
    display: flex; align-items: center; justify-content: center;
    transition: background .18s, color .18s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
  }
  .ml-slide-btn:hover { background: var(--g); color: #fff; }
  .ml-slide-btn.prev { left: 12px; }
  .ml-slide-btn.next { right: 12px; }

  /* Dots */
  .ml-dots {
    position: absolute;
    bottom: 14px;
    width: 100%;
    text-align: center;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .ml-dot {
    height: 6px; width: 6px;
    background: rgba(255,255,255,0.5);
    border-radius: 50%;
    cursor: pointer;
    transition: width .3s, background .3s;
    display: inline-block;
  }
  .ml-dot.active {
    width: 18px;
    border-radius: 10px;
    background: #fff;
  }

  /* overlay + title */
  .ml-hero-overlay {
    position: absolute; inset: 0; z-index: 5;
    background: linear-gradient(to bottom, transparent 35%, rgba(0,0,0,.65));
    pointer-events: none;
  }
  .ml-hero-title {
    position: absolute; bottom: 16px; left: 16px; right: 16px;
    z-index: 10; pointer-events: none;
  }
  .ml-hero-title h1 {
    font-family: sans-serif; font-size: 1.35rem; font-weight: 800;
    color: #fff; text-shadow: 0 2px 8px rgba(0,0,0,.4);
  }

  /* action bar */
  .ml-action-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 14px 20px;
    background: var(--surface); border-bottom: 1px solid var(--border);
    flex-shrink: 0; flex-wrap: wrap;
  }
  .action-btn {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 15px; border-radius: 9px;
    font-size: 0.78rem; font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    cursor: pointer; border: 1.5px solid transparent;
    text-decoration: none; transition: all .16s;
  }
  .action-btn.primary { background: var(--g); color: #fff; }
  .action-btn.primary:hover { background: var(--g-dark); color: #fff; }
  .action-btn.outline { background: #fff; color: var(--ink); border-color: var(--border); }
  .action-btn.outline:hover { border-color: var(--g); color: var(--g); }
  .action-btn.danger  { background: #fff; color: #dc2626; border-color: #fecaca; }
  .action-btn.danger:hover { background: #fee2e2; }
  .action-btn.ghost   { background: transparent; color: var(--muted); }
  .action-btn.ghost:hover { color: var(--ink); }
  .ml-action-spacer { flex: 1; }
  .ml-status-badge {
    padding: 6px 12px; border-radius: 20px;
    font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.4px; text-transform: uppercase;
  }
  .ml-status-badge.Pending  { background: #fef3c7; color: #92400e; }
  .ml-status-badge.Approved { background: #d1fae5; color: #065f46; }
  .ml-status-badge.Rejected { background: #fee2e2; color: #991b1b; }

  /* body */
  .ml-body { padding: 22px 22px 40px; }

  .ml-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px; margin-bottom: 22px;
  }
  .ml-info-card {
    background: var(--surface); border-radius: var(--radius);
    padding: 14px; border: 1px solid var(--border);
  }
  .ml-info-card .label {
    font-size: 0.67rem; color: var(--muted); text-transform: uppercase;
    letter-spacing: 0.6px; font-weight: 600; margin-bottom: 4px;
  }
  .ml-info-card .value {
    font-size: 1rem; font-weight: 700; color: var(--ink); font-family: sans-serif;
  }
  .ml-info-card .value.green { color: var(--g); }

  .ml-section { margin-bottom: 20px; }
  .ml-section-title {
    font-family: sans-serif; font-size: 0.82rem; font-weight: 800;
    color: var(--ink); margin-bottom: 10px;
    text-transform: uppercase; letter-spacing: 0.5px;
    display: flex; align-items: center; gap: 6px;
  }
  .ml-section-title i { color: var(--g); font-size: 0.8rem; }

  .ml-rooms-table { width: 100%; border-collapse: collapse; }
  .ml-rooms-table th {
    text-align: left; font-size: 0.68rem; font-weight: 700; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.5px; padding: 8px 10px;
    background: var(--bg); border-bottom: 1.5px solid var(--border);
  }
  .ml-rooms-table td {
    padding: 10px; font-size: 0.78rem; color: var(--ink2);
    border-bottom: 1px solid var(--border);
  }
  .ml-rooms-table tbody tr:last-child td { border-bottom: none; }
  .ml-rooms-table tbody tr:hover td { background: var(--bg); }
  .ml-rooms-wrap {
    background: var(--surface); border-radius: var(--radius);
    overflow: hidden; border: 1px solid var(--border);
  }

  .ml-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .ml-chip {
    display: flex; align-items: center; gap: 5px;
    padding: 5px 11px; border-radius: 20px;
    font-size: 0.72rem; font-weight: 500;
    background: var(--surface); border: 1px solid var(--border); color: var(--ink2);
  }
  .ml-chip i { color: var(--g); font-size: 0.72rem; }

  .ml-rule {
    display: flex; align-items: flex-start; gap: 8px;
    padding: 8px 0; border-bottom: 1px solid var(--border);
    font-size: 0.78rem; color: var(--ink2);
  }
  .ml-rule:last-child { border-bottom: none; }
  .ml-rule i { color: var(--g); font-size: 0.7rem; margin-top: 3px; flex-shrink: 0; }

  .ml-contact-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .ml-contact-item {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 14px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--border);
    font-size: 0.78rem; color: var(--ink2);
  }
  .ml-contact-item i { color: var(--g); }

  .ml-loc-box {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 14px 16px;
    font-size: 0.78rem; color: var(--ink2); line-height: 1.7;
  }
  .ml-loc-box span { color: var(--muted); font-size: 0.7rem; }

  .ml-analytics { display: flex; gap: 10px; flex-wrap: wrap; }
  .ml-analytic {
    flex: 1; min-width: 100px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 14px; text-align: center;
  }
  .ml-analytic .an-val {
    font-family: sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--ink);
  }
  .ml-analytic .an-label {
    font-size: 0.68rem; color: var(--muted); margin-top: 2px;
    text-transform: uppercase; letter-spacing: 0.5px;
  }

  /* modal */
  .ml-modal-bg {
    position: fixed; inset: 0; background: rgba(0,0,0,.45);
    z-index: 1000; display: none; align-items: center; justify-content: center;
  }
  .ml-modal-bg.open { display: flex; }
  .ml-modal {
    background: var(--surface); border-radius: 18px; padding: 28px 28px 22px;
    max-width: 380px; width: 90%;
    box-shadow: 0 20px 60px rgba(0,0,0,.18);
    animation: modalIn .2s ease;
  }
  @keyframes modalIn { from { opacity:0; transform: scale(.94) translateY(10px); } to { opacity:1; transform: none; } }
  .ml-modal h3 {
    font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 800;
    color: var(--ink); margin-bottom: 8px;
  }
  .ml-modal p { font-size: 0.82rem; color: var(--muted); margin-bottom: 20px; line-height: 1.6; }
  .ml-modal-btns { display: flex; gap: 8px; justify-content: flex-end; }

  .no-results { display: none; padding: 20px; text-align: center; color: var(--muted); font-size: 0.78rem; }

  @media (max-width: 700px) {
    .ml-shell { width: 100%; margin: 20px auto; flex-direction: column; height: auto; }
    .ml-left { width: 100%; min-width: unset; height: auto; max-height: 45vh; border-right: none; border-bottom: 1.5px solid var(--border); }
    .ml-right { min-height: 60vh; }
  }
</style>

<div class="ml-shell">

  <!-- ════ LEFT PANEL ════ -->
  <div class="ml-left">
    <div class="ml-left-head">
      <h2>My Properties</h2>
      <p><%= listings.length %> listing<%= listings.length !== 1 ? 's' : '' %> found</p>
      <a href="/user/list-property" class="ml-add-btn">
        <i class="fa-solid fa-plus"></i> Add New Listing
      </a>
    </div>

    <div class="ml-search">
      <div class="ml-search-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="listingSearch" placeholder="Search by name, city…" oninput="filterCards(this.value)">
      </div>
    </div>

    <div class="ml-cards-scroll" id="cardsScroll">
      <% if (listings.length === 0) { %>
        <div class="ml-empty">
          <i class="fa-solid fa-house-circle-xmark"></i>
          <p>No listings yet.<br>Add your first property!</p>
        </div>
      <% } else { %>
        <% listings.forEach((l, idx) => { %>
          <div class="ml-card <%= idx === 0 ? 'active' : '' %>"
               id="card-<%= l._id %>"
               onclick="selectListing('<%= l._id %>')">

            <% if (l.images && l.images.length > 0) { %>
              <img class="ml-card-thumb"
                   src="/listing-images/<%= l.images[0] %>"
                   alt="<%= l.title %>"
                   onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
              <div class="ml-card-thumb-placeholder" style="display:none">
                <i class="fa-solid fa-image"></i>
              </div>
            <% } else { %>
              <div class="ml-card-thumb-placeholder">
                <i class="fa-solid fa-image"></i>
              </div>
            <% } %>

            <div class="ml-card-info">
              <div class="ml-card-title"><%= l.title %> </div>
              <div class="ml-card-loc">
                <i class="fa-solid fa-location-dot" style="font-size:0.6rem"></i>
                <%= l.location?.city || '—' %>
              </div>
              <div class="ml-card-meta">
                <span class="ml-card-price">₹<%= l.startingPrice?.toLocaleString('en-IN') %>/mo</span>
                <span class="status-pill <%= l.status %>"><%= l.status %></span>
              </div>
            </div>
          </div>
        <% }) %>
        <div class="no-results" id="noResults">No listings match your search.</div>
      <% } %>
    </div>
  </div><!-- /ml-left -->


  <!-- ════ RIGHT PANEL ════ -->
  <div class="ml-right">

    <div class="ml-placeholder" id="mlPlaceholder"
         style="<%= listings.length > 0 ? 'display:none' : '' %>">
      <div class="ph-icon"><i class="fa-solid fa-house"></i></div>
      <p>Select a property to view details</p>
    </div>

    <% listings.forEach((l, idx) => { %>
    <div class="ml-detail <%= idx === 0 ? 'visible' : '' %>"
         id="detail-<%= l._id %>">

      <!-- ══ HERO SLIDER ══ -->
      <div class="ml-hero">

        <% if (l.images && l.images.length > 0) { %>

          <%# 
            KEY FIX: Each slider gets a unique data-id so JS can target it precisely.
            Arrows/dots stop-propagate clicks and call the global sliderNav(id, dir) function.
            No more "dataset.init" guard causing skips.
          %>
          <div class="ml-slider" data-slider-id="<%= l._id %>" data-current="0">

            <% l.images.forEach((img, i) => { %>
              <img
                src="/listing-images/<%= img %>"
                class="ml-slide <%= i === 0 ? 'active' : '' %>"
                alt="<%= l.title %> photo <%= i+1 %>"
                loading="<%= i === 0 ? 'eager' : 'lazy' %>"
                onerror="this.src='/images/hostelnode-logo-cutout.png'">
            <% }) %>

            <% if (l.images.length > 1) { %>
              <!-- Prev arrow -->
              <button
                type="button"
                class="ml-slide-btn prev"
                onclick="event.stopPropagation(); sliderNav('<%= l._id %>', -1)">
                <i class="fa-solid fa-chevron-left"></i>
              </button>

              <!-- Next arrow -->
              <button
                type="button"
                class="ml-slide-btn next"
                onclick="event.stopPropagation(); sliderNav('<%= l._id %>', 1)">
                <i class="fa-solid fa-chevron-right"></i>
              </button>

              <!-- Dots -->
              <div class="ml-dots">
                <% l.images.forEach((_, i) => { %>
                  <span
                    class="ml-dot <%= i === 0 ? 'active' : '' %>"
                    onclick="event.stopPropagation(); sliderGoTo('<%= l._id %>', <%= i %>)">
                  </span>
                <% }) %>
              </div>
            <% } %>

          </div><!-- /ml-slider -->

        <% } else { %>
          <!-- No images fallback -->
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#1a1d25">
            <i class="fa-solid fa-image" style="font-size:2.5rem;color:#3a3d47"></i>
          </div>
        <% } %>

        <div class="ml-hero-overlay"></div>
        <div class="ml-hero-title">
          <h1><%= l.title %></h1>  <h4 class="badge bg-success"  style="padding: 8px;"> <%= l.propertyType %> | <%= l.gender %>  </h4>
        </div>
      </div><!-- /ml-hero -->

      <!-- Action Bar -->
      <div class="ml-action-bar">
        <a href="/user/listing/<%= l._id %>/edit" class="action-btn primary">
          <i class="fa-solid fa-pen-to-square"></i> Edit
        </a>
        <button class="action-btn outline" onclick="copyLink('<%= l.slug %>')">
          <i class="fa-solid fa-link"></i> Copy Link
        </button>
        <% if (l.status === 'Approved') { %>
        <a href="/listings/<%= l.slug %>" target="_blank" class="action-btn outline">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> Preview
        </a>
        <% } %>
        <button class="action-btn ghost" onclick="boostListing('<%= l._id %>')">
          <i class="fa-solid fa-bolt"></i> Boost
        </button>
        
        <div class="ml-action-spacer"></div>
        <span class="ml-status-badge <%= l.status %>">
          <% if (l.status === 'Pending')  { %><i class="fa-solid fa-clock"></i><% } %>
          <% if (l.status === 'Approved') { %><i class="fa-solid fa-circle-check"></i><% } %>
          <% if (l.status === 'Rejected') { %><i class="fa-solid fa-circle-xmark"></i><% } %>
          &nbsp;<%= l.status %>
        </span>
        <button class="action-btn danger"
                onclick="openDelete('<%= l._id %>', '<%= l.title.replace(/'/g, "\\'") %>')">
          <i class="fa-solid fa-trash"></i> Delete
        </button>
      </div>

      <!-- Body -->
      <div class="ml-body">

        <div class="ml-info-grid">
          <div class="ml-info-card">
            <div class="label">Starting price</div>
            <div class="value green">₹<%= l.startingPrice?.toLocaleString('en-IN') %></div>
          </div>
          <% if (l.deposit) { %>
          <div class="ml-info-card">
            <div class="label">Deposit</div>
            <div class="value">₹<%= l.deposit?.toLocaleString('en-IN') %></div>
          </div>
          <% } %>
          <% if (l.capacity) { %>
          <div class="ml-info-card">
            <div class="label">Capacity</div>
            <div class="value"><%= l.capacity %> beds</div>
          </div>
          <% } %>
          <div class="ml-info-card">
            <div class="label">Rooms listed</div>
            <div class="value"><%= l.rooms?.length || 0 %></div>
          </div>
          <div class="ml-info-card">
            <div class="label">Rating</div>
            <div class="value"><%= l.rating > 0 ? l.rating.toFixed(1) + ' ★' : '—' %></div>
          </div>
          <div class="ml-info-card">
            <div class="label">Listed on</div>
            <div class="value" style="font-size:0.75rem">
              <%= new Date(l.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %>
            </div>
          </div>
        </div>

        <!-- Analytics -->
        <div class="ml-section">
          <div class="ml-section-title"><i class="fa-solid fa-chart-line"></i> Analytics</div>
          <div class="ml-analytics">
            <div class="ml-analytic"><div class="an-val"><%= l.views %></div><div class="an-label">Views</div></div>
            <div class="ml-analytic"><div class="an-val"><%= l.shortlisted %></div><div class="an-label">Shortlisted</div></div>
            <div class="ml-analytic"><div class="an-val"><%= l.reviewCount %></div><div class="an-label">Reviews</div></div>
            <div class="ml-analytic"><div class="an-val"><%= l.isVerified ? '✓' : '—' %></div><div class="an-label">Verified</div></div>
          </div>
        </div>

        <!-- Description -->
        <% if (l.description) { %>
        <div class="ml-section">
          <div class="ml-section-title"><i class="fa-solid fa-align-left"></i> Description</div>
          <div class="ml-loc-box"><%= l.description %></div>
        </div>
        <% } %>

        <!-- Location -->
        <div class="ml-section">
          <div class="ml-section-title"><i class="fa-solid fa-location-dot"></i> Location</div>
          <div class="ml-loc-box">
            <div><%= l.location?.address %></div>
            <div><%= l.location?.city %>, <%= l.location?.state %> — <%= l.location?.pincode %></div>
            <div><%= l.location?.country %></div>
            <% if (l.location?.nearCollege) { %>
            <div style="margin-top:6px"><span><i class="fa-solid fa-location"></i> Near by  </span><strong><%= l.location.nearCollege %></strong></div>
            <% } %>
            <% if (l.location?.coordinates?.lat) { %>
            <div style="margin-top:6px;font-size:0.69rem;color:#aaa">
              <i class="fa-solid fa-map-pin"></i>
              <%= l.location.coordinates.lat.toFixed(6) %>, <%= l.location.coordinates.lng.toFixed(6) %>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Rooms -->
        <% if (l.rooms && l.rooms.length > 0) { %>
        <div class="ml-section">
          <div class="ml-section-title"><i class="fa-solid fa-bed"></i> Rooms & Pricing</div>
          <div class="ml-rooms-wrap">
            <table class="ml-rooms-table">
              <thead>
                <tr><th>Type</th><th>Price/mo</th><th>Deposit</th><th>Features</th><th>Available</th></tr>
              </thead>
              <tbody>
                <% l.rooms.forEach(r => { %>
                <tr>
                  <td><strong><%= r.type %></strong></td>
                  <td style="color:var(--g);font-weight:600">₹<%= r.price?.toLocaleString('en-IN') %></td>
                  <td>₹<%= r.deposit?.toLocaleString('en-IN') || '0' %></td>
                  <td><%= r.features?.join(', ') || '—' %></td>
                  <td>
                    <% if (r.available) { %>
                      <span style="color:#059669;font-size:0.72rem;font-weight:600">✓ Yes</span>
                    <% } else { %>
                      <span style="color:#dc2626;font-size:0.72rem;font-weight:600">✗ No</span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <% } %>

        <!-- Amenities -->
        <% if (l.amenities && l.amenities.length > 0) { %>
        <div class="ml-section">
          <div class="ml-section-title"><i class="fa-solid fa-star"></i> Amenities (<%= l.amenities.length %>)</div>
          <div class="ml-chips">
            <% l.amenities.forEach(a => { %>
            <span class="ml-chip"><i class="fa-solid fa-check"></i> <%= a %></span>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Rules -->
        <% const cleanRules = (l.rules || []).filter(r => r && r.trim()); %>
        <% if (cleanRules.length > 0) { %>
        <div class="ml-section">
          <div class="ml-section-title"><i class="fa-solid fa-circle-info"></i> House Rules</div>
          <div class="ml-loc-box" style="padding:4px 16px">
            <% cleanRules.forEach(r => { %>
            <div class="ml-rule"><i class="fa-solid fa-angles-right"></i> <%= r %></div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Contact -->
        <div class="ml-section">
          <div class="ml-section-title"><i class="fa-solid fa-phone"></i> Contact</div>
          <div class="ml-contact-row">
            <% if (l.contact?.phone) { %>
            <div class="ml-contact-item"><i class="fa-solid fa-phone"></i>+91 <%= l.contact.phone %></div>
            <% } %>
            <% if (l.contact?.whatsapp) { %>
            <div class="ml-contact-item"><i class="fa-brands fa-whatsapp" style="color:#25D366"></i>+91 <%= l.contact.whatsapp %></div>
            <% } %>
          </div>
        </div>

      </div><!-- /ml-body -->
    </div><!-- /ml-detail -->
    <% }) %>

  </div><!-- /ml-right -->
</div><!-- /ml-shell -->


<!-- DELETE MODAL -->
<div class="ml-modal-bg" id="deleteModal">
  <div class="ml-modal">
    <h3>Delete Listing?</h3>
    <p id="deleteMsg">This will permanently remove your listing. This action cannot be undone.</p>
    <div class="ml-modal-btns">
      <button class="action-btn outline" onclick="closeDelete()">Cancel</button>
      <form id="deleteForm" method="POST">
        <input type="hidden" name="_method" value="DELETE">
        <button type="submit" class="action-btn danger">
          <i class="fa-solid fa-trash"></i> Yes, delete
        </button>
      </form>
    </div>
  </div>
</div>


<script>
/* ============================================================
   SLIDER  — complete rewrite, no dataset.init guard
   Each slider is identified by data-slider-id (= listing _id)
   State is stored in a plain JS Map: sliderState[id] = { current, timer }
============================================================ */
const sliderState = {};   // id -> { current: Number, timer: id }

function sliderGoTo(id, index) {
  const slider = document.querySelector(`.ml-slider[data-slider-id="${id}"]`);
  if (!slider) return;

  const slides = slider.querySelectorAll('.ml-slide');
  const dots   = slider.querySelectorAll('.ml-dot');
  if (!slides.length) return;

  const prev = sliderState[id]?.current ?? 0;

  // hide previous
  slides[prev]?.classList.remove('active');
  dots[prev]?.classList.remove('active');

  // clamp index
  const next = (index + slides.length) % slides.length;
  slides[next].classList.add('active');
  dots[next]?.classList.add('active');

  sliderState[id] = { ...sliderState[id], current: next };
}

function sliderNav(id, dir) {
  const slider = document.querySelector(`.ml-slider[data-slider-id="${id}"]`);
  if (!slider) return;
  const slides = slider.querySelectorAll('.ml-slide');
  const cur    = sliderState[id]?.current ?? 0;
  sliderGoTo(id, cur + dir);
  // reset auto-advance timer
  sliderResetAuto(id, slides.length);
}

function sliderStartAuto(id, total) {
  if (total <= 1) return;
  const timer = setInterval(() => {
    const cur = sliderState[id]?.current ?? 0;
    sliderGoTo(id, cur + 1);
  }, 3500);
  sliderState[id] = { ...(sliderState[id] || {}), timer };
}

function sliderStopAuto(id) {
  if (sliderState[id]?.timer) {
    clearInterval(sliderState[id].timer);
    sliderState[id].timer = null;
  }
}

function sliderResetAuto(id, total) {
  sliderStopAuto(id);
  sliderStartAuto(id, total);
}

function initAllSliders() {
  document.querySelectorAll('.ml-slider').forEach(slider => {
    const id     = slider.dataset.sliderId;
    const slides = slider.querySelectorAll('.ml-slide');
    if (!id || !slides.length) return;

    // init state
    sliderState[id] = { current: 0, timer: null };

    // pause on hover
    slider.addEventListener('mouseenter', () => sliderStopAuto(id));
    slider.addEventListener('mouseleave', () => sliderStartAuto(id, slides.length));

    // swipe support
    let touchStartX = 0;
    slider.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
    slider.addEventListener('touchend', e => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) sliderNav(id, diff > 0 ? 1 : -1);
    });

    // start auto only if slider is in a VISIBLE detail panel
    const detail = slider.closest('.ml-detail');
    if (detail && detail.classList.contains('visible')) {
      sliderStartAuto(id, slides.length);
    }
  });
}

/* ============================================================
   SELECT LISTING
============================================================ */
function selectListing(id) {
  // cards
  document.querySelectorAll('.ml-card').forEach(c => c.classList.remove('active'));
  document.getElementById('card-' + id)?.classList.add('active');

  // stop auto on ALL sliders
  Object.keys(sliderState).forEach(sid => sliderStopAuto(sid));

  // hide all details
  document.querySelectorAll('.ml-detail').forEach(d => d.classList.remove('visible'));

  // show selected
  const detail = document.getElementById('detail-' + id);
  if (detail) {
    detail.classList.add('visible');
    detail.scrollTop = 0;   // scroll to top on switch
  }

  document.getElementById('mlPlaceholder').style.display = 'none';

  // start auto for the newly visible slider
  const slider = detail?.querySelector('.ml-slider');
  if (slider) {
    const slides = slider.querySelectorAll('.ml-slide');
    sliderStartAuto(id, slides.length);
  }
}

/* ============================================================
   SEARCH FILTER
============================================================ */
function filterCards(q) {
  const ql = q.toLowerCase().trim();
  let visible = 0;
  document.querySelectorAll('.ml-card').forEach(card => {
    const show = !ql || card.textContent.toLowerCase().includes(ql);
    card.style.display = show ? '' : 'none';
    if (show) visible++;
  });
  document.getElementById('noResults').style.display = visible === 0 ? 'block' : 'none';
}

/* ============================================================
   COPY LINK
============================================================ */
function copyLink(slug) {
  const url = window.location.origin + '/listings/' + slug;
  navigator.clipboard.writeText(url)
    .then(() => showToast('Link copied!'))
    .catch(() => showToast('Could not copy', true));
}

/* ============================================================
   BOOST
============================================================ */
function boostListing(id) { showToast('Boost feature coming soon!'); }

/* ============================================================
   DELETE MODAL
============================================================ */
function openDelete(id, name) {
  document.getElementById('deleteMsg').textContent =
    `"${name}" will be permanently removed. This cannot be undone.`;
  document.getElementById('deleteForm').action = '/user/listing/' + id + '/delete';
  document.getElementById('deleteModal').classList.add('open');
}
function closeDelete() {
  document.getElementById('deleteModal').classList.remove('open');
}
document.getElementById('deleteModal').addEventListener('click', function(e) {
  if (e.target === this) closeDelete();
});

/* ============================================================
   TOAST
============================================================ */
function showToast(msg, err = false) {
  let t = document.getElementById('mlToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'mlToast';
    Object.assign(t.style, {
      position: 'fixed', bottom: '24px', right: '24px',
      padding: '10px 18px', borderRadius: '10px',
      fontSize: '0.78rem', fontWeight: '600',
      fontFamily: "'DM Sans', sans-serif",
      zIndex: '9999', transition: 'opacity .3s',
      boxShadow: '0 4px 20px rgba(0,0,0,.15)'
    });
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.background = err ? '#dc2626' : '#09B850';
  t.style.color = '#fff';
  t.style.opacity = '1';
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.style.opacity = '0', 2800);
}

/* ============================================================
   INIT on DOM ready
============================================================ */
document.addEventListener('DOMContentLoaded', initAllSliders);
</script>
