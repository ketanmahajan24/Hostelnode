<!-- messages.ejs — HostelNode universal Messages inbox -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Messages | HostelNode</title>
  <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/findhostel.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: var(--bg); }
    .msg-wrap { max-width: 720px; margin: 0 auto; padding: 24px 20px 80px; }
    .msg-head h1 { font-family: var(--font-d); font-size: 1.5rem; font-weight: 700; color: var(--ink); margin-bottom: 16px; }

    .msg-tabs { display: flex; gap: 8px; margin-bottom: 20px; }
    .msg-tab { padding: 9px 18px; border-radius: 999px; border: 1.5px solid var(--border); background: var(--card-bg); font-size: 13.5px; font-weight: 700; color: var(--muted); cursor: pointer; transition: all .15s; }
    .msg-tab.active { background: var(--ink); border-color: var(--ink); color: #fff; }

    .msg-row { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 16px 18px; margin-bottom: 12px; transition: box-shadow .15s; }
    .msg-row:hover { box-shadow: var(--shadow-sm); }
    .msg-row-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
    .msg-kind-tag { font-size: 11px; font-weight: 800; letter-spacing: .3px; display: inline-flex; align-items: center; gap: 5px; }
    .msg-kind-tag.request { color: #92400e; }
    .msg-kind-tag.flatmate { color: var(--green-dark); }
    .msg-kind-tag.pg { color: #2563eb; }
    .msg-title { font-size: 14px; font-weight: 700; color: var(--ink); margin: 4px 0 2px; }
    .msg-sub { font-size: 12.5px; color: var(--muted); }
    .msg-preview { font-size: 13px; color: var(--ink-mid); margin-top: 6px; font-style: italic; }
    .msg-status-badge { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 700; padding: 4px 10px; border-radius: 999px; margin-top: 8px; }
    .msg-status-badge.new { background: #ecfdf3; color: #078a3c; }
    .msg-status-badge.pending { background: #fffbeb; color: #92400e; }
    .msg-status-badge.connected { background: var(--green-light); color: var(--green-dark); }
    .msg-status-badge.ended { background: var(--bg2); color: var(--muted); }
    .msg-unread-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--green); flex-shrink: 0; }

    .msg-actions { display: flex; gap: 10px; margin-top: 10px; }
    .msg-btn { padding: 9px 18px; border-radius: 999px; font-size: 12.5px; font-weight: 700; border: none; cursor: pointer; }
    .msg-btn.accept { background: linear-gradient(135deg, var(--green), #00c264); color: #fff; }
    .msg-btn.decline { background: var(--bg2); color: var(--ink-mid); }
    .msg-btn.cancel { background: none; color: #c53030; text-decoration: underline; padding: 0; }
    .msg-btn.chat { background: var(--ink); color: #fff; }
    .msg-btn.chat:hover { background: var(--green-dark); }
    a.msg-btn { text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }

    .msg-empty { text-align: center; padding: 60px 20px; color: var(--muted); }
    .msg-empty i { font-size: 2rem; color: var(--border-dark); display: block; margin-bottom: 14px; }
  </style>
</head>
<body>

<%- include("../includes/navbar-user.ejs") %>

<div class="msg-wrap">
  <div class="msg-head"><h1>Messages</h1></div>

  <div class="msg-tabs" id="msgTabs">
    <button class="msg-tab active" data-filter="all" onclick="setFilter('all', this)">All</button>
    <button class="msg-tab" data-filter="pg" onclick="setFilter('pg', this)">PG &amp; Hostel</button>
    <button class="msg-tab" data-filter="flatmate" onclick="setFilter('flatmate', this)">Flatmate</button>
  </div>

  <div id="msgList">
    <% if (!rows || rows.length === 0) { %>
      <div class="msg-empty">
        <i class="fa-regular fa-comments"></i>
        <p>No messages yet. Connect with a flatmate or contact a PG owner to start chatting.</p>
      </div>
    <% } %>

    <% rows.forEach(function(row) { %>
      <div class="msg-row" data-category="<%= row.category %>">

        <% if (row.kind === 'request' && row.incoming) { %>
          <div class="msg-row-top">
            <span class="msg-kind-tag request"><i class="fa-solid fa-handshake"></i> FLATMATE REQUEST</span>
          </div>
          <div class="msg-title"><%= row.counterpartName %> wants to connect with you</div>
          <div class="msg-sub"><%= row.listingText %></div>
          <% if (row.message) { %><div class="msg-preview">"<%= row.message %>"</div><% } %>
          <div class="msg-status-badge new"><i class="fa-solid fa-circle"></i> New Request</div>
          <div class="msg-actions">
            <button class="msg-btn accept" onclick="acceptRequest('<%= row.connectionId %>', this)">Accept</button>
            <button class="msg-btn decline" onclick="declineRequest('<%= row.connectionId %>', this)">Decline</button>
          </div>

        <% } else if (row.kind === 'request' && !row.incoming) { %>
          <div class="msg-row-top">
            <span class="msg-kind-tag request"><i class="fa-solid fa-handshake"></i> FLATMATE REQUEST</span>
          </div>
          <div class="msg-title">Your request to <%= row.counterpartName %></div>
          <div class="msg-sub"><%= row.listingText %></div>
          <div class="msg-status-badge pending"><i class="fa-solid fa-clock"></i> Request Pending</div>
          <div class="msg-actions">
            <button class="msg-btn cancel" onclick="cancelRequest('<%= row.connectionId %>', this)">Cancel Request</button>
          </div>

        <% } else if (row.kind === 'chat' && row.category === 'flatmate') { %>
          <div class="msg-row-top">
            <span class="msg-kind-tag flatmate"><i class="fa-solid fa-user"></i> FLATMATE</span>
            <% if (row.unread > 0) { %><span class="msg-unread-dot"></span><% } %>
          </div>
          <div class="msg-title"><%= row.counterpartName %> &middot; <%= row.listingText %></div>
          <% if (row.lastMessage) { %><div class="msg-preview">"<%= row.lastMessage %>"</div><% } %>
          <% if (row.status === 'active') { %>
            <div class="msg-status-badge connected"><i class="fa-solid fa-circle-check"></i> Connected</div>
            <div class="msg-actions"><a class="msg-btn chat" href="/messages/<%= row.conversationId %>">Chat Now</a></div>
          <% } else { %>
            <div class="msg-status-badge ended"><i class="fa-solid fa-circle-minus"></i> Connection Ended</div>
            <div class="msg-actions"><a class="msg-btn decline" href="/messages/<%= row.conversationId %>">View</a></div>
          <% } %>

        <% } else if (row.kind === 'chat' && row.category === 'pg') { %>
          <div class="msg-row-top">
            <span class="msg-kind-tag pg"><i class="fa-solid fa-house"></i> PG &amp; HOSTEL</span>
            <% if (row.unread > 0) { %><span class="msg-unread-dot"></span><% } %>
          </div>
          <div class="msg-title"><%= row.listingText %></div>
          <% if (row.lastMessage) { %><div class="msg-preview">"<%= row.lastMessage %>"</div><% } %>
          <div class="msg-actions"><a class="msg-btn chat" href="/messages/<%= row.conversationId %>">Open Chat</a></div>
        <% } %>

      </div>
    <% }) %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
function setFilter(filter, btn) {
  document.querySelectorAll('.msg-tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('#msgList .msg-row').forEach(row => {
    row.style.display = (filter === 'all' || row.dataset.category === filter) ? '' : 'none';
  });
}

async function acceptRequest(id, btn) {
  btn.disabled = true; btn.textContent = 'Accepting…';
  try {
    const res = await fetch('/messages/connection/' + id + '/accept', { method: 'POST' });
    const data = await res.json();
    if (data.success) window.location.href = '/messages/' + data.conversationId;
    else { alert(data.error || 'Could not accept request.'); btn.disabled = false; btn.textContent = 'Accept'; }
  } catch (err) { alert('Network error — please try again.'); btn.disabled = false; btn.textContent = 'Accept'; }
}

async function declineRequest(id, btn) {
  if (!confirm('Decline this request?')) return;
  btn.disabled = true;
  try {
    const res = await fetch('/messages/connection/' + id + '/decline', { method: 'POST' });
    const data = await res.json();
    if (data.success) window.location.reload();
    else { alert(data.error || 'Could not decline request.'); btn.disabled = false; }
  } catch (err) { alert('Network error — please try again.'); btn.disabled = false; }
}

async function cancelRequest(id, btn) {
  if (!confirm('Cancel this request?')) return;
  btn.disabled = true;
  try {
    const res = await fetch('/flatmate/connection/' + id + '/cancel', { method: 'POST' });
    const data = await res.json();
    if (data.success) window.location.reload();
    else { alert(data.error || 'Could not cancel request.'); btn.disabled = false; }
  } catch (err) { alert('Network error — please try again.'); btn.disabled = false; }
}
</script>
</body>
</html>
