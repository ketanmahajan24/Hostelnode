<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Signup Successful | HostelNode</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:'Inter',sans-serif;
  background: linear-gradient(135deg, #09B850, #0f172a);
  height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

body::before{
  content:"";
  position:absolute;
  width:200%;
  height:200%;
  background: radial-gradient(circle, rgba(255,255,255,0.05) 10%, transparent 10%);
  background-size:70px 70px;
  animation:move 30s linear infinite;
}

@keyframes move{
  0%{transform:translate(0,0);}
  50%{transform:translate(-100px,-120px);}
  100%{transform:translate(0,0);}
}

.login-wrapper{
  width:100%;
  max-width:420px;
  backdrop-filter:blur(20px);
  border-radius:22px;
  overflow:hidden;
  box-shadow:0 25px 70px rgba(0,0,0,0.35);
}

.logo{
  text-align:center;
  margin:25px 0;
}
.logo img{
  height:90px;
  transition:.3s;
}
.logo img:hover{
  transform:scale(1.08) rotate(-3deg);
}

.card-login{
  background:rgba(255,255,255,0.95);
  padding:40px 30px;
  border-radius:22px;
  text-align:center;
}

.success-message{
  font-size:20px;
  font-weight:700;
  color:#16A34A;
  margin-bottom:15px;
}

.login-instruction{
  font-size:14px;
  color:#64748B;
  margin-bottom:25px;
}

/* button */
.btn-login{
  width:100%;
  margin-top:18px;
  padding:12px;
  border:none;
  border-radius:12px;
  font-weight:600;
  color:white;
  background:linear-gradient(135deg,#09B850,#22C55E);
  transition:.3s;
  cursor:pointer;
}

.btn-login:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 30px rgba(0,0,0,0.25);
}

.btn-login:active{
  transform:scale(.97);
}

/* links */
.signup-link{
  text-align:center;
  margin-top:12px;
  font-size:14px;
}
.signup-link a{
  color:#09B850;
  text-decoration:none;
  font-weight:600;
}
.signup-link a:hover{
  text-decoration:underline;
}

/* responsive */
@media(max-width:480px){
  .card-login{padding:25px;}
}
</style>
</head>
<body>

<div class="login-wrapper">

  <div class="logo">
    <img src="/images/hostelnode-logo-cutout.png">
  </div>

  <div class="card-login">
            <!-- Collab Logo + Profile -->
          <!-- <div class="logo-collab">
              <img src="/images/hostelnode-logo-cutout.png" class="collab-img logo-img">
              <img src="/profile-image/<%= user.profileImage %>" class="collab-img user-img">
          </div>  -->
    <div class="success-message">
      🎉 Congratulations, <%= user.name %>!
    </div>
    <div class="login-instruction">
      Your account has been created successfully. You can now login using your email <%= user.email %> and password.
    </div>

    <form method="GET" action="/login">
      <button class="btn-login">Go to Login</button>
    </form>

    <div class="signup-link">
      Already have an account? <a href="/login">Login</a>
    </div>

  </div>

</div>

</body>
</html>