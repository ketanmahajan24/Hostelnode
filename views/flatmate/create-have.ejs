<!-- create-have.ejs — HostelNode Flatmate: List Your Flat (HAVE_FLAT wizard) -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>List Your Flat &amp; Find Your Flatmate | HostelNode</title>
  <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/findhostel.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: var(--bg); }
    .wiz-wrap { max-width: 760px; margin: 0 auto; padding: 32px 20px 80px; }
    .wiz-head { text-align: center; margin-bottom: 26px; }
    .wiz-head h1 { font-family: var(--font-d); font-size: 1.7rem; font-weight: 700; color: var(--ink); }
    .wiz-head p { font-size: 13.5px; color: var(--muted); margin-top: 6px; }

    /* Progress stepper */
    .wiz-progress { display: flex; align-items: center; justify-content: center; gap: 4px; margin-bottom: 30px; flex-wrap: wrap; }
    .wiz-progress .pstep { display: flex; align-items: center; gap: 8px; }
    .wiz-progress .circ {
      width: 30px; height: 30px; border-radius: 50%; background: var(--bg2); color: var(--muted);
      display: flex; align-items: center; justify-content: center; font-size: 12.5px; font-weight: 700;
      border: 2px solid var(--border); transition: all .2s;
    }
    .wiz-progress .plabel { font-size: 11.5px; font-weight: 600; color: var(--muted); display: none; }
    @media (min-width: 640px) { .wiz-progress .plabel { display: inline; } }
    .wiz-progress .pstep.active .circ { background: var(--green); border-color: var(--green); color: #fff; }
    .wiz-progress .pstep.active .plabel { color: var(--ink); }
    .wiz-progress .pstep.done .circ { background: var(--green-light); border-color: var(--green); color: var(--green-dark); }
    .wiz-progress .pline { width: 20px; height: 2px; background: var(--border); }
    .wiz-progress .pstep.done + .pline { background: var(--green); }

    .wiz-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: 28px; }
    .wiz-step { display: none; }
    .wiz-step.active { display: block; animation: wizFade .3s ease; }
    @keyframes wizFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      .wiz-step.active { animation: none; }
      .wiz-card, .chip, .wiz-btn, .photo-drop { transition: none !important; }
    }
    .wiz-card { transition: box-shadow .2s ease; }
    .wiz-card:hover { box-shadow: var(--shadow-md); }
    .chip:active { transform: scale(.96); }
    .chip.selected { animation: chipPop .18s ease; }
    @keyframes chipPop { 0% { transform: scale(.94); } 100% { transform: scale(1); } }
    .wiz-btn { transition: background .18s, transform .12s, box-shadow .18s; }
    .wiz-btn:active:not(:disabled) { transform: scale(.97); }
    .wiz-btn.primary:hover:not(:disabled) { box-shadow: 0 6px 20px rgba(9,184,80,.35); transform: translateY(-1px); }
    .wiz-step h2 { font-family: var(--font-d); font-size: 1.15rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .wiz-step .step-sub { font-size: 12.5px; color: var(--muted); margin-bottom: 20px; }

    .field { margin-bottom: 18px; }
    .field label { display: block; font-size: 12.5px; font-weight: 700; color: var(--ink-mid); margin-bottom: 7px; }
    .field .hint { font-size: 11.5px; color: var(--muted-light); margin-top: 5px; }
    .field input[type="text"], .field input[type="number"], .field input[type="date"], .field select, .field textarea {
      width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: 12px; font-size: 14px;
      font-family: inherit; color: var(--ink); background: #fff; outline: none; box-sizing: border-box;
    }
    .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--green); box-shadow: 0 0 0 4px var(--green-glow); }
    .field textarea { resize: vertical; }
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    @media (max-width: 480px) { .row-2 { grid-template-columns: 1fr; } }

    .chips { display: flex; flex-wrap: wrap; gap: 9px; }
    .chip { padding: 9px 16px; border-radius: 999px; border: 1.5px solid var(--border); background: #fff; font-size: 13px; font-weight: 600; color: var(--ink-mid); cursor: pointer; transition: all .15s; user-select: none; }
    .chip:hover { border-color: var(--green); }
    .chip.selected { background: var(--green); border-color: var(--green); color: #fff; }

    .radio-group { display: flex; flex-wrap: wrap; gap: 16px; }
    .radio-opt { display: flex; align-items: center; gap: 7px; font-size: 13.5px; color: var(--ink-mid); cursor: pointer; }
    .radio-opt input { accent-color: var(--green); width: 16px; height: 16px; }

    .checkbox-row { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-mid); margin-top: 6px; }
    .verified-phone-box { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: var(--green-light); border: 1.5px solid var(--green-border); border-radius: 12px; font-size: 14.5px; font-weight: 600; color: var(--ink); }
    .verified-phone-box i { color: var(--green); }
    .verified-tag { margin-left: auto; background: var(--green); color: #fff; font-size: 10.5px; font-weight: 700; padding: 3px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: .3px; }

    /* Photo upload */
    .pin-map { width: 100%; height: 220px; border-radius: 12px; background: var(--bg2); margin-top: 10px; }
    .pin-map-unavailable { height: 220px; border-radius: 12px; background: var(--bg2); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; color: var(--muted); margin-top: 10px; text-align: center; padding: 0 20px; }
    .pin-map-unavailable i { font-size: 24px; color: var(--border-dark); }
    .pin-map-unavailable p { font-size: 12px; }

    .photo-drop {
      border: 2px dashed var(--border); border-radius: 14px; padding: 28px; text-align: center; cursor: pointer;
      transition: border-color .15s, background .15s; background: var(--bg2);
    }
    .photo-drop:hover, .photo-drop.dragover { border-color: var(--green); background: var(--green-light); }
    .photo-drop i { font-size: 26px; color: var(--green); margin-bottom: 8px; display: block; }
    .photo-drop span { font-size: 13px; color: var(--muted); }
    .photo-count { font-size: 12.5px; font-weight: 700; color: var(--ink-mid); margin-top: 14px; }
    .photo-progress-wrap { display: none; margin-top: 14px; }
    .photo-progress-text { font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
    .photo-progress-track { height: 6px; background: var(--bg2); border-radius: 3px; overflow: hidden; }
    .photo-progress-bar { height: 100%; width: 0%; background: var(--green); border-radius: 3px; transition: width .25s ease; }
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px; margin-top: 12px; }
    .photo-thumb { position: relative; aspect-ratio: 1; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); }
    .photo-thumb.is-cover { border: 2px solid var(--green); }
    .photo-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .photo-thumb .cover-tag { position: absolute; bottom: 4px; left: 4px; background: var(--green); color: #fff; font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 6px; display: flex; align-items: center; gap: 3px; }
    .photo-thumb .cover-btn { position: absolute; bottom: 4px; left: 4px; background: rgba(0,0,0,.6); color: #fff; border: none; font-size: 9px; font-weight: 700; padding: 3px 7px; border-radius: 6px; cursor: pointer; opacity: 0; transition: opacity .15s; }
    .photo-thumb:hover .cover-btn, .photo-thumb .cover-btn:focus-visible { opacity: 1; }
    /* Accessibility audit (Phase 7): a hover-only reveal is unusable for
       keyboard users (they can tab to it but never see it, only fixed
       above for :focus-visible) and for any touch device (no hover event
       at all) — so on a device with no real hover, show it always. */
    @media (hover: none) { .photo-thumb .cover-btn { opacity: 1; } }
    .photo-thumb .cover-btn:focus-visible, .photo-drop:focus-visible { outline: 2.5px solid var(--green); outline-offset: 2px; }
    .photo-thumb .rm-btn { position: absolute; top: 4px; right: 4px; width: 20px; height: 20px; border-radius: 50%; background: rgba(0,0,0,.6); color: #fff; border: none; font-size: 11px; cursor: pointer; }

    /* Preview card (step 6) */
    .preview-card { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 20px; }
    .preview-img { aspect-ratio: 16/9; background: var(--bg2); position: relative; }
    .preview-img img { width: 100%; height: 100%; object-fit: cover; }
    .preview-badge { position: absolute; top: 10px; left: 10px; background: rgba(9,184,80,.92); color: #fff; font-size: 11px; font-weight: 800; padding: 4px 10px; border-radius: 999px; }
    .preview-body { padding: 16px; }
    .preview-body .pv-title { font-family: var(--font-d); font-weight: 700; font-size: 15px; color: var(--ink); }
    .preview-body .pv-loc { font-size: 12.5px; color: var(--muted); margin-top: 3px; }
    .preview-body .pv-price { font-family: var(--font-d); font-weight: 700; font-size: 17px; color: var(--ink); margin-top: 10px; }
    .preview-body .pv-meta { font-size: 12px; color: var(--muted); margin-top: 4px; }
    .preview-body .pv-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
    .preview-body .pv-tags span { background: var(--bg2); color: var(--ink-mid); font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 999px; }

    .wiz-nav { display: flex; align-items: center; justify-content: space-between; margin-top: 26px; gap: 10px; }
    .wiz-btn { padding: 12px 22px; border-radius: 999px; font-size: 13.5px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
    .wiz-btn.primary { background: linear-gradient(135deg, var(--green), #00c264); color: #fff; box-shadow: var(--shadow-green); }
    .wiz-btn.ghost { background: var(--bg2); color: var(--ink-mid); }
    .wiz-btn.link { background: none; color: var(--muted); font-weight: 600; }
    .wiz-btn:disabled { opacity: .5; cursor: not-allowed; }
    .wiz-errors { background: #fef2f2; border: 1px solid #fecaca; color: #c53030; border-radius: 12px; padding: 12px 16px; font-size: 13px; margin-bottom: 16px; display: none; }
    .wiz-errors.show { display: block; }
    .wiz-errors ul { margin: 4px 0 0 18px; padding: 0; }
  </style>
</head>
<body>

<%- include("../includes/navbar-user.ejs") %>

<div class="wiz-wrap">
  <div class="wiz-head">
    <h1>List Your Flat. Find Your Flatmate.</h1>
    <p>List your available room or flat and connect directly with verified users.</p>
  </div>

  <div class="wiz-progress" id="wizProgress">
    <% ["Flat","Location","Rent","Preferences","Photos","Review"].forEach(function(label, i){ %>
      <div class="pstep <%= i===0?'active':'' %>" data-pstep="<%= i+1 %>">
        <div class="circ"><%= i+1 %></div>
        <div class="plabel"><%= label %></div>
      </div>
      <% if (i < 5) { %><div class="pline"></div><% } %>
    <% }) %>
  </div>

  <div class="wiz-errors" id="wizErrors"><strong>Please fix the following:</strong><ul id="wizErrorList"></ul></div>

  <form class="wiz-card" id="haveForm">
    <input type="hidden" name="type" value="have">
    <input type="hidden" name="draftId" id="draftIdField" value="<%= draft ? draft._id : '' %>">
    <input type="hidden" name="clientRequestId" id="clientRequestIdField" value="<%= draft && draft.clientRequestId ? draft.clientRequestId : '' %>">

    <!-- STEP 1 — Flat -->
    <div class="wiz-step active" data-step="1">
      <h2>Flat details</h2>
      <p class="step-sub">Tell us about the flat you're offering.</p>

      <div class="field">
        <label>Flat type <span style="color:#e53e3e">*</span></label>
        <div class="chips" data-chip-group="bhk" data-required="true">
          <% [["1","1 BHK"],["2","2 BHK"],["3","3 BHK"],["4","4+ BHK"]].forEach(function(o){ %>
            <div class="chip <%= draft && String(draft.bhk)===o[0] ? 'selected' : '' %>" data-value="<%= o[0] %>"><%= o[1] %></div>
          <% }) %>
        </div>
        <input type="hidden" name="bhk" id="bhkInput" value="<%= draft ? draft.bhk : '' %>">
      </div>

      <div class="field">
        <label>Room being offered <span style="color:#e53e3e">*</span></label>
        <div class="chips" data-chip-group="roomType" data-required="true">
          <% ["Private Room","Shared Room"].forEach(function(o){ %>
            <div class="chip <%= draft && draft.roomType===o ? 'selected' : '' %>" data-value="<%= o %>"><%= o %></div>
          <% }) %>
        </div>
        <input type="hidden" name="roomType" id="roomTypeInput" value="<%= draft ? draft.roomType : '' %>">
      </div>

      <div class="field">
        <label>What is available? <span style="color:#e53e3e">*</span></label>
        <div class="chips" data-chip-group="availabilityType" data-required="true">
          <% ["Room","Bed/Spot","Entire Flat"].forEach(function(o){ %>
            <div class="chip <%= draft && draft.have && draft.have.availabilityType===o ? 'selected' : '' %>" data-value="<%= o %>"><%= o %></div>
          <% }) %>
        </div>
        <input type="hidden" name="availabilityType" id="availabilityTypeInput" value="<%= draft && draft.have ? draft.have.availabilityType||'' : '' %>">
      </div>

      <div class="row-2">
        <div class="field">
          <label>Number of available spots</label>
          <select name="availableSpots">
            <option value="1" <%= draft && draft.have && draft.have.availableSpots===1?'selected':'' %>>1</option>
            <option value="2" <%= draft && draft.have && draft.have.availableSpots===2?'selected':'' %>>2</option>
            <option value="3" <%= draft && draft.have && draft.have.availableSpots===3?'selected':'' %>>3</option>
            <option value="4" <%= draft && draft.have && draft.have.availableSpots>=4?'selected':'' %>>4+</option>
          </select>
        </div>
        <div class="field">
          <label>Furnishing</label>
          <select name="furnishing">
            <option value="">Select (optional)</option>
            <option value="Fully Furnished">Fully Furnished</option>
            <option value="Semi Furnished">Semi Furnished</option>
            <option value="Unfurnished">Unfurnished</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label>Available from</label>
        <div class="radio-group">
          <label class="radio-opt"><input type="radio" name="availableFromMode" value="now" checked onchange="toggleAvailDate()"> Available Now</label>
          <label class="radio-opt"><input type="radio" name="availableFromMode" value="date" onchange="toggleAvailDate()"> Specific Date</label>
        </div>
        <div class="field" id="availDateWrap" style="display:none; margin-top:10px;">
          <input type="date" name="availableFromDate">
        </div>
      </div>

      <div class="field">
        <label>Description <span style="font-weight:400;color:var(--muted-light)">(optional, max 500 characters)</span></label>
        <textarea name="description" rows="3" maxlength="500" placeholder="e.g. Fully furnished 2 BHK near Powai Lake and Hiranandani."></textarea>
      </div>
    </div>

    <!-- STEP 2 — Location -->
    <div class="wiz-step" data-step="2">
      <h2>Location</h2>
      <p class="step-sub">We'll only show your city and area publicly — your exact address stays private until you accept a connection request.</p>

      <div class="row-2">
        <div class="field">
          <label>City <span style="color:#e53e3e">*</span></label>
          <select name="city" required>
            <option value="">Select city</option>
            <% cities.forEach(function(c){ %>
              <option value="<%= c %>" <%= draft && draft.city===c ? 'selected':'' %>><%= c %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label>Area / Locality <span style="color:#e53e3e">*</span></label>
          <input type="text" name="area" placeholder="e.g. Powai" value="<%= draft ? draft.area||'' : '' %>" required>
        </div>
      </div>

      <div class="row-2">
        <div class="field">
          <label>Nearby landmark <span style="font-weight:400;color:var(--muted-light)">(optional)</span></label>
          <input type="text" name="landmark" placeholder="e.g. Near Hiranandani Gardens">
        </div>
        <div class="field">
          <label>Nearest college/office area <span style="font-weight:400;color:var(--muted-light)">(optional)</span></label>
          <input type="text" name="nearCollege" placeholder="e.g. IIT Bombay">
        </div>
      </div>

      <div class="field">
        <label>Full address <span style="font-weight:400;color:var(--muted-light)">(private — only shared after you accept a connection)</span></label>
        <textarea name="address" rows="2" placeholder="Flat/House no., building, street..."></textarea>
        <div class="hint"><i class="fa-solid fa-lock"></i> This is never shown on your public listing.</div>
      </div>

      <div class="field">
        <label>Property Location <span style="font-weight:400;color:var(--muted-light)">(optional, but strongly recommended — helps flatmates find you)</span></label>
        <input type="text" id="pinSearchBox" placeholder="Search for your building or area…">
        <div id="pinMapUnavailable" class="pin-map-unavailable" style="display:none">
          <i class="fa-solid fa-map"></i>
          <p>Map is temporarily unavailable — you can still publish without a pinned location.</p>
        </div>
        <div id="pinMap" class="pin-map"></div>
        <div class="hint"><i class="fa-solid fa-arrows-up-down-left-right"></i> Drag the pin to fine-tune the exact spot. Only the approximate area is ever shown publicly.</div>
        <input type="hidden" name="lat" id="pinLat" value="<%= draft && draft.coordinates ? draft.coordinates.lat||'' : '' %>">
        <input type="hidden" name="lng" id="pinLng" value="<%= draft && draft.coordinates ? draft.coordinates.lng||'' : '' %>">
        <input type="hidden" name="placeId" id="pinPlaceId" value="<%= draft ? draft.placeId||'' : '' %>">
      </div>
    </div>

    <!-- STEP 3 — Rent -->
    <div class="wiz-step" data-step="3">
      <h2>Rent &amp; money</h2>
      <p class="step-sub">Keep it simple — the public card only shows the monthly rent.</p>

      <div class="row-2">
        <div class="field">
          <label>Monthly rent per person <span style="color:#e53e3e">*</span></label>
          <input type="number" name="rentMonthly" placeholder="e.g. 12500" min="0" value="<%= draft && draft.have ? draft.have.rentMonthly||'' : '' %>" required>
        </div>
        <div class="field">
          <label>Security deposit</label>
          <input type="number" name="depositAmount" placeholder="e.g. 25000" min="0" id="depositAmountInput">
          <div class="checkbox-row">
            <input type="checkbox" name="depositNegotiable" id="depositNegotiable" onchange="document.getElementById('depositAmountInput').disabled=this.checked">
            <label for="depositNegotiable" style="margin:0;font-weight:500">Negotiable</label>
          </div>
        </div>
      </div>

      <div class="field">
        <label>Maintenance</label>
        <div class="radio-group">
          <label class="radio-opt"><input type="radio" name="maintenance" value="Included" checked onchange="toggleMaintenance()"> Included</label>
          <label class="radio-opt"><input type="radio" name="maintenance" value="Separate" onchange="toggleMaintenance()"> Separate</label>
        </div>
        <div class="field" id="maintenanceAmountWrap" style="display:none; margin-top:10px;">
          <input type="number" name="maintenanceAmount" placeholder="Maintenance amount" min="0">
        </div>
      </div>
    </div>

    <!-- STEP 4 — Amenities & Preferences -->
    <div class="wiz-step" data-step="4">
      <h2>Amenities &amp; flatmate preferences</h2>
      <p class="step-sub">These help the right flatmate find you — not a dating profile, just accommodation compatibility.</p>

      <div class="field">
        <label>Amenities</label>
        <%
          const amenityIcons = {
            'WiFi': 'wifi', 'AC': 'snowflake', 'Washing Machine': 'shirt', 'Geyser': 'fire-flame-simple',
            'Refrigerator': 'kitchen-set', 'Bed': 'bed', 'Wardrobe': 'box-archive', 'Study Table': 'book',
            'Sofa': 'couch', 'Dining Table': 'utensils', 'TV': 'tv', 'Microwave': 'kitchen-set',
            'RO Water': 'droplet', 'Power Backup': 'bolt', 'Lift': 'elevator', 'Parking': 'car',
            'CCTV': 'camera', 'Security': 'shield-halved', 'Balcony': 'building', 'Gym': 'dumbbell',
            'Swimming Pool': 'person-swimming', 'Housekeeping': 'broom',
          };
        %>
        <div class="chips" data-chip-group="amenities" data-multi="true">
          <% ["WiFi","AC","Washing Machine","Geyser","Refrigerator","Bed","Wardrobe","Study Table","Sofa","Dining Table","TV","Microwave","RO Water","Power Backup","Lift","Parking","CCTV","Security","Balcony","Gym","Swimming Pool","Housekeeping"].forEach(function(a){ %>
            <div class="chip" data-value="<%= a %>"><i class="fa-solid fa-<%= amenityIcons[a] || 'check' %>" aria-hidden="true"></i> <%= a %></div>
          <% }) %>
        </div>
        <input type="hidden" name="amenities[]" id="amenitiesInput" value="">
      </div>

      <div class="field">
        <label>Preferred gender</label>
        <div class="radio-group">
          <label class="radio-opt"><input type="radio" name="preferredGender" value="Male"> Male</label>
          <label class="radio-opt"><input type="radio" name="preferredGender" value="Female"> Female</label>
          <label class="radio-opt"><input type="radio" name="preferredGender" value="No Preference" checked> No Preference</label>
        </div>
      </div>

      <div class="row-2">
        <div class="field">
          <label>Suitable for</label>
          <select name="occupation">
            <option value="">No preference</option>
            <option value="Student">Students</option>
            <option value="Working Professional">Working Professionals</option>
            <option value="Intern">Interns</option>
            <option value="Other">Anyone</option>
          </select>
        </div>
        <div class="field">
          <label>Food preference</label>
          <select name="food">
            <option value="No Preference">No Preference</option>
            <option value="Vegetarian">Vegetarian</option>
            <option value="Non-Vegetarian">Non-Vegetarian</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label>Lifestyle <span style="font-weight:400;color:var(--muted-light)">(optional)</span></label>
        <div class="chips" data-chip-group="lifestyle" data-multi="true">
          <% ["Non-Smoker","Non-Drinker","No Pets","Pet Friendly","Quiet Lifestyle","Social","Early Riser","Night Owl","No Overnight Guests"].forEach(function(l){ %>
            <div class="chip" data-value="<%= l %>"><%= l %></div>
