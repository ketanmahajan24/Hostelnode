        <div class="photo-progress-track"><div class="photo-progress-bar" id="photoProgressBar"></div></div>
      </div>

      <div class="photo-count" id="photoCount">0 / 15 photos added</div>
      <div class="photo-grid" id="photoGrid"></div>
      <p class="step-sub" style="margin-top:10px;margin-bottom:0;">Hover a photo and tap <b>Set Cover</b> to choose which one shows first on your listing card.</p>
    </div>

    <!-- STEP 6 — Contact & Review -->
    <div class="wiz-step" data-step="6">
      <h2>Contact &amp; review</h2>
