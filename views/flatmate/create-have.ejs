            <span class="verified-tag">Verified</span>
          </div>
          <div class="hint">This is your account's verified number and can't be changed here.</div>
        </div>
        <div class="field">
          <label>WhatsApp</label>
          <input type="text" name="whatsapp" id="whatsappInput" placeholder="10-digit WhatsApp number" maxlength="10" disabled>
          <div class="checkbox-row">
            <input type="checkbox" id="sameAsPhone" name="sameAsPhone" checked onchange="toggleSamePhone()">
            <label for="sameAsPhone" style="margin:0;font-weight:500">Same as verified mobile</label>
          </div>
        </div>
      </div>

      <div class="field">
        <label>Preferred contact method</label>
        <select name="preferredMethod">
          <option value="HostelNode Messages">HostelNode Messages</option>
          <option value="WhatsApp">WhatsApp</option>
          <option value="Both">Both</option>
        </select>
      </div>

      <div class="row-2">
        <div class="field">
          <label>Company <span style="font-weight:400;color:var(--muted-light)">(optional)</span></label>
          <input type="text" name="company" placeholder="e.g. TCS">
        </div>
        <div class="field">
          <label>College <span style="font-weight:400;color:var(--muted-light)">(optional)</span></label>
          <input type="text" name="college" placeholder="e.g. IIT Bombay">
        </div>
      </div>

      <h2 style="margin-top:8px">Listing preview</h2>
      <div class="preview-card">
        <div class="preview-img">
          <img id="pvImg" src="/images/placeholder.jpg" alt="Preview">
          <span class="preview-badge">🏠 FLAT</span>
        </div>
        <div class="preview-body">
          <div class="pv-title" id="pvTitle">— BHK · —</div>
          <div class="pv-loc" id="pvLoc">—</div>
          <div class="pv-price" id="pvPrice">₹—/month</div>
          <div class="pv-meta" id="pvMeta">Available from —</div>
          <div class="pv-tags" id="pvTags"></div>
        </div>
      </div>
    </div>

    <div class="wiz-nav">
      <div>
        <button type="button" class="wiz-btn ghost" id="btnBack" onclick="wizBack()" style="display:none"><i class="fa-solid fa-arrow-left"></i> Back</button>
      </div>
      <div style="display:flex; gap:10px; align-items:center;">
        <button type="button" class="wiz-btn link" onclick="saveDraft()"><i class="fa-regular fa-floppy-disk"></i> Save Draft</button>
        <button type="button" class="wiz-btn primary" id="btnNext" onclick="wizNext()">Next <i class="fa-solid fa-arrow-right"></i></button>
        <button type="button" class="wiz-btn primary" id="btnPublish" onclick="publishListing()" style="display:none">Publish Listing <i class="fa-solid fa-check"></i></button>
      </div>
    </div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
const TOTAL_STEPS = 6;
let currentStep = 1;
const DRAFT_DATA = <%- JSON.stringify(draft || null).replace(/</g, "\\u003c") %>;

/* ── Chip selectors (single + multi) ──
   FIX: multi-select used to join selected values into ONE comma-string in
   a single hidden input (e.g. "WiFi,AC,Washing Machine"). Since only one
   input existed, the server received a single string, not an array — it
   got saved as ONE array element containing the whole joined string,
   which is why amenity labels showed up merged together with no icon
   match. Now emits one hidden input per selected value, all sharing the
   same name, which is what the backend's array parsing actually expects. */
document.querySelectorAll('[data-chip-group]').forEach(function(group) {
  const isMulti = group.dataset.multi === 'true';
  const hiddenInput = document.getElementById(group.dataset.chipGroup + 'Input');
  const inputName = hiddenInput ? hiddenInput.name : null;

  function syncMultiHiddenInputs() {
    if (!hiddenInput || !inputName) return;
    const values = [...group.querySelectorAll('.chip.selected')].map(c => c.dataset.value);
    // Remove any previously-created extra hidden inputs for this field.
    document.querySelectorAll('input[data-multi-for="' + group.dataset.chipGroup + '"]').forEach(el => el.remove());
    // The original static input carries the first value (or empty); every
    // additional selected value gets its own sibling hidden input.
    hiddenInput.value = values[0] || '';
    for (let i = 1; i < values.length; i++) {
      const extra = document.createElement('input');
      extra.type = 'hidden';
      extra.name = inputName;
      extra.value = values[i];
      extra.setAttribute('data-multi-for', group.dataset.chipGroup);
      hiddenInput.insertAdjacentElement('afterend', extra);
    }
  }

  group.querySelectorAll('.chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      if (isMulti) {
        chip.classList.toggle('selected');
        syncMultiHiddenInputs();
      } else {
        group.querySelectorAll('.chip').forEach(c => c.classList.remove('selected'));
        chip.classList.add('selected');
        if (hiddenInput) hiddenInput.value = chip.dataset.value;
      }
    });
  });

  // Expose for hydrateForm() to call after pre-selecting chips on edit.
  group._syncMultiHiddenInputs = syncMultiHiddenInputs;
});

function toggleAvailDate() {
  document.getElementById('availDateWrap').style.display =
    document.querySelector('input[name="availableFromMode"]:checked').value === 'date' ? 'block' : 'none';
}
function toggleMaintenance() {
  document.getElementById('maintenanceAmountWrap').style.display =
    document.querySelector('input[name="maintenance"]:checked').value === 'Separate' ? 'block' : 'none';
}
function toggleSamePhone() {
  const same = document.getElementById('sameAsPhone').checked;
  document.getElementById('whatsappInput').disabled = same;
  if (same) document.getElementById('whatsappInput').value = '';
}

/* ── Wizard navigation ── */
function showStep(n) {
  document.querySelectorAll('.wiz-step').forEach(s => s.classList.toggle('active', parseInt(s.dataset.step) === n));
  document.querySelectorAll('.pstep').forEach(function(p) {
    const idx = parseInt(p.dataset.pstep);
    p.classList.toggle('active', idx === n);
    p.classList.toggle('done', idx < n);
  });
  document.getElementById('btnBack').style.display = n > 1 ? 'inline-flex' : 'none';
  document.getElementById('btnNext').style.display = n < TOTAL_STEPS ? 'inline-flex' : 'none';
  document.getElementById('btnPublish').style.display = n === TOTAL_STEPS ? 'inline-flex' : 'none';
  if (n === TOTAL_STEPS) updatePreview();
  if (n === 2) onLocationStepShown();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function validateStep(n) {
  const errors = [];
  if (n === 1) {
    if (!document.getElementById('bhkInput').value) errors.push('Please select a flat type.');
    if (!document.getElementById('roomTypeInput').value) errors.push('Please select the room being offered.');
    if (!document.getElementById('availabilityTypeInput').value) errors.push("Please select what's available.");
  }
  if (n === 2) {
    if (!document.querySelector('[name="city"]').value) errors.push('Please select a city.');
    if (!document.querySelector('[name="area"]').value.trim()) errors.push('Please enter an area/locality.');
  }
  if (n === 3) {
    if (!document.querySelector('[name="rentMonthly"]').value) errors.push('Please enter the monthly rent.');
  }
  if (n === 6) {
    if (totalPhotoCount() === 0) errors.push('Please add at least 1 photo (3+ recommended).');
  }
  return errors;
}

function showErrors(errors) {
  const box = document.getElementById('wizErrors');
  const list = document.getElementById('wizErrorList');
  if (!errors.length) { box.classList.remove('show'); return; }
  list.innerHTML = errors.map(e => `<li>${e}</li>`).join('');
  box.classList.add('show');
  box.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function wizNext() {
  const errors = validateStep(currentStep);
  if (errors.length) { showErrors(errors); return; }
  showErrors([]);
  currentStep = Math.min(currentStep + 1, TOTAL_STEPS);
  showStep(currentStep);
}
function wizBack() {
  currentStep = Math.max(currentStep - 1, 1);
  showStep(currentStep);
}

/* ── Preview (step 6) ── */
function updatePreview() {
  const bhk = document.getElementById('bhkInput').value;
  const roomType = document.getElementById('roomTypeInput').value;
  const area = document.querySelector('[name="area"]').value || '—';
  const city = document.querySelector('[name="city"]').value || '—';
  const rent = document.querySelector('[name="rentMonthly"]').value || '—';
  const availMode = document.querySelector('input[name="availableFromMode"]:checked').value;
  const availDate = document.querySelector('[name="availableFromDate"]').value;

  document.getElementById('pvTitle').textContent = `${bhk || '—'} BHK · ${roomType || '—'}`;
  document.getElementById('pvLoc').textContent = `${area}, ${city}`;
  document.getElementById('pvPrice').textContent = `₹${Number(rent).toLocaleString('en-IN')}/month`;
  document.getElementById('pvMeta').textContent = 'Available ' + (availMode === 'now' ? 'now' : (availDate ? 'from ' + availDate : 'soon'));

  const gender = document.querySelector('input[name="preferredGender"]:checked')?.value || 'No Preference';
  const occupation = document.querySelector('[name="occupation"]').selectedOptions[0]?.text || '';
  document.getElementById('pvTags').innerHTML = [gender, occupation].filter(Boolean).map(t => `<span>${t}</span>`).join('');

  const coverUrl = getCoverPreviewUrl();
  if (coverUrl) document.getElementById('pvImg').src = coverUrl;
}

/* ============================================================
   ★ IMAGE COMPRESSION — ported as-is from the PG listing upload
   flow (views/listings/listproperty.ejs), which already handles
   this correctly: canvas-based, WebP, ≤1280px, quality 0.82.
   Runs entirely in the browser; falls back to the original file
   on any failure so a compression problem never blocks upload
   (and never shows as a fake "Network Error" — see addFiles()).
============================================================ */
const MAX_IMAGES       = 15;
const MAX_IMG_MB       = 5;
const ALLOWED_TYPES    = ['image/jpeg', 'image/png', 'image/webp'];
const COMPRESS_MAX_W   = 1280;
const COMPRESS_MAX_H   = 1280;
const COMPRESS_QUALITY = 0.82;
const COMPRESS_FORMAT  = 'image/webp';

function compressImage(file) {
  return new Promise((resolve) => {
    const img = new Image();
    const objectUrl = URL.createObjectURL(file);
    img.onerror = () => { URL.revokeObjectURL(objectUrl); resolve(file); };
    img.onload = () => {
      URL.revokeObjectURL(objectUrl);
      let { width, height } = img;
      if (width > COMPRESS_MAX_W || height > COMPRESS_MAX_H) {
        const ratio = Math.min(COMPRESS_MAX_W / width, COMPRESS_MAX_H / height);
        width = Math.round(width * ratio);
        height = Math.round(height * ratio);
      }
      const canvas = document.createElement('canvas');
      canvas.width = width; canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, 0, 0, width, height);
      canvas.toBlob((blob) => {
        if (!blob) { resolve(file); return; }
        const newName = file.name.replace(/\.[^.]+$/, '') + '.webp';
        resolve(new File([blob], newName, { type: COMPRESS_FORMAT, lastModified: Date.now() }));
      }, COMPRESS_FORMAT, COMPRESS_QUALITY);
    };
    img.src = objectUrl;
  });
}

/* ── Photo upload — existing (already-saved) + new (this session) photos,
   combined into one grid with an explicit cover-image picker. ──

   existingImages : [{ filename, url }]   — hydrated from the draft on edit
   newFiles       : [{ file, localId, previewUrl }] — this session's uploads
   coverRef       : { type:'existing', filename } | { type:'new', localId } | null
*/
const photoDrop = document.getElementById('photoDrop');
const photoInput = document.getElementById('photoInput');
const photoGrid = document.getElementById('photoGrid');
const photoCountEl = document.getElementById('photoCount');
const photoProgressWrap = document.getElementById('photoProgressWrap');
const photoProgressBar = document.getElementById('photoProgressBar');
const photoProgressText = document.getElementById('photoProgressText');

let existingImages = [];
let newFiles = [];
let coverRef = null;
let removedExistingFilenames = [];
let newFileLocalIdCounter = 0;

photoInput.addEventListener('change', e => { addFiles(e.target.files); photoInput.value = ''; });
['dragover','dragenter'].forEach(evt => photoDrop.addEventListener(evt, e => { e.preventDefault(); photoDrop.classList.add('dragover'); }));
['dragleave','drop'].forEach(evt => photoDrop.addEventListener(evt, e => { e.preventDefault(); photoDrop.classList.remove('dragover'); }));
photoDrop.addEventListener('drop', e => addFiles(e.dataTransfer.files));

function totalPhotoCount() {
  return existingImages.length + newFiles.length;
}

async function addFiles(fileList) {
  const incoming = Array.from(fileList || []);
  if (!incoming.length) return;

  const total = totalPhotoCount();
  const slots = Math.max(0, MAX_IMAGES - total);

  if (slots === 0) {
    showErrors([`Maximum ${MAX_IMAGES} photos are allowed per listing. Remove a photo to add more.`]);
    return;
  }

  const accepted = [];
  const skipped = [];
  incoming.forEach(file => {
    if (!ALLOWED_TYPES.includes(file.type)) { skipped.push(`"${file.name}" — please upload JPG, PNG or WebP images.`); return; }
    if (file.size > MAX_IMG_MB * 1024 * 1024) { skipped.push(`"${file.name}" — this image could not be processed. Please choose another image.`); return; }
    accepted.push(file);
  });

  const toProcess = accepted.slice(0, slots);
  const overflow = accepted.length - toProcess.length;

  const errs = [];
  if (skipped.length) errs.push(...skipped.slice(0, 3));
  if (overflow > 0) errs.push(`You can add only ${slots} more photo${slots === 1 ? '' : 's'}. Maximum ${MAX_IMAGES} photos per listing.`);
  if (errs.length) showErrors(errs); else showErrors([]);

  if (!toProcess.length) return;

  photoProgressWrap.style.display = 'block';
  photoProgressBar.style.width = '0%';
  photoProgressText.textContent = `Optimizing ${toProcess.length} photo${toProcess.length > 1 ? 's' : ''}…`;

  for (let i = 0; i < toProcess.length; i++) {
    let compressed;
    try {
      compressed = await compressImage(toProcess[i]);
    } catch (e) {
      // Compression genuinely failed (not a network issue) — fall back to
      // the original file rather than blocking or misreporting the error.
      compressed = toProcess[i];
    }
    const localId = ++newFileLocalIdCounter;
    newFiles.push({ file: compressed, localId, previewUrl: URL.createObjectURL(compressed) });
    if (!coverRef) coverRef = { type: 'new', localId }; // first photo ever added becomes cover by default
    photoProgressBar.style.width = Math.round(((i + 1) / toProcess.length) * 100) + '%';
    photoProgressText.textContent = `Optimizing… ${i + 1} / ${toProcess.length} done`;
  }

  setTimeout(() => { photoProgressWrap.style.display = 'none'; }, 500);
  renderPhotoGrid();
}

function removeExistingPhoto(filename) {
  existingImages = existingImages.filter(img => img.filename !== filename);
  removedExistingFilenames.push(filename);
  if (coverRef && coverRef.type === 'existing' && coverRef.filename === filename) coverRef = null;
  reassignCoverIfNeeded();
  renderPhotoGrid();
}

function removeNewPhoto(localId) {
  const item = newFiles.find(f => f.localId === localId);
  if (item) URL.revokeObjectURL(item.previewUrl);
  newFiles = newFiles.filter(f => f.localId !== localId);
  if (coverRef && coverRef.type === 'new' && coverRef.localId === localId) coverRef = null;
  reassignCoverIfNeeded();
  renderPhotoGrid();
}

function reassignCoverIfNeeded() {
  if (coverRef) return;
  if (existingImages.length) coverRef = { type: 'existing', filename: existingImages[0].filename };
  else if (newFiles.length) coverRef = { type: 'new', localId: newFiles[0].localId };
}

function setCoverExisting(filename) { coverRef = { type: 'existing', filename }; renderPhotoGrid(); }
function setCoverNew(localId) { coverRef = { type: 'new', localId }; renderPhotoGrid(); }

function isCover(ref) {
  if (!coverRef || !ref) return false;
  if (coverRef.type !== ref.type) return false;
  return coverRef.type === 'existing' ? coverRef.filename === ref.filename : coverRef.localId === ref.localId;
}

function getCoverPreviewUrl() {
  if (coverRef && coverRef.type === 'existing') {
    const found = existingImages.find(img => img.filename === coverRef.filename);
    if (found) return found.url;
  }
  if (coverRef && coverRef.type === 'new') {
    const found = newFiles.find(f => f.localId === coverRef.localId);
    if (found) return found.previewUrl;
  }
  if (existingImages.length) return existingImages[0].url;
  if (newFiles.length) return newFiles[0].previewUrl;
  return null;
}

function renderPhotoGrid() {
  photoCountEl.textContent = `${totalPhotoCount()} / ${MAX_IMAGES} photos added`;
  photoGrid.innerHTML = '';

  existingImages.forEach(img => {
    const ref = { type: 'existing', filename: img.filename };
    const cover = isCover(ref);
    const div = document.createElement('div');
    div.className = 'photo-thumb' + (cover ? ' is-cover' : '');
    div.innerHTML = `<img src="${img.url}" alt="Listing photo">` +
      (cover ? `<span class="cover-tag"><i class="fa-solid fa-star"></i> Cover</span>` : `<button type="button" class="cover-btn" onclick="setCoverExisting('${img.filename}')">Set Cover</button>`) +
      `<button type="button" class="rm-btn" onclick="removeExistingPhoto('${img.filename}')" aria-label="Remove photo">✕</button>`;
    photoGrid.appendChild(div);
  });

  newFiles.forEach(item => {
    const ref = { type: 'new', localId: item.localId };
    const cover = isCover(ref);
    const div = document.createElement('div');
    div.className = 'photo-thumb' + (cover ? ' is-cover' : '');
    div.innerHTML = `<img src="${item.previewUrl}" alt="New listing photo">` +
      (cover ? `<span class="cover-tag"><i class="fa-solid fa-star"></i> Cover</span>` : `<button type="button" class="cover-btn" onclick="setCoverNew(${item.localId})">Set Cover</button>`) +
      `<button type="button" class="rm-btn" onclick="removeNewPhoto(${item.localId})" aria-label="Remove photo">✕</button>`;
    photoGrid.appendChild(div);
  });
}

/* ── Build FormData from the whole form + photo state ── */
function buildFormData() {
  const form = document.getElementById('haveForm');
  const fd = new FormData(form);
  newFiles.forEach(item => fd.append('photos', item.file));
  // Tells the backend exactly which already-saved images survive this
  // save — anything previously on the listing but missing from this list
  // is being removed. Omitted entirely for a brand-new listing (no
  // existing images to begin with).
  fd.append('keepImages', JSON.stringify(existingImages.map(img => img.filename)));
  // "NEW:<index>" = the Nth file in this request's `photos`; otherwise an
  // existing filename that's still being kept.
  if (coverRef && coverRef.type === 'new') {
    const idx = newFiles.findIndex(f => f.localId === coverRef.localId);
    if (idx > -1) fd.append('coverImage', `NEW:${idx}`);
  } else if (coverRef && coverRef.type === 'existing') {
    fd.append('coverImage', coverRef.filename);
  }
  return fd;
}

/* ── Submit helper — distinguishes a genuine network/connectivity failure
   (fetch() itself throws: offline, DNS, CORS, timeout) from a server
   response that just isn't valid JSON (a 500 with an HTML error page, a
   proxy error page, etc.) or a well-formed error response. Only the first
   case is an actual "network error" — the second is a real server-side
   failure and should say so, and the third already carries its own
   specific message. Previously a single catch-all turned ALL of these
   into "Network Error", which is exactly what issue 11.18/Problem E
   flagged. ── */
async function submitListingForm(url) {
  let res;
  try {
    res = await fetch(url, { method: 'POST', body: buildFormData() });
  } catch (networkErr) {
    return { networkFailure: true };
  }
  let data;
  try {
    data = await res.json();
  } catch (parseErr) {
    return {
      networkFailure: false,
      data: {
        success: false,
        error: res.status >= 500
          ? 'Something went wrong on our end while saving your listing. Please try again.'
          : 'Unexpected response from the server. Please try again.',
      },
    };
  }
  return { networkFailure: false, data };
}

/* ── Save draft ── */
async function saveDraft() {
  const btn = event.target.closest('button');
  const original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Saving…';

  const { networkFailure, data } = await submitListingForm('/flatmate/create/draft');
  btn.disabled = false; btn.innerHTML = original;

  if (networkFailure) {
    showErrors(['Upload failed. Please check your connection and try again.']);
    return;
  }
  if (data.success) {
    document.getElementById('draftIdField').value = data.draftId;
    showErrors([]);
    alert('Draft saved! You can come back to finish this listing anytime.');
  } else {
    showErrors([data.error || 'Could not save draft.']);
  }
}

/* ── Publish ──
   clientRequestId: one UUID generated the first time this listing is
   ever submitted, resent on every publish attempt for it (survives a
   draft save too — see hydrateForm). Lets the backend recognize a
   retried/duplicated submit and update the same listing instead of
   creating a second one, even before a draftId exists. See
   models/FlatmateListing.js's clientRequestId field. */
function getOrCreateClientRequestId() {
  const field = document.getElementById('clientRequestIdField');
  if (field.value) return field.value;
  const id = (window.crypto && crypto.randomUUID) ? crypto.randomUUID() : ('cr-' + Date.now() + '-' + Math.random().toString(36).slice(2));
  field.value = id;
  return id;
}

async function publishListing() {
  const errors = validateStep(6);
  if (errors.length) { showErrors(errors); return; }

  getOrCreateClientRequestId();

  const btn = document.getElementById('btnPublish');
  const original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Publishing…';

  const { networkFailure, data } = await submitListingForm('/flatmate/create/publish');

  if (networkFailure) {
    btn.disabled = false; btn.innerHTML = original;
    showErrors(['Upload failed. Please check your connection and try again.']);
    return;
  }
  if (data.success) {
    window.location.href = data.redirect;
  } else {
    btn.disabled = false; btn.innerHTML = original;
    showErrors(data.errors || [data.error || 'Something went wrong. Please try again.']);
    if (data.draftId) document.getElementById('draftIdField').value = data.draftId;
  }
}

/* ── HYDRATE FORM FROM EXISTING DRAFT/LISTING ── */
function setChipSelected(groupName, value) {
  const group = document.querySelector('[data-chip-group="' + groupName + '"]');
  const hidden = document.getElementById(groupName + 'Input');
  if (!group || value === undefined || value === null || value === '') return;
  group.querySelectorAll('.chip').forEach(function (chip) {
    if (chip.dataset.value === String(value)) chip.classList.add('selected');
  });
  if (hidden) hidden.value = value;
}
function setMultiChipSelected(groupName, values) {
  const group = document.querySelector('[data-chip-group="' + groupName + '"]');
  if (!group || !Array.isArray(values) || !values.length) return;
  // Defensive: older listings may have been saved with the pre-fix bug,
  // where multiple selections got joined into one comma-string stored as
  // a single array element (e.g. ["WiFi,AC,Washing Machine"]). Split any
  // such entries apart so editing an old listing shows the real values.
  const flatValues = values.flatMap(v => typeof v === 'string' && v.includes(',') ? v.split(',').map(s => s.trim()) : [v]);
  group.querySelectorAll('.chip').forEach(function (chip) {
    if (flatValues.includes(chip.dataset.value)) chip.classList.add('selected');
  });
  if (group._syncMultiHiddenInputs) group._syncMultiHiddenInputs();
}
function setFieldValue(name, value) {
  if (value === undefined || value === null || value === '') return;
  const el = document.querySelector('[name="' + name + '"]');
  if (el) el.value = value;
}
function setRadioValue(name, value) {
  if (!value) return;
  const el = document.querySelector('input[name="' + name + '"][value="' + value + '"]');
  if (el) el.checked = true;
}

function hydrateForm(d) {
  if (!d) return;

  setChipSelected('bhk', d.bhk);
  setChipSelected('roomType', d.roomType);
  setChipSelected('availabilityType', d.have && d.have.availabilityType);
  setMultiChipSelected('amenities', d.have && d.have.amenities);
  setMultiChipSelected('lifestyle', d.lifestyle);

  setFieldValue('availableSpots', d.have && d.have.availableSpots);
  setFieldValue('furnishing', d.have && d.have.furnishing);
  setFieldValue('description', d.description);
  setFieldValue('city', d.city);
  setFieldValue('area', d.area);
  setFieldValue('landmark', d.landmark);
  setFieldValue('nearCollege', d.nearCollege);
  setFieldValue('address', d.address);
  setFieldValue('rentMonthly', d.have && d.have.rentMonthly);
  setFieldValue('occupation', d.occupation);
  setFieldValue('food', d.food);
  setFieldValue('occupantsCount', d.have && d.have.occupantsCount);
  setFieldValue('occupantsType', d.have && d.have.occupantsType);
  setFieldValue('company', d.about && d.about.company);
  setFieldValue('college', d.about && d.about.college);
  // phone is no longer a form field — always the account's verified number,
  // rendered server-side and never submitted/edited here
  // Real gap found in the Phase 7 hydration audit: this <select> was never
  // restored on edit, so it silently reset to the first option
  // ("HostelNode Messages") every time someone edited a listing where
  // they'd actually chosen WhatsApp or Both.
  setFieldValue('preferredMethod', d.contact && d.contact.preferredMethod);

  if (d.have) {
    if (!d.have.depositNegotiable) setFieldValue('depositAmount', d.have.depositAmount);
    else { document.getElementById('depositNegotiable').checked = true; document.getElementById('depositAmountInput').disabled = true; }

    if (d.have.availableFromMode === 'date' && d.have.availableFromDate) {
      setRadioValue('availableFromMode', 'date');
      setFieldValue('availableFromDate', new Date(d.have.availableFromDate).toISOString().slice(0, 10));
      toggleAvailDate();
    }

    setRadioValue('maintenance', d.have.maintenance);
    if (d.have.maintenance === 'Separate' && d.have.maintenanceAmount) {
      setFieldValue('maintenanceAmount', d.have.maintenanceAmount);
      toggleMaintenance();
    }
  }

  // Stored as lowercase male/female/any; the radio's values are capitalized labels.
  const genderLabel = { male: 'Male', female: 'Female', any: 'No Preference' }[d.gender];
  if (genderLabel) setRadioValue('preferredGender', genderLabel);

  const phone = (d.contact && d.contact.phone) || '';
  const whatsapp = (d.contact && d.contact.whatsapp) || '';
  if (whatsapp && whatsapp !== phone) {
    document.getElementById('sameAsPhone').checked = false;
    document.getElementById('whatsappInput').disabled = false;
    document.getElementById('whatsappInput').value = whatsapp;
  }

  // Existing pinned location (editing a listing that already has one) —
  // the hidden lat/lng/placeId inputs are already prefilled server-side
  // via EJS; this just remembers it so the map centers there once it loads.
  if (d.coordinates && d.coordinates.lat != null && d.coordinates.lng != null) {
    pinInitialCenter = { lat: d.coordinates.lat, lng: d.coordinates.lng, hasExisting: true };
  }

  // Previously uploaded photos — this is the piece that was missing
  // before: the edit form never rendered d.images at all, so existing
  // photos silently disappeared from view (though they stayed in the DB).
  if (Array.isArray(d.images) && d.images.length) {
    existingImages = d.images.map(filename => ({ filename, url: `/flatmate-images/${filename}` }));
    coverRef = d.coverImage && d.images.includes(d.coverImage)
      ? { type: 'existing', filename: d.coverImage }
      : { type: 'existing', filename: existingImages[0].filename };
  }
  renderPhotoGrid();
}

/* ── PROPERTY LOCATION MAP-PIN PICKER ── */
const GOOGLE_MAPS_KEY = <%- JSON.stringify(googleMapsApiKey || null) %>;
let pinMap = null, pinMarker = null, pinAutocomplete = null, pinMapLoaded = false, pinScriptRequested = false;
let pinInitialCenter = { lat: 20.5937, lng: 78.9629, hasExisting: false }; // India centroid fallback

function showPinMapUnavailable() {
  const mapEl = document.getElementById('pinMap');
  if (mapEl) mapEl.style.display = 'none';
  const fallback = document.getElementById('pinMapUnavailable');
  if (fallback) fallback.style.display = 'flex';
}

// Lazy-init: only load/create the map the first time the Location step is
// actually shown (a Google Map created inside a display:none container
// renders blank), and just resize+recenter on subsequent visits.
function onLocationStepShown() {
  if (!GOOGLE_MAPS_KEY) { showPinMapUnavailable(); return; }
  if (pinMapLoaded && pinMap) {
    google.maps.event.trigger(pinMap, 'resize');
    pinMap.setCenter(pinMarker.getPosition());
    return;
  }
  if (pinScriptRequested) return;
  pinScriptRequested = true;

  setTimeout(function () { if (!pinMapLoaded) showPinMapUnavailable(); }, 6000);

  const script = document.createElement('script');
  script.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(GOOGLE_MAPS_KEY) + '&libraries=places&callback=initPinMap&loading=async';
  script.async = true;
  script.onerror = showPinMapUnavailable;
  document.head.appendChild(script);
}

function initPinMap() {
  pinMapLoaded = true;
  const mapEl = document.getElementById('pinMap');
  if (!mapEl) return;

  const center = { lat: pinInitialCenter.lat, lng: pinInitialCenter.lng };
  pinMap = new google.maps.Map(mapEl, {
    center, zoom: pinInitialCenter.hasExisting ? 16 : 5,
    disableDefaultUI: true, zoomControl: true,
  });
  pinMarker = new google.maps.Marker({ position: center, map: pinMap, draggable: true });

  google.maps.event.addListener(pinMarker, 'dragend', function () {
    const pos = pinMarker.getPosition();
    setPinCoordinates(pos.lat(), pos.lng(), null);
    reverseGeocodePin(pos.lat(), pos.lng());
  });

  pinAutocomplete = new google.maps.places.Autocomplete(document.getElementById('pinSearchBox'), {
    fields: ['geometry', 'place_id', 'name'],
  });
  pinAutocomplete.addListener('place_changed', function () {
    const place = pinAutocomplete.getPlace();
    if (!place.geometry || !place.geometry.location) return;
    const lat = place.geometry.location.lat(), lng = place.geometry.location.lng();
    pinMap.setCenter({ lat, lng });
    pinMap.setZoom(16);
    pinMarker.setPosition({ lat, lng });
    setPinCoordinates(lat, lng, place.place_id || null);
    reverseGeocodePin(lat, lng);
  });
}
window.initPinMap = initPinMap;

function setPinCoordinates(lat, lng, placeId) {
  document.getElementById('pinLat').value = lat;
  document.getElementById('pinLng').value = lng;
  if (placeId) document.getElementById('pinPlaceId').value = placeId;
}

// Convenience only — auto-fills the Area field from the pinned spot so
// the student doesn't have to type it separately. Never overwrites a
// value they've already typed themselves.
async function reverseGeocodePin(lat, lng) {
  const areaField = document.querySelector('[name="area"]');
  if (areaField && areaField.value.trim()) return;
  try {
    const res = await fetch('/flatmate/geocode/reverse?lat=' + lat + '&lng=' + lng);
    const data = await res.json();
    if (data.success && areaField && !areaField.value.trim()) {
      areaField.value = data.area || '';
    }
  } catch (err) { /* silent — pin coordinates are already saved regardless */ }
}

hydrateForm(DRAFT_DATA);
showStep(1);
</script>
</body>
</html>
