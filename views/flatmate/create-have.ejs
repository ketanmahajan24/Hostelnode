    <!-- STEP 5 — Photos -->
    <div class="wiz-step" data-step="5">
      <h2>Photos</h2>
      <p class="step-sub">3–15 photos recommended. Show the living room, bedroom, kitchen and common areas — no personal photos needed. Photos are auto-optimized for fast loading.</p>

      <div class="photo-drop" id="photoDrop" role="button" tabindex="0" aria-label="Add photos" onclick="document.getElementById('photoInput').click()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();document.getElementById('photoInput').click();}">
        <i class="fa-solid fa-cloud-arrow-up"></i>
        <span>Click or drag photos here &middot; JPG, PNG or WebP &middot; up to 5 MB each</span>
        <input type="file" id="photoInput" name="photos" accept="image/jpeg,image/png,image/webp" multiple hidden>
      </div>

      <div class="photo-progress-wrap" id="photoProgressWrap">
