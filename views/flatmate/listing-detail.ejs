<script>
// Resume target after a successful login/signup — set by whichever
// action opened the modal (e.g. "Send Request" on a listing passes the
// listing's own URL + #request so the request modal reopens right where
// the guest left off, instead of dropping them back on a blank page).
// Left null for a plain navbar "Login" click, which just reloads in place.
let nudgeResumeUrl = null;

function openNudgeModal(mode, resumeUrl) {
  nudgeResumeUrl = resumeUrl || null;
  if (mode === 'login') nudgeSwitchLogin();
  else if (mode === 'signup') nudgeSwitchSignup();
  document.getElementById('enqOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeNudgeModal(isLogin = false) {
  document.getElementById('enqOverlay').classList.remove('open');
  document.body.style.overflow = '';
  if (isLogin) {
    if (nudgeResumeUrl) window.location.href = nudgeResumeUrl;
    else location.reload();
  }
}
// Close on overlay background click
document.getElementById('enqOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeNudgeModal();
});

function showNudgeAlert(msg, type) {
  var el = document.getElementById('nudgeAlert');
  el.textContent = msg;
  el.className = 'enq-alert show ' + (type || 'error');
  setTimeout(function(){ el.classList.remove('show'); }, 4000);
}

/* ── TABS / PANEL SWITCH ── */
function nudgeSwitchLogin() {
  document.getElementById('tabSignup').classList.remove('active');
  document.getElementById('tabLogin').classList.add('active');
  document.getElementById('nudgePanel1').style.display = 'none';
  document.getElementById('nudgePanel2').style.display = 'block';
}
function nudgeSwitchSignup() {
  document.getElementById('tabLogin').classList.remove('active');
  document.getElementById('tabSignup').classList.add('active');
  document.getElementById('nudgePanel1').style.display = 'block';
  document.getElementById('nudgePanel2').style.display = 'none';
}
function nudgeBackToPhone(kind) {
  if (kind === 'signup') {
    document.getElementById('nudgeSignupStep2').style.display = 'none';
    document.getElementById('nudgeSignupStep1').style.display = 'block';
  } else {
    document.getElementById('nudgeLoginStep2').style.display = 'none';
    document.getElementById('nudgeLoginStep1').style.display = 'block';
  }
}

/* ── COUNTDOWN ── */
function startNudgeCountdown(timerId, countdownId, resendRowId) {
  var s = 60;
  var cd = document.getElementById(countdownId);
  var t  = document.getElementById(timerId);
  var rr = document.getElementById(resendRowId);
  cd.style.display = 'block';
  rr.style.display  = 'none';
  var iv = setInterval(function() {
    t.textContent = --s;
    if (s <= 0) {
      clearInterval(iv);
      cd.style.display = 'none';
      rr.style.display  = 'block';
    }
  }, 1000);
}

/* ── OTP BOXES: auto-advance, backspace, paste, auto-submit ── */
function setupOtpGroup(groupEl, onComplete) {
  var boxes = Array.prototype.slice.call(groupEl.querySelectorAll('input'));
  boxes.forEach(function(box, i) {
    box.addEventListener('input', function() {
      this.value = this.value.replace(/[^0-9]/g, '').slice(0, 1);
      this.classList.toggle('filled', !!this.value);
      if (this.value && boxes[i + 1]) boxes[i + 1].focus();
      var val = boxes.map(function(b){ return b.value; }).join('');
      if (val.length === 4) onComplete(val);
    });
    box.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace' && !this.value && boxes[i - 1]) boxes[i - 1].focus();
    });
    box.addEventListener('paste', function(e) {
      e.preventDefault();
      var text = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '').slice(0, 4);
      text.split('').forEach(function(ch, j) { if (boxes[j]) { boxes[j].value = ch; boxes[j].classList.add('filled'); } });
      var last = boxes[Math.min(text.length, 4) - 1];
      if (last) last.focus();
      if (text.length === 4) onComplete(text);
    });
  });
}
function resetOtpGroup(groupEl) {
  groupEl.querySelectorAll('input').forEach(function(b) { b.value = ''; b.classList.remove('filled'); b.disabled = false; });
  var first = groupEl.querySelector('input');
  if (first) first.focus();
}

var nudgeOtpVerified = false;
var nudgeLoginOtpVerified = false;
var nudgeSignupOtpGroupEl = document.querySelector('.enq-otp-boxes[data-group="signup"]');
var nudgeLoginOtpGroupEl  = document.querySelector('.enq-otp-boxes[data-group="login"]');

/* ── SIGNUP: send OTP ── */
async function nudgeSendOtp() {
  var phone = document.getElementById('nudgePhone').value.trim();
  if (!/^[6-9]\d{9}$/.test(phone)) return showNudgeAlert('Enter a valid 10-digit number');
  var btn = document.getElementById('nudgeSendBtn');
  var original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Sending…';
  var res = await fetch('/student/send-otp', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone })
  }).catch(function(){ return null; });
  btn.disabled = false; btn.innerHTML = original;
  if (!res) return showNudgeAlert('Network error');
  var data = await res.json();
  if (!data.success) {
    if (data.error?.toLowerCase().includes('registered')) {
      showNudgeAlert('Already registered — switching to login', 'success');
      return setTimeout(nudgeSwitchLogin, 1000);
    }
    return showNudgeAlert(data.error || 'Failed to send OTP');
  }
  document.getElementById('nudgeSentTo1').textContent = '+91 ' + phone;
  document.getElementById('nudgeSignupStep1').style.display = 'none';
  document.getElementById('nudgeSignupStep2').style.display = 'block';
  resetOtpGroup(nudgeSignupOtpGroupEl);
  startNudgeCountdown('nudgeTimer', 'nudgeCountdown', 'nudgeResendRow');
}

async function nudgeVerifySignupOtp(otp) {
  var phone = document.getElementById('nudgePhone').value.trim();
  var res = await fetch('/student/verify-otp', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone, otp })
  }).catch(function(){ return null; });
  if (!res) return showNudgeAlert('Network error');
  var data = await res.json();
  if (!data.success) {
    resetOtpGroup(nudgeSignupOtpGroupEl);
    return showNudgeAlert(data.error || 'Wrong OTP, try again');
  }
  nudgeOtpVerified = true;
  document.getElementById('nudgeVerifiedBadge').style.display = 'inline-flex';
  nudgeSignupOtpGroupEl.querySelectorAll('input').forEach(function(b){ b.disabled = true; });
  document.getElementById('nudgeSignupBtn').disabled = false;
  showNudgeAlert('Number verified ✅', 'success');
}
if (nudgeSignupOtpGroupEl) setupOtpGroup(nudgeSignupOtpGroupEl, nudgeVerifySignupOtp);

async function nudgeSignup() {
  if (!nudgeOtpVerified) return showNudgeAlert('Verify your mobile first');
  var firstName = document.getElementById('nudgeFirst').value.trim();
  var lastName  = document.getElementById('nudgeLast').value.trim();
  var phone     = document.getElementById('nudgePhone').value.trim();
  if (firstName.length < 2) return showNudgeAlert('Enter your first name');
  if (lastName.length  < 2) return showNudgeAlert('Enter your last name');
  var btn = document.getElementById('nudgeSignupBtn');
  var original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Creating account…';
  var res = await fetch('/student/signup', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ firstName, lastName, phone })
  }).catch(function(){ return null; });
  if (!res) { btn.disabled=false; btn.innerHTML=original; return showNudgeAlert('Network error'); }
  var data = await res.json();
  if (!data.success) {
    btn.disabled=false; btn.innerHTML=original;
    return showNudgeAlert(data.error || 'Signup failed');
  }
  document.getElementById('nudgeStepAuth').style.display = 'none';
  document.getElementById('nudgeStepSuccess').style.display = 'block';
}

/* ── LOGIN: send OTP ── */
async function nudgeLoginSendOtp() {
  var phone = document.getElementById('nudgeLoginPhone').value.trim();
  if (!/^[6-9]\d{9}$/.test(phone)) return showNudgeAlert('Enter a valid 10-digit number');
  var btn = document.getElementById('nudgeLoginSendBtn');
  var original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Sending…';
  var res = await fetch('/student/send-otp', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone })
  }).catch(function(){ return null; });
  btn.disabled = false; btn.innerHTML = original;
  if (!res) return showNudgeAlert('Network error');
  var data = await res.json();
  if (!data.success) {
    if (data.error?.toLowerCase().includes('no account')) {
      showNudgeAlert('No account found — switching to signup', 'success');
      return setTimeout(nudgeSwitchSignup, 1000);
    }
    return showNudgeAlert(data.error || 'Failed to send OTP');
  }
  document.getElementById('nudgeSentTo2').textContent = '+91 ' + phone;
  document.getElementById('nudgeLoginStep1').style.display = 'none';
  document.getElementById('nudgeLoginStep2').style.display = 'block';
  resetOtpGroup(nudgeLoginOtpGroupEl);
  startNudgeCountdown('nudgeLoginTimer', 'nudgeLoginCountdown', 'nudgeLoginResendRow');
}

async function nudgeVerifyLoginOtp(otp) {
  if (nudgeLoginOtpVerified) return;
  var phone = document.getElementById('nudgeLoginPhone').value.trim();
  var res = await fetch('/student/verify-otp', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone, otp })
  }).catch(function(){ return null; });
  if (!res) return showNudgeAlert('Network error');
  var data = await res.json();
  if (!data.success) {
    resetOtpGroup(nudgeLoginOtpGroupEl);
    return showNudgeAlert(data.error || 'Wrong OTP, try again');
  }
  nudgeLoginOtpVerified = true;
  document.getElementById('nudgeLoginVerifiedBadge').style.display = 'inline-flex';
  nudgeLoginOtpGroupEl.querySelectorAll('input').forEach(function(b){ b.disabled = true; });
  document.getElementById('nudgeLoginBtn').disabled = false;
  showNudgeAlert('Number verified ✅', 'success');
}
if (nudgeLoginOtpGroupEl) setupOtpGroup(nudgeLoginOtpGroupEl, nudgeVerifyLoginOtp);

async function nudgeLogin() {
  if (!nudgeLoginOtpVerified) return showNudgeAlert('Verify OTP first');
  var phone = document.getElementById('nudgeLoginPhone').value.trim();
  var btn   = document.getElementById('nudgeLoginBtn');
  var original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Logging in…';
  var res = await fetch('/student/login', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone })
  }).catch(function(){ return null; });
  if (!res) { btn.disabled=false; btn.innerHTML=original; return showNudgeAlert('Network error'); }
  var data = await res.json();
  if (!data.success) {
    btn.disabled=false; btn.innerHTML=original;
    return showNudgeAlert(data.error || 'Login failed');
  }
  document.getElementById('nudgeStepAuth').style.display = 'none';
  document.getElementById('nudgeStepSuccess').style.display = 'block';
}
</script>

<% } %>

