<!-- listing-detail.ejs — HostelNode Flatmate listing detail page -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% if (listing) { %>
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.description %>">
    <link rel="canonical" href="<%= seo.canonical %>">
    <meta name="robots" content="<%= listing.status === 'ACTIVE' ? 'index, follow' : 'noindex, follow' %>">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= seo.title %>">
    <meta property="og:description" content="<%= seo.description %>">
    <meta property="og:url" content="<%= seo.canonical %>">
  <% } else { %>
    <title>Listing Not Found | HostelNode</title>
    <meta name="robots" content="noindex, follow">
  <% } %>
  <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/findhostel.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: var(--bg); }
    .detail-wrap { max-width: 880px; margin: 0 auto; padding: 20px 20px 80px; }

    /* breadcrumb */
    .crumb { font-size: 12.5px; color: var(--muted); margin-bottom: 16px; }
    .crumb a { color: var(--muted); text-decoration: none; }
    .crumb a:hover { color: var(--green-dark); }
    .crumb .sep { margin: 0 6px; opacity: .5; }

    /* gallery */
    .gallery { border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 20px; border: 1px solid var(--border); }
    .gallery-main { aspect-ratio: 16/9; background: var(--bg2); position: relative; }
    .gallery-main img { width: 100%; height: 100%; object-fit: cover; }
    .gallery-need-placeholder {
      width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 10px; background: linear-gradient(135deg,#eaf1ff,#f5f8ff); color: #2563eb;
    }
    .gallery-need-placeholder i { font-size: 40px; }
    .gallery-badge { position: absolute; top: 14px; left: 14px; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 800; color: #fff; }
    .gallery-badge.have { background: rgba(9,184,80,.92); }
    .gallery-badge.need { background: rgba(37,99,235,.92); }
    .gallery-save-btn { position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.92); border: none; color: #94a3a8; font-size: 14px; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,.12); }
    .gallery-save-btn.saved { color: #e53e3e; }
    .gallery-thumbs { display: flex; gap: 8px; padding: 10px; background: #fff; overflow-x: auto; }
    .gallery-thumbs img { width: 74px; height: 56px; object-fit: cover; border-radius: 8px; cursor: pointer; border: 2px solid transparent; flex-shrink: 0; }
    .gallery-thumbs img.active { border-color: var(--green); }

    /* header block */
    .listing-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px; flex-wrap: wrap; }
    .listing-head h1 { font-family: var(--font-d); font-size: 1.5rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .listing-loc { font-size: 13.5px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
    .listing-loc i { color: var(--green); }
    .listing-price { text-align: right; }
    .listing-price .val { font-family: var(--font-d); font-size: 1.4rem; font-weight: 700; color: var(--ink); }
    .listing-price .label { font-size: 11.5px; color: var(--muted-light); }

    .section { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; margin-bottom: 16px; }
    .section h3 { font-family: var(--font-d); font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 12px; }
    .kv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px; }
    @media (max-width: 480px) { .kv-grid { grid-template-columns: 1fr; } }
    .kv { font-size: 13px; }
    .kv .k { color: var(--muted-light); font-weight: 600; text-transform: uppercase; font-size: 10.5px; letter-spacing: .3px; }
    .kv .v { color: var(--ink); font-weight: 600; margin-top: 2px; }

    .tag-row { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag { background: var(--bg2); color: var(--ink-mid); font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; }
    .tag i { color: var(--green); font-size: 11px; }

    /* Location / Map */
    .map-approx-note { font-size: 12px; color: var(--muted); margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }
    .flatmate-map { width: 100%; height: 280px; border-radius: 14px; background: var(--bg2); overflow: hidden; }
    .map-unavailable { height: 280px; border-radius: 14px; background: var(--bg2); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; color: var(--muted); }
    .map-unavailable i { font-size: 28px; color: var(--border-dark); }
    .map-unavailable button { background: var(--ink); color: #fff; border: none; padding: 8px 18px; border-radius: 999px; font-size: 12.5px; font-weight: 700; margin-top: 4px; }

    .nearby-categories { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }

    .nearby-highlights-label { font-size: 11px; font-weight: 700; color: var(--muted-light); text-transform: uppercase; letter-spacing: .3px; margin-top: 16px; margin-bottom: 8px; }
    .nearby-highlights { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 8px; }
    .nearby-highlight-chip { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: var(--bg2); border-radius: 12px; cursor: pointer; transition: background .15s; }
    .nearby-highlight-chip:hover { background: var(--green-light); }
    .nhc-icon { font-size: 18px; flex-shrink: 0; }
    .nhc-text { min-width: 0; }
    .nhc-name { font-size: 12.5px; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nhc-dist { font-size: 11px; color: var(--green-dark); font-weight: 600; margin-top: 1px; }
    .nearby-syncing { font-size: 12.5px; color: var(--muted); margin-top: 14px; display: flex; align-items: center; gap: 6px; }
    .nearby-cat-btn { background: var(--bg2); border: 1.5px solid transparent; border-radius: 999px; padding: 8px 14px; font-size: 12.5px; font-weight: 600; color: var(--ink-mid); cursor: pointer; transition: all .15s; }
    .nearby-cat-btn:hover { border-color: var(--green-border); }
    .nearby-cat-btn.active { background: var(--green); color: #fff; }

    .nearby-results { margin-top: 14px; display: flex; flex-direction: column; gap: 8px; }
    .nearby-result-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: var(--bg2); border-radius: 12px; cursor: pointer; transition: background .15s; }
    .nearby-result-item:hover { background: var(--green-light); }
    .nearby-result-name { font-size: 13px; font-weight: 700; color: var(--ink); }
    .nearby-result-addr { font-size: 11.5px; color: var(--muted); margin-top: 2px; }
    .nearby-result-dist { font-size: 12px; font-weight: 700; color: var(--green-dark); white-space: nowrap; margin-left: 10px; }
    .nearby-empty, .nearby-loading, .nearby-error { text-align: center; padding: 16px; font-size: 12.5px; color: var(--muted); }

    .route-panel { margin-top: 14px; border: 1px solid var(--border); border-radius: 14px; padding: 16px; background: var(--card-bg); }
    .route-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
    .route-panel-title { font-size: 11px; color: var(--muted-light); text-transform: uppercase; letter-spacing: .3px; }
    .route-panel-dest { font-size: 14.5px; font-weight: 700; color: var(--ink); margin-top: 2px; }
    .route-panel-close { background: var(--bg2); border: none; width: 28px; height: 28px; border-radius: 50%; color: var(--muted); }
    .route-mode-tabs { display: flex; gap: 8px; margin-bottom: 12px; }
    .route-mode-tab { flex: 1; padding: 9px; border-radius: 10px; border: 1.5px solid var(--border); background: #fff; font-size: 12.5px; font-weight: 700; color: var(--muted); cursor: pointer; }
    .route-mode-tab.active { background: var(--ink); border-color: var(--ink); color: #fff; }
    .route-result { font-size: 13px; color: var(--ink-mid); }
    .route-result .route-stat-row { display: flex; align-items: center; gap: 16px; }
    .route-result .route-stat { display: flex; flex-direction: column; }
    .route-result .route-stat .val { font-size: 18px; font-weight: 700; color: var(--ink); }
    .route-result .route-stat .lbl { font-size: 11px; color: var(--muted); }

    .desc-text { font-size: 13.5px; color: var(--ink-mid); line-height: 1.7; }

    .private-box { border: 1.5px dashed var(--border); border-radius: 12px; padding: 16px; text-align: center; }
    .private-box.locked { color: var(--muted); font-size: 13px; }
    .private-box.locked i { font-size: 20px; color: var(--muted-light); display: block; margin-bottom: 8px; }
    .private-box.unlocked { text-align: left; }
    .private-row { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--ink); margin-bottom: 8px; }
    .private-row i { color: var(--green); width: 16px; }

    .poster-row { display: flex; align-items: center; justify-content: space-between; }
    .poster-info { display: flex; align-items: center; gap: 10px; }
    .poster-avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, var(--green), #00c264); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
    .poster-name { font-size: 13.5px; font-weight: 700; color: var(--ink); }
    .poster-meta { font-size: 11.5px; color: var(--muted); }
    .verified-badge { display: inline-flex; align-items: center; gap: 4px; background: var(--green-light); color: var(--green-dark); font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }

    /* sticky CTA bar (mobile) + inline CTA (desktop) */
    .cta-bar { position: sticky; bottom: 0; background: #fff; border-top: 1px solid var(--border); padding: 14px 20px; margin: 0 -20px; }
    .cta-btn { width: 100%; padding: 14px; border-radius: 999px; font-size: 14.5px; font-weight: 700; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; }
    .cta-btn.connect { background: linear-gradient(135deg, var(--green), #00c264); color: #fff; box-shadow: var(--shadow-green); }
    .cta-btn.pending { background: #fffbeb; color: #92400e; border: 1.5px solid #fde68a; cursor: default; }
    .cta-btn.connected { background: var(--green-light); color: var(--green-dark); border: 1.5px solid var(--green-border); cursor: default; }
    .cta-btn.muted { background: var(--bg2); color: var(--muted); cursor: default; }
    .cta-sub { text-align: center; font-size: 12px; margin-top: 8px; }
    .cta-sub a, .cta-sub button { color: var(--muted); background: none; border: none; text-decoration: underline; cursor: pointer; font-size: 12px; }

    .not-found { text-align: center; padding: 80px 20px; }
    .not-found i { font-size: 2.4rem; color: var(--border-dark); }
    .not-found h2 { font-family: var(--font-d); margin: 16px 0 8px; }

    /* modal */
    .rc-overlay { position: fixed; inset: 0; background: rgba(10,22,40,.55); backdrop-filter: blur(4px); z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 16px; opacity: 0; pointer-events: none; transition: opacity .2s; }
    .rc-overlay.open { opacity: 1; pointer-events: all; }
    .rc-box { background: #fff; border-radius: 20px; width: 100%; max-width: 420px; padding: 24px; position: relative; }
    .rc-close { position: absolute; top: 14px; right: 14px; width: 28px; height: 28px; border-radius: 50%; border: none; background: var(--bg2); color: var(--muted); }
    .rc-box h3 { font-family: var(--font-d); font-size: 1.1rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .rc-box p.hint { font-size: 12.5px; color: var(--muted); margin-bottom: 16px; }
    .rc-summary { background: var(--bg2); border-radius: 12px; padding: 12px 14px; font-size: 13px; color: var(--ink-mid); margin-bottom: 16px; }
    .rc-field textarea { width: 100%; padding: 11px 13px; border: 1.5px solid var(--border); border-radius: 12px; font-size: 13.5px; font-family: inherit; resize: vertical; box-sizing: border-box; }
    .rc-send { width: 100%; margin-top: 14px; padding: 13px; background: linear-gradient(135deg, var(--green), #00c264); color: #fff; border: none; border-radius: 13px; font-weight: 700; font-size: 14px; }
    .rc-alert { font-size: 12.5px; color: #c53030; margin-top: 10px; display: none; }
    .rc-alert.show { display: block; }
  </style>
</head>
<body>

<%- include("../includes/navbar-user.ejs") %>

<div class="detail-wrap">

<% if (!listing) { %>
  <div class="not-found">
    <i class="fa-solid fa-magnifying-glass"></i>
    <h2>Listing not found</h2>
    <p style="color:var(--muted);font-size:13.5px">This listing may have been removed or the link is incorrect.</p>
    <a href="/flatmate" style="color:var(--green-dark);font-weight:700">&larr; Back to Flatmate</a>
  </div>
<% } else { %>

  <div class="crumb">
    <a href="/flatmate">Home</a><span class="sep">/</span><a href="/flatmate">Flatmate</a><span class="sep">/</span>
    <%= listing.bhk %> BHK <%= listing.roomType %>, <%= listing.area %>
  </div>

  <!-- Gallery -->
  <div class="gallery">
    <div class="gallery-main">
      <% if (listing.type === 'HAVE_FLAT' && listing.images && listing.images.length) { %>
        <img id="galleryMainImg" src="/flatmate-images/<%= listing.images[0] %>" alt="<%= listing.bhk %> BHK <%= listing.roomType %> in <%= listing.area %>, <%= listing.city %>">
      <% } else if (listing.type === 'HAVE_FLAT') { %>
        <img src="/images/placeholder.jpg" alt="<%= listing.bhk %> BHK <%= listing.roomType %> in <%= listing.area %>">
      <% } else { %>
        <div class="gallery-need-placeholder"><i class="fa-solid fa-magnifying-glass"></i><span>Looking for a flat</span></div>
      <% } %>
      <span class="gallery-badge <%= listing.type === 'HAVE_FLAT' ? 'have' : 'need' %>">
        <%= listing.type === 'HAVE_FLAT' ? '🏠 FLAT' : '👤 FLATMATE' %>
      </span>
      <% if (!isOwner) { %>
        <button class="gallery-save-btn <%= isSaved ? 'saved' : '' %>" onclick="toggleDetailSave(event, this, '<%= listing._id %>')" aria-label="Save to properties" aria-pressed="<%= isSaved ? 'true' : 'false' %>">
          <i class="fa-<%= isSaved ? 'solid' : 'regular' %> fa-heart" aria-hidden="true"></i>
        </button>
      <% } %>
    </div>
    <% if (listing.type === 'HAVE_FLAT' && listing.images && listing.images.length > 1) { %>
      <div class="gallery-thumbs">
        <% listing.images.forEach(function(img, i) { %>
          <img src="/flatmate-images/<%= img %>" class="<%= i===0?'active':'' %>" onclick="switchGalleryImage('<%= img %>', this)">
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Header -->
  <div class="listing-head">
    <div>
      <h1><%= listing.bhk %> BHK &middot; <%= listing.roomType %></h1>
      <div class="listing-loc"><i class="fa-solid fa-location-dot"></i> <%= listing.area %>, <%= listing.city %></div>
    </div>
    <div class="listing-price">
      <% if (listing.type === 'HAVE_FLAT') { %>
        <div class="val">₹<%= (listing.have?.rentMonthly || 0).toLocaleString('en-IN') %></div>
        <div class="label">per month</div>
      <% } else { %>
        <div class="val">₹<%= (listing.need?.budgetMin || 0).toLocaleString('en-IN') %>&ndash;₹<%= (listing.need?.budgetMax || 0).toLocaleString('en-IN') %></div>
        <div class="label">budget / month</div>
      <% } %>
    </div>
  </div>

  <!-- Key facts -->
  <div class="section">
    <h3>Details</h3>
    <div class="kv-grid">
      <% if (listing.type === 'HAVE_FLAT') { %>
        <div class="kv"><div class="k">Available</div><div class="v"><%= listing.have?.availabilityType || '—' %> &middot; <%= listing.have?.availableSpots || 1 %> spot(s)</div></div>
        <div class="kv"><div class="k">Furnishing</div><div class="v"><%= listing.have?.furnishing || 'Not specified' %></div></div>
        <div class="kv"><div class="k">Available from</div>
          <div class="v"><%= listing.have?.availableFromMode === 'now' ? 'Now' : (listing.have?.availableFromDate ? new Date(listing.have.availableFromDate).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) : 'Flexible') %></div>
        </div>
        <div class="kv"><div class="k">Deposit</div><div class="v"><%= listing.have?.depositNegotiable ? 'Negotiable' : ('₹' + (listing.have?.depositAmount || 0).toLocaleString('en-IN')) %></div></div>
        <div class="kv"><div class="k">Maintenance</div><div class="v"><%= listing.have?.maintenance %><%= listing.have?.maintenance === 'Separate' && listing.have?.maintenanceAmount ? ' — ₹' + listing.have.maintenanceAmount.toLocaleString('en-IN') : '' %></div></div>
        <% if (listing.have?.occupantsCount) { %>
          <div class="kv"><div class="k">Current occupants</div><div class="v"><%= listing.have.occupantsCount %> (<%= listing.have.occupantsType || 'Not specified' %>)</div></div>
        <% } %>
      <% } else { %>
        <div class="kv"><div class="k">Looking for</div><div class="v"><%= listing.need?.needType || '—' %></div></div>
        <div class="kv"><div class="k">Move-in</div>
          <div class="v"><%
            const moveInLabels = { immediate:'Immediately', '15days':'Within 15 days', '1month':'Within 1 month' };
            %><%= moveInLabels[listing.need?.moveInMode] || (listing.need?.moveInDate ? new Date(listing.need.moveInDate).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) : 'Flexible') %></div>
        </div>
        <div class="kv"><div class="k">Deposit preference</div><div class="v"><%= listing.need?.depositPreference || 'Flexible' %></div></div>
        <% if (listing.need?.preferredAreas && listing.need.preferredAreas.length > 1) { %>
          <div class="kv"><div class="k">Also considering</div><div class="v"><%= listing.need.preferredAreas.slice(1).join(', ') %></div></div>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- Amenities (HAVE only) -->
  <% if (listing.type === 'HAVE_FLAT' && listing.have?.amenities && listing.have.amenities.length) { %>
    <%
      const amenityIcons = {
        'WiFi': 'wifi', 'AC': 'snowflake', 'Washing Machine': 'shirt', 'Geyser': 'fire-flame-simple',
        'Refrigerator': 'kitchen-set', 'Bed': 'bed', 'Wardrobe': 'box-archive', 'Study Table': 'book',
        'Sofa': 'couch', 'Dining Table': 'utensils', 'TV': 'tv', 'Microwave': 'kitchen-set',
        'RO Water': 'droplet', 'Power Backup': 'bolt', 'Lift': 'elevator', 'Parking': 'car',
        'CCTV': 'camera', 'Security': 'shield-halved', 'Balcony': 'building', 'Gym': 'dumbbell',
        'Swimming Pool': 'person-swimming', 'Housekeeping': 'broom',
      };
    %>
    <div class="section">
      <h3>Amenities</h3>
      <div class="tag-row">
        <% listing.have.amenities.forEach(function(a){ %>
          <span class="tag"><i class="fa-solid fa-<%= amenityIcons[a] || 'check' %>" aria-hidden="true"></i> <%= a %></span>
        <% }) %>
      </div>
    </div>
  <% } %>

  <!-- Location / Map (HAVE_FLAT only — a NEED_FLAT listing is about
       preferred areas, not one pinned property) -->
  <% if (listing.type === 'HAVE_FLAT') { %>
  <div class="section">
    <h3><i class="fa-solid fa-location-dot" style="font-size:13px;color:var(--muted-light)"></i> Location</h3>
    <p class="map-approx-note">
      <% if (mapData.precise) { %>
        <i class="fa-solid fa-location-dot" style="color:var(--green)"></i> Exact location shown on the map. The full address, phone, and WhatsApp become available once your connection request is accepted.
      <% } else { %>
        <i class="fa-solid fa-circle-info"></i> This listing doesn't have a pinned location yet.
      <% } %>
    </p>

    <div id="mapUnavailable" class="map-unavailable" style="display:none">
      <i class="fa-solid fa-map"></i>
      <p>Map is temporarily unavailable.</p>
      <button onclick="initFlatmateMap()">Retry</button>
    </div>
    <div id="flatmateMap" class="flatmate-map"></div>

    <!-- Nearby Highlights — auto-computed once when the listing was pinned,
         shown here with zero clicks. Clicking any of these opens the route
         panel immediately (no extra API call needed, since lat/lng is
         already cached). -->
    <% if (listing.nearbyCache && Object.keys(listing.nearbyCache).length) { %>
      <div class="nearby-highlights-label">Nearby, at a glance</div>
      <div class="nearby-highlights">
        <%
          const categoryMeta = {
            metro: ['🚇','Metro'], hospital: ['🏥','Hospital'], college: ['🎓','College'],
            grocery: ['🛒','Grocery'], food: ['🍽️','Food'], pharmacy: ['💊','Pharmacy'],
            gym: ['🏋️','Gym'], atm: ['🏧','ATM'], movies: ['🎬','Movies'], clubs: ['🌳','Clubs'],
          };
        %>
        <% Object.keys(categoryMeta).forEach(function(cat) { %>
          <% const hit = listing.nearbyCache[cat]; %>
          <% if (hit) { %>
            <div class="nearby-highlight-chip" onclick='openRoutePanel(<%- JSON.stringify(Object.assign({}, hit, {category: cat})).replace(/</g,"\\u003c") %>)'>
              <span class="nhc-icon"><%= categoryMeta[cat][0] %></span>
              <div class="nhc-text">
                <div class="nhc-name"><%= categoryMeta[cat][1] %> &middot; <%= hit.name %></div>
                <div class="nhc-dist"><%= hit.distanceMeters < 1000 ? hit.distanceMeters + ' m' : (hit.distanceMeters/1000).toFixed(1) + ' km' %> away</div>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="nearby-syncing"><i class="fa-solid fa-circle-info"></i> Nearby places aren't available for this listing yet.</div>
    <% } %>

    <!-- Nearby categories (explore the full list for any category) -->
    <div class="nearby-categories">
      <button class="nearby-cat-btn" data-category="metro" onclick="loadNearby('metro', this)">🚇 Metro</button>
      <button class="nearby-cat-btn" data-category="hospital" onclick="loadNearby('hospital', this)">🏥 Hospital</button>
      <button class="nearby-cat-btn" data-category="college" onclick="loadNearby('college', this)">🎓 College</button>
      <button class="nearby-cat-btn" data-category="grocery" onclick="loadNearby('grocery', this)">🛒 Grocery</button>
      <button class="nearby-cat-btn" data-category="food" onclick="loadNearby('food', this)">🍽️ Food</button>
      <button class="nearby-cat-btn" data-category="pharmacy" onclick="loadNearby('pharmacy', this)">💊 Pharmacy</button>
      <button class="nearby-cat-btn" data-category="gym" onclick="loadNearby('gym', this)">🏋️ Gym</button>
      <button class="nearby-cat-btn" data-category="atm" onclick="loadNearby('atm', this)">🏧 ATM</button>
      <button class="nearby-cat-btn" data-category="movies" onclick="loadNearby('movies', this)">🎬 Movies</button>
      <button class="nearby-cat-btn" data-category="clubs" onclick="loadNearby('clubs', this)">🌳 Clubs</button>
    </div>

    <div id="nearbyResults" class="nearby-results" style="display:none"></div>

    <!-- Route panel -->
    <div id="routePanel" class="route-panel" style="display:none">
      <div class="route-panel-head">
        <div>
          <div class="route-panel-title">Route to</div>
          <div class="route-panel-dest" id="routeDestName">—</div>
        </div>
        <button class="route-panel-close" onclick="closeRoutePanel()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="route-mode-tabs">
        <button class="route-mode-tab active" data-mode="driving" onclick="loadRoute('driving', this)">🚗 Driving</button>
        <button class="route-mode-tab" data-mode="walking" onclick="loadRoute('walking', this)">🚶 Walking</button>
        <button class="route-mode-tab" data-mode="transit" onclick="loadRoute('transit', this)">🚌 Transit</button>
      </div>
      <div id="routeResult" class="route-result">Loading…</div>
    </div>
  </div>
  <% } %>

  <!-- Preferences -->
  <div class="section">
    <h3>Flatmate preferences</h3>
    <div class="tag-row">
      <span class="tag"><%= listing.gender === 'any' ? 'No gender preference' : (listing.gender === 'male' ? 'Male' : 'Female') %></span>
      <% if (listing.occupation) { %><span class="tag"><%= listing.occupation %></span><% } %>
      <span class="tag"><%= listing.food %></span>
      <% (listing.lifestyle || []).forEach(function(l){ %><span class="tag"><%= l %></span><% }) %>
    </div>
  </div>

  <!-- Description -->
  <% if (listing.description || listing.need?.intro) { %>
    <div class="section">
      <h3><%= listing.type === 'HAVE_FLAT' ? 'About this listing' : 'About this person' %></h3>
      <p class="desc-text"><%= listing.description || listing.need.intro %></p>
    </div>
  <% } %>

  <!-- Private info -->
  <div class="section">
    <h3><i class="fa-solid fa-lock" style="font-size:13px;color:var(--muted-light)"></i> Contact information</h3>
    <% if (isOwner || (connection && connection.status === 'accepted')) { %>
      <div class="private-box unlocked">
        <div class="private-row"><i class="fa-solid fa-phone"></i> <%= listing.contact?.phone || 'Not provided' %></div>
        <% if (listing.contact?.whatsapp) { %><div class="private-row"><i class="fa-brands fa-whatsapp"></i> <%= listing.contact.whatsapp %></div><% } %>
        <% if (listing.address) { %><div class="private-row"><i class="fa-solid fa-location-dot"></i> <%= listing.address %></div><% } %>
        <div class="private-row"><i class="fa-solid fa-comment"></i> Prefers <%= listing.contact?.preferredMethod || 'HostelNode Messages' %></div>
      </div>
    <% } else { %>
      <div class="private-box locked">
        <i class="fa-solid fa-lock"></i>
        Private profile information — phone, WhatsApp and exact address — becomes available after your connection request is accepted.
      </div>
    <% } %>
  </div>

  <!-- Posted by -->
  <div class="section poster-row">
    <div class="poster-info">
      <div class="poster-avatar"><%= (listing.student?.firstName || 'H')[0] %></div>
      <div>
        <div class="poster-name">Posted by <%= listing.student?.firstName || 'HostelNode User' %></div>
        <div class="poster-meta">
          <%= new Date(listing.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
          &middot; <%= listing.views || 0 %> views
        </div>
      </div>
    </div>
    <% if (listing.isVerified) { %><span class="verified-badge"><i class="fa-solid fa-circle-check"></i> Verified</span><% } %>
  </div>

  <!-- CTA -->
  <div class="cta-bar">
    <% if (cta === 'manage') { %>
      <a class="cta-btn muted" href="/flatmate/my-listings"><i class="fa-solid fa-gear"></i> This is your listing — Manage it</a>
      <div class="cta-sub">Status: <%= listing.status %></div>

    <% } else if (cta === 'closed') { %>
      <button class="cta-btn muted" disabled><i class="fa-solid fa-lock"></i> This listing is no longer available</button>

    <% } else if (cta === 'blocked') { %>
      <button class="cta-btn muted" disabled>Unavailable</button>

    <% } else if (cta === 'pending_sent') { %>
      <button class="cta-btn pending" disabled><i class="fa-solid fa-clock"></i> Request Pending</button>
      <div class="cta-sub"><button onclick="cancelRequest('<%= connection._id %>')">Cancel Request</button></div>

    <% } else if (cta === 'connected') { %>
      <button class="cta-btn connected" disabled><i class="fa-solid fa-circle-check"></i> Connected</button>
      <div class="cta-sub">Messages &amp; chat launching soon</div>

    <% } else if (!isOwner) { %>
      <% /* cta === 'connect', logged in or not */ %>
      <% if (typeof student !== 'undefined' && student) { %>
        <button class="cta-btn connect" id="connectBtn" onclick="openConnectModal()"><i class="fa-solid fa-people-arrows"></i> Request to Connect</button>
      <% } else { %>
        <a class="cta-btn connect" href="/student/login?next=<%= encodeURIComponent('/flatmate/' + listing.slug) %>"><i class="fa-solid fa-people-arrows"></i> Request to Connect</a>
      <% } %>
    <% } %>
  </div>

  <!-- Request to Connect modal -->
  <div class="rc-overlay" id="rcOverlay" onclick="if(event.target===this) closeConnectModal()">
    <div class="rc-box">
      <button class="rc-close" onclick="closeConnectModal()"><i class="fa-solid fa-xmark"></i></button>
      <h3>Request to Connect</h3>
      <p class="hint">You're requesting to connect with <%= listing.student?.firstName || 'this user' %> about this listing.</p>
      <div class="rc-summary">
        <%= listing.type === 'HAVE_FLAT' ? '🏠' : '👤' %> <%= listing.bhk %> BHK &middot; <%= listing.area %>, <%= listing.city %>
        <% if (listing.type === 'HAVE_FLAT') { %> &middot; ₹<%= (listing.have?.rentMonthly||0).toLocaleString('en-IN') %>/mo<% } %>
      </div>
      <div class="rc-field">
        <textarea id="rcMessage" rows="3" maxlength="500" placeholder="Hi, I'm interested in this listing..."></textarea>
      </div>
      <button class="rc-send" id="rcSendBtn" onclick="sendConnectRequest('<%= listing._id %>')">Send Request</button>
      <div class="rc-alert" id="rcAlert"></div>
    </div>
  </div>

<% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
/* ── LOCATION / MAP ── */
const LISTING_SLUG = <%- JSON.stringify(listing.slug) %>;
const MAP_DATA = <%- JSON.stringify(mapData || null) %>;
const GOOGLE_MAPS_KEY = <%- JSON.stringify(googleMapsApiKey || null) %>;
let flatmateMap = null;
let flatmateMarker = null;
let destMarker = null;
let routePolyline = null;
let currentDestination = null;
let mapLoaded = false;

function showMapUnavailable() {
  document.getElementById('flatmateMap').style.display = 'none';
  document.getElementById('mapUnavailable').style.display = 'flex';
}

function loadGoogleMapsScript() {
  if (!GOOGLE_MAPS_KEY || !MAP_DATA) { showMapUnavailable(); return; }
  // If the script fails to load or the key is invalid, Google never calls
  // our callback — this timeout catches that case so the page never hangs
  // on a blank map container.
  setTimeout(function () { if (!mapLoaded) showMapUnavailable(); }, 6000);

  const script = document.createElement('script');
  script.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(GOOGLE_MAPS_KEY) + '&libraries=geometry&callback=initFlatmateMap&loading=async';
  script.async = true;
  script.onerror = showMapUnavailable;
  document.head.appendChild(script);
}

function initFlatmateMap() {
  mapLoaded = true;
  const el = document.getElementById('flatmateMap');
  if (!el || !MAP_DATA) return;
  flatmateMap = new google.maps.Map(el, {
    center: { lat: MAP_DATA.lat, lng: MAP_DATA.lng },
    zoom: MAP_DATA.zoom,
    disableDefaultUI: true,
    zoomControl: true,
  });
  flatmateMarker = new google.maps.Marker({
    position: { lat: MAP_DATA.lat, lng: MAP_DATA.lng },
    map: flatmateMap,
    title: MAP_DATA.precise ? 'This property' : 'Approximate area',
  });
  if (!MAP_DATA.precise) {
    // Visually reinforce that this is an area, not a pinpointed address.
    new google.maps.Circle({
      map: flatmateMap,
      center: { lat: MAP_DATA.lat, lng: MAP_DATA.lng },
      radius: 3000,
      fillColor: '#09b850', fillOpacity: 0.08,
      strokeColor: '#09b850', strokeOpacity: 0.3, strokeWeight: 1,
    });
  }
}
window.initFlatmateMap = initFlatmateMap;
loadGoogleMapsScript();

/* ── NEARBY PLACES ── */
async function loadNearby(category, btn) {
  document.querySelectorAll('.nearby-cat-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  closeRoutePanel();

  const box = document.getElementById('nearbyResults');
  box.style.display = 'block';
  box.innerHTML = '<div class="nearby-loading">Finding nearby places…</div>';

  try {
    const res = await fetch('/flatmate/' + LISTING_SLUG + '/nearby?category=' + encodeURIComponent(category));
    const data = await res.json();
    if (!data.success) {
      box.innerHTML = '<div class="nearby-error">' + (data.error || 'Could not load nearby places.') + '</div>';
      return;
    }
    if (!data.places || !data.places.length) {
      box.innerHTML = '<div class="nearby-empty">No nearby places found in this category.</div>';
      return;
    }
    box.innerHTML = data.places.map(function (p, i) {
      const distText = p.distanceMeters != null ? (p.distanceMeters < 1000 ? p.distanceMeters + ' m' : (p.distanceMeters / 1000).toFixed(1) + ' km') : '';
      return '<div class="nearby-result-item" onclick=\'openRoutePanel(' + JSON.stringify(p).replace(/'/g, "&#39;") + ')\'>' +
        '<div><div class="nearby-result-name">' + escapeHtml(p.name) + '</div>' +
        (p.address ? '<div class="nearby-result-addr">' + escapeHtml(p.address) + '</div>' : '') + '</div>' +
        '<div class="nearby-result-dist">' + distText + '</div></div>';
    }).join('');
  } catch (err) {
    box.innerHTML = '<div class="nearby-error">Network error — please try again.</div>';
  }
}

function escapeHtml(s) {
  return String(s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
}

/* ── ROUTE PANEL ── */
function openRoutePanel(place) {
  currentDestination = place;
  document.getElementById('routePanel').style.display = 'block';
  document.getElementById('routeDestName').textContent = place.name;
  document.querySelectorAll('.route-mode-tab').forEach(t => t.classList.remove('active'));
  document.querySelector('.route-mode-tab[data-mode="driving"]').classList.add('active');
  loadRoute('driving');
  document.getElementById('routePanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  if (flatmateMap && place.lat && place.lng) {
    if (destMarker) destMarker.setMap(null);
    destMarker = new google.maps.Marker({
      position: { lat: place.lat, lng: place.lng }, map: flatmateMap,
      title: place.name, icon: { url: 'https://maps.google.com/mapfiles/ms/icons/blue-dot.png' },
    });
    const bounds = new google.maps.LatLngBounds();
    bounds.extend({ lat: MAP_DATA.lat, lng: MAP_DATA.lng });
    bounds.extend({ lat: place.lat, lng: place.lng });
    flatmateMap.fitBounds(bounds);
  }
}

function closeRoutePanel() {
  document.getElementById('routePanel').style.display = 'none';
  currentDestination = null;
  if (destMarker) { destMarker.setMap(null); destMarker = null; }
  if (routePolyline) { routePolyline.setMap(null); routePolyline = null; }
}

async function loadRoute(mode, tabBtn) {
  if (!currentDestination) return;
  if (tabBtn) {
    document.querySelectorAll('.route-mode-tab').forEach(t => t.classList.remove('active'));
    tabBtn.classList.add('active');
  }
  const resultEl = document.getElementById('routeResult');
  resultEl.textContent = 'Loading…';

  try {
    const res = await fetch('/flatmate/' + LISTING_SLUG + '/route?destLat=' + currentDestination.lat + '&destLng=' + currentDestination.lng + '&mode=' + mode);
    const data = await res.json();
    if (!data.success) {
      resultEl.innerHTML = '<div class="nearby-error">' + (data.error || 'No route available for this mode.') + '</div>';
      if (routePolyline) { routePolyline.setMap(null); routePolyline = null; }
      return;
    }
    const km = (data.distanceMeters / 1000).toFixed(1);
    const mins = Math.round(data.durationSeconds / 60);
    resultEl.innerHTML = '<div class="route-stat-row">' +
      '<div class="route-stat"><span class="val">' + km + ' km</span><span class="lbl">Distance</span></div>' +
      '<div class="route-stat"><span class="val">' + mins + ' min</span><span class="lbl">Duration</span></div>' +
      '</div>';

    if (flatmateMap && data.polyline && google.maps.geometry) {
      if (routePolyline) routePolyline.setMap(null);
      const path = google.maps.geometry.encoding.decodePath(data.polyline);
      routePolyline = new google.maps.Polyline({ path, strokeColor: '#09b850', strokeWeight: 4, map: flatmateMap });
    }
  } catch (err) {
    resultEl.innerHTML = '<div class="nearby-error">Network error — please try again.</div>';
  }
}

function switchGalleryImage(filename, thumbEl) {
  document.getElementById('galleryMainImg').src = '/flatmate-images/' + filename;
  document.querySelectorAll('.gallery-thumbs img').forEach(i => i.classList.remove('active'));
  thumbEl.classList.add('active');
}

async function toggleDetailSave(e, btn, listingId) {
  e.stopPropagation();
  try {
    const res = await fetch('/student/saved/toggle', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ listingType: 'flatmate', listingId }),
    });
    if (res.redirected || res.status === 401) {
      window.location.href = '/student/login?next=' + encodeURIComponent(window.location.pathname);
      return;
    }
    const data = await res.json();
    if (data.success) {
      btn.classList.toggle('saved', data.saved);
      btn.setAttribute('aria-pressed', data.saved ? 'true' : 'false');
      btn.querySelector('i').className = data.saved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
    }
  } catch (err) { /* silent — non-critical action */ }
}

function openConnectModal() {
  document.getElementById('rcOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeConnectModal() {
  document.getElementById('rcOverlay').classList.remove('open');
  document.body.style.overflow = '';
}

// Cards elsewhere on the site (Featured, search results) link "Request to
// Talk" to /flatmate/<slug>#request — land here with the connect modal
// already open, instead of the hash doing nothing.
if (window.location.hash === '#request' && document.getElementById('connectBtn')) {
  openConnectModal();
}

async function sendConnectRequest(listingId) {
  const btn = document.getElementById('rcSendBtn');
  const alertBox = document.getElementById('rcAlert');
  const original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Sending…';
  try {
    const res = await fetch('/flatmate/connect', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ listingId, message: document.getElementById('rcMessage').value.trim() }),
    });
    if (res.status === 302 || res.redirected) {
      window.location.href = '/student/login?next=' + encodeURIComponent(window.location.pathname);
      return;
    }
    const data = await res.json();
    btn.disabled = false; btn.innerHTML = original;
    if (data.success) {
      closeConnectModal();
      window.location.reload();
    } else {
      alertBox.textContent = data.error || 'Something went wrong.';
      alertBox.classList.add('show');
    }
  } catch (err) {
    btn.disabled = false; btn.innerHTML = original;
    alertBox.textContent = 'Network error — please try again.';
    alertBox.classList.add('show');
  }
}

async function cancelRequest(connectionId) {
  if (!confirm('Cancel this request?')) return;
  try {
    const res = await fetch('/flatmate/connection/' + connectionId + '/cancel', { method: 'POST' });
    const data = await res.json();
    if (data.success) window.location.reload();
    else alert(data.error || 'Could not cancel request.');
  } catch (err) {
    alert('Network error — please try again.');
  }
}
</script>
</body>
</html>