<!-- listing-detail.ejs — HostelNode Flatmate listing detail
     Visually rebuilt to match views/listings/hostel-view.ejs exactly —
     reuses /css/hostel-view1.css's real classes (hv-container, hv-section,
     hv-h2, amenities-grid, booking-card, host-card, progress-nav, map-*)
     rather than a separate visual system, per the master-reference spec. -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% if (listing) { %>
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.description %>">
    <link rel="canonical" href="<%= seo.canonical %>">
    <meta name="robots" content="<%= listing.status === 'ACTIVE' ? 'index, follow' : 'noindex, follow' %>">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= seo.title %>">
    <meta property="og:description" content="<%= seo.description %>">
    <meta property="og:url" content="<%= seo.canonical %>">
    <% if (listing.status === 'ACTIVE') { %>
      <!-- Structured data for search engines. Built with JSON.stringify()
           for every field (not raw string interpolation) so a description
           or area name containing a quote can never produce broken/invalid
           JSON — a real risk in string-concatenated JSON-LD. Deliberately
           excludes phone/contact/exact-address fields: those aren't shown
           on the page itself, so they must not leak into a public,
           search-engine-crawled script tag either. -->
      <script type="application/ld+json">
      <%- JSON.stringify({
        "@context": "https://schema.org",
        "@type": "RealEstateListing",
        "name": (listing.bhk + " BHK " + listing.roomType + " in " + listing.area + ", " + listing.city),
        "description": (listing.description || (listing.type === 'HAVE_FLAT' ? "Flat available for flatmates in " + listing.area : "Looking for a flat/flatmate in " + listing.area)),
        "url": seo.canonical,
        "datePosted": listing.createdAt,
        "address": { "@type": "PostalAddress", "addressLocality": listing.area, "addressRegion": listing.city, "addressCountry": "IN" },
        ...(listing.type === 'HAVE_FLAT' && listing.have?.rentMonthly ? {
          "offers": { "@type": "Offer", "price": listing.have.rentMonthly, "priceCurrency": "INR", "availability": "https://schema.org/InStock" }
        } : {}),
        ...(listing.images && listing.images.length ? { "image": "https://hostelnode.com/flatmate-images/" + listing.images[0] } : {}),
      }) %>
      </script>
    <% } %>
  <% } else { %>
    <title>Listing Not Found | HostelNode</title>
    <meta name="robots" content="noindex, follow">
  <% } %>
  <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet">
  <!-- SAME master stylesheet the PG/Hostel detail page uses — this is what
       gives real, exact visual parity (not an approximation). -->
  <link rel="stylesheet" href="/css/hostel-view1.css">
  <link rel="stylesheet" href="/css/findhostel.css">
  <link rel="stylesheet" href="/css/flatmate-listing-detail.css">
</head>
<body>

<%- include("../includes/navbar-user.ejs") %>

<% if (!listing) { %>
  <div class="fm-not-found">
    <i class="fa-solid fa-magnifying-glass"></i>
    <h2>Listing not found</h2>
    <p style="color:var(--muted);font-size:0.85rem">This listing may have been removed or the link is incorrect.</p>
    <a href="/flatmate" style="color:var(--green-dark);font-weight:700">&larr; Back to Flatmate</a>
  </div>
<% } else { %>

  <!-- ══ GALLERY (same band/height/radius as PG's gallery-section) ══ -->
  <section class="fm-gallery-section">
    <div class="fm-gallery-inner" data-swipe-card>
      <% if (listing.type === 'HAVE_FLAT' && listing.images && listing.images.length) { %>
        <% listing.images.forEach(function(img, si) { %>
          <div class="fm-slide <%= si===0?'active':'' %>"><img id="<%= si===0?'galleryMainImg':'' %>" src="/flatmate-images/<%= img %>" alt="<%= listing.bhk %> BHK <%= listing.roomType %> in <%= listing.area %>, <%= listing.city %>"></div>
        <% }) %>
        <% if (listing.images.length > 1) { %>
          <button class="fm-slide-btn prev" onclick="fmSlide(-1)" aria-label="Previous photo"><i class="fa-solid fa-chevron-left"></i></button>
          <button class="fm-slide-btn next" onclick="fmSlide(1)" aria-label="Next photo"><i class="fa-solid fa-chevron-right"></i></button>
          <div class="fm-slide-dots"><% listing.images.forEach(function(_, di) { %><span class="fm-dot <%= di===0?'active':'' %>"></span><% }) %></div>
        <% } %>
      <% } else if (listing.type === 'HAVE_FLAT') { %>
        <div class="fm-slide active"><img src="/images/placeholder.jpg" alt="<%= listing.bhk %> BHK <%= listing.roomType %>"></div>
      <% } else { %>
        <div class="fm-need-placeholder"><i class="fa-solid fa-magnifying-glass"></i><span>Looking for a flat</span></div>
      <% } %>
      <span class="fm-gallery-badge <%= listing.type === 'HAVE_FLAT' ? 'have' : 'need' %>"><%= listing.type === 'HAVE_FLAT' ? '🏠 FLAT' : '👤 FLATMATE' %></span>
    </div>
  </section>

  <!-- ══ STICKY TAB NAV (same as PG's progress-nav) ══ -->
  <div class="progress-nav visible" id="progressNav">
    <a href="#overview" class="pnav-link active">Overview</a>
    <a href="#details" class="pnav-link">Details</a>
    <% if (listing.type === 'HAVE_FLAT') { %><a href="#occupants" class="pnav-link">Who's There</a><% } %>
    <% if (listing.type === 'HAVE_FLAT') { %><a href="#amenities" class="pnav-link">Amenities</a><% } %>
    <a href="#preferences" class="pnav-link">Lifestyle</a>
    <% if (listing.type === 'HAVE_FLAT') { %><a href="#location" class="pnav-link">Location</a><% } %>
  </div>

  <!-- ══ MAIN LAYOUT (same hv-container/hv-left/hv-right grid as PG) ══ -->
  <div class="hv-container">
    <div class="hv-left">

      <!-- OVERVIEW -->
      <section class="hv-section" id="overview">
        <div class="title-row">
          <div>
            <div class="title-tags">
              <span class="htag htag-type"><i class="fa-solid <%= listing.type === 'HAVE_FLAT' ? 'fa-house' : 'fa-magnifying-glass' %>"></i> <%= listing.type === 'HAVE_FLAT' ? 'Flat Available' : 'Flatmate Wanted' %></span>
              <span class="htag htag-gender"><i class="fa-solid fa-<%= listing.gender === 'any' ? 'venus-mars' : (listing.gender === 'male' ? 'mars' : 'venus') %>"></i> <%= listing.gender === 'any' ? 'No Preference' : (listing.gender === 'male' ? 'Male' : 'Female') %></span>
              <% if (listing.isVerified) { %><span class="htag htag-verified"><i class="fa-solid fa-shield-halved"></i> Verified</span><% } %>
            </div>
            <h1 class="hv-title"><%= listing.bhk %> BHK &middot; <%= listing.roomType %></h1>
            <div class="hv-loc"><i class="fa-solid fa-location-dot"></i> <%= listing.area %>, <%= listing.city %></div>
          </div>
        </div>

        <% if (listing.description || listing.need?.intro) { %>
          <div class="about-block" style="margin-top:18px">
            <h2 class="hv-h2" style="font-size:1rem;margin-bottom:8px"><%= listing.type === 'HAVE_FLAT' ? 'About this listing' : 'About this person' %></h2>
            <p class="about-text" style="font-size:0.88rem;color:var(--ink-mid);line-height:1.6"><%= listing.description || listing.need.intro %></p>
          </div>
        <% } %>
      </section>

      <!-- DETAILS -->
      <section class="hv-section" id="details">
        <h2 class="hv-h2">Details</h2>
        <div class="quick-stats">
          <% if (listing.type === 'HAVE_FLAT') { %>
            <div class="qstat"><i class="fa-solid fa-key"></i><div><div class="qstat-val"><%= listing.have?.availabilityType || '—' %></div><div class="qstat-label"><%= listing.have?.availableSpots || 1 %> spot(s)</div></div></div>
            <div class="qstat"><i class="fa-solid fa-couch"></i><div><div class="qstat-val"><%= listing.have?.furnishing || 'Not specified' %></div><div class="qstat-label">Furnishing</div></div></div>
            <div class="qstat"><i class="fa-solid fa-calendar-check"></i><div><div class="qstat-val"><%= listing.have?.availableFromMode === 'now' ? 'Now' : (listing.have?.availableFromDate ? new Date(listing.have.availableFromDate).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) : 'Flexible') %></div><div class="qstat-label">Available from</div></div></div>
            <div class="qstat"><i class="fa-solid fa-indian-rupee-sign"></i><div><div class="qstat-val"><%= listing.have?.depositNegotiable ? 'Negotiable' : ('₹' + (listing.have?.depositAmount || 0).toLocaleString('en-IN')) %></div><div class="qstat-label">Deposit</div></div></div>
            <div class="qstat"><i class="fa-solid fa-file-invoice"></i><div><div class="qstat-val"><%= listing.have?.maintenance %></div><div class="qstat-label">Maintenance<%= listing.have?.maintenance === 'Separate' && listing.have?.maintenanceAmount ? ' — ₹' + listing.have.maintenanceAmount.toLocaleString('en-IN') : '' %></div></div></div>
            <% if (listing.have?.occupantsCount) { %><div class="qstat"><i class="fa-solid fa-users"></i><div><div class="qstat-val"><%= listing.have.occupantsCount %></div><div class="qstat-label"><%= listing.have.occupantsType || 'Current occupants' %></div></div></div><% } %>
          <% } else { %>
            <div class="qstat"><i class="fa-solid fa-key"></i><div><div class="qstat-val"><%= listing.need?.needType || '—' %></div><div class="qstat-label">Looking for</div></div></div>
            <% const moveInLabels = { immediate:'Immediately', '15days':'Within 15 days', '1month':'Within 1 month' }; %>
            <div class="qstat"><i class="fa-solid fa-calendar-check"></i><div><div class="qstat-val"><%= moveInLabels[listing.need?.moveInMode] || (listing.need?.moveInDate ? new Date(listing.need.moveInDate).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) : 'Flexible') %></div><div class="qstat-label">Move-in</div></div></div>
            <div class="qstat"><i class="fa-solid fa-indian-rupee-sign"></i><div><div class="qstat-val"><%= listing.need?.depositPreference || 'Flexible' %></div><div class="qstat-label">Deposit preference</div></div></div>
            <% if (listing.need?.preferredAreas && listing.need.preferredAreas.length > 1) { %><div class="qstat"><i class="fa-solid fa-map-location-dot"></i><div><div class="qstat-val"><%= listing.need.preferredAreas.slice(1).join(', ') %></div><div class="qstat-label">Also considering</div></div></div><% } %>
          <% } %>
        </div>
      </section>

      <!-- AMENITIES (HAVE only) — same amenities-grid/amenity-item/icon as PG -->
      <% if (listing.type === 'HAVE_FLAT' && listing.have?.amenities && listing.have.amenities.length) { %>
        <%
          const amenityIcons = {
            'WiFi': 'wifi', 'AC': 'snowflake', 'Washing Machine': 'shirt', 'Geyser': 'fire-flame-simple',
            'Refrigerator': 'kitchen-set', 'Bed': 'bed', 'Wardrobe': 'box-archive', 'Study Table': 'book',
            'Sofa': 'couch', 'Dining Table': 'utensils', 'TV': 'tv', 'Microwave': 'kitchen-set',
            'RO Water': 'droplet', 'Power Backup': 'bolt', 'Lift': 'elevator', 'Parking': 'car',
            'CCTV': 'camera', 'Security': 'shield-halved', 'Balcony': 'building', 'Gym': 'dumbbell',
            'Swimming Pool': 'person-swimming', 'Housekeeping': 'broom',
          };
          // Defensive: some existing listings were saved before the
          // amenity-chip bug fix, with multiple values joined into one
          // comma-string stored as a single array element. Flatten those
          // here so they display correctly without needing a re-save.
          const flatAmenities = listing.have.amenities.flatMap(a => typeof a === 'string' && a.includes(',') ? a.split(',').map(s => s.trim()).filter(Boolean) : [a]);
        %>
        <section class="hv-section" id="amenities">
          <h2 class="hv-h2">Amenities</h2>
          <div class="amenities-grid" id="amenitiesGrid">
            <% flatAmenities.forEach(function(a){ %>
              <div class="amenity-item"><div class="amenity-icon"><i class="fa-solid fa-<%= amenityIcons[a] || 'check' %>"></i></div><span class="amenity-label"><%= a %></span></div>
            <% }) %>
          </div>
          <button type="button" class="fm-amenities-toggle" id="amenitiesToggle" onclick="toggleAmenities()" style="display:none">
            <span id="amenitiesToggleLabel">View more</span> <i class="fa-solid fa-chevron-down" id="amenitiesToggleIcon"></i>
          </button>
        </section>
      <% } %>

      <!-- PREFERENCES -->
      <!-- WHO'S ALREADY THERE — HAVE_FLAT only (a NEED_FLAT listing describes
           a person looking for a place, not an existing household). Built
           entirely from fields that already exist on the schema — no new
           data, just a dedicated section instead of burying this inside
           "Preferences" where it currently duplicates. -->
      <% if (listing.type === 'HAVE_FLAT' && (listing.have?.occupantsCount || listing.food || listing.gender)) { %>
        <section class="hv-section" id="occupants">
          <h2 class="hv-h2">Who's Already There</h2>
          <div class="fm-occupant-grid">
            <% if (listing.have?.occupantsCount) { %>
              <div class="fm-occupant-card">
                <div class="fm-occupant-label">Currently Living</div>
                <div class="fm-occupant-val"><%= listing.have.occupantsCount %> <%= listing.have.occupantsType || '' %></div>
              </div>
            <% } %>
            <div class="fm-occupant-card">
              <div class="fm-occupant-label">Food in the Flat</div>
              <div class="fm-occupant-val"><%= listing.food || 'No preference' %></div>
            </div>
            <div class="fm-occupant-card">
              <div class="fm-occupant-label">Looking For</div>
              <div class="fm-occupant-val"><%= listing.gender === 'any' ? 'Any Gender' : (listing.gender === 'male' ? 'Male' : 'Female') %></div>
            </div>
          </div>
        </section>
      <% } %>

      <!-- PREFERENCES — lifestyle/occupation only now (gender & food moved
           to "Who's Already There" above, so they're shown exactly once). -->
      <% const flatLifestyle = (listing.lifestyle || []).flatMap(l => typeof l === 'string' && l.includes(',') ? l.split(',').map(s => s.trim()).filter(Boolean) : [l]); %>
      <% if (listing.occupation || flatLifestyle.length) { %>
        <section class="hv-section" id="preferences">
          <h2 class="hv-h2">Lifestyle</h2>
          <div class="amenities-grid">
            <% if (listing.occupation) { %><div class="amenity-item"><div class="amenity-icon"><i class="fa-solid fa-briefcase"></i></div><span class="amenity-label"><%= listing.occupation %></span></div><% } %>
            <% flatLifestyle.forEach(function(l){ %>
              <div class="amenity-item"><div class="amenity-icon"><i class="fa-solid fa-circle-check"></i></div><span class="amenity-label"><%= l %></span></div>
            <% }) %>
          </div>
        </section>
      <% } %>

      <!-- LOCATION / MAP (HAVE only) — same map-address-row/map-frame-wrap as PG -->
      <% if (listing.type === 'HAVE_FLAT') { %>
        <section class="hv-section" id="location">
          <h2 class="hv-h2">Location</h2>
          <p class="fm-map-approx-note">
            <% if (mapData.precise) { %>
              <i class="fa-solid fa-location-dot" style="color:var(--green)"></i> Exact location shown on the map.
            <% } else { %>
              <i class="fa-solid fa-circle-info"></i> This listing doesn't have a pinned location yet.
            <% } %>
          </p>

          <div id="fmMapUnavailable" class="fm-map-unavailable" style="display:none">
            <i class="fa-solid fa-map"></i>
            <p>Map is temporarily unavailable.</p>
            <button onclick="initFlatmateMap()">Retry</button>
          </div>
          <div class="map-frame-wrap" id="fmMapFrameWrap" style="height:280px">
            <div id="flatmateMap" style="width:100%;height:100%"></div>
          </div>

          <% if (listing.nearbyCache && Object.keys(listing.nearbyCache).length) { %>
            <div class="fm-nearby-highlights-label">Nearby, at a glance</div>
            <div class="fm-nearby-highlights">
              <%
                const categoryMeta = {
                  metro: ['🚇','Metro'], hospital: ['🏥','Hospital'], college: ['🎓','College'],
                  grocery: ['🛒','Grocery'], food: ['🍽️','Food'], pharmacy: ['💊','Pharmacy'],
                  gym: ['🏋️','Gym'], atm: ['🏧','ATM'], movies: ['🎬','Movies'], clubs: ['🌳','Clubs'],
                };
              %>
              <% Object.keys(categoryMeta).forEach(function(cat) { %>
                <% const hit = listing.nearbyCache[cat]; %>
                <% if (hit) { %>
                  <button type="button" class="fm-nearby-highlight-chip" aria-label="View route to <%= hit.name %>, <%= hit.distanceMeters < 1000 ? hit.distanceMeters + ' meters' : (hit.distanceMeters/1000).toFixed(1) + ' km' %> away" onclick='openRoutePanel(<%- JSON.stringify(Object.assign({}, hit, {category: cat})).replace(/</g,"\\u003c") %>)'>
                    <span class="fm-nhc-icon"><%= categoryMeta[cat][0] %></span>
                    <div class="fm-nhc-text"><div class="fm-nhc-name"><%= categoryMeta[cat][1] %> &middot; <%= hit.name %></div><div class="fm-nhc-dist"><%= hit.distanceMeters < 1000 ? hit.distanceMeters + ' m' : (hit.distanceMeters/1000).toFixed(1) + ' km' %> away</div></div>
                  </button>
                <% } %>
              <% }) %>
            </div>
          <% } %>

          <div class="fm-nearby-categories">
            <button class="fm-nearby-cat-btn" data-category="metro" onclick="loadNearby('metro', this)">🚇 Metro</button>
            <button class="fm-nearby-cat-btn" data-category="hospital" onclick="loadNearby('hospital', this)">🏥 Hospital</button>
            <button class="fm-nearby-cat-btn" data-category="college" onclick="loadNearby('college', this)">🎓 College</button>
            <button class="fm-nearby-cat-btn" data-category="grocery" onclick="loadNearby('grocery', this)">🛒 Grocery</button>
            <button class="fm-nearby-cat-btn" data-category="food" onclick="loadNearby('food', this)">🍽️ Food</button>
            <button class="fm-nearby-cat-btn" data-category="pharmacy" onclick="loadNearby('pharmacy', this)">💊 Pharmacy</button>
            <button class="fm-nearby-cat-btn" data-category="gym" onclick="loadNearby('gym', this)">🏋️ Gym</button>
            <button class="fm-nearby-cat-btn" data-category="atm" onclick="loadNearby('atm', this)">🏧 ATM</button>
            <button class="fm-nearby-cat-btn" data-category="movies" onclick="loadNearby('movies', this)">🎬 Movies</button>
            <button class="fm-nearby-cat-btn" data-category="clubs" onclick="loadNearby('clubs', this)">🌳 Clubs</button>
          </div>
          <div id="nearbyResults" class="fm-nearby-results" style=" display:none"></div>

          <div id="routePanel" class="fm-route-panel" style="display:none">
            <div class="fm-route-panel-head">
              <div><div class="fm-route-panel-title">Route to</div><div class="fm-route-panel-dest" id="routeDestName">—</div></div>
              <button class="fm-route-panel-close" onclick="closeRoutePanel()" aria-label="Close route panel"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </div>
            <div class="fm-route-mode-tabs">
              <button class="fm-route-mode-tab active" data-mode="driving" onclick="loadRoute('driving', this)">🚗 Driving</button>
              <button class="fm-route-mode-tab" data-mode="walking" onclick="loadRoute('walking', this)">🚶 Walking</button>
              <button class="fm-route-mode-tab" data-mode="transit" onclick="loadRoute('transit', this)">🚌 Transit</button>
            </div>
            <div id="routeResult" class="fm-route-result">Loading…</div>
          </div>
        </section>
      <% } %>


    </div><!-- /hv-left -->

    <!-- ══ STICKY RIGHT SIDEBAR (same booking-card/host-card as PG) ══ -->
    <div class="hv-right">
      <div class="booking-card">
        <div class="bc-price-row">
          <% if (listing.type === 'HAVE_FLAT') { %>
            <div><div class="bc-from">Rent</div><div class="bc-price">₹<%= (listing.have?.rentMonthly || 0).toLocaleString('en-IN') %><span>/month</span></div></div>
          <% } else { %>
            <div><div class="bc-from">Budget</div><div class="bc-price">₹<%= (listing.need?.budgetMin || 0).toLocaleString('en-IN') %>&ndash;₹<%= (listing.need?.budgetMax || 0).toLocaleString('en-IN') %><span>/mo</span></div></div>
          <% } %>
          <div class="fm-bc-icon-group">
            <% if (!isOwner) { %>
              <button class="bc-wish <%= isSaved ? 'saved' : '' %>" onclick="toggleDetailSave(event, this, '<%= listing._id %>')" title="Save" aria-label="Save to properties" aria-pressed="<%= isSaved ? 'true' : 'false' %>">
                <i class="fa-<%= isSaved ? 'solid' : 'regular' %> fa-heart" aria-hidden="true"></i>
              </button>
            <% } %>
            <button class="bc-wish" onclick="shareFlatmateListing()" title="Share" aria-label="Share this listing">
              <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <% if (listing.type === 'HAVE_FLAT' && (listing.have?.depositAmount || listing.have?.depositNegotiable)) { %>
          <div class="fm-bc-deposit-row">
            <span class="fm-bc-deposit-label">Security Deposit</span>
            <span class="fm-bc-deposit-val"><%= listing.have.depositNegotiable ? 'Negotiable' : '₹' + listing.have.depositAmount.toLocaleString('en-IN') %></span>
          </div>
        <% } %>

        <div class="bc-actions" id="bcActionsSource">
          <% if (cta === 'manage') { %>
            <a class="fm-cta-btn muted" href="/flatmate/my-listings"><i class="fa-solid fa-gear"></i> My Listing</a>
            <div class="fm-cta-sub">Status: <%= listing.status %></div>

          <% } else if (cta === 'closed') { %>
            <button class="fm-cta-btn muted" disabled><i class="fa-solid fa-lock"></i> No longer available</button>

          <% } else if (cta === 'blocked') { %>
            <button class="fm-cta-btn muted" disabled>Unavailable</button>

          <% } else if (cta === 'pending_sent') { %>
            <button class="fm-cta-btn pending" disabled><i class="fa-solid fa-clock"></i> Request Sent</button>
            <div class="fm-cta-sub"><button onclick="cancelRequest('<%= connection._id %>')">Cancel Request</button></div>

          <% } else if (cta === 'connected') { %>
            <% if (conversationId) { %>
              <a class="fm-cta-btn connected" href="/messages/<%= conversationId %>"><i class="fa-solid fa-comment"></i> Chat Now</a>
            <% } else { %>
              <button class="fm-cta-btn connected" disabled><i class="fa-solid fa-circle-check"></i> Connected</button>
              <div class="fm-cta-sub">Visit Messages to start chatting</div>
            <% } %>

          <% } else if (!isOwner) { %>
            <% if (typeof student !== 'undefined' && student) { %>
              <button class="fm-cta-btn connect" id="connectBtn" onclick="openConnectModal()"><i class="fa-solid fa-paper-plane"></i> Send Request</button>
            <% } else { %>
              <button class="fm-cta-btn connect" onclick="openNudgeModal('login', '/flatmate/<%= listing.slug %>#request')"><i class="fa-solid fa-paper-plane"></i> Send Request</button>
            <% } %>
          <% } %>
        </div>

        <div class="bc-trust">
          <div class="trust-item"><i class="fa-solid fa-circle-check"></i><span>Verified listing</span></div>
          <div class="trust-item"><i class="fa-solid fa-ban"></i><span>Zero broker fee</span></div>
        </div>
        <div class="bc-emi"><i class="fa-solid fa-calendar-days"></i> <%= listing.views || 0 %> views</div>
      </div>

      <div class="host-card">
        <h4 class="host-title">Posted by</h4>
        <div class="host-info">
          <div class="host-avatar"><%= (listing.student?.firstName || 'H')[0] %></div>
          <div>
            <div class="host-name"><%= listing.student?.firstName || 'HostelNode User' %></div>
            <div class="host-since"><%= new Date(listing.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></div>
          </div>
        </div>
        <% if (listing.isVerified) { %><span class="htag htag-verified"><i class="fa-solid fa-circle-check"></i> Verified</span><% } %>
      </div>

      <!-- Trust & Safety accordion -->
      <div class="host-card fm-trust-accordion">
        <% const trustItems = [
          { icon:'shield-halved', title:'Verified Listings', body:'Every lister\'s mobile number is verified by HostelNode before their listing goes live, so you\'re always talking to the person on the listing.' },
          { icon:'lock', title:'Secure Requests', body:'Your contact details are never shared until you choose to send a request and the owner accepts it.' },
          { icon:'comments', title:'Messages Stay On HostelNode', body:'Chat happens right here after a request is accepted, so there\'s a record if anything goes wrong.' },
          { icon:'hand-holding-dollar', title:'Zero Brokerage', body:'HostelNode never charges brokerage — you deal directly with the person who posted the listing.' },
        ]; %>
        <% trustItems.forEach(function(t, i) { %>
          <button class="fm-trust-item" onclick="toggleTrustItem(this)" aria-expanded="false">
            <span class="fm-trust-item-head"><i class="fa-solid fa-<%= t.icon %>"></i> <%= t.title %></span>
            <i class="fa-solid fa-chevron-down fm-trust-chevron"></i>
          </button>
          <div class="fm-trust-item-body"><%= t.body %></div>
        <% }) %>
        <a href="javascript:void(0)" class="fm-report-link" onclick="openReportListingModal()">Something feel off? Report this listing</a>
      </div>
    </div><!-- /hv-right -->

  </div><!-- /hv-container -->

  <!-- Report this listing modal -->
  <div class="rc-overlay" id="reportListingOverlay" onclick="if(event.target===this) closeReportListingModal()" role="dialog" aria-modal="true" aria-labelledby="reportModalTitle">
    <div class="rc-box">
      <button class="rc-close" onclick="closeReportListingModal()" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      <h3 id="reportModalTitle">Report this listing</h3>
      <p class="hint">Let us know what's wrong — an admin will review it. This won't notify the listing owner.</p>
      <div class="rc-field">
        <select id="reportReason" style="width:100%;padding:11px 13px;border:1.5px solid var(--border);border-radius:var(--radius-md);font-size:0.85rem;font-family:inherit;margin-bottom:10px">
          <option value="">Select a reason…</option>
          <option>Spam</option>
          <option>Fake profile</option>
          <option>Fraud / Scam</option>
          <option>Inappropriate content</option>
          <option>Other</option>
        </select>
        <textarea id="reportDetails" rows="3" maxlength="1000" placeholder="Any additional details (optional)"></textarea>
      </div>
      <button class="rc-send" id="reportSendBtn" onclick="submitListingReport('<%= listing._id %>', '<%= listing.student?._id %>')">Submit Report</button>
      <div class="rc-alert" id="reportAlert"></div>
    </div>
  </div>

  <!-- MOBILE STICKY BOTTOM BAR — same pattern as the PG/Hostel page.
       The action slot is populated by JS from the sidebar's own CTA
       markup (#bcActionsSource) rather than reimplementing the 5-state
       logic a second time — this guarantees the mobile bar can never
       show a different state than the sidebar. -->
  <div class="mobile-bottom-bar">
    <div class="mbb-price">
      <div class="mbb-from"><%= listing.type === 'HAVE_FLAT' ? 'Rent' : 'Budget' %></div>
      <% if (listing.type === 'HAVE_FLAT') { %>
        <div class="mbb-val">₹<%= (listing.have?.rentMonthly || 0).toLocaleString('en-IN') %>/mo</div>
      <% } else { %>
        <div class="mbb-val">₹<%= (listing.need?.budgetMin || 0).toLocaleString('en-IN') %>&ndash;₹<%= (listing.need?.budgetMax || 0).toLocaleString('en-IN') %></div>
      <% } %>
    </div>
    <div class="mbb-actions" id="mbbActionsTarget"></div>
  </div>

  <!-- Request to Connect modal -->
  <div class="rc-overlay" id="rcOverlay" onclick="if(event.target===this) closeConnectModal()" role="dialog" aria-modal="true" aria-labelledby="connectModalTitle">
    <div class="rc-box">
      <button class="rc-close" onclick="closeConnectModal()" aria-label="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
      <h3 id="connectModalTitle">Request to Connect</h3>
      <p class="hint">You're requesting to connect with <%= listing.student?.firstName || 'this user' %> about this listing.</p>
      <div class="rc-summary">
        <%= listing.type === 'HAVE_FLAT' ? '🏠' : '👤' %> <%= listing.bhk %> BHK &middot; <%= listing.area %>, <%= listing.city %>
        <% if (listing.type === 'HAVE_FLAT') { %> &middot; ₹<%= (listing.have?.rentMonthly||0).toLocaleString('en-IN') %>/mo<% } %>
      </div>
      <div class="rc-field">
        <textarea id="rcMessage" rows="3" maxlength="500" placeholder="Hi, I'm interested in this listing..."></textarea>
      </div>
      <button class="rc-send" id="rcSendBtn" onclick="sendConnectRequest('<%= listing._id %>')">Send Request</button>
      <div class="rc-alert" id="rcAlert"></div>
    </div>
  </div>

<% } %>

<% if (listing) { %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
<script>
/* ── Guest auth modal, with a same-page fallback ──
   The login/signup modal only exists in the DOM for a guest (it's
   rendered inside a server-side "student is not logged in" check
   further down this page). This page is rendered once per request, so
   a normally-guest action calling this always finds the modal. The
   only way it wouldn't is a session that expires mid-view on a page
   that rendered as logged-in — an edge case, but one the old
   hard-redirect never hit, so this keeps that same guarantee instead of
   throwing on an undefined function. */
function goToLoginOrModal(resumeUrl) {
  if (typeof openNudgeModal === 'function') openNudgeModal('login', resumeUrl);
  else window.location.href = '/student/login?next=' + encodeURIComponent(resumeUrl);
}

/* ── LOCATION / MAP ── */
const LISTING_SLUG = <%- JSON.stringify(listing.slug) %>;
const MAP_DATA = <%- JSON.stringify(mapData || null) %>;
const GOOGLE_MAPS_KEY = <%- JSON.stringify(googleMapsApiKey || null) %>;
let flatmateMap = null;
let flatmateMarker = null;
let destMarker = null;
let routePolyline = null;
let currentDestination = null;
let mapLoaded = false;

function showMapUnavailable() {
  const wrap = document.getElementById('fmMapFrameWrap');
  if (wrap) wrap.style.display = 'none';
  const fallback = document.getElementById('fmMapUnavailable');
  if (fallback) fallback.style.display = 'flex';
}

function loadGoogleMapsScript() {
  if (!GOOGLE_MAPS_KEY || !MAP_DATA) { showMapUnavailable(); return; }
  // If the script fails to load or the key is invalid, Google never calls
  // our callback — this timeout catches that case so the page never hangs
  // on a blank map container.
  setTimeout(function () { if (!mapLoaded) showMapUnavailable(); }, 6000);

  const script = document.createElement('script');
  script.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(GOOGLE_MAPS_KEY) + '&libraries=geometry&callback=initFlatmateMap&loading=async';
  script.async = true;
  script.onerror = showMapUnavailable;
  document.head.appendChild(script);
}

function initFlatmateMap() {
  mapLoaded = true;
  const el = document.getElementById('flatmateMap');
  if (!el || !MAP_DATA) return;
  flatmateMap = new google.maps.Map(el, {
    center: { lat: MAP_DATA.lat, lng: MAP_DATA.lng },
    zoom: MAP_DATA.zoom,
    disableDefaultUI: true,
    zoomControl: true,
  });
  flatmateMarker = new google.maps.Marker({
    position: { lat: MAP_DATA.lat, lng: MAP_DATA.lng },
    map: flatmateMap,
    title: MAP_DATA.precise ? 'This property' : 'Approximate area',
  });
  if (!MAP_DATA.precise) {
    // Visually reinforce that this is an area, not a pinpointed address.
    new google.maps.Circle({
      map: flatmateMap,
      center: { lat: MAP_DATA.lat, lng: MAP_DATA.lng },
      radius: 3000,
      fillColor: '#09b850', fillOpacity: 0.08,
      strokeColor: '#09b850', strokeOpacity: 0.3, strokeWeight: 1,
    });
  }
}
window.initFlatmateMap = initFlatmateMap;
loadGoogleMapsScript();

/* ── NEARBY PLACES ── */
async function loadNearby(category, btn) {
  document.querySelectorAll('.fm-nearby-cat-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  closeRoutePanel();

  const box = document.getElementById('nearbyResults');
  box.style.display = 'block';
  box.innerHTML = '<div class="fm-nearby-loading">Finding nearby places…</div>';

  try {
    const res = await fetch('/flatmate/' + LISTING_SLUG + '/nearby?category=' + encodeURIComponent(category));
    const data = await res.json();
    if (!data.success) {
      box.innerHTML = '<div class="fm-nearby-error">' + (data.error || 'Could not load nearby places.') + '</div>';
      return;
    }
    if (!data.places || !data.places.length) {
      box.innerHTML = '<div class="fm-nearby-empty">No nearby places found in this category.</div>';
      return;
    }
    box.innerHTML = data.places.map(function (p, i) {
      const distText = p.distanceMeters != null ? (p.distanceMeters < 1000 ? p.distanceMeters + ' m' : (p.distanceMeters / 1000).toFixed(1) + ' km') : '';
      const distLabel = p.distanceMeters != null ? (p.distanceMeters < 1000 ? p.distanceMeters + ' meters' : (p.distanceMeters / 1000).toFixed(1) + ' km') : '';
      return '<button type="button" class="fm-nearby-result-item" aria-label="View route to ' + escapeHtml(p.name) + (distLabel ? ', ' + distLabel + ' away' : '') + '" onclick=\'openRoutePanel(' + JSON.stringify(p).replace(/'/g, "&#39;") + ')\'>' +
        '<div><div class="fm-nearby-result-name">' + escapeHtml(p.name) + '</div>' +
        (p.address ? '<div class="fm-nearby-result-addr">' + escapeHtml(p.address) + '</div>' : '') + '</div>' +
        '<div class="fm-nearby-result-dist">' + distText + '</div></button>';
    }).join('');
  } catch (err) {
    box.innerHTML = '<div class="fm-nearby-error">Network error — please try again.</div>';
  }
}

function escapeHtml(s) {
  return String(s || '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
}

/* ── ROUTE PANEL ── */
function openRoutePanel(place) {
  currentDestination = place;
  document.getElementById('routePanel').style.display = 'block';
  document.getElementById('routeDestName').textContent = place.name;
  document.querySelectorAll('.fm-route-mode-tab').forEach(t => t.classList.remove('active'));
  document.querySelector('.fm-route-mode-tab[data-mode="driving"]').classList.add('active');
  loadRoute('driving');
  document.getElementById('routePanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  if (flatmateMap && place.lat && place.lng) {
    if (destMarker) destMarker.setMap(null);
    destMarker = new google.maps.Marker({
      position: { lat: place.lat, lng: place.lng }, map: flatmateMap,
      title: place.name, icon: { url: 'https://maps.google.com/mapfiles/ms/icons/blue-dot.png' },
    });
    const bounds = new google.maps.LatLngBounds();
    bounds.extend({ lat: MAP_DATA.lat, lng: MAP_DATA.lng });
    bounds.extend({ lat: place.lat, lng: place.lng });
    flatmateMap.fitBounds(bounds);
  }
}

function closeRoutePanel() {
  document.getElementById('routePanel').style.display = 'none';
  currentDestination = null;
  if (destMarker) { destMarker.setMap(null); destMarker = null; }
  if (routePolyline) { routePolyline.setMap(null); routePolyline = null; }
}

async function loadRoute(mode, tabBtn) {
  if (!currentDestination) return;
  if (tabBtn) {
    document.querySelectorAll('.fm-route-mode-tab').forEach(t => t.classList.remove('active'));
    tabBtn.classList.add('active');
  }
  const resultEl = document.getElementById('routeResult');
  resultEl.textContent = 'Loading…';

  try {
    const res = await fetch('/flatmate/' + LISTING_SLUG + '/route?destLat=' + currentDestination.lat + '&destLng=' + currentDestination.lng + '&mode=' + mode);
    const data = await res.json();
    if (!data.success) {
      resultEl.innerHTML = '<div class="fm-nearby-error">' + (data.error || 'No route available for this mode.') + '</div>';
      if (routePolyline) { routePolyline.setMap(null); routePolyline = null; }
      return;
    }
    const km = (data.distanceMeters / 1000).toFixed(1);
    const mins = Math.round(data.durationSeconds / 60);
    resultEl.innerHTML = '<div class="fm-route-stat-row">' +
      '<div class="fm-route-stat"><span class="val">' + km + ' km</span><span class="lbl">Distance</span></div>' +
      '<div class="fm-route-stat"><span class="val">' + mins + ' min</span><span class="lbl">Duration</span></div>' +
      '</div>';

    if (flatmateMap && data.polyline && google.maps.geometry) {
      if (routePolyline) routePolyline.setMap(null);
      const path = google.maps.geometry.encoding.decodePath(data.polyline);
      routePolyline = new google.maps.Polyline({ path, strokeColor: '#09b850', strokeWeight: 4, map: flatmateMap });
    }
  } catch (err) {
    resultEl.innerHTML = '<div class="fm-nearby-error">Network error — please try again.</div>';
  }
}

/* ── AMENITIES: show only 3 visual rows, "View more/less" toggle ──
   "3 rows" means actual rendered rows in the responsive grid, which
   have a different item count at every breakpoint (2 cols on mobile,
   4+ on desktop) — so this measures each item's real offsetTop after
   layout, rather than guessing a fixed pixel height or item count. */
let amenitiesExpanded = false;
function measureAndApplyAmenityRows() {
  const grid = document.getElementById('amenitiesGrid');
  const toggle = document.getElementById('amenitiesToggle');
  if (!grid || !toggle) return;
  const items = [...grid.children];
  if (!items.length) { toggle.style.display = 'none'; return; }

  // Group items by their rendered row (same offsetTop = same row).
  const rowTops = [...new Set(items.map(el => el.offsetTop))];
  if (rowTops.length <= 3) {
    // 3 or fewer rows total — nothing to collapse, no button per spec.
    items.forEach(el => { el.style.display = ''; });
    toggle.style.display = 'none';
    return;
  }

  toggle.style.display = 'inline-flex';
  const cutoffTop = rowTops[3]; // first row beyond the visible 3
  items.forEach(el => {
    el.style.display = (amenitiesExpanded || el.offsetTop < cutoffTop) ? '' : 'none';
  });
}
function toggleAmenities() {
  amenitiesExpanded = !amenitiesExpanded;
  document.getElementById('amenitiesToggleLabel').textContent = amenitiesExpanded ? 'View less' : 'View more';
  document.getElementById('amenitiesToggleIcon').style.transform = amenitiesExpanded ? 'rotate(180deg)' : 'none';
  measureAndApplyAmenityRows();
}
if (document.getElementById('amenitiesGrid')) {
  measureAndApplyAmenityRows();
  let resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(measureAndApplyAmenityRows, 150);
  });
}

/* ── Staggered entrance animation (reuses PG's own .animate-in / animIn
   keyframe from hostel-view1.css — not a second animation system) ── */
document.querySelectorAll('.hv-section, .booking-card, .host-card').forEach(function (el, i) {
  el.classList.add('animate-in');
  el.style.animationDelay = (i * 0.06) + 's';
});
document.querySelectorAll('.amenity-item, .qstat').forEach(function (el, i) {
  el.classList.add('animate-in');
  el.style.animationDelay = (0.1 + i * 0.03) + 's';
});

/* ── MOBILE BOTTOM BAR: mirror the sidebar's CTA, don't reimplement it ──
   Copies whatever the server already rendered in the sidebar (5 possible
   states, all correctly synced) into the compact mobile bar slot, so the
   two can never disagree. */
(function () {
  const source = document.getElementById('bcActionsSource');
  const target = document.getElementById('mbbActionsTarget');
  if (source && target) target.innerHTML = source.innerHTML;
})();

/* ── PROGRESS NAV: smooth scroll + active-tab tracking ── */
document.querySelectorAll('.pnav-link').forEach(function (link) {
  link.addEventListener('click', function (e) {
    e.preventDefault();
    const target = document.querySelector(this.getAttribute('href'));
    if (!target) return;
    const offset = target.getBoundingClientRect().top + window.scrollY - 80;
    window.scrollTo({ top: offset, behavior: 'smooth' });
  });
});

(function () {
  const pnavLinks = [...document.querySelectorAll('.pnav-link')];
  const sections = pnavLinks.map(l => document.querySelector(l.getAttribute('href'))).filter(Boolean);
  if (!sections.length) return;
  window.addEventListener('scroll', function () {
    let current = sections[0];
    sections.forEach(function (s) {
      if (window.scrollY + 100 >= s.offsetTop) current = s;
    });
    pnavLinks.forEach(function (l) {
      l.classList.toggle('active', l.getAttribute('href') === '#' + current.id);
    });
  }, { passive: true });
})();

/* ── GALLERY: slide + dots + touch swipe (replaces old thumbnail-strip click) ── */
function fmGoToSlide(idx) {
  const wrap = document.querySelector('.fm-gallery-inner');
  if (!wrap) return;
  const slides = wrap.querySelectorAll('.fm-slide');
  const dots = wrap.querySelectorAll('.fm-dot');
  if (!slides.length) return;
  const clamped = (idx + slides.length) % slides.length;
  slides.forEach(s => s.classList.remove('active'));
  dots.forEach(d => d.classList.remove('active'));
  slides[clamped].classList.add('active');
  if (dots[clamped]) dots[clamped].classList.add('active');
}
function fmSlide(dir) {
  const wrap = document.querySelector('.fm-gallery-inner');
  if (!wrap) return;
  const slides = [...wrap.querySelectorAll('.fm-slide')];
  const idx = slides.findIndex(s => s.classList.contains('active'));
  fmGoToSlide(idx + dir);
}
(function () {
  const wrap = document.querySelector('[data-swipe-card]');
  if (!wrap) return;
  let startX = 0, startY = 0, dragging = false;
  wrap.addEventListener('touchstart', e => { if (!e.touches[0]) return; startX = e.touches[0].clientX; startY = e.touches[0].clientY; dragging = true; }, { passive: true });
  wrap.addEventListener('touchmove', e => {
    if (!dragging || !e.touches[0]) return;
    const dx = e.touches[0].clientX - startX, dy = e.touches[0].clientY - startY;
    if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) e.preventDefault();
  }, { passive: false });
  wrap.addEventListener('touchend', e => {
    if (!dragging) return;
    dragging = false;
    const dx = (e.changedTouches[0] ? e.changedTouches[0].clientX : startX) - startX;
    if (Math.abs(dx) < 30) return;
    fmSlide(dx < 0 ? 1 : -1);
  });
})();

/* ── SCROLL-SPY for the sticky tab nav ── */
(function () {
  if (typeof IntersectionObserver === 'undefined') return;
  const sections = [...document.querySelectorAll('.hv-section[id]')];
  const links = [...document.querySelectorAll('.pnav-link')];
  if (!sections.length || !links.length) return;
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        const match = links.find(l => l.getAttribute('href') === '#' + entry.target.id);
        if (match) match.classList.add('active');
      }
    });
  }, { rootMargin: '-40% 0px -50% 0px' });
  sections.forEach(s => observer.observe(s));
})();

async function toggleDetailSave(e, btn, listingId) {
  e.stopPropagation();
  try {
    const res = await fetch('/student/saved/toggle', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ listingType: 'flatmate', listingId }),
    });
    if (res.redirected || res.status === 401) {
      goToLoginOrModal(window.location.pathname);
      return;
    }
    const data = await res.json();
    if (data.success) {
      btn.classList.toggle('saved', data.saved);
      btn.setAttribute('aria-pressed', data.saved ? 'true' : 'false');
      btn.querySelector('i').className = data.saved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
    }
  } catch (err) { /* silent — non-critical action */ }
}

/* ── Share (same pattern as PG/Hostel's shareHostel(), reused not
   reinvented — Web Share API where available, WhatsApp link fallback) ── */
function shareFlatmateListing() {
  const url = window.location.href;
  const text = <%- JSON.stringify((listing.type === 'HAVE_FLAT' ? '🏠 ' + listing.bhk + ' BHK in ' + listing.area : '👤 Looking for a flat in ' + listing.area) + ' on HostelNode') %>;

  if (navigator.share) {
    navigator.share({ title: document.title, text, url })
      .then(() => console.log('Shared successfully'))
      .catch((err) => console.log('Share cancelled', err));
  } else {
    window.open('https://wa.me/?text=' + encodeURIComponent(text + ' ' + url), '_blank');
  }
}

/* ── Trust & Safety accordion ── */
function toggleTrustItem(btn) {
  const body = btn.nextElementSibling;
  const isOpen = btn.getAttribute('aria-expanded') === 'true';
  btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
  body.classList.toggle('open', !isOpen);
}

/* ── Report this listing (reuses the existing /messages/report endpoint —
   it already supports an optional listingId with no conversation
   required, so no new backend route needed) ── */
/* ── Modal accessibility: Escape closes whichever is open, focus moves
   into the modal and returns to whatever triggered it on close ── */
let fmLastFocusedEl = null;
function fmOpenModal(overlayId) {
  fmLastFocusedEl = document.activeElement;
  const overlay = document.getElementById(overlayId);
  overlay.classList.add('open');
  document.body.style.overflow = 'hidden';
  const closeBtn = overlay.querySelector('.rc-close');
  if (closeBtn) closeBtn.focus();
}
function fmCloseModal(overlayId) {
  document.getElementById(overlayId).classList.remove('open');
  document.body.style.overflow = '';
  if (fmLastFocusedEl && typeof fmLastFocusedEl.focus === 'function') fmLastFocusedEl.focus();
}
document.addEventListener('keydown', function (e) {
  if (e.key !== 'Escape') return;
  const openOverlay = document.querySelector('.rc-overlay.open');
  if (!openOverlay) return;
  if (openOverlay.id === 'reportListingOverlay') closeReportListingModal();
  else if (openOverlay.id === 'rcOverlay') closeConnectModal();
});

function openReportListingModal() {
  const isLoggedIn = <%= typeof student !== 'undefined' && student ? 'true' : 'false' %>;
  if (!isLoggedIn) { goToLoginOrModal(window.location.pathname); return; }
  fmOpenModal('reportListingOverlay');
}
function closeReportListingModal() {
  fmCloseModal('reportListingOverlay');
}
async function submitListingReport(listingId, reportedUserId) {
  const reason = document.getElementById('reportReason').value;
  const details = document.getElementById('reportDetails').value.trim();
  const alertEl = document.getElementById('reportAlert');
  if (!reason) { alertEl.textContent = 'Please select a reason.'; alertEl.classList.add('show'); return; }

  const btn = document.getElementById('reportSendBtn');
  btn.disabled = true; btn.textContent = 'Submitting…';
  try {
    const res = await fetch('/messages/report', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reportedUserId, listingId, reason, details }),
    });
    const data = await res.json();
    if (data.success) {
      closeReportListingModal();
      if (typeof showToastMsg === 'function') showToastMsg('Report submitted — thank you.');
      else alert('Report submitted — thank you.');
    } else {
      alertEl.textContent = data.error || 'Could not submit report.'; alertEl.classList.add('show');
    }
  } catch (e) {
    alertEl.textContent = 'Network error — please try again.'; alertEl.classList.add('show');
  } finally {
    btn.disabled = false; btn.textContent = 'Submit Report';
  }
}

function openConnectModal() {
  fmOpenModal('rcOverlay');
}
function closeConnectModal() {
  fmCloseModal('rcOverlay');
}

// Cards elsewhere on the site (Featured, search results) link "Request to
// Talk" to /flatmate/<slug>#request — land here with the connect modal
// already open, instead of the hash doing nothing.
if (window.location.hash === '#request' && document.getElementById('connectBtn')) {
  openConnectModal();
}

async function sendConnectRequest(listingId) {
  const btn = document.getElementById('rcSendBtn');
  const alertBox = document.getElementById('rcAlert');
  const original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Sending…';
  try {
    const res = await fetch('/flatmate/connect', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ listingId, message: document.getElementById('rcMessage').value.trim() }),
    });
    if (res.status === 302 || res.redirected) {
      // Session expired while the request modal was open (rare — the
      // button only shows to a logged-in student to begin with) — close
      // it and resume via the login modal instead of a hard redirect.
      closeConnectModal();
      goToLoginOrModal(window.location.pathname + '#request');
      return;
    }
    const data = await res.json();
    btn.disabled = false; btn.innerHTML = original;
    if (data.success) {
      closeConnectModal();
      window.location.reload();
    } else {
      alertBox.textContent = data.error || 'Something went wrong.';
      alertBox.classList.add('show');
    }
  } catch (err) {
    btn.disabled = false; btn.innerHTML = original;
    alertBox.textContent = 'Network error — please try again.';
    alertBox.classList.add('show');
  }
}

async function cancelRequest(connectionId) {
  if (!confirm('Cancel this request?')) return;
  try {
    const res = await fetch('/flatmate/connection/' + connectionId + '/cancel', { method: 'POST' });
    const data = await res.json();
    if (data.success) window.location.reload();
    else alert(data.error || 'Could not cancel request.');
  } catch (err) {
    alert('Network error — please try again.');
  }
}
</script>
