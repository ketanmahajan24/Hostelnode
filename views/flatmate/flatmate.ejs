<style>.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  setTimeout(function () {
    var loader = document.getElementById('hn-loader');
    loader.style.opacity = '0';
    setTimeout(function () { loader.style.display = 'none'; }, 400);
  }, 900);

  /* ── SCROLL-REVEAL (subtle, one-time, animate once) ── */
  var revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    revealEls.forEach(function (el) { io.observe(el); });
  } else {
    revealEls.forEach(function (el) { el.classList.add('in'); });
  }

  /* ── FEEDBACK STAR PICKER ── */
  var stars = document.querySelectorAll('#fbStars button');
  window._fbRating = 5;
  stars.forEach(function (starBtn) {
    starBtn.addEventListener('click', function () {
      window._fbRating = parseInt(this.dataset.v, 10);
      stars.forEach(function (s) {
        s.querySelector('i').classList.toggle('active', parseInt(s.dataset.v, 10) <= window._fbRating);
      });
    });
  });
  stars.forEach(function (s) {
    s.querySelector('i').classList.toggle('active', parseInt(s.dataset.v, 10) <= window._fbRating);
  });
});

/* ── RESULT TABS (client-side, no reload) — preserves existing setFeedType() ── */
function setFeedType(type, btn) {
  document.querySelectorAll('.hn-flatmate-tab').forEach(function (t) {
    t.classList.remove('active');
    t.setAttribute('aria-selected', 'false');
  });
  btn.classList.add('active');
  btn.setAttribute('aria-selected', 'true');

  var cards = document.querySelectorAll('#fmGrid .hn-flatmate-card');
  var visible = 0;
  cards.forEach(function (c) {
    var match = !type || c.dataset.type === type;
    c.style.display = match ? '' : 'none';
    if (match) visible++;
  });
  var countEl = document.getElementById('fmResultsCount');
  if (countEl) countEl.textContent = visible;

  var emptyEl = document.querySelector('#fmGrid .hn-flatmate-empty');
  if (emptyEl) emptyEl.style.display = visible === 0 ? '' : 'none';
}

/* ── MORE FILTERS TOGGLE (desktop inline) ── */
function toggleExtraFilters() {
  var el = document.getElementById('fmExtraFilters');
  var open = el.classList.toggle('open');
  var btn = document.querySelector('.hn-flatmate-more-filters button');
  if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
}
function submitWithExtra() {
  var form = document.getElementById('flatmateSearchForm');
  var budget = document.getElementById('fmBudget').value;
  var bhk = document.getElementById('fmBhk').value;
  var addHidden = function (name, val) {
    if (!val) return;
    var inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = name; inp.value = val;
    form.appendChild(inp);
  };
  addHidden('budget', budget);
  addHidden('bhk', bhk);
  form.submit();
}

/* ── MOBILE FILTER DRAWER (preserved API: openFilterDrawer / closeFilterDrawer) ── */
function openFilterDrawer() {
  document.getElementById('fmDrawerOverlay').classList.add('open');
  document.getElementById('fmDrawer').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeFilterDrawer() {
  document.getElementById('fmDrawerOverlay').classList.remove('open');
  document.getElementById('fmDrawer').classList.remove('open');
  document.body.style.overflow = '';
}
function applyDrawerFilters() {
  var form = document.getElementById('flatmateSearchForm');
  var gender = document.getElementById('drawerGender').value;
  var budget = document.getElementById('drawerBudget').value;
  var bhk = document.getElementById('drawerBhk').value;
  document.getElementById('fmGender').value = gender;
  var addHidden = function (name, val) {
    if (!val) return;
    var inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = name; inp.value = val;
    form.appendChild(inp);
  };
  addHidden('budget', budget);
  addHidden('bhk', bhk);
  form.submit();
}

/* ── HORIZONTAL SCROLL BUTTONS (across-India row) ── */
function scrollRow(id, dir) {
  var track = document.getElementById(id);
  if (track) track.scrollBy({ left: dir * 280, behavior: 'smooth' });
}

/* ── SORT (client-side re-order, main feed only) ── */
document.getElementById('fmSort')?.addEventListener('change', function () {
  var grid = document.getElementById('fmGrid');
  var cards = Array.prototype.slice.call(grid.querySelectorAll('.hn-flatmate-card'));
  var val = this.value;
  cards.sort(function (a, b) {
    var pa = parseInt(a.querySelector('.hn-flatmate-card-price').textContent.replace(/[^0-9]/g, '')) || 0;
    var pb = parseInt(b.querySelector('.hn-flatmate-card-price').textContent.replace(/[^0-9]/g, '')) || 0;
    if (val === 'price-low') return pa - pb;
    if (val === 'price-high') return pb - pa;
    return 0;
  });
  if (val === 'latest') return;
  cards.forEach(function (c) { grid.appendChild(c); });
});

/* ── WISHLIST TOGGLE (existing behaviour + small pop animation) ── */
function toggleFmWish(e, el) {
  el.classList.toggle('saved');
  el.setAttribute('aria-pressed', el.classList.contains('saved') ? 'true' : 'false');
  el.querySelector('i').className = el.classList.contains('saved') ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
  el.classList.add('pop');
  setTimeout(function () { el.classList.remove('pop'); }, 200);
}

/* ── REQUEST TO TALK (stub — wires to modal once backend exists) ── */
function requestToTalk(id) {
  window.location.href = '/flatmate/' + id + '#request';
}

/* ── FEEDBACK MODAL ── */
function openFeedbackModal() {
  document.getElementById('fbOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeFeedbackModal() {
  document.getElementById('fbOverlay').classList.remove('open');
  document.body.style.overflow = '';
}
async function submitFeedback() {
  var message = document.getElementById('fbMessage').value.trim();
  var name = document.getElementById('fbName').value.trim();
  var btn = document.getElementById('fbSubmitBtn');
  if (!message) {
    document.getElementById('fbMessage').style.borderColor = '#e53e3e';
    return;
  }
  var original = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = 'Sending…';
  try {
    var res = await fetch('/flatmate/feedback', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, rating: window._fbRating, message: message })
    });
    var data = await res.json();
    btn.disabled = false; btn.innerHTML = original;
    if (data.success) {
      document.getElementById('fbForm').style.display = 'none';
      document.getElementById('fbSuccess').style.display = 'block';
      setTimeout(closeFeedbackModal, 2200);
    }
  } catch (err) {
    btn.disabled = false; btn.innerHTML = original;
    console.error('Feedback submit error:', err);
  }
}

/* ── ESCAPE KEY closes any open modal/drawer ── */
document.addEventListener('keydown', function (e) {
  if (e.key !== 'Escape') return;
  if (document.getElementById('fbOverlay').classList.contains('open')) closeFeedbackModal();
  if (document.getElementById('fmDrawer').classList.contains('open')) closeFilterDrawer();
});
</script>
</body>
</html>
