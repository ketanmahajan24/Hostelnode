  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:opsz,wght@14..32,300..700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/findhostel.css">
  <link rel="stylesheet" href="style.css">

  <style>
    /* ══════════════════════════════════════════════════════════
       HN-FLATMATE — scoped styles, reuses tokens from findhostel.css
       Does not touch global .card/.btn/.container/.navbar/.row
    ══════════════════════════════════════════════════════════ */

    .hn-flatmate-page { background: var(--bg); overflow-x: hidden; max-width: 100vw; }

    /* ---- reduced motion (mandatory, overrides everything below) ---- */
    @media (prefers-reduced-motion: reduce) {
      .hn-flatmate-page *, .hn-flatmate-page *::before, .hn-flatmate-page *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* ---- scroll-reveal (subtle, one-time, opacity+transform only) ---- */
    .reveal { opacity: 0; transform: translateY(16px); transition: opacity .55s ease, transform .55s ease; }
    .reveal.in { opacity: 1; transform: none; }

    /* ---- HERO — staggered entrance on load ---- */
    .hn-flatmate-hero { padding: 52px 24px 8px; text-align: center; max-width: 700px; margin: 0 auto; }
    @keyframes hnFadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
    .hn-hero-anim { opacity: 0; animation: hnFadeUp 650ms cubic-bezier(0.22, 1, 0.36, 1) forwards; }
    .hn-hero-eyebrow-a  { animation-delay: 0ms; }
    .hn-hero-h1-a       { animation-delay: 100ms; }
    .hn-hero-tagline-a  { animation-delay: 200ms; }
    .hn-hero-sub-a      { animation-delay: 300ms; }
    .hn-hero-stats-a    { animation-delay: 350ms; }
    .hn-hero-cta-a      { animation-delay: 400ms; }
    .hn-hero-cta-a.need { animation-delay: 400ms; }
    .hn-hero-cta-a.have { animation-delay: 500ms; }

    .hn-flatmate-eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 16px; border-radius: 999px;
      background: var(--green-light); border: 1px solid var(--green-border);
      color: var(--green-dark); font-size: 12px; font-weight: 800;
      letter-spacing: .6px; text-transform: uppercase; margin-bottom: 16px;
    }
    .hn-flatmate-eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: hnDotPulse 1.8s ease infinite; }
    @keyframes hnDotPulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
    .hn-flatmate-h1 {
      font-family: var(--font-d); font-size: clamp(1.9rem, 5vw, 2.7rem);
      font-weight: 700; letter-spacing: -0.02em; color: var(--ink); line-height: 1.12;
    }
    .hn-flatmate-h1 span { color: var(--green); }
    .hn-flatmate-tagline { font-size: 1.1rem; font-weight: 600; color: var(--ink-mid); margin-top: 6px; }
    .hn-flatmate-sub { font-size: .95rem; color: var(--muted); margin-top: 10px; line-height: 1.6; }

    /* ---- floating decorative shapes (subtle, transform/opacity only) ---- */
    .hn-flatmate-hero { position: relative; }
    .hn-hero-blob { position: absolute; font-size: 22px; opacity: .18; color: var(--green); pointer-events: none; user-select: none; }
    .hn-hero-blob.b1 { top: 6px; left: 4%; animation: hnFloat1 16s ease-in-out infinite; }
    .hn-hero-blob.b2 { top: 60px; right: 5%; animation: hnFloat2 20s ease-in-out infinite; }
    .hn-hero-blob.b3 { bottom: 0; left: 12%; animation: hnFloat1 18s ease-in-out infinite reverse; }
    @keyframes hnFloat1 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(6px,-14px); } }
    @keyframes hnFloat2 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-8px,10px); } }

    /* ---- TRUST STATS (real numbers, not fabricated) ---- */
    .hn-flatmate-stats { display: flex; justify-content: center; gap: 34px; margin: 26px auto 0; flex-wrap: wrap; }
    .hn-flatmate-stat { text-align: center; }
    .hn-flatmate-stat b { display: block; font-family: var(--font-d); font-size: 1.4rem; font-weight: 700; color: var(--ink); }
    .hn-flatmate-stat span { font-size: 11px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .3px; }

    /* ---- CTA CARDS (posting options) ---- */
    .hn-flatmate-ctas {
      max-width: 900px; margin: 34px auto 0; padding: 0 24px;
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
    }
    .hn-flatmate-cta-card {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg);
      padding: 26px 22px; text-align: left; box-shadow: var(--shadow-sm); position: relative;
      transition: transform .2s cubic-bezier(.22,1,.36,1), box-shadow .2s ease, border-color .2s ease;
    }
    .hn-flatmate-cta-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--green-border); }
    .hn-flatmate-cta-icon {
      width: 50px; height: 50px; border-radius: 15px; display: flex; align-items: center; justify-content: center;
      font-size: 21px; margin-bottom: 15px; transition: transform .2s ease;
    }
    .hn-flatmate-cta-card:hover .hn-flatmate-cta-icon { transform: scale(1.06) rotate(-3deg); }
    .hn-flatmate-cta-card.need .hn-flatmate-cta-icon { background: var(--green-light); color: var(--green-dark); }
    .hn-flatmate-cta-card.have .hn-flatmate-cta-icon { background: #eaf1ff; color: #2563eb; }
    .hn-flatmate-cta-card h3 { font-family: var(--font-d); font-size: 1.1rem; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
    .hn-flatmate-cta-card p { font-size: 13px; color: var(--muted); line-height: 1.55; margin-bottom: 16px; min-height: 38px; }
    .hn-flatmate-cta-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 11px 20px;
      border-radius: 999px; font-size: 13.5px; font-weight: 700; border: none; cursor: pointer;
      transition: transform .15s, box-shadow .15s;
    }
    .hn-flatmate-cta-card.need .hn-flatmate-cta-btn { background: linear-gradient(135deg, var(--green), #00c264); color: #fff; box-shadow: 0 6px 20px rgba(9,184,80,.32); }
    .hn-flatmate-cta-card.have .hn-flatmate-cta-btn { background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; box-shadow: 0 6px 20px rgba(37,99,235,.32); }
    .hn-flatmate-cta-btn:hover { transform: translateY(-2px); }
    .hn-flatmate-cta-btn i { transition: transform .15s ease; }
    .hn-flatmate-cta-btn:hover i { transform: translateX(3px); }

    /* ---- SEARCH: "Looking for Flatmates" ---- */
    .hn-flatmate-search-wrap { max-width: 860px; margin: 30px auto 0; padding: 0 24px; }
    .hn-flatmate-search-heading { text-align: center; font-family: var(--font-d); font-size: 1.05rem; font-weight: 700; color: var(--ink); margin-bottom: 12px; }
    .hn-flatmate-search {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm); padding: 8px; display: flex; align-items: stretch; gap: 4px; flex-wrap: wrap;
      transition: box-shadow .2s ease;
    }
    .hn-flatmate-search:focus-within { box-shadow: var(--shadow-md), 0 0 0 4px var(--green-glow); }
    .hn-flatmate-field { flex: 1; min-width: 130px; display: flex; align-items: center; gap: 10px; padding: 9px 16px; border-radius: var(--radius-md); transition: background .15s; }
    .hn-flatmate-field:focus-within { background: var(--green-light); }
    .hn-flatmate-field:not(:last-child) { border-right: 1px solid var(--border); }
    .hn-flatmate-field i { color: var(--green); font-size: 14px; flex-shrink: 0; transition: transform .15s; }
    .hn-flatmate-field:focus-within i { transform: scale(1.1); }
    .hn-flatmate-field .fld-wrap { display: flex; flex-direction: column; width: 100%; }
    .hn-flatmate-field label { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .3px; color: var(--muted-light); }
    .hn-flatmate-field select, .hn-flatmate-field input {
      border: none; outline: none; background: transparent; font-size: 14px; font-weight: 600; color: var(--ink);
      font-family: var(--font-b); padding: 2px 0; width: 100%;
    }
    .hn-flatmate-field select { cursor: pointer; }
    .hn-flatmate-search-btn {
      background: linear-gradient(135deg, var(--green), #00c264); color: #fff; border: none;
      border-radius: var(--radius-md); padding: 0 26px; font-size: 14px; font-weight: 700;
      display: flex; align-items: center; gap: 8px; box-shadow: var(--shadow-green); cursor: pointer; flex-shrink: 0;
      transition: transform .15s, box-shadow .15s;
    }
    .hn-flatmate-search-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(9,184,80,.32); }
    .hn-flatmate-filter-btn {
      display: none; align-items: center; gap: 8px; background: var(--card-bg); border: 1px solid var(--border);
      border-radius: var(--radius-md); padding: 12px 16px; font-size: 13.5px; font-weight: 700; color: var(--ink);
      cursor: pointer; flex-shrink: 0;
    }
    .hn-flatmate-more-filters { text-align: center; margin-top: 10px; }
    .hn-flatmate-more-filters button {
      background: none; border: none; font-size: 12.5px; font-weight: 700; color: var(--muted); cursor: pointer;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .hn-flatmate-more-filters button:hover { color: var(--green-dark); }
    .hn-flatmate-extra-filters {
      max-width: 860px; margin: 10px auto 0; padding: 0 24px; display: none; gap: 10px; flex-wrap: wrap;
    }
    .hn-flatmate-extra-filters.open { display: flex; }
    .hn-flatmate-extra-filters select {
      border: 1.5px solid var(--border); border-radius: 999px; padding: 8px 16px; font-size: 13px; font-weight: 600;
      color: var(--ink); background: #fff;
    }
    .hn-flatmate-active-filter-note { max-width: 860px; margin: 12px auto 0; padding: 0 24px; text-align: center; font-size: 13px; color: var(--muted); }
    .hn-flatmate-active-filter-note a { color: var(--green-dark); font-weight: 700; }

    /* ---- ACROSS INDIA (compact horizontal-scroll strip) ---- */
    .hn-flatmate-across { max-width: 1180px; margin: 40px auto 0; padding: 0 24px; }
    .hn-flatmate-across-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 14px; }
    .hn-flatmate-across-head h2 { font-family: var(--font-d); font-size: 1.25rem; font-weight: 700; color: var(--ink); display: flex; align-items: center; gap: 8px; }
    .hn-flatmate-across-head h2 i { color: var(--green); font-size: 15px; }
    .hn-flatmate-row-scroll-btns { display: flex; gap: 6px; }
    .hn-flatmate-row-scroll-btns button {
      width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid var(--border); background: #fff;
      color: var(--ink-mid); font-size: 12px; display: flex; align-items: center; justify-content: center;
      transition: all .15s;
    }
    .hn-flatmate-row-scroll-btns button:hover { border-color: var(--green); color: var(--green-dark); }

    .hn-flatmate-across-pills { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin-bottom: 16px; scrollbar-width: none; }
    .hn-flatmate-across-pills::-webkit-scrollbar { display: none; }
    .hn-flatmate-across-pills a {
      flex: 0 0 auto; padding: 6px 14px; border-radius: 999px; border: 1.5px solid var(--border); background: var(--card-bg);
      font-size: 12.5px; font-weight: 700; color: var(--ink-mid); transition: all .15s; white-space: nowrap;
    }
    .hn-flatmate-across-pills a:hover, .hn-flatmate-across-pills a.active { border-color: var(--green); background: var(--green-light); color: var(--green-dark); }

    .hn-flatmate-row-track {
      display: flex; gap: 16px; overflow-x: auto; padding-bottom: 10px; scroll-snap-type: x proximity;
      scroll-behavior: smooth; scrollbar-width: none;
    }
    .hn-flatmate-row-track::-webkit-scrollbar { display: none; }
    .hn-flatmate-row-card-wrap { flex: 0 0 250px; scroll-snap-align: start; }

    /* ---- CARD (shared shape for both listing types & rows) ---- */
    .hn-flatmate-card {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg);
      overflow: hidden; box-shadow: var(--shadow-xs); transition: transform .2s ease, box-shadow .2s ease; cursor: pointer;
      display: flex; flex-direction: column; height: 100%;
    }
    .hn-flatmate-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }

    .hn-flatmate-card-img { position: relative; aspect-ratio: 4/3; background: var(--bg2); overflow: hidden; }
    .hn-flatmate-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
    .hn-flatmate-card:hover .hn-flatmate-card-img img { transform: scale(1.03); }
    .hn-flatmate-card-img.placeholder-need {
      display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8px;
      background: linear-gradient(135deg,#eaf1ff,#f5f8ff); color: #2563eb;
    }
    .hn-flatmate-card-img.placeholder-need i { font-size: 28px; }
    .hn-flatmate-card-img.placeholder-need span { font-size: 11.5px; font-weight: 700; }

    .hn-flatmate-badge {
      position: absolute; top: 12px; left: 12px; display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 12px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: .3px;
      backdrop-filter: blur(6px);
    }
    .hn-flatmate-badge.have { background: rgba(9,184,80,.92); color: #fff; }
    .hn-flatmate-badge.need { background: rgba(37,99,235,.92); color: #fff; }

    .hn-flatmate-wish {
      position: absolute; top: 12px; right: 12px; width: 30px; height: 30px; border-radius: 50%;
      background: rgba(255,255,255,.92); border: none; display: flex; align-items: center; justify-content: center;
      color: #94a3a8; font-size: 13px; box-shadow: 0 2px 8px rgba(0,0,0,.12); transition: transform .2s cubic-bezier(.34,1.56,.64,1);
    }
    .hn-flatmate-wish.pop { transform: scale(1.2); }
    .hn-flatmate-wish.saved { color: #e53e3e; }

    .hn-flatmate-card-body { padding: 14px 14px 12px; display: flex; flex-direction: column; gap: 7px; flex: 1; }
    .hn-flatmate-card-title { font-family: var(--font-d); font-size: 14.5px; font-weight: 700; color: var(--ink); }
    .hn-flatmate-card-loc { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
    .hn-flatmate-card-loc i { color: var(--green); font-size: 11px; }
    .hn-flatmate-card-gender {
      display: inline-flex; align-self: flex-start; font-size: 10.5px; font-weight: 700; color: var(--muted);
      background: var(--bg2); padding: 3px 9px; border-radius: 999px;
    }

    .hn-flatmate-card-price { font-family: var(--font-d); font-size: 16px; font-weight: 700; color: var(--ink); }
    .hn-flatmate-card-price span { font-size: 11.5px; font-weight: 500; color: var(--muted-light); }
    .hn-flatmate-card-meta { font-size: 11.5px; color: var(--muted); }

    .hn-flatmate-card-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; padding-top: 11px; border-top: 1px solid var(--border); }
    .hn-flatmate-poster { font-size: 12px; font-weight: 700; color: var(--ink-mid); }
    .hn-flatmate-talk-btn {
      background: var(--ink); color: #fff; border: none; border-radius: 999px; padding: 8px 14px;
      font-size: 11.5px; font-weight: 700; display: flex; align-items: center; gap: 6px; transition: background .15s, transform .15s;
    }
    .hn-flatmate-talk-btn:hover { background: var(--green-dark); transform: translateY(-1px); }
    .hn-flatmate-talk-btn:active { transform: scale(.96); }

    /* ---- RESULT TABS (All / Need a Flat / Have a Flat) ---- */
    .hn-flatmate-tabs-wrap { max-width: 1180px; margin: 44px auto 0; padding: 0 24px; }
    .hn-flatmate-tabs { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
    .hn-flatmate-tabs::-webkit-scrollbar { display: none; }
    .hn-flatmate-tab {
      flex: 0 0 auto; padding: 9px 18px; border-radius: 999px; border: 1.5px solid var(--border); background: var(--card-bg);
      font-size: 13.5px; font-weight: 700; color: var(--muted); cursor: pointer; transition: background .2s ease, color .2s ease, border-color .2s ease;
    }
    .hn-flatmate-tab.active { background: var(--ink); border-color: var(--ink); color: #fff; }
    .hn-flatmate-tab .cnt { opacity: .65; font-weight: 500; margin-left: 4px; transition: opacity .2s ease; }

    /* ---- FLATS & FLATMATES (main feed) ---- */
    .hn-flatmate-feed { max-width: 1180px; margin: 20px auto 0; padding: 0 24px 60px; }
    .hn-flatmate-feed-head { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    .hn-flatmate-feed-head h2 { font-family: var(--font-d); font-size: 1.4rem; font-weight: 700; color: var(--ink); }
    .hn-flatmate-feed-head .cnt { font-size: 13px; color: var(--muted); margin-top: 2px; }
    .hn-flatmate-sort { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
    .hn-flatmate-sort select { border: 1px solid var(--border); border-radius: 10px; padding: 7px 12px; font-size: 13px; font-weight: 600; color: var(--ink); background: #fff; }

    .hn-flatmate-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .hn-flatmate-grid .hn-flatmate-card { animation: hnCardIn .5s ease both; }
    @keyframes hnCardIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }

    /* ---- EMPTY STATE ---- */
    .hn-flatmate-empty { grid-column: 1/-1; text-align: center; padding: 60px 20px; color: var(--muted); transition: opacity .25s ease; }
    .hn-flatmate-empty i { font-size: 2rem; color: var(--border-dark); display: block; margin-bottom: 14px; }
    .hn-flatmate-empty h3 { font-family: var(--font-d); font-size: 1.1rem; color: var(--ink); margin-bottom: 6px; }
    .hn-flatmate-empty a { color: var(--green); font-weight: 700; }

    /* ---- SEO CONTENT SECTION ---- */
    .hn-flatmate-seo { max-width: 900px; margin: 0 auto; padding: 10px 24px 50px; }
    .hn-flatmate-seo h2 { font-family: var(--font-d); font-size: 1.25rem; font-weight: 700; color: var(--ink); margin-bottom: 10px; }
    .hn-flatmate-seo p { font-size: 13.5px; color: var(--muted); line-height: 1.7; }

    /* ---- FEEDBACK / TESTIMONIALS ---- */
    .hn-flatmate-feedback { background: var(--bg2); padding: 56px 24px; }
    .hn-flatmate-feedback-inner { max-width: 980px; margin: 0 auto; }
    .hn-flatmate-feedback-tag { text-align: center; font-size: 12px; font-weight: 800; letter-spacing: .8px; color: var(--green-dark); text-transform: uppercase; margin-bottom: 8px; }
    .hn-flatmate-feedback h2 { text-align: center; font-family: var(--font-d); font-size: 1.6rem; font-weight: 700; color: var(--ink); margin-bottom: 8px; }
    .hn-flatmate-feedback > .hn-flatmate-feedback-inner > p.sub { text-align: center; font-size: 13.5px; color: var(--muted); margin-bottom: 30px; }
    .hn-flatmate-feedback-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
    .hn-flatmate-feedback-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; transition: transform .2s ease, box-shadow .2s ease; }
    .hn-flatmate-feedback-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-sm); }
    .hn-flatmate-feedback-stars { color: #f5a623; font-size: 13px; margin-bottom: 10px; letter-spacing: 2px; }
    .hn-flatmate-feedback-quote { font-size: 13.5px; color: var(--ink-mid); line-height: 1.6; font-style: italic; margin-bottom: 16px; }
    .hn-flatmate-feedback-person { display: flex; align-items: center; gap: 10px; }
    .hn-flatmate-feedback-avatar {
      width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--green), #00c264);
      color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; flex-shrink: 0;
    }
    .hn-flatmate-feedback-name { font-size: 13px; font-weight: 700; color: var(--ink); }
    .hn-flatmate-feedback-role { font-size: 11.5px; color: var(--muted); }
    .hn-flatmate-feedback-cta { text-align: center; }
    .hn-flatmate-feedback-cta button {
      background: linear-gradient(135deg, var(--green), #00c264); color: #fff; border: none; border-radius: 999px;
      padding: 12px 26px; font-size: 13.5px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px;
      box-shadow: var(--shadow-green); cursor: pointer; transition: transform .15s, box-shadow .15s;
    }
    .hn-flatmate-feedback-cta button:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(9,184,80,.36); }

    /* ---- FEEDBACK MODAL ---- */
    .hn-fb-overlay { position: fixed; inset: 0; background: rgba(10,22,40,.55); backdrop-filter: blur(4px); z-index: 99999; display: flex; align-items: center; justify-content: center; padding: 16px; opacity: 0; pointer-events: none; transition: opacity .22s; }
    .hn-fb-overlay.open { opacity: 1; pointer-events: all; }
    .hn-fb-box { background: #fff; border-radius: 22px; width: 100%; max-width: 420px; padding: 26px; position: relative; box-shadow: 0 24px 70px rgba(10,22,40,.28); transform: translateY(16px) scale(.96); opacity: 0; transition: transform .22s cubic-bezier(.22,1,.36,1), opacity .22s ease; }
    .hn-fb-overlay.open .hn-fb-box { transform: translateY(0) scale(1); opacity: 1; }
    .hn-fb-close { position: absolute; top: 16px; right: 16px; width: 30px; height: 30px; border-radius: 50%; border: none; background: var(--bg2); color: var(--muted); cursor: pointer; }
    .hn-fb-box h3 { font-family: var(--font-d); font-size: 1.15rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .hn-fb-box p.hint { font-size: 12.5px; color: var(--muted); margin-bottom: 18px; }
    .hn-fb-stars { display: flex; gap: 6px; margin-bottom: 16px; }
    .hn-fb-stars button { background: none; border: none; padding: 0; cursor: pointer; }
    .hn-fb-stars i { font-size: 22px; color: var(--border-dark); transition: color .15s, transform .1s; }
    .hn-fb-stars i.active { color: #f5a623; transform: scale(1.08); }
    .hn-fb-field { margin-bottom: 14px; }
    .hn-fb-field label { display: block; font-size: 12px; font-weight: 600; color: var(--ink-mid); margin-bottom: 6px; }
    .hn-fb-field input, .hn-fb-field textarea {
      width: 100%; padding: 11px 13px; border: 1.5px solid var(--border); border-radius: 12px; font-size: 14px;
      font-family: inherit; color: var(--ink); outline: none; box-sizing: border-box; resize: vertical;
    }
    .hn-fb-field input:focus, .hn-fb-field textarea:focus { border-color: var(--green); box-shadow: 0 0 0 4px var(--green-glow); }
    .hn-fb-submit {
      width: 100%; padding: 13px; background: linear-gradient(135deg, var(--green), #00c264); color: #fff; border: none;
      border-radius: 13px; font-size: 14.5px; font-weight: 700; cursor: pointer; display: flex; align-items: center;
      justify-content: center; gap: 8px; box-shadow: var(--shadow-green);
    }
    .hn-fb-success { text-align: center; padding: 20px 0; }
    .hn-fb-success i { font-size: 40px; color: var(--green); margin-bottom: 12px; }
    .hn-fb-success h4 { font-family: var(--font-d); font-weight: 700; color: var(--ink); margin-bottom: 6px; }
    .hn-fb-success p { font-size: 13px; color: var(--muted); }

    /* ---- HOW IT WORKS (3 steps) ---- */
    .hn-flatmate-steps { padding: 56px 24px; }
    .hn-flatmate-steps-inner { max-width: 900px; margin: 0 auto; }
    .hn-flatmate-steps-tag { text-align: center; font-size: 12px; font-weight: 800; letter-spacing: .8px; color: var(--green-dark); text-transform: uppercase; margin-bottom: 8px; }
    .hn-flatmate-steps h2 { text-align: center; font-family: var(--font-d); font-size: 1.6rem; font-weight: 700; color: var(--ink); margin-bottom: 36px; }
    .hn-flatmate-steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .hn-flatmate-step { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 22px; transition: transform .2s ease, box-shadow .2s ease; }
    .hn-flatmate-step:hover { transform: translateY(-4px); box-shadow: var(--shadow-sm); }
    .hn-flatmate-step .num { font-family: var(--font-m); font-size: 13px; font-weight: 700; color: var(--green); margin-bottom: 10px; }
    .hn-flatmate-step h4 { font-family: var(--font-d); font-size: 1rem; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
    .hn-flatmate-step p { font-size: 13px; color: var(--muted); line-height: 1.55; }

    /* ---- BOTTOM CTA ---- */
    .hn-flatmate-bottom-cta { max-width: 900px; margin: 0 auto; padding: 20px 24px 60px; text-align: center; }
    .hn-flatmate-bottom-cta h2 { font-family: var(--font-d); font-size: 1.45rem; font-weight: 700; color: var(--ink); margin-bottom: 8px; }
    .hn-flatmate-bottom-cta p { font-size: 13.5px; color: var(--muted); margin-bottom: 20px; }
    .hn-flatmate-bottom-cta-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 13px 28px; border-radius: 999px;
      background: linear-gradient(135deg, var(--green), #00c264); color: #fff; font-size: 14.5px; font-weight: 700;
      box-shadow: 0 8px 26px rgba(9,184,80,.34); transition: transform .15s, box-shadow .15s;
    }
    .hn-flatmate-bottom-cta-btn:hover { transform: translateY(-2px); color: #fff; box-shadow: 0 10px 30px rgba(9,184,80,.4); }

    /* ---- FOOTER (city links + policies + support) ---- */
    .hn-flatmate-footer { background: #0a1628; color: rgba(255,255,255,.75); padding: 50px 24px 24px; }
    .hn-flatmate-footer-grid { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr; gap: 30px; }
    .hn-flatmate-footer-brand { display: flex; align-items: center; gap: 8px; font-family: var(--font-d); font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 14px; }
    .hn-flatmate-footer-brand img { width: 26px; height: 26px; border-radius: 7px; }
    .hn-flatmate-footer-addr { font-size: 12.5px; line-height: 1.7; margin-bottom: 14px; }
    .hn-flatmate-footer-contact a { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: rgba(255,255,255,.75); text-decoration: none; margin-bottom: 8px; transition: color .15s; }
    .hn-flatmate-footer-contact a:hover { color: var(--green); }
    .hn-flatmate-footer-contact i { width: 14px; color: var(--green); }
    .hn-flatmate-footer h4 { color: #fff; font-size: 13px; font-weight: 700; margin-bottom: 14px; text-transform: uppercase; letter-spacing: .4px; }
    .hn-flatmate-footer ul { list-style: none; padding: 0; margin: 0; }
    .hn-flatmate-footer ul li { margin-bottom: 9px; }
    .hn-flatmate-footer ul li a { font-size: 12.5px; color: rgba(255,255,255,.65); text-decoration: none; transition: color .15s; }
    .hn-flatmate-footer ul li a:hover { color: var(--green); }
    .hn-flatmate-footer-bottom { max-width: 1180px; margin: 34px auto 0; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.1); font-size: 12px; color: rgba(255,255,255,.45); text-align: center; }

    /* ---- MOBILE FILTER DRAWER ---- */
    .hn-flatmate-drawer-overlay { position: fixed; inset: 0; background: rgba(10,22,40,.5); z-index: 9998; opacity: 0; pointer-events: none; transition: opacity .2s; }
    .hn-flatmate-drawer-overlay.open { opacity: 1; pointer-events: all; }
    .hn-flatmate-drawer {
      position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 20px 20px 0 0;
      z-index: 9999; padding: 20px; transform: translateY(100%); transition: transform .28s cubic-bezier(0.22,1,0.36,1); max-height: 80vh; overflow-y: auto;
    }
    .hn-flatmate-drawer.open { transform: translateY(0); }
    .hn-flatmate-drawer h3 { font-family: var(--font-d); font-weight: 700; margin-bottom: 16px; }
    .hn-flatmate-drawer-close { position: absolute; top: 18px; right: 18px; width: 30px; height: 30px; border-radius: 50%; background: var(--bg2); border: none; }
    .hn-flatmate-drawer-field { margin-bottom: 16px; }
    .hn-flatmate-drawer-field label { display: block; font-size: 12px; font-weight: 700; color: var(--ink-mid); margin-bottom: 8px; }
    .hn-flatmate-drawer-field select { width: 100%; padding: 11px 13px; border: 1.5px solid var(--border); border-radius: 12px; font-size: 14px; color: var(--ink); background: #fff; }
    .hn-flatmate-drawer-apply { width: 100%; padding: 13px; background: linear-gradient(135deg, var(--green), #00c264); color: #fff; border: none; border-radius: 13px; font-size: 14.5px; font-weight: 700; }

    /* ---- RESPONSIVE ---- */
    @media (max-width: 1000px) {
      .hn-flatmate-footer-grid { grid-template-columns: 1fr 1fr 1fr; }
    }
    @media (max-width: 900px) {
      .hn-flatmate-grid { grid-template-columns: repeat(2, 1fr); }
      .hn-flatmate-steps-grid { grid-template-columns: 1fr; }
      .hn-flatmate-feedback-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .hn-flatmate-ctas { grid-template-columns: 1fr; }
      .hn-flatmate-search { flex-direction: column; padding: 12px; }
      .hn-flatmate-field:not(:last-child) { border-right: none; border-bottom: 1px solid var(--border); padding-bottom: 12px; }
      .hn-flatmate-search-btn { width: 100%; justify-content: center; padding: 13px; margin-top: 4px; }
      .hn-flatmate-filter-btn { display: flex; width: 100%; justify-content: center; margin-top: 8px; }
      .hn-flatmate-h1 { font-size: 1.7rem; }
      .hn-flatmate-row-card-wrap { flex-basis: 210px; }
      .hn-flatmate-row-scroll-btns { display: none; }
      .hn-flatmate-stats { gap: 22px; }
      .hn-flatmate-footer-grid { grid-template-columns: 1fr 1fr; }

      /* mandatory mobile horizontal listing carousel — main feed only */
      .hn-flatmate-grid {
        display: flex; grid-template-columns: none; overflow-x: auto; overflow-y: hidden;
        gap: 14px; scroll-snap-type: x mandatory; padding-bottom: 8px; scrollbar-width: none;
        margin: 0 -24px; padding-left: 24px; padding-right: 24px;
      }
      .hn-flatmate-grid::-webkit-scrollbar { display: none; }
      .hn-flatmate-grid .hn-flatmate-card { flex: 0 0 84%; scroll-snap-align: start; }
      .hn-flatmate-empty { flex: 0 0 100%; }
    }
  </style>
</head>
<body class="hn-flatmate-page">

<!-- ===== LOADER ===== -->
<div id="hn-loader">
  <div class="loader-brand">Hostel<span>Node</span></div>
  <div class="loader-dots">
    <div class="loader-dot"></div>
    <div class="loader-dot"></div>
    <div class="loader-dot"></div>
  </div>
</div>

<header>
  <%- include("../includes/navbar-user.ejs") %>
</header>

<main>

<!-- ===== HERO ===== -->
<section class="hn-flatmate-hero">
  <div class="hn-hero-blob b1" aria-hidden="true"><i class="fa-solid fa-house"></i></div>
  <div class="hn-hero-blob b2" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></div>
  <div class="hn-hero-blob b3" aria-hidden="true"><i class="fa-solid fa-user"></i></div>

  <div class="hn-flatmate-eyebrow hn-hero-anim hn-hero-eyebrow-a"><span class="dot"></span> Flat Share</div>
  <h1 class="hn-flatmate-h1 hn-hero-anim hn-hero-h1-a">Find a <span>Flatmate</span></h1>
  <p class="hn-flatmate-tagline hn-hero-anim hn-hero-tagline-a">Find a flat. Share the rent.</p>
  <p class="hn-flatmate-sub hn-hero-anim hn-hero-sub-a">Find flats, rooms and flatmates near you. Connect directly and find the right place to live — without brokers.</p>

  <div class="hn-flatmate-stats hn-hero-anim hn-hero-stats-a">
    <div class="hn-flatmate-stat"><b><%= totalListingsCount %></b><span>Live Listings</span></div>
    <div class="hn-flatmate-stat"><b>6</b><span>Cities</span></div>
    <div class="hn-flatmate-stat"><b>₹0</b><span>Brokerage</span></div>
  </div>
</section>

<!-- ===== POSTING OPTIONS ===== -->
<section class="hn-flatmate-ctas" aria-label="Posting options">
  <div class="hn-flatmate-cta-card need hn-hero-anim hn-hero-cta-a need">
    <div class="hn-flatmate-cta-icon"><i class="fa-solid fa-house-user" aria-hidden="true"></i></div>
    <h3>I Need a Flat</h3>
    <p>Looking for a flat or room? Post your requirement.</p>
    <a href="/flatmate/create?type=need" class="hn-flatmate-cta-btn">
      Post Requirement <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:11px"></i>
    </a>
  </div>
  <div class="hn-flatmate-cta-card have hn-hero-anim hn-hero-cta-a have">
    <div class="hn-flatmate-cta-icon"><i class="fa-solid fa-people-roof" aria-hidden="true"></i></div>
    <h3>I Have a Flat</h3>
    <p>Have a spare room or bed? Find a flatmate.</p>
    <a href="/flatmate/create?type=have" class="hn-flatmate-cta-btn">
      Find a Flatmate <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:11px"></i>
    </a>
  </div>
</section>

<!-- ===== SEARCH: Looking for Flatmates ===== -->
<section class="hn-flatmate-search-wrap reveal" aria-label="Search flats and flatmates">
  <p class="hn-flatmate-search-heading">Looking for Flatmates</p>
  <form class="hn-flatmate-search" id="flatmateSearchForm" action="/flatmate" method="GET">
    <div class="hn-flatmate-field">
      <i class="fa-solid fa-people-group" aria-hidden="true"></i>
      <div class="fld-wrap">
        <label for="fmType">Looking for</label>
        <!-- UI labels are Flat / Flatmates. Internal values stay have/need — unchanged. -->
        <select name="type" id="fmType">
          <option value="have" <%= (!filters || filters.type !== 'need') ? 'selected' : '' %>>Flatmates</option>
          <option value="need" <%= filters && filters.type === 'need' ? 'selected' : '' %>>Flat</option>
        </select>
      </div>
    </div>
    <div class="hn-flatmate-field" style="flex:1.4">
      <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
      <div class="fld-wrap">
        <label for="fmLocation">Where to?</label>
        <input type="text" name="location" id="fmLocation" placeholder="City, area…" value="<%= filters && filters.location ? filters.location : '' %>">
      </div>
    </div>
    <div class="hn-flatmate-field">
      <i class="fa-solid fa-venus-mars" aria-hidden="true"></i>
      <div class="fld-wrap">
        <label for="fmGender">Gender</label>
        <select name="gender" id="fmGender">
          <option value="any" <%= (!filters || !filters.gender || filters.gender === 'any') ? 'selected' : '' %>>Any</option>
          <option value="male" <%= filters && filters.gender === 'male' ? 'selected' : '' %>>Male</option>
          <option value="female" <%= filters && filters.gender === 'female' ? 'selected' : '' %>>Female</option>
        </select>
      </div>
    </div>
    <button type="submit" class="hn-flatmate-search-btn"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Search</button>
    <button type="button" class="hn-flatmate-filter-btn" onclick="openFilterDrawer()" aria-haspopup="dialog">
      <i class="fa-solid fa-sliders" aria-hidden="true"></i> Filters
    </button>
  </form>

  <div class="hn-flatmate-more-filters">
    <button type="button" onclick="toggleExtraFilters()" aria-expanded="false" aria-controls="fmExtraFilters">
      <i class="fa-solid fa-sliders" aria-hidden="true"></i> More filters (budget, BHK)
    </button>
  </div>
  <div class="hn-flatmate-extra-filters" id="fmExtraFilters">
    <label for="fmBudget" class="visually-hidden">Budget</label>
    <select id="fmBudget" onchange="submitWithExtra()">
      <option value="">Any budget</option>
      <option value="8000"  <%= filters && filters.budget === '8000'  ? 'selected' : '' %>>Under ₹8,000</option>
      <option value="15000" <%= filters && filters.budget === '15000' ? 'selected' : '' %>>Under ₹15,000</option>
      <option value="25000" <%= filters && filters.budget === '25000' ? 'selected' : '' %>>Under ₹25,000</option>
    </select>
    <label for="fmBhk" class="visually-hidden">BHK</label>
    <select id="fmBhk" onchange="submitWithExtra()">
      <option value="">Any BHK</option>
      <option value="1" <%= filters && filters.bhk === '1' ? 'selected' : '' %>>1 BHK</option>
      <option value="2" <%= filters && filters.bhk === '2' ? 'selected' : '' %>>2 BHK</option>
      <option value="3" <%= filters && filters.bhk === '3' ? 'selected' : '' %>>3 BHK</option>
    </select>
  </div>

  <% if (filters && (filters.location || (filters.gender && filters.gender !== 'any') || filters.budget || filters.bhk)) { %>
    <div class="hn-flatmate-active-filter-note">
      Showing <strong><%= listings.length %></strong> result<%= listings.length === 1 ? '' : 's' %> for your filters &middot; <a href="/flatmate">Clear all</a>
    </div>
  <% } %>
</section>

<!-- ===== ACROSS INDIA (single compact horizontal-scroll strip) ===== -->
<section class="hn-flatmate-across reveal" aria-label="Flatmates across India">
  <div class="hn-flatmate-across-head">
    <h2><i class="fa-solid fa-earth-asia" aria-hidden="true"></i> Flatmates across India</h2>
    <div class="hn-flatmate-row-scroll-btns">
      <button type="button" onclick="scrollRow('acrossIndiaRow', -1)" aria-label="Scroll left"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
      <button type="button" onclick="scrollRow('acrossIndiaRow', 1)" aria-label="Scroll right"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
    </div>
  </div>

  <div class="hn-flatmate-across-pills">
    <% cityCounts.forEach(function(c) { %>
      <a href="/flatmate?location=<%= encodeURIComponent(c.name) %>" class="<%= filters && filters.location === c.name ? 'active' : '' %>">
        <%= c.name %> <span style="opacity:.6">(<%= c.count %>)</span>
      </a>
    <% }) %>
  </div>

  <div class="hn-flatmate-row-track" id="acrossIndiaRow">
    <% acrossIndiaListings.forEach(function(l) { %>
      <div class="hn-flatmate-row-card-wrap">
        <div class="hn-flatmate-card" onclick="window.location.href='/flatmate/<%= l._id %>'">
          <div class="hn-flatmate-card-img <%= (l.type === 'need') ? 'placeholder-need' : '' %>">
            <% if (l.type === 'have') { %>
              <img src="<%= l.image || '/images/placeholder.jpg' %>" alt="<%= l.bhk %> BHK <%= l.roomType %> flat available in <%= l.location %>, <%= l.city %>" loading="lazy" decoding="async">
            <% } else { %>
              <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              <span>Looking for a flat</span>
            <% } %>
            <% if (l.type === 'have') { %>
              <span class="hn-flatmate-badge have">🏠 FLAT</span>
            <% } else { %>
              <span class="hn-flatmate-badge need">👤 FLATMATE</span>
            <% } %>
            <button class="hn-flatmate-wish" onclick="event.stopPropagation(); toggleFmWish(event, this)" aria-label="Save to wishlist" aria-pressed="false">
              <i class="fa-regular fa-heart" aria-hidden="true"></i>
            </button>
          </div>
          <div class="hn-flatmate-card-body">
            <div class="hn-flatmate-card-title"><%= l.bhk %> BHK &middot; <%= l.roomType %></div>
            <div class="hn-flatmate-card-loc"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= l.location %>, <%= l.city %></div>
            <span class="hn-flatmate-card-gender"><%= l.gender === 'any' ? 'Co-ed' : (l.gender === 'male' ? 'Males only' : 'Females only') %></span>
            <% if (l.type === 'have') { %>
              <div class="hn-flatmate-card-price">₹<%= l.rent.toLocaleString('en-IN') %> <span>/ month</span></div>
              <div class="hn-flatmate-card-meta">Available from <%= l.moveIn %></div>
            <% } else { %>
              <div class="hn-flatmate-card-price">₹<%= l.budgetMin.toLocaleString('en-IN') %>&ndash;₹<%= l.budgetMax.toLocaleString('en-IN') %></div>
              <div class="hn-flatmate-card-meta">Move-in <%= l.moveIn %></div>
            <% } %>
            <div class="hn-flatmate-card-footer">
              <div class="hn-flatmate-poster">Posted by <%= l.postedBy %></div>
              <button class="hn-flatmate-talk-btn" onclick="event.stopPropagation(); requestToTalk('<%= l._id %>')">Request to Talk</button>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- ===== RESULT TABS ===== -->
<section class="hn-flatmate-tabs-wrap reveal">
  <div class="hn-flatmate-tabs" role="tablist" aria-label="Filter listings by type">
    <button class="hn-flatmate-tab <%= (!filters || !filters.type) ? 'active' : '' %>" onclick="setFeedType('', this)" role="tab" aria-selected="<%= (!filters || !filters.type) ? 'true' : 'false' %>">
      All <span class="cnt">(<%= listings.length %>)</span>
    </button>
    <button class="hn-flatmate-tab <%= filters && filters.type === 'need' ? 'active' : '' %>" onclick="setFeedType('need', this)" role="tab" aria-selected="<%= filters && filters.type === 'need' ? 'true' : 'false' %>">
      Need a Flat <span class="cnt">(<%= listings.filter(function(l){return l.type==='need'}).length %>)</span>
    </button>
    <button class="hn-flatmate-tab <%= filters && filters.type === 'have' ? 'active' : '' %>" onclick="setFeedType('have', this)" role="tab" aria-selected="<%= filters && filters.type === 'have' ? 'true' : 'false' %>">
      Have a Flat <span class="cnt">(<%= listings.filter(function(l){return l.type==='have'}).length %>)</span>
    </button>
  </div>
</section>

<!-- ===== FLATS & FLATMATES (main feed) ===== -->
<section class="hn-flatmate-feed reveal">
  <div class="hn-flatmate-feed-head">
    <div>
      <h2>Flats &amp; Flatmates</h2>
      <p class="cnt"><strong id="fmResultsCount"><%= listings.length %></strong> listings</p>
    </div>
    <div class="hn-flatmate-sort">
      <label for="fmSort" class="visually-hidden">Sort by</label>
      Sort:
      <select id="fmSort">
        <option value="latest">Latest</option>
        <option value="price-low">Price: Low to High</option>
        <option value="price-high">Price: High to Low</option>
      </select>
    </div>
  </div>

  <div class="hn-flatmate-grid" id="fmGrid">
    <% if (listings && listings.length > 0) { %>
      <% listings.forEach(function(l, i) { %>
        <div class="hn-flatmate-card" data-type="<%= l.type %>" style="animation-delay:<%= Math.min(i,8) * 80 %>ms" onclick="window.location.href='/flatmate/<%= l._id %>'">
          <div class="hn-flatmate-card-img <%= (l.type === 'need') ? 'placeholder-need' : '' %>">
            <% if (l.type === 'have') { %>
              <img src="<%= l.image || '/images/placeholder.jpg' %>" alt="<%= l.bhk %> BHK <%= l.roomType %> flat available in <%= l.location %>, <%= l.city %>" loading="lazy" decoding="async">
            <% } else { %>
              <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
              <span>Looking for a flat</span>
            <% } %>
            <% if (l.type === 'have') { %>
              <span class="hn-flatmate-badge have">🏠 FLAT</span>
            <% } else { %>
              <span class="hn-flatmate-badge need">👤 FLATMATE</span>
            <% } %>
            <button class="hn-flatmate-wish" onclick="event.stopPropagation(); toggleFmWish(event, this)" aria-label="Save to wishlist" aria-pressed="false">
              <i class="fa-regular fa-heart" aria-hidden="true"></i>
            </button>
          </div>
          <div class="hn-flatmate-card-body">
            <div class="hn-flatmate-card-title"><%= l.bhk %> BHK &middot; <%= l.roomType %></div>
            <div class="hn-flatmate-card-loc"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= l.location %>, <%= l.city %></div>
            <span class="hn-flatmate-card-gender"><%= l.gender === 'any' ? 'Co-ed' : (l.gender === 'male' ? 'Males only' : 'Females only') %></span>
            <% if (l.type === 'have') { %>
              <div class="hn-flatmate-card-price">₹<%= l.rent.toLocaleString('en-IN') %> <span>/ month</span></div>
              <div class="hn-flatmate-card-meta">Available from <%= l.moveIn %></div>
            <% } else { %>
              <div class="hn-flatmate-card-price">₹<%= l.budgetMin.toLocaleString('en-IN') %>&ndash;₹<%= l.budgetMax.toLocaleString('en-IN') %></div>
              <div class="hn-flatmate-card-meta">Move-in <%= l.moveIn %></div>
            <% } %>
            <div class="hn-flatmate-card-footer">
              <div class="hn-flatmate-poster">Posted by <%= l.postedBy %></div>
              <button class="hn-flatmate-talk-btn" onclick="event.stopPropagation(); requestToTalk('<%= l._id %>')">Request to Talk</button>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="hn-flatmate-empty">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <h3><%= filters && filters.type === 'need' ? 'No flatmates found' : (filters && filters.type === 'have' ? 'No flats found' : 'No listings found') %></h3>
        <p>Try another location or adjust your filters.</p>
        <a href="/flatmate">Clear filters</a>
      </div>
    <% } %>
  </div>
</section>

