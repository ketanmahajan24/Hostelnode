<!-- flatmate-results.ejs — HostelNode Flatmate search results (same layout as findHostels-results.ejs) -->
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-3J9E7QW77B"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-3J9E7QW77B');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= filters.location ? `Flats & Flatmates near ${filters.location}` : 'Flatmate Search Results' %> | HostelNode
  </title>
  <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">
  <meta name="robots" content="noindex, follow">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet">
  <!-- Reusing the EXACT same stylesheets as /findHostels/results for pixel-identical layout -->
  <link rel="stylesheet" href="/css/findhostel.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/findHostel-results.css">
  <style>
    /* ── Small additions only for things findHostel-results.css has no
       equivalent for (Flat/Flatmate badge colors, the "looking for a
       flat" icon placeholder in place of a photo, and the posted-by
       line that replaces the star-rating slot since we don't fabricate
       ratings for flatmate listings). Nothing above is modified. ── */
    .badge-have { background: #dcfce7; color: #087a3c; }
    .badge-need { background: #dbeafe; color: #1d4ed8; }

    .r-need-placeholder {
      position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: 8px; background: linear-gradient(135deg,#eaf1ff,#f5f8ff); color: #2563eb;
    }
    .r-need-placeholder i { font-size: 26px; }
    .r-need-placeholder span { font-size: 12px; font-weight: 700; }

    .r-posted-by { font-size: 12px; color: #888; display: flex; align-items: center; gap: 5px; white-space: nowrap; }
    .muted-see-more { background: #f1f5f2 !important; box-shadow: none !important; cursor: default !important; }
    .muted-see-more .btn-inner { color: #6b7a72 !important; justify-content: center; }
    .muted-see-more:hover { transform: none !important; }
    .r-card-img { touch-action: pan-y; }
    .r-slide-dots { position: absolute; bottom: 8px; left: 0; right: 0; display: flex; justify-content: center; gap: 4px; z-index: 3; }
    .r-dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,.55); transition: all .15s ease; }
    .r-dot.active { background: #fff; width: 14px; border-radius: 3px; }
    .r-posted-by i { color: var(--green); font-size: 11px; }
  </style>
</head>
<body>

<header>
  <%- include("../includes/navbar-user.ejs") %>
</header>

<!-- ── STICKY TOPBAR ── -->
<div class="results-topbar">
  <div class="container">
    <form action="/flatmate/results" method="GET" id="topSearchForm" style="display:contents">

      <div class="tb-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" name="location" id="topLocationInput"
          placeholder="City, area…"
          value="<%= filters.location %>"
          autocomplete="off">
      </div>

      <!-- Looking for pill (Flat = have, Flatmates = need — internal values unchanged) -->
      <div class="tb-pill">
        <i class="fa-solid fa-people-group" style="color:var(--green)"></i>
        <select name="type" onchange="document.getElementById('topSearchForm').submit()">
          <option value="need" <%= filters.type !== 'have' ? 'selected' : '' %>>Flatmates</option>
          <option value="have" <%= filters.type === 'have' ? 'selected' : '' %>>Flat</option>
        </select>
      </div>

      <!-- Gender pill -->
      <div class="tb-pill">
        <i class="fa-solid fa-venus-mars" style="color:var(--green)"></i>
        <select name="gender" onchange="document.getElementById('topSearchForm').submit()">
          <option value="any" <%= (!filters.gender || filters.gender==='any') ? 'selected' : '' %>>Any gender</option>
          <option value="male"   <%= filters.gender==='male'   ? 'selected' : '' %>>Male</option>
          <option value="female" <%= filters.gender==='female' ? 'selected' : '' %>>Female</option>
        </select>
      </div>

      <!-- Budget pill -->
      <div class="tb-pill">
        <i class="fa-solid fa-indian-rupee-sign" style="color:var(--green)"></i>
        <select name="budget" onchange="document.getElementById('topSearchForm').submit()">
          <option value="">Any budget</option>
          <option value="8000"  <%= filters.budget==='8000'  ? 'selected' : '' %>>Under ₹8k</option>
          <option value="15000" <%= filters.budget==='15000' ? 'selected' : '' %>>Under ₹15k</option>
          <option value="25000" <%= filters.budget==='25000' ? 'selected' : '' %>>Under ₹25k</option>
        </select>
      </div>

      <!-- Preserve sidebar filter state across topbar pill changes -->
      <input type="hidden" name="bhk"      id="bhkHidden"      value="<%= filters.bhk      || '' %>">
      <input type="hidden" name="roomType" id="roomTypeHidden" value="<%= filters.roomType || '' %>">
      <input type="hidden" name="sort"     id="sortHidden"     value="<%= filters.sort     || 'newest' %>">

      <button type="button" class="mob-filter-btn" onclick="openMobFilter()">
        <i class="fa-solid fa-sliders"></i> Filters
      </button>

      <button type="submit" class="tb-search-btn">
        <i class="fa-solid fa-magnifying-glass"></i> Search
      </button>

    </form>
  </div>
</div>

<!-- ── MAIN LAYOUT ── -->
<div class="results-layout">

  <!-- ── SIDEBAR ── -->
  <aside class="results-sidebar" id="sidebarInner">
    <%- include("../includes/flatmate-results-filters.ejs", { filters }) %>
  </aside>

  <!-- ── RESULTS AREA ── -->
  <main>

    <!-- Header row -->
    <div class="results-head">
      <div>
        <div class="results-count-txt">
          <span><%= total %></span> <%= filters.type === 'have' ? 'flats' : (filters.type === 'need' ? 'flatmates' : 'flats & flatmates') %> found
          <% if (filters.location) { %> near "<%= filters.location %>"<% } %>
        </div>
        <div class="results-sub">
          Showing page <%= currentPage %> of <%= totalPages || 1 %> · Zero broker fees
        </div>
      </div>

      <!-- Sort buttons (no rating/popularity sort — we don't fabricate that data) -->
      <div class="sort-row">
        <% const sorts = [
          { key:'newest',     label:'Newest' },
          { key:'price_asc',  label:'Price ↑' },
          { key:'price_desc', label:'Price ↓' },
        ]; %>
        <% sorts.forEach(function(s){ %>
          <button class="sort-btn <%= (filters.sort||'newest')===s.key ? 'active' : '' %>"
            onclick="setSort('<%= s.key %>')">
            <%= s.label %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Active filter tags -->
    <div class="active-filters" id="activeTags">
      <% if (filters.location) { %>
        <div class="af-tag">
          <i class="fa-solid fa-location-dot"></i>
          "<%= filters.location %>"
          <button onclick="removeFilter('location')">×</button>
        </div>
      <% } %>
      <% if (filters.gender && filters.gender !== 'any') { %>
        <div class="af-tag">
          <i class="fa-solid fa-venus-mars"></i>
          <%= filters.gender.charAt(0).toUpperCase() + filters.gender.slice(1) %>
          <button onclick="removeFilter('gender')">×</button>
        </div>
      <% } %>
      <% if (filters.budget) { %>
        <div class="af-tag">
          <i class="fa-solid fa-indian-rupee-sign"></i>
          Under ₹<%= Number(filters.budget).toLocaleString('en-IN') %>
          <button onclick="removeFilter('budget')">×</button>
        </div>
      <% } %>
      <% if (filters.bhk) { %>
        <div class="af-tag">
          <i class="fa-solid fa-door-open"></i>
          <%= filters.bhk %> BHK
          <button onclick="removeFilter('bhk')">×</button>
        </div>
      <% } %>
      <% if (filters.roomType) { %>
        <div class="af-tag">
          <i class="fa-solid fa-bed"></i>
          <%= filters.roomType.charAt(0).toUpperCase() + filters.roomType.slice(1) %> room
          <button onclick="removeFilter('roomType')">×</button>
        </div>
      <% } %>
    </div>

    <!-- Cards Grid -->
    <div class="rg-grid">
      <% if (listings && listings.length > 0) { %>
        <% listings.forEach(function(l) { %>

          <div class="r-card" data-slug="<%= l.slug %>" onclick="rCardNavigate(event, this)">

            <!-- Image slider (have) / icon placeholder (need) -->
            <div class="r-card-img" data-swipe-card>
              <% if (l.type === 'have' && l.images && l.images.length > 0) { %>
                <% l.images.forEach(function(img, i) { %>
                  <div class="slide <%= i===0?'active':'' %>">
                    <img src="/flatmate-images/<%= img %>" alt="<%= l.bhk %> BHK <%= l.roomType %> flat in <%= l.location %>, <%= l.city %>" loading="lazy" decoding="async">
                  </div>
                <% }) %>
                <% if (l.images.length > 1) { %>
                  <button class="slide-btn prev" onclick="event.stopPropagation(); slide(event,this,-1)" aria-label="Previous photo">
                    <i class="fa-solid fa-chevron-left"></i>
                  </button>
                  <button class="slide-btn next" onclick="event.stopPropagation(); slide(event,this,1)" aria-label="Next photo">
                    <i class="fa-solid fa-chevron-right"></i>
                  </button>
                  <div class="r-slide-dots">
                    <% l.images.forEach(function(_, di) { %><span class="r-dot <%= di===0?'active':'' %>"></span><% }) %>
                  </div>
                <% } %>
              <% } else { %>
                <div class="slide active">
                  <div class="r-need-placeholder">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <span>Looking for a flat</span>
                  </div>
                </div>
              <% } %>

              <span class="r-badge badge-<%= l.type %>">
                <%= l.type === 'have' ? '🏠 FLAT' : '👤 FLATMATE' %>
              </span>

              <button class="r-wish <%= l.isSaved ? 'saved' : '' %>" onclick="flatWishToggle(event,this,'<%= l._id %>')" aria-label="Save to wishlist" aria-pressed="<%= l.isSaved ? 'true' : 'false' %>">
                <i class="fa-<%= l.isSaved ? 'solid' : 'regular' %> fa-heart"></i>
              </button>

              <div class="r-dist">
                <i class="fa-solid fa-location-dot"></i>
                <%= l.location %>, <%= l.city %>
              </div>
            </div><!-- /img -->

            <!-- Body -->
            <div class="r-body">
              <div class="r-row">
                <div>
                  <div class="r-name"><%= l.bhk %> BHK &middot; <%= l.roomType %></div>
                  <div class="r-type"><i class="fa-solid fa-bolt"></i> <%= l.type === 'have' ? 'Offering a room' : 'Looking for a room' %></div>
                </div>
              </div>

              <div class="r-loc">
                <i class="fa-solid fa-venus-mars"></i>
                <%= l.gender === 'any' ? 'Co-ed' : (l.gender === 'male' ? 'Males only' : 'Females only') %>
              </div>

              <div class="r-amenities">
                <% if (l.type === 'have') { %>
                  <span class="r-tag">Available <%= l.moveIn %></span>
                <% } else { %>
                  <span class="r-tag">Move-in <%= l.moveIn %></span>
                <% } %>
              </div>

              <div class="r-footer">
                <div>
                  <% if (l.type === 'have') { %>
                    <div class="r-price-val">₹<%= Number(l.rent).toLocaleString('en-IN') %> <span>/mo</span></div>
                    <div class="r-price-label"><%= l.roomType %></div>
                  <% } else { %>
                    <div class="r-price-val">₹<%= Number(l.budgetMin).toLocaleString('en-IN') %>&ndash;₹<%= Number(l.budgetMax).toLocaleString('en-IN') %></div>
                    <div class="r-price-label">Budget</div>
                  <% } %>
                </div>
                <div class="r-posted-by"><i class="fa-solid fa-user"></i> <%= l.postedBy %></div>
              </div>

              <div class="btn-wrap">
                <% if (l.requestStatus === 'own') { %>
                  <button class="btn-see-more muted-see-more" disabled>
                    <span class="btn-inner"><span class="btn-label">Your Listing</span></span>
                  </button>
                <% } else if (l.requestStatus === 'pending') { %>
                  <button class="btn-see-more muted-see-more" disabled>
                    <span class="btn-inner"><span class="btn-label"><i class="fa-solid fa-clock"></i> Request Sent</span></span>
                  </button>
                <% } else if (l.requestStatus === 'accepted') { %>
                  <a class="btn-see-more" href="/messages/<%= l.conversationId %>" onclick="event.stopPropagation()">
                    <span class="btn-gloss"></span>
                    <span class="btn-sheen"></span>
                    <span class="btn-inner">
                      <span class="dot"></span>
                      <span class="btn-label"><i class="fa-solid fa-comment"></i> Chat Now</span>
                      <span class="btn-arrow"><i class="fa-solid fa-arrow-right" style="font-size:11px"></i></span>
                    </span>
                  </a>
                <% } else { %>
                  <button class="btn-see-more" data-listing-id="<%= l._id %>"
                    onclick="event.stopPropagation(); sendCardRequest('<%= l._id %>', this)">
                    <span class="btn-gloss"></span>
                    <span class="btn-sheen"></span>
                    <span class="btn-inner">
                      <span class="dot"></span>
                      <span class="btn-label">Send Request</span>
                      <span class="btn-arrow">
                        <i class="fa-solid fa-arrow-right" style="font-size:11px"></i>
                      </span>
                    </span>
                  </button>
                <% } %>
              </div>
            </div>
          </div>

        <% }) %>

      <% } else { %>
        <div class="no-results">
          <div class="no-results-icon">🔍</div>
          <h3>No listings found</h3>
          <p>Try a different city, area, or loosen your filters to see more options.</p>
          <a href="/flatmate">← Back to search</a>
        </div>
      <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="pagination-wrap">
        <% if (currentPage > 1) { %>
          <button class="pg-btn" onclick="goPage(<%= currentPage-1 %>)" aria-label="Previous page">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
        <% } %>
        <% for(let p=1;p<=totalPages;p++) { %>
          <button class="pg-btn <%= p===currentPage?'active':'' %>"
            onclick="goPage(<%= p %>)"><%= p %></button>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <button class="pg-btn" onclick="goPage(<%= currentPage+1 %>)" aria-label="Next page">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        <% } %>
      </div>
    <% } %>

  </main>
</div><!-- /results-layout -->

<!-- ── MOBILE FILTER OVERLAY ── -->
<div class="mob-filter-overlay" id="mobFilterOverlay" onclick="closeMobFilter(event)">
  <div class="mob-filter-drawer">
    <div class="mob-drawer-handle"></div>
    <%- include("../includes/flatmate-results-filters.ejs", { filters }) %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // ── Current query state ──────────────────────────────
  const Q = {
    location: "<%= (filters.location||'').replace(/\"/g,'&quot;') %>",
    budget:   "<%= filters.budget   || '' %>",
    gender:   "<%= filters.gender   || '' %>",
    type:     "<%= filters.type     || '' %>",
    bhk:      "<%= filters.bhk      || '' %>",
    roomType: "<%= filters.roomType || '' %>",
    sort:     "<%= filters.sort     || 'newest' %>",
    page:     1,
  };

  function buildURL(overrides = {}) {
    const p = { ...Q, ...overrides };
    const u = new URLSearchParams();
    Object.entries(p).forEach(([k,v]) => { if(v) u.set(k, v); });
    return '/flatmate/results?' + u.toString();
  }

  // ── Sort ─────────────────────────────────────────────
  function setSort(key) {
    window.location.href = buildURL({ sort: key, page: 1 });
  }

  // ── Remove filter tag ────────────────────────────────
  function removeFilter(key) {
    window.location.href = buildURL({ [key]: '', page: 1 });
  }

  // ── Pagination ───────────────────────────────────────
  function goPage(p) {
    window.location.href = buildURL({ page: p });
  }

  // ── View listing ─────────────────────────────────────
  function rCardNavigate(e, cardEl) {
    if (cardEl.dataset.swiped === 'true') { cardEl.dataset.swiped = 'false'; return; } // swipe, not a tap
    window.location.href = '/flatmate/' + cardEl.dataset.slug;
  }

  // Touch swipe for the image slider — same click-vs-swipe discrimination
  // as the Featured cards on /flatmate, so a swipe never accidentally
  // navigates to the listing.
  document.querySelectorAll('[data-swipe-card]').forEach(function (wrap) {
    let startX = 0, startY = 0, dragging = false;
    const THRESHOLD = 30;

    wrap.addEventListener('touchstart', function (e) {
      if (!e.touches[0]) return;
      startX = e.touches[0].clientX; startY = e.touches[0].clientY; dragging = true;
    }, { passive: true });

    wrap.addEventListener('touchmove', function (e) {
      if (!dragging || !e.touches[0]) return;
      const dx = e.touches[0].clientX - startX, dy = e.touches[0].clientY - startY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) e.preventDefault();
    }, { passive: false });

    wrap.addEventListener('touchend', function (e) {
      if (!dragging) return;
      dragging = false;
      const dx = (e.changedTouches[0] ? e.changedTouches[0].clientX : startX) - startX;
      if (Math.abs(dx) < THRESHOLD) return; // a tap — let navigation proceed
      const cardEl = wrap.closest('.r-card');
      if (cardEl) cardEl.dataset.swiped = 'true';
      const slides = [...wrap.querySelectorAll('.slide')];
      const dots = [...wrap.querySelectorAll('.r-dot')];
      if (slides.length < 2) return;
      const idx = slides.findIndex(s => s.classList.contains('active'));
      slides[idx].classList.remove('active');
      dots[idx]?.classList.remove('active');
      const next = (idx + (dx < 0 ? 1 : -1) + slides.length) % slides.length;
      slides[next].classList.add('active');
      dots[next]?.classList.add('active');
    });
  });

  // ── Send Request (no modal — one-click, same backend endpoint the
  //    detail page's modal uses) ──
  async function sendCardRequest(listingId, btn) {
    if (btn.disabled) return; // guard against double-click/duplicate requests
    const original = btn.innerHTML;
    btn.disabled = true;
    try {
      const res = await fetch('/flatmate/connect', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ listingId, message: '' }),
      });
      if (res.redirected || res.status === 401) {
        window.location.href = '/student/login?next=' + encodeURIComponent(window.location.pathname + window.location.search);
        return;
      }
      const data = await res.json();
      if (data.success) {
        btn.classList.add('muted-see-more');
        btn.innerHTML = '<span class="btn-inner"><span class="btn-label"><i class="fa-solid fa-clock"></i> Request Sent</span></span>';
        btn.disabled = true; // stays disabled — status is now server-confirmed "pending"
      } else {
        btn.disabled = false;
        btn.innerHTML = original;
        showToast(data.error || 'Could not send request.');
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = original;
      showToast('Network error — please try again.');
    }
  }

  // ── Wishlist (real — persists via /student/saved/toggle, the new
  //    unified Saved Properties system) ──
  async function flatWishToggle(e, btn, listingId) {
    e.stopPropagation();
    try {
      const res = await fetch('/student/saved/toggle', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ listingType: 'flatmate', listingId }),
      });
      if (res.redirected || res.status === 401) {
        window.location.href = '/student/login?next=' + encodeURIComponent(window.location.pathname + window.location.search);
        return;
      }
      const data = await res.json();
      if (data.success) {
        btn.classList.toggle('saved', data.saved);
        btn.setAttribute('aria-pressed', data.saved ? 'true' : 'false');
        btn.querySelector('i').className = data.saved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
        showToast(data.saved ? '❤️ Saved to your properties' : '🤍 Removed from saved');
      } else {
        showToast(data.error || 'Could not update saved properties.');
      }
    } catch (err) {
      showToast('Network error — please try again.');
    }
  }

  // ── Image slider ─────────────────────────────────────
  function slide(e, btn, dir) {
    e.stopPropagation();
    const wrap   = btn.closest('.r-card-img');
    const slides = [...wrap.querySelectorAll('.slide')];
    const dots   = [...wrap.querySelectorAll('.r-dot')];
    let idx = slides.findIndex(s => s.classList.contains('active'));
    slides[idx].classList.remove('active');
    dots[idx]?.classList.remove('active');
    idx = (idx + dir + slides.length) % slides.length;
    slides[idx].classList.add('active');
    dots[idx]?.classList.add('active');
  }

  // ── Mobile filter ────────────────────────────────────
  function openMobFilter()  { document.getElementById('mobFilterOverlay').classList.add('open'); }
  function closeMobFilter(e) {
    if(e.target.classList.contains('mob-filter-overlay'))
      document.getElementById('mobFilterOverlay').classList.remove('open');
  }

  // ── Sidebar filter apply (from flatmate-results-filters partial) ──
  function applyResultFilters() {
    const form = document.getElementById('flatSidebarFilterForm') ||
                 document.querySelector('#mobFilterOverlay form');
    if(!form) return;
    const data = new FormData(form);
    window.location.href = buildURL({
      bhk:      data.get('bhk')      || '',
      roomType: data.get('roomType') || '',
      budget:   data.get('budget')   || Q.budget,
      page: 1,
    });
  }

  // ── Toast ────────────────────────────────────────────
  function showToast(msg) {
    let t = document.getElementById('hn-toast');
    if(!t) {
      t = document.createElement('div'); t.id='hn-toast';
      t.style.cssText='position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:#1a1a2e;color:#fff;padding:12px 22px;border-radius:12px;font-size:14px;font-weight:500;z-index:9999;transition:.3s;opacity:0;pointer-events:none;';
      document.body.appendChild(t);
    }
    t.textContent=msg; t.style.opacity='1'; t.style.transform='translateX(-50%) translateY(0)';
    clearTimeout(t._t);
    t._t=setTimeout(()=>{ t.style.opacity='0'; t.style.transform='translateX(-50%) translateY(80px)'; },2500);
  }

  // ── Navbar scroll ────────────────────────────────────
  window.addEventListener('scroll', () => {
    document.getElementById('hnNav')?.classList.toggle('scrolled', scrollY > 10);
  }, { passive:true });
</script>

</body>
</html>
