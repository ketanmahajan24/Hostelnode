<!-- flatmate-results.ejs — HostelNode Flatmate search results (same layout as findHostels-results.ejs) -->
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-3J9E7QW77B"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-3J9E7QW77B');
  </script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= filters.location ? `Flats & Flatmates near ${filters.location}` : 'Flatmate Search Results' %> | HostelNode
  </title>
  <link rel="icon" type="image/png" href="/images/hostelnode-logo-cutout.png">
  <meta name="robots" content="noindex, follow">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Inter:opsz,wght@14..32,300..700&display=swap" rel="stylesheet">
  <!-- Reusing the EXACT same stylesheets as /findHostels/results for pixel-identical layout -->
  <link rel="stylesheet" href="/css/findhostel.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/findHostel-results.css">
  <style>
    /* ── Small additions only for things findHostel-results.css has no
       equivalent for (Flat/Flatmate badge colors, the "looking for a
       flat" icon placeholder in place of a photo, and the posted-by
       line that replaces the star-rating slot since we don't fabricate
       ratings for flatmate listings). Nothing above is modified. ── */
    .badge-have { background: #dcfce7; color: #087a3c; }
    .badge-need { background: #dbeafe; color: #1d4ed8; }

    /* Phase 10 — "Save this search" (no equivalent on the PG/Hostel
       results page, so nothing to reuse from findHostel-results.css). */
    .save-search-btn {
      margin-top: 8px; display: inline-flex; align-items: center; gap: 6px;
      background: none; border: 1.5px solid var(--border); border-radius: 999px;
      padding: 6px 14px; font-size: 12px; font-weight: 700; color: var(--ink-mid);
      cursor: pointer; transition: border-color .15s, color .15s;
    }
    .save-search-btn:hover, .save-search-btn:focus-visible { border-color: var(--green); color: var(--green-dark); }
    .save-search-btn:focus-visible { outline: 2.5px solid var(--green); outline-offset: 2px; }
    .save-search-btn.saved { border-color: var(--green); color: var(--green-dark); background: var(--green-light); cursor: default; }
    .save-search-btn:disabled { opacity: .7; cursor: default; }

    .r-need-placeholder {
      position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center;
      justify-content: center; gap: 8px; background: linear-gradient(135deg,#eaf1ff,#f5f8ff); color: #2563eb;
    }
    .r-need-placeholder i { font-size: 26px; }
    .r-need-placeholder span { font-size: 12px; font-weight: 700; }

    .r-posted-by { font-size: 12px; color: #888; display: flex; align-items: center; gap: 5px; white-space: nowrap; }
    .muted-see-more { background: #f1f5f2 !important; box-shadow: none !important; cursor: default !important; }
    .muted-see-more .btn-inner { color: #6b7a72 !important; justify-content: center; }
    .muted-see-more:hover { transform: none !important; }

    /* ══ Card redesign — duplicated independently from the landing page's
       card CSS (same visual result, no shared file/include between them,
       per explicit instruction) ══ */
    /* ---- CARD (modernized) ---- */
    .hn-flatmate-card {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg);
      overflow: hidden; box-shadow: var(--shadow-sm); transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
      cursor: pointer; display: flex; flex-direction: column; height: 100%;
      animation: fmCardFadeUp .4s ease backwards;
    }
    .hn-flatmate-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--green-border); }
    @keyframes fmCardFadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) {
      .hn-flatmate-card { animation: none; }
      .hn-flatmate-card, .hn-flatmate-card-img img, .hn-flatmate-wish, .hn-flatmate-talk-btn { transition: none !important; }
    }

    .hn-flatmate-card-img { position: relative; aspect-ratio: 4/3; background: var(--bg2); overflow: hidden; touch-action: pan-y; }
    .hn-flatmate-card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
    .hn-flatmate-card:hover .hn-flatmate-card-img img { transform: scale(1.04); }
    .fm-slide { position: absolute; inset: 0; opacity: 0; transition: opacity .25s ease; pointer-events: none; }
    .fm-slide.active { opacity: 1; pointer-events: auto; }
    .fm-slide-btn {
      position: absolute; top: 50%; transform: translateY(-50%); width: 28px; height: 28px; border-radius: 50%;
      background: rgba(255,255,255,.9); border: none; color: var(--ink); font-size: 11px; display: flex;
      align-items: center; justify-content: center; opacity: 0; transition: opacity .15s ease; z-index: 3;
    }
    .hn-flatmate-card-img:hover .fm-slide-btn { opacity: 1; }
    .fm-slide-btn.prev { left: 8px; }
    .fm-slide-btn.next { right: 8px; }
    .fm-slide-dots { position: absolute; bottom: 8px; left: 0; right: 0; display: flex; justify-content: center; gap: 4px; z-index: 3; }
    .fm-dot { width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,.55); transition: all .15s ease; }
    .fm-dot.active { background: #fff; width: 14px; border-radius: 3px; }
    .hn-flatmate-card-img.placeholder-need {
      display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8px;
      background: linear-gradient(135deg,#eaf1ff,#f5f8ff); color: #2563eb;
    }
    .hn-flatmate-card-img.placeholder-need i { font-size: 28px; }
    .hn-flatmate-card-img.placeholder-need span { font-size: 11.5px; font-weight: 700; }

    .hn-flatmate-badge {
      position: absolute; top: 12px; left: 12px; display: inline-flex; align-items: center; gap: 6px;
      padding: 5px 12px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: .3px;
      backdrop-filter: blur(6px); z-index: 3;
    }
    .hn-flatmate-badge.have { background: rgba(9,184,80,.92); color: #fff; }
    .hn-flatmate-badge.need { background: rgba(37,99,235,.92); color: #fff; }

    .hn-flatmate-verified {
      position: absolute; top: 12px; left: 50%; transform: translateX(-50%);
      display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 999px;
      font-size: 10px; font-weight: 800; color: var(--green-dark); background: rgba(255,255,255,.92); z-index: 3;
    }

    .hn-flatmate-wish {
      position: absolute; top: 12px; right: 12px; width: 32px; height: 32px; border-radius: 50%;
      background: rgba(255,255,255,.92); border: none; display: flex; align-items: center; justify-content: center;
      color: #94a3a8; font-size: 13px; box-shadow: 0 2px 8px rgba(0,0,0,.12); transition: transform .2s cubic-bezier(.34,1.56,.64,1), color .18s;
      z-index: 3;
    }
    .hn-flatmate-wish:hover { color: #e53e3e; }
    .hn-flatmate-wish.pop { transform: scale(1.2); }
    .hn-flatmate-wish.saved { color: #e53e3e; }

    .hn-flatmate-card-body { padding: 14px 14px 12px; display: flex; flex-direction: column; gap: 7px; flex: 1; }
    .hn-flatmate-card-title { font-family: var(--font-d); font-size: 15px; font-weight: 700; color: var(--ink); }
    .hn-flatmate-card-loc { font-size: 12.5px; color: var(--muted); display: flex; align-items: center; gap: 6px; font-weight: 500; }
    .hn-flatmate-card-loc i { color: var(--green); font-size: 12px; }

    .hn-flatmate-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1px; }
    .hn-flatmate-card-gender {
      display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700; color: var(--muted);
      background: var(--bg2); padding: 3px 9px; border-radius: 999px;
    }
    .hn-flatmate-spots {
      display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 700;
      color: var(--green-dark); background: var(--green-light); padding: 3px 9px; border-radius: 999px;
    }

    .hn-flatmate-card-price { font-family: var(--font-d); font-size: 17px; font-weight: 700; color: var(--ink); margin-top: 2px; }
    .hn-flatmate-card-price span { font-size: 11.5px; font-weight: 500; color: var(--muted-light); }
    .hn-flatmate-card-meta { font-size: 11.5px; color: var(--muted); }

    .hn-flatmate-card-footer { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; padding-top: 11px; border-top: 1px solid var(--border); }
    .hn-flatmate-poster { font-size: 12px; font-weight: 700; color: var(--ink-mid); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hn-flatmate-btn-row { display: flex; gap: 8px; }
    .hn-flatmate-view-btn {
      flex: 1; background: var(--bg2); color: var(--ink-mid); border: 1.5px solid var(--border); border-radius: 999px;
      padding: 8px 14px; font-size: 11.5px; font-weight: 700; display: flex; align-items: center; justify-content: center;
      gap: 6px; text-decoration: none; transition: background .18s, border-color .18s, transform .15s;
    }
    .hn-flatmate-view-btn:hover { background: var(--white); border-color: var(--ink-mid); color: var(--ink); transform: translateY(-1px); }
    .hn-flatmate-talk-btn {
      flex: 1; background: var(--green); color: #fff; border: none; border-radius: 999px; padding: 8px 15px;
      font-size: 11.5px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 6px; text-decoration: none;
      transition: background .18s, transform .15s, box-shadow .18s;
    }
    .hn-flatmate-talk-btn:hover { background: var(--green-dark); box-shadow: var(--shadow-green); transform: translateY(-1px); }
    .hn-flatmate-talk-btn:active { transform: scale(.96); }
    .hn-flatmate-talk-btn.muted { background: var(--bg2); color: var(--muted); cursor: default; }
    .hn-flatmate-talk-btn.muted:hover { background: var(--bg2); box-shadow: none; transform: none; }
    .hn-flatmate-talk-btn:disabled { opacity: .7; cursor: not-allowed; }

    /* Results grid uses the shared .rg-grid container (generic layout
       scaffolding, also used by PG results — safe to reuse since it's
       just grid-template-columns, not visual card styling) but a tighter
       gap to match the featured row's spacing. */
    .rg-grid { gap: 20px; }
    @media (max-width: 640px) { .rg-grid { gap: 14px; } }
  </style>
</head>
<body>

<header>
  <%- include("../includes/navbar-user.ejs") %>
</header>

<!-- ── STICKY TOPBAR ── -->
<div class="results-topbar">
  <div class="container">
    <form action="/flatmate/results" method="GET" id="topSearchForm" style="display:contents">

      <div class="tb-search">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" name="location" id="topLocationInput"
          placeholder="City, area…"
          value="<%= filters.location %>"
          autocomplete="off">
      </div>

      <!-- Looking for pill (Flat = have, Flatmates = need — internal values unchanged) -->
      <div class="tb-pill">
        <i class="fa-solid fa-people-group" style="color:var(--green)"></i>
        <select name="type" onchange="document.getElementById('topSearchForm').submit()">
          <option value="need" <%= filters.type !== 'have' ? 'selected' : '' %>>Flatmates</option>
          <option value="have" <%= filters.type === 'have' ? 'selected' : '' %>>Flat</option>
        </select>
      </div>

      <!-- Gender pill -->
      <div class="tb-pill">
        <i class="fa-solid fa-venus-mars" style="color:var(--green)"></i>
        <select name="gender" onchange="document.getElementById('topSearchForm').submit()">
          <option value="any" <%= (!filters.gender || filters.gender==='any') ? 'selected' : '' %>>Any gender</option>
          <option value="male"   <%= filters.gender==='male'   ? 'selected' : '' %>>Male</option>
          <option value="female" <%= filters.gender==='female' ? 'selected' : '' %>>Female</option>
        </select>
      </div>

      <!-- Budget pill -->
      <div class="tb-pill">
        <i class="fa-solid fa-indian-rupee-sign" style="color:var(--green)"></i>
        <select name="budget" onchange="document.getElementById('topSearchForm').submit()">
          <option value="">Any budget</option>
          <option value="8000"  <%= filters.budget==='8000'  ? 'selected' : '' %>>Under ₹8k</option>
          <option value="15000" <%= filters.budget==='15000' ? 'selected' : '' %>>Under ₹15k</option>
          <option value="25000" <%= filters.budget==='25000' ? 'selected' : '' %>>Under ₹25k</option>
        </select>
      </div>

      <!-- Preserve sidebar filter state across topbar pill changes -->
      <input type="hidden" name="bhk"      id="bhkHidden"      value="<%= filters.bhk      || '' %>">
      <input type="hidden" name="roomType" id="roomTypeHidden" value="<%= filters.roomType || '' %>">
      <input type="hidden" name="sort"     id="sortHidden"     value="<%= filters.sort     || 'newest' %>">

      <button type="button" class="mob-filter-btn" onclick="openMobFilter()">
        <i class="fa-solid fa-sliders"></i> Filters
      </button>

      <button type="submit" class="tb-search-btn">
        <i class="fa-solid fa-magnifying-glass"></i> Search
      </button>

    </form>
  </div>
</div>

<!-- ── MAIN LAYOUT ── -->
<div class="results-layout">

  <!-- ── SIDEBAR ── -->
  <aside class="results-sidebar" id="sidebarInner">
    <%- include("../includes/flatmate-results-filters.ejs", { filters }) %>
  </aside>

  <!-- ── RESULTS AREA ── -->
  <main>

    <!-- Header row -->
    <div class="results-head">
      <div>
        <div class="results-count-txt">
          <span><%= total %></span> <%= filters.type === 'have' ? 'flats' : (filters.type === 'need' ? 'flatmates' : 'flats & flatmates') %> found
          <% if (filters.location) { %> near "<%= filters.location %>"<% } %>
        </div>
        <div class="results-sub">
          Showing page <%= currentPage %> of <%= totalPages || 1 %> · Zero broker fees
        </div>
        <button type="button" class="save-search-btn" id="saveSearchBtn" onclick="saveThisSearch(this)">
          <i class="fa-regular fa-bookmark" aria-hidden="true"></i> Save this search
        </button>
      </div>

      <!-- Sort buttons (no rating/popularity sort — we don't fabricate that data) -->
      <div class="sort-row">
        <% const sorts = [
          { key:'newest',     label:'Newest' },
          { key:'price_asc',  label:'Price ↑' },
          { key:'price_desc', label:'Price ↓' },
        ]; %>
        <% sorts.forEach(function(s){ %>
          <button class="sort-btn <%= (filters.sort||'newest')===s.key ? 'active' : '' %>"
            onclick="setSort('<%= s.key %>')">
            <%= s.label %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Active filter tags -->
    <div class="active-filters" id="activeTags">
      <% if (filters.location) { %>
        <div class="af-tag">
          <i class="fa-solid fa-location-dot"></i>
          "<%= filters.location %>"
          <button onclick="removeFilter('location')">×</button>
        </div>
      <% } %>
      <% if (filters.gender && filters.gender !== 'any') { %>
        <div class="af-tag">
          <i class="fa-solid fa-venus-mars"></i>
          <%= filters.gender.charAt(0).toUpperCase() + filters.gender.slice(1) %>
          <button onclick="removeFilter('gender')">×</button>
        </div>
      <% } %>
      <% if (filters.budget) { %>
        <div class="af-tag">
          <i class="fa-solid fa-indian-rupee-sign"></i>
          Under ₹<%= Number(filters.budget).toLocaleString('en-IN') %>
          <button onclick="removeFilter('budget')">×</button>
        </div>
      <% } %>
      <% if (filters.bhk) { %>
        <div class="af-tag">
          <i class="fa-solid fa-door-open"></i>
          <%= filters.bhk %> BHK
          <button onclick="removeFilter('bhk')">×</button>
        </div>
      <% } %>
      <% if (filters.roomType) { %>
        <div class="af-tag">
          <i class="fa-solid fa-bed"></i>
          <%= filters.roomType.charAt(0).toUpperCase() + filters.roomType.slice(1) %> room
          <button onclick="removeFilter('roomType')">×</button>
        </div>
      <% } %>
    </div>

    <!-- Cards Grid -->
    <div class="rg-grid">
      <% if (listings && listings.length > 0) { %>
        <% listings.forEach(function(l, i) { %>

          <div class="hn-flatmate-card" data-type="<%= l.type %>" data-slug="<%= l.slug %>" style="animation-delay:<%= Math.min(i,8) * 80 %>ms" onclick="rCardNavigate(event, this)">
            <div class="hn-flatmate-card-img <%= (l.type === 'need') ? 'placeholder-need' : '' %>" data-swipe-card>
              <% if (l.type === 'have' && l.images && l.images.length > 0) { %>
                <% l.images.forEach(function(img, i) { %>
                  <div class="fm-slide <%= i===0?'active':'' %>">
                    <img src="/flatmate-images/<%= img %>" alt="<%= l.bhk %> BHK <%= l.roomType %> flat in <%= l.location %>, <%= l.city %>" loading="lazy" decoding="async">
                  </div>
                <% }) %>
                <% if (l.images.length > 1) { %>
                  <button class="fm-slide-btn prev" onclick="event.stopPropagation(); slide(event,this,-1)" aria-label="Previous photo"><i class="fa-solid fa-chevron-left"></i></button>
                  <button class="fm-slide-btn next" onclick="event.stopPropagation(); slide(event,this,1)" aria-label="Next photo"><i class="fa-solid fa-chevron-right"></i></button>
                  <div class="fm-slide-dots"><% l.images.forEach(function(_, di) { %><span class="fm-dot <%= di===0?'active':'' %>"></span><% }) %></div>
                <% } %>
              <% } else if (l.type === 'have') { %>
                <div class="fm-slide active"><img src="/images/placeholder.jpg" alt="<%= l.bhk %> BHK <%= l.roomType %> flat" loading="lazy"></div>
              <% } else { %>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span>Looking for a flat</span>
              <% } %>
              <% if (l.type === 'have') { %>
                <span class="hn-flatmate-badge have">🏠 FLAT</span>
              <% } else { %>
                <span class="hn-flatmate-badge need">👤 FLATMATE</span>
              <% } %>
              <% if (l.isVerified) { %><span class="hn-flatmate-verified"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Verified</span><% } %>
              <button class="hn-flatmate-wish <%= l.isSaved ? 'saved' : '' %>" onclick="event.stopPropagation(); flatWishToggle(event, this, '<%= l._id %>')" aria-label="Save to wishlist" aria-pressed="<%= l.isSaved ? 'true' : 'false' %>">
                <i class="fa-<%= l.isSaved ? 'solid' : 'regular' %> fa-heart" aria-hidden="true"></i>
              </button>
            </div>
            <div class="hn-flatmate-card-body">
              <div class="hn-flatmate-card-title"><%= l.bhk %> BHK &middot; <%= l.roomType %></div>
              <div class="hn-flatmate-card-loc"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> <%= l.location %>, <%= l.city %></div>
              <div class="hn-flatmate-chips">
                <span class="hn-flatmate-card-gender"><%= l.gender === 'any' ? 'Co-ed' : (l.gender === 'male' ? 'Males only' : 'Females only') %></span>
                <% if (l.type === 'have' && l.availableSpots) { %>
                  <span class="hn-flatmate-spots"><i class="fa-solid fa-door-open" aria-hidden="true"></i> <%= l.availableSpots %> spot<%= l.availableSpots === 1 ? '' : 's' %> open</span>
                <% } %>
              </div>
              <% if (l.type === 'have') { %>
                <div class="hn-flatmate-card-price">₹<%= Number(l.rent||0).toLocaleString('en-IN') %> <span>/ month</span></div>
                <div class="hn-flatmate-card-meta">Available from <%= l.moveIn %></div>
              <% } else { %>
                <div class="hn-flatmate-card-price">₹<%= Number(l.budgetMin||0).toLocaleString('en-IN') %>&ndash;₹<%= Number(l.budgetMax||0).toLocaleString('en-IN') %></div>
                <div class="hn-flatmate-card-meta">Move-in <%= l.moveIn %></div>
              <% } %>
              <div class="hn-flatmate-card-footer">
                <div class="hn-flatmate-poster">Posted by <%= l.postedBy %></div>
                <div class="hn-flatmate-btn-row">
                  <a class="hn-flatmate-view-btn" href="/flatmate/<%= l.slug %>" onclick="event.stopPropagation()"><i class="fa-solid fa-eye"></i> View Detail</a>
                  <% if (l.requestStatus === 'own') { %>
                    <button class="hn-flatmate-talk-btn muted" disabled>Your Listing</button>
                  <% } else if (l.requestStatus === 'pending') { %>
                    <button class="hn-flatmate-talk-btn muted" disabled><i class="fa-solid fa-clock"></i> Request Sent</button>
                  <% } else if (l.requestStatus === 'accepted') { %>
                    <a class="hn-flatmate-talk-btn" href="/messages/<%= l.conversationId %>" onclick="event.stopPropagation()"><i class="fa-solid fa-comment"></i> Chat Now</a>
                  <% } else { %>
                    <button class="hn-flatmate-talk-btn" data-listing-id="<%= l._id %>" onclick="event.stopPropagation(); sendCardRequest('<%= l._id %>', this)">Send Request</button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

        <% }) %>

      <% } else { %>
        <div class="no-results">
          <div class="no-results-icon">🔍</div>
          <h3>No listings found</h3>
          <p>Try a different city, area, or loosen your filters to see more options.</p>
          <a href="/flatmate">← Back to search</a>
        </div>
      <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="pagination-wrap">
        <% if (currentPage > 1) { %>
          <button class="pg-btn" onclick="goPage(<%= currentPage-1 %>)" aria-label="Previous page">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
        <% } %>
        <% for(let p=1;p<=totalPages;p++) { %>
          <button class="pg-btn <%= p===currentPage?'active':'' %>"
            onclick="goPage(<%= p %>)"><%= p %></button>
        <% } %>
        <% if (currentPage < totalPages) { %>
          <button class="pg-btn" onclick="goPage(<%= currentPage+1 %>)" aria-label="Next page">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        <% } %>
      </div>
    <% } %>

  </main>
</div><!-- /results-layout -->

<!-- ── MOBILE FILTER OVERLAY ── -->
<div class="mob-filter-overlay" id="mobFilterOverlay" onclick="closeMobFilter(event)" role="dialog" aria-modal="true" aria-label="Filters">
  <div class="mob-filter-drawer">
    <div class="mob-drawer-handle"></div>
    <%- include("../includes/flatmate-results-filters.ejs", { filters }) %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // ── Guest auth modal, with a same-page fallback for the edge case of a
  // session expiring mid-view on a page that rendered as logged-in (the
  // modal markup only exists in the DOM for a guest). ──
  function goToLoginOrModal(resumeUrl) {
    if (typeof openNudgeModal === 'function') openNudgeModal('login', resumeUrl);
    else window.location.href = '/student/login?next=' + encodeURIComponent(resumeUrl);
  }

  // ── Current query state ──────────────────────────────
  const Q = {
    location: "<%= (filters.location||'').replace(/\"/g,'&quot;') %>",
    budget:   "<%= filters.budget   || '' %>",
    gender:   "<%= filters.gender   || '' %>",
    type:     "<%= filters.type     || '' %>",
    bhk:      "<%= filters.bhk      || '' %>",
    roomType: "<%= filters.roomType || '' %>",
    sort:     "<%= filters.sort     || 'newest' %>",
    page:     1,
  };

  function buildURL(overrides = {}) {
    const p = { ...Q, ...overrides };
    const u = new URLSearchParams();
    Object.entries(p).forEach(([k,v]) => { if(v) u.set(k, v); });
    return '/flatmate/results?' + u.toString();
  }

  // ── Sort ─────────────────────────────────────────────
  function setSort(key) {
    window.location.href = buildURL({ sort: key, page: 1 });
  }

  // ── Save this search (Phase 10) ─────────────────────
  async function saveThisSearch(btn) {
    <% if (!student) { %>
      if (typeof openNudgeModal === 'function') openNudgeModal('login', window.location.pathname + window.location.search);
      return;
    <% } %>
    btn.disabled = true;
    const params = new URLSearchParams(window.location.search);
    const body = {
      location: params.get('location') || '',
      gender: params.get('gender') || '',
      type: params.get('type') || '',
      budget: params.get('budget') || '',
      bhk: params.get('bhk') || '',
      roomType: params.get('roomType') || '',
    };
    try {
      const res = await fetch('/flatmate/saved-searches', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (data.success) {
        btn.classList.add('saved');
        btn.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i> ' + (data.alreadySaved ? 'Already saved' : 'Saved — we\'ll notify you');
      } else {
        alert(data.error || 'Could not save this search.');
        btn.disabled = false;
      }
    } catch (err) {
      alert('Network error — please try again.');
      btn.disabled = false;
    }
  }

  // ── Remove filter tag ────────────────────────────────
  function removeFilter(key) {
    window.location.href = buildURL({ [key]: '', page: 1 });
  }

  // ── Pagination ───────────────────────────────────────
  function goPage(p) {
    window.location.href = buildURL({ page: p });
  }

  // ── View listing ─────────────────────────────────────
  function rCardNavigate(e, cardEl) {
    if (cardEl.dataset.swiped === 'true') { cardEl.dataset.swiped = 'false'; return; } // swipe, not a tap
    window.location.href = '/flatmate/' + cardEl.dataset.slug;
  }

  // Touch swipe for the image slider — same click-vs-swipe discrimination
  // as the Featured cards on /flatmate, so a swipe never accidentally
  // navigates to the listing.
  document.querySelectorAll('[data-swipe-card]').forEach(function (wrap) {
    let startX = 0, startY = 0, dragging = false;
    const THRESHOLD = 30;

    wrap.addEventListener('touchstart', function (e) {
      if (!e.touches[0]) return;
      startX = e.touches[0].clientX; startY = e.touches[0].clientY; dragging = true;
    }, { passive: true });

    wrap.addEventListener('touchmove', function (e) {
      if (!dragging || !e.touches[0]) return;
      const dx = e.touches[0].clientX - startX, dy = e.touches[0].clientY - startY;
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10) e.preventDefault();
    }, { passive: false });

    wrap.addEventListener('touchend', function (e) {
      if (!dragging) return;
      dragging = false;
      const dx = (e.changedTouches[0] ? e.changedTouches[0].clientX : startX) - startX;
      if (Math.abs(dx) < THRESHOLD) return; // a tap — let navigation proceed
      const cardEl = wrap.closest('.hn-flatmate-card');
      if (cardEl) cardEl.dataset.swiped = 'true';
      const slides = [...wrap.querySelectorAll('.fm-slide')];
      const dots = [...wrap.querySelectorAll('.fm-dot')];
      if (slides.length < 2) return;
      const idx = slides.findIndex(s => s.classList.contains('active'));
      slides[idx].classList.remove('active');
      dots[idx]?.classList.remove('active');
      const next = (idx + (dx < 0 ? 1 : -1) + slides.length) % slides.length;
      slides[next].classList.add('active');
      dots[next]?.classList.add('active');
    });
  });

  // ── Send Request (no modal — one-click, same backend endpoint the
  //    detail page's modal uses) ──
  async function sendCardRequest(listingId, btn) {
    if (btn.disabled) return; // guard against double-click/duplicate requests
    const original = btn.innerHTML;
    btn.disabled = true;
    try {
      const res = await fetch('/flatmate/connect', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ listingId, message: '' }),
      });
      if (res.redirected || res.status === 401) {
        // Guest clicked a card's Send Request — resume straight into that
        // listing's request modal after login, rather than dropping them
        // back on the login page with no idea which listing they wanted.
        const slug = btn.closest('[data-slug]')?.dataset.slug;
        btn.disabled = false;
        btn.innerHTML = original;
        goToLoginOrModal(slug ? ('/flatmate/' + slug + '#request') : window.location.pathname);
        return;
      }
      const data = await res.json();
      if (data.success) {
        btn.classList.add('muted-see-more');
        btn.innerHTML = '<span class="btn-inner"><span class="btn-label"><i class="fa-solid fa-clock"></i> Request Sent</span></span>';
        btn.disabled = true; // stays disabled — status is now server-confirmed "pending"
      } else {
        btn.disabled = false;
        btn.innerHTML = original;
        showToast(data.error || 'Could not send request.');
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = original;
      showToast('Network error — please try again.');
    }
  }

  // ── Wishlist (real — persists via /student/saved/toggle, the new
  //    unified Saved Properties system) ──
  async function flatWishToggle(e, btn, listingId) {
    e.stopPropagation();
    try {
      const res = await fetch('/student/saved/toggle', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ listingType: 'flatmate', listingId }),
      });
      if (res.redirected || res.status === 401) {
        goToLoginOrModal(window.location.pathname + window.location.search);
        return;
      }
      const data = await res.json();
      if (data.success) {
        btn.classList.toggle('saved', data.saved);
        btn.setAttribute('aria-pressed', data.saved ? 'true' : 'false');
        btn.querySelector('i').className = data.saved ? 'fa-solid fa-heart' : 'fa-regular fa-heart';
        showToast(data.saved ? '❤️ Saved to your properties' : '🤍 Removed from saved');
      } else {
        showToast(data.error || 'Could not update saved properties.');
      }
    } catch (err) {
      showToast('Network error — please try again.');
    }
  }

  // ── Image slider ─────────────────────────────────────
  function slide(e, btn, dir) {
    e.stopPropagation();
    const wrap   = btn.closest('.hn-flatmate-card-img');
    const slides = [...wrap.querySelectorAll('.fm-slide')];
    const dots   = [...wrap.querySelectorAll('.fm-dot')];
    let idx = slides.findIndex(s => s.classList.contains('active'));
    slides[idx].classList.remove('active');
    dots[idx]?.classList.remove('active');
    idx = (idx + dir + slides.length) % slides.length;
    slides[idx].classList.add('active');
    dots[idx]?.classList.add('active');
  }

  // ── Mobile filter ────────────────────────────────────
  function openMobFilter()  { document.getElementById('mobFilterOverlay').classList.add('open'); }
  function closeMobFilter(e) {
    if(e.target.classList.contains('mob-filter-overlay'))
      document.getElementById('mobFilterOverlay').classList.remove('open');
  }
  // Accessibility audit (Phase 7): no Escape handler existed for this
  // drawer at all — background-click already closed it, Escape didn't.
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && document.getElementById('mobFilterOverlay').classList.contains('open')) {
      document.getElementById('mobFilterOverlay').classList.remove('open');
    }
  });

  // ── Sidebar filter apply (from flatmate-results-filters partial) ──
  function applyResultFilters() {
    const form = document.getElementById('flatSidebarFilterForm') ||
                 document.querySelector('#mobFilterOverlay form');
    if(!form) return;
    const data = new FormData(form);
    window.location.href = buildURL({
      bhk:      data.get('bhk')      || '',
      roomType: data.get('roomType') || '',
      budget:   data.get('budget')   || Q.budget,
      page: 1,
    });
  }

  // ── Toast ────────────────────────────────────────────
  function showToast(msg) {
    let t = document.getElementById('hn-toast');
    if(!t) {
      t = document.createElement('div'); t.id='hn-toast';
      t.style.cssText='position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:#1a1a2e;color:#fff;padding:12px 22px;border-radius:12px;font-size:14px;font-weight:500;z-index:9999;transition:.3s;opacity:0;pointer-events:none;';
      document.body.appendChild(t);
    }
    t.textContent=msg; t.style.opacity='1'; t.style.transform='translateX(-50%) translateY(0)';
    clearTimeout(t._t);
    t._t=setTimeout(()=>{ t.style.opacity='0'; t.style.transform='translateX(-50%) translateY(80px)'; },2500);
  }

  // ── Navbar scroll ────────────────────────────────────
  window.addEventListener('scroll', () => {
    document.getElementById('hnNav')?.classList.toggle('scrolled', scrollY > 10);
  }, { passive:true });
</script>

