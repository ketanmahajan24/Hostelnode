<% locals.pageTitle = 'Analytics'; locals.activePage = 'analytics'; %>
<%- include('layout', { body: `

<div class="page-header">
  <div class="page-header-left">
    <h1>Analytics</h1>
    <p>12-month platform performance overview</p>
  </div>
</div>

<!-- Signup trend -->
<div class="card" style="margin-bottom:20px">
  <div class="card-header">
    <div class="card-title"><i class="fa-solid fa-chart-line"></i> User Growth (12 months)</div>
  </div>
  <div class="card-body chart-wrap">
    <canvas id="growthChart"></canvas>
  </div>
</div>

<div class="charts-grid-3" style="margin-bottom:20px">
  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-building"></i> Listings Over Time</div></div>
    <div class="card-body chart-wrap"><canvas id="listingTrendChart"></canvas></div>
  </div>
  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-chart-pie"></i> Listing Types</div></div>
    <div class="card-body chart-wrap" style="display:flex;align-items:center;justify-content:center">
      <canvas id="typeChart" style="max-height:200px;max-width:200px"></canvas>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-inbox"></i> Enquiry Status</div></div>
    <div class="card-body chart-wrap" style="display:flex;align-items:center;justify-content:center">
      <canvas id="enquiryStatusChart" style="max-height:200px;max-width:200px"></canvas>
    </div>
  </div>
</div>

<div class="charts-grid-2" style="margin-bottom:20px">
  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-location-dot"></i> Top Cities by Listings</div></div>
    <div class="card-body chart-wrap"><canvas id="citiesChart"></canvas></div>
  </div>
  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-comment-dots"></i> Monthly Enquiries</div></div>
    <div class="card-body chart-wrap"><canvas id="enquiryChart"></canvas></div>
  </div>
</div>

<!-- Top listings tables -->
<div class="charts-grid-2">
  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-star"></i> Top Rated Listings</div></div>
    <div class="table-wrap">
      <table class="admin-table">
        <thead><tr><th>Listing</th><th>Rating</th><th>Reviews</th><th>Price</th></tr></thead>
        <tbody>
          ${topRatedListings.map(l=>`
          <tr onclick="window.location='/admin/listings/${l._id}'" style="cursor:pointer">
            <td><div class="cell-name">${l.title}</div><div class="cell-sub">${l.location?.city||'—'}</div></td>
            <td><span style="font-weight:700;color:#f59e0b">${l.rating?.toFixed(1)||'—'} ★</span></td>
            <td>${l.reviewCount||0}</td>
            <td style="color:var(--g);font-weight:600">₹${(l.startingPrice||0).toLocaleString('en-IN')}</td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>
  </div>
  <div class="card">
    <div class="card-header"><div class="card-title"><i class="fa-solid fa-eye"></i> Most Viewed Listings</div></div>
    <div class="table-wrap">
      <table class="admin-table">
        <thead><tr><th>Listing</th><th>Views</th><th>Price</th></tr></thead>
        <tbody>
          ${mostViewedListings.map(l=>`
          <tr onclick="window.location='/admin/listings/${l._id}'" style="cursor:pointer">
            <td><div class="cell-name">${l.title}</div><div class="cell-sub">${l.location?.city||'—'}</div></td>
            <td><span style="font-weight:700">${(l.views||0).toLocaleString('en-IN')}</span></td>
            <td style="color:var(--g);font-weight:600">₹${(l.startingPrice||0).toLocaleString('en-IN')}</td>
          </tr>`).join('')}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

const ownerTrend   = ${chartData.ownerTrend};
const studentTrend = ${chartData.studentTrend};
const listingTrend = ${chartData.listingTrend};
const topCities    = ${chartData.topCities};
const typeData     = ${chartData.listingsByType};
const statusData   = ${chartData.listingsByStatus};
const enqStatus    = ${chartData.enquiriesByStatus};
const enqMonth     = ${chartData.enquiriesByMonth};

function ml(d){ return MONTHS[((d._id?.m||d._id?.month||1))-1]+"'"+(d._id?.y||d._id?.year||'').toString().slice(-2); }

/* Growth */
new Chart(document.getElementById('growthChart'),{
  type:'line',
  data:{
    labels: ownerTrend.map(ml),
    datasets:[
      { label:'Owners',   data:ownerTrend.map(d=>d.count),   borderColor:'#f59e0b', backgroundColor:'rgba(245,158,11,0.08)', tension:0.4, fill:true, pointRadius:4 },
      { label:'Students', data:studentTrend.map(d=>d.count), borderColor:'#09B850', backgroundColor:'rgba(9,184,80,0.08)',   tension:0.4, fill:true, pointRadius:4 }
    ]
  },
  options:{ responsive:true, plugins:{legend:{position:'bottom'}}, scales:{x:{grid:{display:false}},y:{beginAtZero:true,grid:{color:'#f3f4f6'},ticks:{precision:0}}} }
});

/* Listing trend */
new Chart(document.getElementById('listingTrendChart'),{
  type:'bar',
  data:{ labels:listingTrend.map(ml), datasets:[{ label:'Listings', data:listingTrend.map(d=>d.count), backgroundColor:'rgba(59,130,246,0.7)', borderRadius:6 }] },
  options:{ responsive:true, plugins:{legend:{display:false}}, scales:{x:{grid:{display:false}},y:{beginAtZero:true,ticks:{precision:0}}} }
});

/* Type doughnut */
new Chart(document.getElementById('typeChart'),{
  type:'doughnut',
  data:{ labels:typeData.map(d=>d._id), datasets:[{ data:typeData.map(d=>d.count), backgroundColor:['rgba(9,184,80,0.8)','rgba(59,130,246,0.8)','rgba(245,158,11,0.8)'], borderWidth:2, borderColor:'#fff' }] },
  options:{ responsive:true, plugins:{legend:{position:'bottom'}}, cutout:'65%' }
});

/* Enquiry status */
new Chart(document.getElementById('enquiryStatusChart'),{
  type:'doughnut',
  data:{ labels:enqStatus.map(d=>d._id), datasets:[{ data:enqStatus.map(d=>d.count), backgroundColor:['rgba(59,130,246,0.8)','rgba(9,184,80,0.8)','rgba(156,163,175,0.8)'], borderWidth:2, borderColor:'#fff' }] },
  options:{ responsive:true, plugins:{legend:{position:'bottom'}}, cutout:'65%' }
});

/* Cities */
new Chart(document.getElementById('citiesChart'),{
  type:'bar',
  data:{ labels:topCities.map(d=>d._id||'Unknown'), datasets:[{ label:'Listings', data:topCities.map(d=>d.count), backgroundColor:'rgba(139,92,246,0.7)', borderRadius:6 }] },
  options:{ indexAxis:'y', responsive:true, plugins:{legend:{display:false}}, scales:{x:{beginAtZero:true,ticks:{precision:0}},y:{grid:{display:false}}} }
});

/* Enquiry monthly */
new Chart(document.getElementById('enquiryChart'),{
  type:'line',
  data:{ labels:enqMonth.map(ml), datasets:[{ label:'Enquiries', data:enqMonth.map(d=>d.count), borderColor:'#14b8a6', backgroundColor:'rgba(20,184,166,0.08)', tension:0.4, fill:true, pointRadius:4 }] },
  options:{ responsive:true, plugins:{legend:{display:false}}, scales:{x:{grid:{display:false}},y:{beginAtZero:true,ticks:{precision:0}}} }
});
</script>
` }) %>