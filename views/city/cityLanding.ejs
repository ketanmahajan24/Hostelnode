     FOOTER
════════════════════════════════════════════ -->
 

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  /* ── Areas toggle ── */
  function toggleAreas() {
    const hidden  = document.getElementById('areasHidden');
    const btn     = document.getElementById('seeMoreAreasBtn');
    const chevron = document.getElementById('areasChevron');
    const isOpen  = hidden.classList.toggle('open');
    chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0)';
    btn.innerHTML = isOpen
      ? '<i class="fa-solid fa-chevron-up" id="areasChevron" style="transform:rotate(180deg)"></i> Show less'
      : '<i class="fa-solid fa-chevron-down" id="areasChevron"></i> See all areas';
  }

  /* ── FAQ accordion ── */
  function toggleFaq(i) {
    const item = document.getElementById('faq' + i);
    item.classList.toggle('open');
  }

  /* ── Image slider ── */
  function slideImg(e, btn, dir) {
    e.stopPropagation();
    const wrap   = btn.closest('.card-img-wrap');
    const slides = wrap.querySelectorAll('.slide');
    let idx = [...slides].findIndex(s => s.classList.contains('active'));
    slides[idx].classList.remove('active');
    slides[(idx + dir + slides.length) % slides.length].classList.add('active');
  }

  /* ── Contact helpers ── */
  function callHostel(phone) { if (phone) window.location.href = 'tel:' + phone; }
  function waHostel(phone) {
    const n = (phone || '').replace(/[^0-9]/g, '');
    if (!n) return;
    window.open('https://wa.me/' + n + '?text=' + encodeURIComponent('Hi! I found your PG on HostelNode and am interested. Can you share details?'), '_blank');
  }

  /* ── Track area click (GA4) ── */
  function trackAreaClick(area, city) {
    if (typeof gtag !== 'undefined') {
      gtag('event', 'area_click', { event_category: 'city_page', event_label: area + ' - ' + city });
    }
  }

  /* ── Navbar scroll ── */
  window.addEventListener('scroll', () => {
    document.getElementById('hnNav')?.classList.toggle('scrolled', scrollY > 10);
  }, { passive: true });
</script>

</body>
</html>
