<!-- ===== APP DOWNLOAD BAR (30px, slides down from top, first-time visitors only) ===== -->
<style>
  #hnAppBar{
    height:0;overflow:hidden;background:#0E1A12;color:#fff;
    font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
    transition:height .45s cubic-bezier(.22,1,.36,1);
    position:relative;z-index:1100;
  }
  #hnAppBar.show{height:30px}
  #hnAppBar .hnab-inner{
    height:30px;display:flex;align-items:center;justify-content:center;gap:10px;
    padding:0 40px;font-size:12.5px;line-height:1;white-space:nowrap;
  }
  #hnAppBar .hnab-text{overflow:hidden;text-overflow:ellipsis}
  #hnAppBar .hnab-dl{
    background:linear-gradient(135deg,#09B850,#0A9F45);color:#fff;font-weight:600;
    padding:4px 12px;border-radius:999px;text-decoration:none;font-size:12px;flex-shrink:0;
  }
  #hnAppBar .hnab-dl:hover{filter:brightness(1.08);color:#fff}
  #hnAppBar .hnab-close{
    position:absolute;right:8px;top:50%;transform:translateY(-50%);
    width:22px;height:22px;border:0;border-radius:50%;background:transparent;
    color:#fff;font-size:18px;line-height:1;cursor:pointer;display:flex;
    align-items:center;justify-content:center;opacity:.8;padding:0;
  }
  #hnAppBar .hnab-close:hover{opacity:1;background:rgba(255,255,255,.15)}
  @media (max-width:480px){
    #hnAppBar .hnab-inner{font-size:11.5px;gap:8px;padding:0 34px 0 10px}
  }
</style>

<div id="hnAppBar" role="region" aria-label="Download HostelNode app">
  <div class="hnab-inner">
    <span class="hnab-text">📱 Get the HostelNode app</span>
    <a class="hnab-dl" href="/app/Hostelnode.apk" download id="hnAppBarDl">Download</a>
  </div>
  <button type="button" class="hnab-close" id="hnAppBarClose" aria-label="Close">&times;</button>
</div>

<script>
(function () {
  var KEY = 'hn_app_bar_seen';
  var bar = document.getElementById('hnAppBar');
  if (!bar) return;

  var seen = false;
  try { seen = !!localStorage.getItem(KEY); } catch (e) {}
  if (seen) { bar.remove(); return; }

  function dismiss() {
    try { localStorage.setItem(KEY, '1'); } catch (e) {}
    bar.classList.remove('show');
    setTimeout(function () { bar.remove(); }, 500);
  }

  // slide down shortly after page load
  window.addEventListener('load', function () {
    setTimeout(function () { bar.classList.add('show'); }, 600);
  });

  document.getElementById('hnAppBarClose').addEventListener('click', dismiss);
  document.getElementById('hnAppBarDl').addEventListener('click', function () {
    try { localStorage.setItem(KEY, '1'); } catch (e) {}
  });
})();
</script>
