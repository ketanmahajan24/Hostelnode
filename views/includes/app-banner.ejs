<!-- ===== APP DOWNLOAD BAR (60px, slides down from top, first-time visitors only) ===== -->
<style>
  #hnAppBar{
    height:0;overflow:hidden;background:#0E1A12;color:#fff;
    font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;
    transition:height .45s cubic-bezier(.22,1,.36,1);
    position:relative;z-index:1100;
  }
  #hnAppBar.show{height:60px}
  #hnAppBar .hnab-inner{
    height:60px;display:flex;align-items:center;justify-content:center;gap:12px;
    padding:0 48px 0 14px;font-size:17px;font-weight:500;line-height:1;white-space:nowrap;
  }
  #hnAppBar .hnab-icon{width:40px;height:40px;object-fit:contain;flex-shrink:0;border-radius:9px;background:#fff;padding:3px}
  #hnAppBar .hnab-text{overflow:hidden;text-overflow:ellipsis}
  #hnAppBar .hnab-dl{
    background:linear-gradient(135deg,#09B850,#0A9F45);color:#fff;font-weight:600;
    padding:9px 18px;border-radius:999px;text-decoration:none;font-size:15.5px;flex-shrink:0;
  }
  #hnAppBar .hnab-dl:hover{filter:brightness(1.08);color:#fff}
  #hnAppBar .hnab-close{
    position:absolute;right:8px;top:50%;transform:translateY(-50%);
    width:32px;height:32px;border:0;border-radius:50%;background:transparent;
    color:#fff;font-size:26px;line-height:1;cursor:pointer;display:flex;
    align-items:center;justify-content:center;opacity:.8;padding:0;
  }
  #hnAppBar .hnab-close:hover{opacity:1;background:rgba(255,255,255,.15)}
  @media (max-width:480px){
    #hnAppBar .hnab-icon{width:36px;height:36px}
    #hnAppBar .hnab-inner{font-size:14.5px;gap:8px;padding:0 42px 0 10px}
    #hnAppBar .hnab-dl{font-size:14px;padding:8px 14px}
  }
</style>

<div id="hnAppBar" role="region" aria-label="Download HostelNode app">
  <div class="hnab-inner">
    <img class="hnab-icon" src="/images/hostelnode-logo-cutout.png" alt="HostelNode">
    <span class="hnab-text">Get the HostelNode app</span>
    <a class="hnab-dl" href="/app/Hostelnode.apk" download id="hnAppBarDl">Download</a>
  </div>
  <button type="button" class="hnab-close" id="hnAppBarClose" aria-label="Close">&times;</button>
</div>

<script>
(function () {
  var KEY = 'hn_app_bar_seen';
  var bar = document.getElementById('hnAppBar');
  if (!bar) return;

  // Never show inside the HostelNode mobile app itself (WebView / installed app)
  var ua = navigator.userAgent || '';
  var inApp =
    /; wv\)/i.test(ua) ||                 // Android WebView
    /HostelNodeApp/i.test(ua) ||           // custom UA tag (optional, set in your app)
    /(iPhone|iPod|iPad)(?!.*Safari)/i.test(ua) || // iOS WebView
    !!window.ReactNativeWebView ||         // React Native
    !!window.Capacitor ||                  // Capacitor / Ionic
    /[?&]app=1\b/.test(location.search) ||  // optional ?app=1 flag
    (window.matchMedia && matchMedia('(display-mode: standalone)').matches); // installed PWA
  if (inApp) { bar.remove(); return; }

  var seen = false;
  try { seen = !!localStorage.getItem(KEY); } catch (e) {}
  if (seen) { bar.remove(); return; }

  function dismiss() {
    try { localStorage.setItem(KEY, '1'); } catch (e) {}
    bar.classList.remove('show');
    setTimeout(function () { bar.remove(); }, 500);
  }

  // slide down once the DOM is ready (does not wait for images/fonts, which
  // can take very long on mobile networks) and after the page loader fades
  function reveal() { setTimeout(function () { bar.classList.add('show'); }, 700); }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', reveal);
  } else {
    reveal();
  }

  document.getElementById('hnAppBarClose').addEventListener('click', dismiss);
  document.getElementById('hnAppBarDl').addEventListener('click', function () {
    try { localStorage.setItem(KEY, '1'); } catch (e) {}
  });
})();
</script>
