<script>
  (function() {
  var btn   = document.getElementById('capsule');
  var front = true;
  var locked = false;

  function flip() {
    if (locked) return;
    locked = true;
    if (front) {
      btn.classList.add('flipped');
      btn.classList.remove('unflipping');
    } else {
      btn.classList.add('unflipping');
      btn.classList.remove('flipped');
    }
    front = !front;
    setTimeout(function() { locked = false; }, 700);
  }

  setInterval(flip, 3000);
})();
</script>

<% if (student) { %>
<script>
(function () {
  const dropdown = document.getElementById('notifDropdown');
  const badge = document.getElementById('notifBadge');
  const list = document.getElementById('notifList');
  let loaded = false;

  function timeAgo(dateStr) {
    const diffMs = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diffMs / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + 'h ago';
    return Math.floor(hrs / 24) + 'd ago';
  }

  async function loadNotifs() {
    try {
      const res = await fetch('/notifications');
      const data = await res.json();
      if (!data.success) return;

      badge.style.display = data.unreadCount > 0 ? 'flex' : 'none';
      badge.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount;

      if (!data.notifications.length) {
        list.innerHTML = '<div class="hn-notif-empty">No notifications yet</div>';
        return;
      }
      list.innerHTML = data.notifications.map(function (n) {
        const href = n.link || '#';
        return '<a class="hn-notif-item ' + (n.isRead ? '' : 'unread') + '" href="' + href + '" onclick="markNotifRead(\'' + n._id + '\')">' +
          '<div class="n-title">' + n.title + '</div>' +
          (n.body ? '<div class="n-body">' + n.body + '</div>' : '') +
          '<div class="n-time">' + timeAgo(n.createdAt) + '</div>' +
          '</a>';
      }).join('');
    } catch (err) { /* silent — bell just stays empty on a network hiccup */ }
  }

  window.toggleNotifDropdown = function (e) {
    e.stopPropagation();
    const willOpen = !dropdown.classList.contains('open');
    dropdown.classList.toggle('open');
    if (willOpen && !loaded) { loaded = true; loadNotifs(); }
    else if (willOpen) { loadNotifs(); }
  };

  window.markNotifRead = function (id) {
    fetch('/notifications/' + id + '/read', { method: 'POST' }).catch(function () {});
  };

  window.markAllNotifsRead = async function () {
    try {
      await fetch('/notifications/read-all', { method: 'POST' });
      loadNotifs();
    } catch (err) {}
  };

  document.addEventListener('click', function (e) {
    if (!e.target.closest('.hn-notif-wrap')) dropdown.classList.remove('open');
  });

  // Refresh the unread badge periodically without opening the dropdown.
  loadNotifs();
  setInterval(loadNotifs, 30000);
})();
</script>
<% } %>